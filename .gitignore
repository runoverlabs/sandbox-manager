# Nothing in this repo is generated, and nothing machine-local belongs in it.
# Machine state lives in ~/.config/msb/ and ~/.local/state/msb/ — see README.

*.swp
*~
.DS_Store
__pycache__/

# Belt and braces. Secrets live in ~/.config/msb/secrets/ at 0600 and should
# never be anywhere near a checkout, but a stray one must not be committable.
*.env
!*.env.example
secrets/

# Release builds from scripts/package.sh.
dist/

# What this MACHINE owns and the repo must not carry, staged in the checkout
# because a dev sandbox mounts nothing else: agent tool bundles point at the
# operator's own endpoints, so they live in ~/.config/msb/tools/ and never here.
# See docs/content/agent-tools.md.
/local/

# The documentation site, built by docs/build.py.
docs/_site/

# ruff, when run by hand (check.sh passes --no-cache)
.ruff_cache/
.claude
