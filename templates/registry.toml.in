# {{NAME}} — registry entry, written by `msbctl add` on {{DATE}}.
#
# Machine-local. Lives in ~/.config/msb/sandboxes/ and is never committed:
# it holds an absolute host path, which is exactly the thing that must not end
# up in a repo.
#
# Hand-editable. msbctl only ever reads this with tomllib; the one exception is
# the [versions] table, which `msbctl update` rewrites — see below.
#
# Anything portable (egress groups, bootstrap extras, resources) belongs in
# {{PROJECT}}/.msb/sandbox.toml instead, so it travels with the repo. The keys
# here override that file when both set the same thing.

name    = "{{NAME}}"
project = "{{PROJECT}}"

# Where the project appears inside the sandbox: "/work", "host" for the same
# path as `project` (so absolute paths in errors and agent output are valid on
# both sides, and it follows a `msbctl move`), or any absolute path. Fixed at
# create time: change it with `msbctl edit {{NAME}}` → Name & folder, which
# offers the rebuild. Claude Code keeps its sessions per path, so the ones from
# the old path stay behind.
guest_path = "{{GUEST_PATH}}"

# owner/name, used for the PAT binding and shown in the picker. Empty if the
# project has no GitHub remote.
repo = "{{REPO}}"

# Git identity, by name from config.toml's [identities]. Applied inside the
# guest with `git config --system` on every start, so changing it here takes
# effect on the next start rather than needing a rebuild.
#
# --system is the LOWEST of git's three layers: this repo's own .git/config,
# and a ~/.gitconfig in the guest, both still win. It is the fallback that stops
# `git commit` failing with "Please tell me who you are" in a repo that carries
# no identity of its own. Empty for none.
identity = "{{IDENTITY}}"

# How git reaches GitHub from inside, set on every start (so a change needs a
# restart, not a rebuild). The repo's own remote is never touched — it is your
# checkout, shared with the host — git rewrites the URL on the way out instead:
#   "gh"   fetch and push over https. An ssh origin is turned into https, and
#          gh's credential helper hands git the GitHub token's placeholder.
#          Needs the GitHub token (`msbctl edit {{NAME}}` → GitHub token).
#   "ssh"  push over ssh, through the forwarded agent, offering github.com only
#          the identity's push_key (a key allowed under ssh keys, below). With
#          no push key, ssh offers every allowed key and GitHub takes the first
#          it knows, which may be another account.
# gh still does PRs, Actions and the API in both. `msbctl edit {{NAME}}` → Git
# push. Empty follows [defaults] git_push.
git_push = "{{GIT_PUSH}}"

# Which Claude token this sandbox logs in with, by the name it was stored under
# (`msbctl setup` → Claude login). Empty follows [defaults] claude_token. The
# value is read on every start, so a change needs a restart, not a rebuild.
claude_token = "{{CLAUDE_TOKEN}}"

# Started by `msbctl start --autostart`: when the picker opens, and on a host
# after a reboot (`msbctl host autostart install`). Each idle sandbox costs
# ~300 MB, so this is cheap, but a stopped sandbox cannot be version-probed.
autostart = {{AUTOSTART}}

# WRITTEN BY msbctl. The digest of the project policy last approved for this
# sandbox: the egress rules, secret bindings and resources in
# {{PROJECT}}/.msb/sandbox.toml. That file is committed and writable from inside
# the sandbox, so a create or rebuild that finds it changed shows the
# difference and asks first (`msbctl policy {{NAME}}` shows it,
# `msbctl policy {{NAME}} approve` accepts it). Without a terminal it refuses.
policy_pin = ""

# --------------------------------------------------------------- ssh keys
#
# Which keys in your host ssh-agent this sandbox can see and sign with, by
# fingerprint — for git over ssh, and for signing commits. The keys never enter
# the VM; the sandbox talks to a per-sandbox filter in front of your agent.
#
# Edit with `msbctl keys {{NAME}}`; it takes effect immediately. Absent means
# every key (what entries from before this existed get); [] means none.
{{SSH_KEYS}}

# ------------------------------------------------------------ extra folders
#
# Other host folders mounted into the sandbox, as "HOST[:GUEST][:ro|rw]" — the
# guest path defaults to /mnt/<name> and the mode to ro. Read-write writes land
# in the host folder as you. Host paths are why this lives here and not in the
# project. Fixed at create time: `msbctl mount {{NAME}} ...` adds one, then
# `msbctl rebuild {{NAME}}` applies it.
{{MOUNTS}}

# ------------------------------------------------------ this machine's groups
#
# Egress groups only THIS machine defines (your own, in config.toml's [rules],
# such as one for a homelab's LAN hosts), added to the project's rule_groups.
# Here and not in the project because nobody who clones it has them: in its
# sandbox.toml they would make every other machine's create fail with "unknown
# rule group". `msbctl add` and `msbctl edit {{NAME}}` → Features & agents put
# them here. A group listed in [defaults] private_dns_groups turns on
# allow_private_dns for this sandbox as well. Fixed at create time: rebuild.
{{EXTRA_RULE_GROUPS}}

# --------------------------------------------------------- published ports
#
# Host ports that reach a server inside the sandbox, so a browser here can open
# http://localhost:PORT: "PORT" (the same on both sides), "HOST:GUEST", or
# "BIND:HOST:GUEST", each optionally "/udp". The host side binds 127.0.0.1
# unless BIND says otherwise — "0.0.0.0:..." opens it to your whole network.
# The server inside must listen on 0.0.0.0: msb connects to the guest's own
# address, so one bound to localhost is never reached. Inbound, so the egress
# rules do not apply. Here and not in the project because a host port is this
# machine's to hand out. Fixed at create time: `msbctl port {{NAME}} 8080` adds
# one, then `msbctl rebuild {{NAME}}` applies it.
# ports = ["8080", "3000:5173"]

# ---------------------------------------------------------------- overrides
#
# Every key below is optional. Omit one and the value comes from
# {{PROJECT}}/.msb/sandbox.toml, then from ~/.config/msb/config.toml.
#
# Uncomment to pin this sandbox to something different from the defaults:
#
# image       = "mcr.microsoft.com/devcontainers/base:ubuntu@sha256:..."
# cpus        = 8
# memory      = "16G"
# root_disk   = "32G"
# conf        = ".msb/dev.yaml"     # relative to project, and must stay inside
#                                   # it; read for `image:` only
# rule_groups = ["github", "npm", "python"]
# extra_rules = ["allow@mirror.example.com:tcp:443"]
# msb_conf    = "~/.config/msb/conf/{{NAME}}.yaml"
#                                   # YOUR msb config file, passed as --conf, for
#                                   # what msbctl does not model (user, rlimits,
#                                   # security, ...). Absolute path. Here only and
#                                   # never in a project: msb's config can mount
#                                   # host paths and copy host files in. It may
#                                   # not contain `${`, which msb fills in from
#                                   # its environment — the one holding the
#                                   # bound secrets. Flags msbctl emits win.
# push_key    = "ssh-ed25519 AAAA... laptop"
#                                   # the public key git_push = "ssh" pushes
#                                   # with, instead of the identity's push_key.
# volumes     = "old-name"          # prefix of the cache/container disk volumes;
#                                   # `msbctl rename` sets it, since msb cannot
#                                   # rename a volume. Defaults to the name.
#
# egress_mode = "observe"   # NOTHING IS BLOCKED; every host reached is recorded.
#                           # For finding out what the rules above are missing,
#                           # because msb never says what it denied. Temporary:
#                           # `msbctl observe {{NAME}}` reads the record back,
#                           # `msbctl observe {{NAME}} off` restores deny-by-default.

# ----------------------------------------------------------------- versions
#
# WRITTEN BY `msbctl update`, not by hand — though hand-editing is fine.
#
# This table exists because updating a component inside a running sandbox
# diverges from the pins in bootstrap.sh, and the next rebuild would silently
# revert it. Recording what was installed here makes the rebuild reproduce it.
# Delete an entry to go back to the default in config.toml.
[versions]
