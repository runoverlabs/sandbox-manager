#!/usr/bin/env python3
# Screenshot harness: the real msbctl, minus the msb/KVM preflight.
import importlib.machinery, importlib.util, os
real = os.environ["MSBCTL_REAL"]
loader = importlib.machinery.SourceFileLoader("msbctl", real)
spec = importlib.util.spec_from_file_location("msbctl", real, loader=loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)
mod.preflight = lambda args: None
mod.main()
