#!/usr/bin/env python3
# Fake msb: invented state for screenshots.
import json, os, sys
STATE = {"webshop": "running", "ml-notebooks": "running", "infra": "stopped"}
USAGE = {"webshop": "MEM=1873/8192 LOAD=0.42 CPUS=4",
         "ml-notebooks": "MEM=5120/16384 LOAD=2.87 CPUS=8"}
a = sys.argv[1:]
if a[:1] == ["ls"] and "--format" in a:
    print(json.dumps([{"name": n, "image": "base", "status": s.capitalize(),
                       "created_at": "2026-10-01T12:00:00+00:00"} for n, s in STATE.items()]))
elif a[:1] == ["ls"]:
    print("NAME          IMAGE   STATUS   CREATED")
    for n, s in STATE.items():
        print(f"{n}  base  {s}  2026-10-01")
elif a[:1] == ["exec"]:
    if "MemTotal" in " ".join(a):
        print(USAGE.get(a[1], ""))
elif a[:1] == ["inspect"]:
    sock = os.path.join(os.environ["MSB_STATE_DIR"], "agent", f"{a[1]}.sock")
    print(json.dumps({"config": {"vsock": {"routes": [{"port": 5001, "host_socket": sock}]}}}))
elif a[:2] == ["volume", "ls"]:
    G = 1 << 30
    print(json.dumps([
        {"name": "webshop-cache-npm", "kind": "disk", "capacity_bytes": 8 * G, "used_bytes": int(2.3 * G)},
        {"name": "ml-notebooks-cache-python", "kind": "disk", "capacity_bytes": 16 * G, "used_bytes": int(6.1 * G)},
    ]))
