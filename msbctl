def pick_signing_key(current_pub):
    """Choose the ssh key an identity signs commits with, or none. Returns the
    public key line to store (git needs the key itself, not a fingerprint), or
    None. Same dialog as `msbctl keys`; the key still has to be one a sandbox is
    allowed to use, which `msbctl keys` and `msbctl add` take care of."""
    cur = _parse_pub_line(current_pub)[0] if current_pub and _parse_pub_line(current_pub) else None
    note("Sign commits with an ssh key? Tick one key to sign every commit made as this")
    note("identity (git's ssh signing; the key stays in your host agent), or none.")
    chosen = pick_ssh_keys([cur] if cur else [], preselect_all=False, signing=cur, single=True)
    if not chosen:
        return None
    pub = public_line(chosen[0][0])
    if not pub:
        warn("could not read that key's public half — no signing key saved")
        return None
    return pub


