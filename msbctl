    else:
        claude = f"{len(tokens)} Claude tokens, default {default_claude_token(config)!r}"
    return claude + (", GitHub token for update checks" if env.get("GH_TOKEN") else "")


def sandboxes_on_token(name, config):
    """The registered sandboxes whose entry pins Claude token `name`."""
    return [n for n in registered()
            if read_toml(registry_path_for(n)).get("claude_token") == name]


def section_login(config, ctx):
    while True:
        config = load_config()
        env = read_env_file(GLOBAL_ENV)
        tokens = claude_tokens(env)
        default = default_claude_token(config)
        say("Claude login")
        note("Sandboxes use a long-lived token from `claude setup-token`. It stays on this")
        note("machine: the sandbox sees only a placeholder, and the real value is swapped")
        note("in on the way out to the two Anthropic hosts. Stored 0600 in secrets/global.env.")
        note("Keep one per account (say `work` and `personal`); a sandbox uses the default")
        note("unless `msbctl edit <name>` → Claude token picks another.")
        if not tokens:
            note("  Claude tokens:  NOT SET")
        for name in tokens:
            pinned = sandboxes_on_token(name, config)
            note(f"  Claude token:  {name}{'  (default)' if name == default else ''}"
                 + (f"  — pinned by {', '.join(pinned)}" if pinned else ""))
        if tokens and default not in tokens:
            warn(f"the default token {default!r} is not stored — pick another default")
        note(f"  GitHub token:  {'stored' if env.get('GH_TOKEN') else 'not set (optional)'}")
        rows = ["add a Claude token (or replace one)"]
        if shutil.which("claude"):
            rows.append("run `claude setup-token` now, then add")
        if len(tokens) > 1 or (tokens and default not in tokens):
            rows.append("choose the default Claude token")
        if tokens:
            rows.append("remove a Claude token")
        rows += ["set a GitHub token for update checks  (optional, host-side only)", "back"]
        action = choose_one("login", rows, 0)
        if action.startswith("run"):
            subprocess.run(["claude", "setup-token"])
            action = "add"
        if action.startswith("add"):
            suggest = "" if tokens else CLAUDE_TOKEN_MAIN
            name = ask("name for it (e.g. work, personal)", suggest).strip().lower()
            if not CLAUDE_TOKEN_NAME.fullmatch(name):
                note("skipped — a name is a lowercase letter, then letters, digits or _")
                continue
            token = read_secret_hidden(f"paste the {name} token")
            if not token or any(c.isspace() for c in token):
                note("skipped — nothing saved")
                continue
            if not token.startswith("sk-ant-"):
                warn("that does not look like a Claude token (they start with sk-ant-) — saved anyway")
            set_env_file_value(GLOBAL_ENV, claude_token_var(name), token)
            note(f"stored {name!r} in {tilde(GLOBAL_ENV)} (0600); running sandboxes "
                 "pick it up on their next start")
            if not tokens and name != default:
                # The first token is the default, whatever it is called.
                set_toml_key(CONFIG_FILE, "claude_token", name, table="defaults")
                note(f"{name!r} is now the default")
        elif action.startswith("choose"):
            names = list(tokens)
            pick = choose_one("default Claude token", names,
                              names.index(default) if default in names else 0)
            set_toml_key(CONFIG_FILE, "claude_token", pick, table="defaults")
            note(f"default is {pick!r}: every sandbox that does not pin one uses it "
                 "from its next start")
        elif action.startswith("remove"):
            names = list(tokens)
            name = choose_one("remove which", names + ["cancel"], 0)
            if name == "cancel":
                continue
