# Above this many, the list is narrowed by a filter first: OpenRouter alone
# lists hundreds.
MODEL_LIST_FILTER_AT = 15


def pick_model(models, current=None, builtin=None):
    """One model id from a server's list, or typed by hand (an id the list
    does not show, or no list at all). `builtin` names a provider whose own
    default can be chosen instead (returned as ""). None means cancelled."""
    rows = []
    shown = models
    if len(models) > MODEL_LIST_FILTER_AT:
        text = ask(f"{len(models)} models — part of the id to narrow it down (blank: all)").strip()
        if text:
            shown = [m for m in models if text.lower() in m["id"].lower()] or models
            if shown is models:
                note(f"nothing matches {text!r} — all of them, then")
    for m in shown:
        ctx_len = f"  {m['context'] // 1000}k context" if m.get("context") else ""
        rows.append((f"{m['id']}{ctx_len}{'  (current)' if m['id'] == current else ''}", m["id"]))
    if builtin:
        rows.append((f"{builtin}'s own default (pi picks)", ""))
    rows += [("type a model id", "type"), ("cancel", None)]
    labels = [label for label, _ in rows]
    start = next((i for i, (_, v) in enumerate(rows) if v == current), 0)
    value = dict(rows)[choose_one("model", labels, start)]
    if value == "type":
        value = ask("model id, exactly as the server knows it", current or "").strip() or None
    return value


def _choose_llm_model(name, spec):
    """Pick the model an endpoint is used with, from what it serves now."""
    say(f"Model for {name}")
    key = read_env_file(GLOBAL_ENV).get(llm_key_var(name))
    try:
        models = fetch_llm_models(spec, key)
    except LlmError as exc:
        warn(f"could not ask {name} for its models ({exc}) — you can still type one")
        models = []
    current = llm_default_model(spec)
    if current and models and current not in [m["id"] for m in models]:
        note(f"{current!r} is no longer served")
    pick = pick_model(models, current, builtin=spec.get("provider"))
    if pick is None or pick == (current or ""):
        return
    set_toml_key(CONFIG_FILE, "default_model", pick or None, table=f"llm.{name}")
    if spec.get("models"):
        # A fixed list is what goes stale: offer the live one instead.
        if confirm(f"[llm.{name}] has a fixed `models` list — offer pi whatever the "
                   "server serves from now on instead?"):
            set_toml_key(CONFIG_FILE, "models", None, table=f"llm.{name}")
        elif pick and pick not in spec["models"]:
            set_toml_key(CONFIG_FILE, "models", [pick, *spec["models"]], table=f"llm.{name}")
    chosen = pick or f"{spec['provider']}'s own default"
    note(f"{name} now uses {chosen}; sandboxes pick it up on their next start — no rebuild")


def _resolves_privately(host):
    """True if every address `host` resolves to here is private (a LAN or a
    tailnet), which msb's DNS-rebind protection would drop."""
    try:
        addrs = {info[4][0] for info in socket.getaddrinfo(host, 443, proto=socket.IPPROTO_TCP)}
    except OSError:
        return False
    return bool(addrs) and all(ipaddress.ip_address(a.split("%")[0]).is_private for a in addrs)


def _add_llm(config):
    """Ask for one model source and write it, key by key, to config.toml: a
    server of yours is probed for what it is and where it lists its models,
    and the model is picked from that list."""
    table = llm_endpoints(config)
    kinds = ["your own server (vLLM, llama.cpp, Ollama, LiteLLM, …)"] + list(PI_PROVIDERS)
    kind = choose_one("what kind", kinds + ["cancel"], 0)
    if kind == "cancel":
        return
    provider = None if kind == kinds[0] else kind
    url = ""
    if not provider:
        url = ask("its URL (with or without /v1)").strip()
        if url.startswith("http://"):
            warn("it has to be https:// — the key can only be swapped in on a TLS connection")
            return
        if "://" not in url:
            url = "https://" + url
    host = urllib.parse.urlsplit(url).hostname or ""
    suggested = provider or re.sub(r"[^a-z0-9-]", "-", host.split(".")[0].lower()).strip("-")
    name = ask("name for it", suggested).strip().lower()
    if name in table:
        warn(f"{name} exists already — remove it first, or `choose a model` for it")
        return
    key = read_secret_hidden("its API key") or None
    if key and any(c.isspace() for c in key):
        warn("that key has whitespace in it — nothing was saved")
        return

    if provider:
        spec = {"provider": provider}
        try:
            models = fetch_llm_models(spec, key)
        except LlmError as exc:
            warn(f"could not list its models ({exc}) — you can still type one")
            models = []
    else:
        ca, models = None, None
        while models is None:
            try:
                base, api, models = probe_llm_server(url, key, ca)
            except LlmError as exc:
                warn(str(exc))
                if exc.kind == "tls":
                    raw = ask("the CA certificate that signed it, as a PEM file "
                              "(blank to give up)").strip()
                    if not raw:
                        return
                    ca = os.path.realpath(os.path.expanduser(raw))
                    continue
                rows = (["enter the key again"] if exc.kind == "auth" else []) + \
                       ["save it anyway and type the model id", "cancel"]
                choice = choose_one("then", rows, 0)
                if choice == "cancel":
                    return
                if choice.startswith("enter"):
                    key = read_secret_hidden("its API key") or None
                    continue
                base, api, models = url, "openai-completions", []
        spec = {"base_url": base, "api": api}
        if ca:
            spec["ca_cert"] = ca
        if models:
            note(f"found an {API_LABELS[api]} server at {base}, serving {len(models)} model(s)")
        if _resolves_privately(host):
            note(f"{host} resolves to a private address: msb would drop that answer, so")
            note("sandboxes using it get allow_private_dns (private_dns = true).")
            spec["private_dns"] = True

    pick = pick_model(models, builtin=provider)
    if pick is None:
        return
    if pick:
        spec["default_model"] = pick
    problem = llm_problem(name, spec)
    if problem:
        warn(problem)
        return
    for k, value in spec.items():
        set_toml_key(CONFIG_FILE, k, value, table=f"llm.{name}")
    note(f"saved [llm.{name}] in {tilde(CONFIG_FILE)} (compat, max_tokens and reasoning "
         "are there for hand-editing)")
    if key:
        set_env_file_value(GLOBAL_ENV, llm_key_var(name), key)
        note(f"stored {llm_key_var(name)}")
    default = list(config.get("defaults", {}).get("llm", []))
    if name not in default and confirm(f"give {name} to every NEW sandbox with pi?"):
        set_toml_key(CONFIG_FILE, "llm", default + [name], table="defaults")


def _store_llm_key(name):
    var = llm_key_var(name)
    value = read_secret_hidden(f"its API key, stored as {var}")
    if not value:
        note("no key stored — right only for a server that wants none")
        return
    if any(c.isspace() for c in value):
        warn("that key has whitespace in it — nothing was stored")
        return
    set_env_file_value(GLOBAL_ENV, var, value)
    note(f"stored {var}; a running sandbox picks it up on its next start")


