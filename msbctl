                     "— `msbctl edit <name>` → Claude token")
            if name == default and len(names) > 1:
                note("that was the default — choose another")
        elif action.startswith("set a GitHub"):
            note("A token with NO scopes is enough: it only raises the anonymous 60/hour limit.")
            token = read_secret_hidden("paste the GitHub token")
            if token:
                set_env_file_value(GLOBAL_ENV, "GH_TOKEN", token)
                note("stored")
        else:
            return


# -- network

def _local_groups(config=None):
    return sorted(read_toml(CONFIG_FILE).get("rules", {}))


def machine_only_groups():
    """Groups this machine defines that msb-manager does not ship: a name in
    your config.toml's [rules] and not in defaults.toml's. Those belong in the
    registry entry's `extra_rule_groups`, never a project's sandbox.toml. A
    shipped group you redefined keeps its name everywhere, so it stays portable."""
    shipped = read_toml(DEFAULTS_FILE).get("rules", {})
    return {g for g in _local_groups() if g not in shipped}


def split_groups(groups):
    """(portable, machine-only) — the project's list and the registry's."""
    local = machine_only_groups()
    return [g for g in groups if g not in local], [g for g in groups if g in local]


def _summary_network(config):
    groups = _local_groups()
    return ", ".join(groups) if groups else "none of your own"


def section_network(config, ctx):
    while True:
        config = load_config()
        say("Your network")
        note("Egress is deny-by-default. A group is a named set of allowed destinations you")
        note("can give to any sandbox — for example your homelab's git server or registry.")
        note("It adds to the shipped groups (github, npm, …); it never loosens `base`.")
        for g in _local_groups():
            note(f"  {g:<14} {len(config['rules'].get(g, []))} rule(s)")
        action = choose_one("network", ["add a group", "remove a group", "back"], 0)
        if action.startswith("add"):
            _add_rule_group(config)
        elif action.startswith("remove"):
            groups = _local_groups()
            if not groups:
                note("none of your own to remove")
                continue
            g = choose_one("remove which", groups + ["cancel"], 0)
            if g != "cancel":
                set_toml_key(CONFIG_FILE, g, None, table="rules")
                for other in registered():
                    path = registry_path_for(other)
                    have = read_toml(path).get("extra_rule_groups", [])
                    if g in have:
                        set_toml_key(path, "extra_rule_groups", [x for x in have if x != g] or None)
                        note(f"  and from {other}'s extra_rule_groups (rebuild it to apply)")
                for key in ("private_dns_groups", "rule_groups"):
                    cur = list(config.get("defaults", {}).get(key, []))
                    if g in cur:
                        set_toml_key(CONFIG_FILE, key, [x for x in cur if x != g], table="defaults")
                note(f"removed {g}")
        else:
            return


def _add_rule_group(config):
    name = ask("name for the group (e.g. homelab)").strip().lower()
    if not NAME_SLUG.fullmatch(name):
        warn("lowercase letters, digits and dashes, starting with a letter")
        return
    if name == "base":
        warn("`base` is always applied and cannot be redefined")
        return
    shipped = read_toml(DEFAULTS_FILE).get("rules", {})
    if name in shipped:
        warn(f"{name} is a shipped group; yours would REPLACE it entirely")
        if not confirm("continue?"):
            return
    kind = choose_one("what do you allow", [
        "names over HTTPS      e.g. git.home.example, *.home.example",
        "addresses and ports   e.g. 10.0.0.10:22, 10.0.0.11:443"], 0)
    by_name = kind.startswith("names")
    raw = ask("list them, separated by spaces or commas")
    rules, notes = [], []
    for token in [t for t in re.split(r"[,\s]+", raw.strip()) if t]:
        if "@" in token:
            # A full rule, kept as given once it has the shape msb takes.
            try:
                rules.append(parse_allow_target(token))
            except SystemExit as exc:
                warn(str(exc).replace("msbctl: ", "", 1) + " — skipped")
            continue
        if by_name and ":" not in token:
            rules.append(parse_allow_target(token))
            if token.startswith("*.") and f"allow@{token[2:]}:tcp:443" not in rules:
                rules.append(f"allow@{token[2:]}:tcp:443")        # a suffix does not cover the apex
                notes.append(f"added {token[2:]} too: *.x does not cover x itself")
        elif not by_name and ":" not in token:
            warn(f"{token}: an address needs a port, like {token}:22 — skipped")
        else:
            try:
                rule = parse_allow_target(token)
            except SystemExit as exc:
                warn(str(exc).replace("msbctl: ", "", 1) + " — skipped")
                continue
            if re.search(r":tcp:80(\b|$)", rule):
                warn(f"{token}: plaintext :80 is denied by `base` first — skipped")
                continue
            rules.append(rule)
            if by_name and not rule.endswith(":tcp:443"):
                notes.append(f"{token}: a NAME on a port other than 443 is enforced by the addresses it "
                             "resolved to, which breaks against address pools — prefer 443")
    rules = list(dict.fromkeys(rules))
    if not rules:
        note("nothing to save")
        return
    for line in notes:
        note(line)
    set_toml_key(CONFIG_FILE, name, rules, table="rules")
    note(f"saved {name}: {len(rules)} rule(s)")
    if by_name and confirm("do those names resolve to PRIVATE (LAN) addresses?"):
        note("msb drops such answers as DNS-rebind protection, so sandboxes using this group")
        note("need allow_private_dns — msbctl will set it for them automatically.")
        cur = list(config.get("defaults", {}).get("private_dns_groups", []))
        if name not in cur:
            set_toml_key(CONFIG_FILE, "private_dns_groups", cur + [name], table="defaults")
    if confirm(f"give {name} to every NEW sandbox by default?"):
        cur = list(config.get("defaults", {}).get("rule_groups", []))
        if name not in cur:
            set_toml_key(CONFIG_FILE, "rule_groups", cur + [name], table="defaults")


