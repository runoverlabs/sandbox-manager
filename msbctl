def tilde(path):
    return path.replace(HOME, "~", 1) if path.startswith(HOME) else path


# ----------------------------------------------------------------------- toml

def read_toml(path):
    """Parse a TOML file. A missing file is an empty table, not an error."""
    try:
        with open(path, "rb") as fh:
            return tomllib.load(fh)
    except FileNotFoundError:
        return {}
    except tomllib.TOMLDecodeError as exc:
        die(f"{path}: {exc}")


def render(template_name, **values):
    """Fill {{KEY}} placeholders. Deliberately not a template engine."""
    with open(os.path.join(TEMPLATES, template_name), encoding="utf-8") as fh:
        text = fh.read()
    for key, value in values.items():
        text = text.replace("{{%s}}" % key, str(value))
    left = re.findall(r"\{\{(\w+)\}\}", text)
    if left:
        die(f"{template_name}: unfilled placeholders: {', '.join(sorted(set(left)))}")
    return text


# ---------------------------------------------------------------------- shell

def run(argv, env=None, check=True, capture=False, quiet=False, to_stderr=False):
    """Run a command. `env` is merged over os.environ, never replaces it.

    stdin is always /dev/null: `msb exec` forwards it into the guest, so the
    housekeeping execs ensure_running() does before `msbctl exec` hands over
    would otherwise eat the input piped to it (`echo x | msbctl exec . -- cat`
    printed nothing). `to_stderr` sends its stdout there instead, for steps
    that must not write into the stdout `msbctl exec` hands to its command."""
    merged = dict(os.environ)
    if env:
        merged.update(env)
    if capture:
        proc = subprocess.run(argv, env=merged, capture_output=True, text=True,
                              stdin=subprocess.DEVNULL)
    else:
        out = subprocess.DEVNULL if quiet else None
        proc = subprocess.run(argv, env=merged, stdin=subprocess.DEVNULL,
                              stdout=sys.stderr if to_stderr and not quiet else out,
                              stderr=out)
    if check and proc.returncode != 0:
        detail = (proc.stderr or "").strip() if capture else ""
        die(f"{argv[0]} failed ({proc.returncode}): {' '.join(argv[1:3])} {detail}")
    return proc


def git(project, *args):
    proc = subprocess.run(["git", "-C", project, *args],
                          capture_output=True, text=True)
    return proc.stdout.strip() if proc.returncode == 0 else ""


# ------------------------------------------------------------------- msb state

def msb_table():
    """`msb ls` as {name: state}.

    Text parsing because 0.7.6 has no machine-readable listing. Kept in ONE
    place so that a format change is one fix rather than a hunt: column 1 is
    the name, column 3 the state.
    """
    table = {}
    if not shutil.which("msb"):
        return table                # a laptop that only drives remotes
    proc = subprocess.run(["msb", "ls"], capture_output=True, text=True)
    if proc.returncode != 0:
        return table
    for line in proc.stdout.splitlines()[1:]:
        cols = line.split()
        if len(cols) >= 3:
            table[cols[0]] = cols[2]
    return table


def state_of(name, table=None):
    table = msb_table() if table is None else table
    return table.get(name, "absent")


# --------------------------------------------------------------------- secrets

def read_env_file(path):
    """Parse KEY=VALUE. Warns if the mode is not 600 — these hold tokens."""
    if not os.path.isfile(path):
        return {}
    mode = os.stat(path).st_mode & 0o777
    if mode != 0o600:
        warn(f"{tilde(path)} is mode {mode:04o}, expected 0600")
    values = {}
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            values[key.strip()] = value.strip().strip('"').strip("'")
    return values


# ------------------------------------------------------- the project's dev.yaml
#
# A project's .msb/dev.yaml is READ BY MSBCTL, for its `image:` line, and never
# handed to msb. msb's config file can mount host paths, copy host files into
# the guest and interpolate `${VAR}` from msb's own environment — the one that
# holds the bound secrets — and the project folder is writable from inside the
# sandbox. So the file is checked line by line, without a YAML parser, and a
# create refuses one that says anything msbctl does not read: a key that looks
# harmless today is one msb may act on tomorrow, and a silently ignored setting
# reads as applied.

# Top-level keys a dev.yaml may carry. Only `image` is read; the others are
# what older `msbctl add` runs wrote, and are accepted and ignored (cpus and
# memory come from sandbox.toml, the workdir from `guest_path`).
CONF_KEYS_READ = ("image", "cpus", "memory", "workdir")
_CONF_KEY = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*)\s*:")


def conf_problems(path):
    """Human-readable problems with a project dev.yaml; [] if there are none,
    and for a missing file (the image lookup reports that)."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            lines = fh.read().splitlines()
    except FileNotFoundError:
        return []
    problems = []
    for n, line in enumerate(lines, 1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or line == "---":
            continue
        if line[0] in " \t":
            problems.append(f"line {n}: nested values are not read ({stripped[:40]!r})")
            continue
        match = _CONF_KEY.match(line)
        if not match:
            problems.append(f"line {n}: not a `key: value` line ({stripped[:40]!r})")
        elif match.group(1) not in CONF_KEYS_READ:
            problems.append(f"line {n}: `{match.group(1)}` is not read by msbctl")
    return problems


# An OCI image reference: [registry[:port]/]path[:tag][@sha256:digest], the
# path lowercase. Validated because the positional image is the one value from
# a project that still reaches msb's argv, and a path-shaped one (`/home/you`,
# `./rootfs`, `~/x`, `file:///x`) is not an image a repo gets to name.
IMAGE_REF = re.compile(
    r"(?:[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[0-9]+)?/)?"
    r"[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*"
    r"(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*"
    r"(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?"
    r"(?:@sha256:[0-9a-f]{64})?")


def conf_image(path):
    """The `image:` of a dev.yaml, or None (no such line, or no file)."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                match = re.match(r"^image:\s*(\S+)\s*$", line)
                if match:
                    return match.group(1)
    except FileNotFoundError:
        pass  # no file: no image line
    return None


def image_problem(ref):
    """Why `ref` is not an OCI image reference, or None."""
    if not isinstance(ref, str) or not IMAGE_REF.fullmatch(ref):
        return ("not an image reference like registry/name:tag@sha256:… "
                "(a path is never accepted)")
    return None


# ---------------------------------------------------------------------- config

class Sandbox:
    """One registered sandbox, with its three config layers already resolved.

    Precedence, lowest first: config.toml [defaults] → <project>/.msb/sandbox.toml
    → the registry entry. The registry wins because it is the machine-local
    layer and the only one that can know about this particular checkout.
    """

    def __init__(self, name, config):
        self.name = name
        self.config = config
        self.entry = read_toml(os.path.join(REGISTRY_DIR, f"{name}.toml"))
        if not self.entry:
            die(f"no sandbox named {name!r} — `msbctl ls` to see what exists")
        # "folder": the project is a host folder, mounted. "repo": there is no
        # host folder at all — the code is cloned from GitHub into a disk volume
        # inside the sandbox, and the project layer is the repo's own .msb/ as
        # fetched at a recorded commit (policy_dir(), never mounted).
        self.source = self.entry.get("source", "folder")
        if self.source not in ("folder", "repo"):
            die(f"{name}.toml: source is {self.source!r}, expected \"folder\" or \"repo\"")
        self.is_repo = self.source == "repo"
        self.repo = self.entry.get("repo", "")
        if self.is_repo:
            if not self.repo:
                die(f"{name}.toml has `source = \"repo\"` but no `repo`")
            self.project = policy_dir(name)
        else:
            if "project" not in self.entry:
                die(f"{name}.toml has no `project` key — it was hand-edited into an "
                    "unusable state, or written by an older msbctl")
            self.project = os.path.realpath(os.path.expanduser(self.entry["project"]))
        self.autostart = bool(self.entry.get("autostart", False))
        self.project_cfg = read_toml(os.path.join(self.project, ".msb", "sandbox.toml"))

        defaults = config.get("defaults", {})
        if self.is_repo and ("conf" in self.project_cfg or "conf" in self.entry):
            # Only .msb/dev.yaml is fetched, so another path would be a missing
            # file and a silent fall to the default image.
            die(f"{name}: `conf` cannot be set for a sandbox cloned from {self.repo} — "
                "only .msb/dev.yaml is read from the repo")
        self.conf = self._pick("conf", ".msb/dev.yaml")
        self.cpus = self._pick("cpus", defaults.get("cpus", 4))
        self.memory = self._pick("memory", defaults.get("memory", "8G"))
        self.root_disk = self._pick("root_disk", defaults.get("root_disk", "16G"))
        # Which layer a binding came from decides where its VALUE may come
        # from: see secret_env(). The registry entry is the operator's; the
        # project's sandbox.toml is a file the sandbox itself can write.
        # A folder sandbox's registry list REPLACES the project's, like every
        # other key. A repo sandbox's ADDS to it: `secret add` and `allow` write
        # to the registry there, since there is no checkout to edit, and
        # replacing would silently drop what the repo asks for.
        if self.is_repo:
            self.registry_binds = list(self.entry.get("secret_binds", []))
            self.secret_binds = list(dict.fromkeys(
                self.project_cfg.get("secret_binds", []) + self.registry_binds))
        else:
            self.secret_binds = self._pick("secret_binds", [])
            self.registry_binds = list(self.secret_binds) if "secret_binds" in self.entry else []
        # {feature: size} for per-package-manager cache disks. See CACHES.
        self.caches = self._pick("caches", {})
        # Size of a dedicated disk for /var/lib/containers, or empty for none.
        self.containers_disk = self._pick("containers_disk",
                                          defaults.get("containers_disk", ""))
        self.claude_auth = defaults.get("claude_auth", "secret")
        # Registry only: token names exist on this machine, not in the project.
        self.claude_token_pinned = self.entry.get("claude_token", "")
        self.claude_token = self.claude_token_pinned or default_claude_token(config)
        self.identity_name = self._pick("identity", defaults.get("identity"))

        self.conf_path = os.path.join(self.project, self.conf)
        # Inside the project, always. An absolute `conf` (or one climbing out
        # with ../, or a symlink) would make os.path.join ignore the project,
        # and the file it names is read for the image and checked by
        # conf_problems() as if the project had written it.
        real_project = os.path.realpath(self.project)
        real_conf = os.path.realpath(self.conf_path)
        if not real_conf.startswith(real_project.rstrip(os.sep) + os.sep):
            die(f"{name}: conf {self.conf!r} is outside the project folder — it must name a "
                f"file under {tilde(self.project)} (set in {tilde(self._origin('conf'))})")
        # Disk volumes are named after the sandbox, but msb cannot rename a
        # volume, so a renamed sandbox keeps its old prefix here (`volumes` in
        # the registry entry) rather than losing its caches and images.
        self.volume_prefix = self.entry.get("volumes") or name
        self.state = os.path.join(STATE_DIR, "claude", name)
        self.agent_sock = os.path.join(AGENT_DIR, f"{name}.sock")

    def reload(self):
        """Read every layer again, after one was rewritten (a fetched policy)."""
        self.__init__(self.name, self.config)

    @property
    def repo_meta(self):
        """What fetch_repo_policy() recorded about the fetch: repo, ref, branch,
        sha, private, fetched_at. {} for a folder sandbox or before a fetch."""
        if not self.is_repo:
            return {}
        return read_json(os.path.join(self.project, "meta.json"))

    @property
    def workspace_volume(self):
        """The disk volume a repo sandbox's clone lives on. Kept across rebuilds,
        deleted by purge."""
        return f"{self.volume_prefix}-workspace"

    @property
    def location(self):
        """Where the code is, for display: a host folder, or the repo."""
        if not self.is_repo:
            return tilde(self.project)
        ref = self.entry.get("ref") or self.repo_meta.get("branch") or "(default branch)"
        return f"github:{self.repo}@{ref}"

    def wants_component(self, comp):
        """Whether this sandbox is set up to have `comp`. Used to keep bun, gitleaks and a
        claude that was switched off, out of the version display and the probes."""
        boot = self.project_cfg.get("bootstrap", {})
        if comp == "bun":
            return bool(boot.get("bun"))
        if comp == "gitleaks":
            return bool(boot.get("gitleaks"))
        if comp == "claude":
            return boot.get("claude") is not False
        return True

    def cache_volume(self, key):
        return f"{self.volume_prefix}-cache-{key}"

    @property
    def containers_volume(self):
        return f"{self.volume_prefix}-containers"

    def owned_volumes(self, vols=None):
        """Names of the existing disk volumes that belong to this sandbox."""
        return [n for n in (msb_volumes() if vols is None else vols)
                if n.startswith(f"{self.volume_prefix}-cache-")
                or n in (self.containers_volume, self.workspace_volume)]

    def named_disk_flags(self, volume, dest, size):
        """`--mount-named` for a disk volume that OUTLIVES the sandbox, so a rebuild
        keeps what is on it. The volume is created by the first mount. Its size is
        fixed at that moment and msb refuses a create that asks for a different
        one, so an existing volume's own capacity wins over the config."""
        have = msb_volumes().get(volume)
        if have and have.get("kind") == "disk" and have["capacity_bytes"] != size_bytes(size):
            warn(f"{volume} already exists at {human_size(have['capacity_bytes'])} but the config "
                 f"says {size} — keeping it as is (`msbctl cache {self.name} clear` to recreate)")
            size = f"{have['capacity_bytes'] // MIB}M"
        return ["--mount-named", f"{volume}:{dest}:kind=disk,size={size}"]

    @property
    def cache_links(self):
        """[(where the volume is mounted, where the tool looks)]."""
        return [(f"{CACHE_MOUNT}/{key}", CACHES[key]) for key in self.caches if key in CACHES]

    @property
    def extra_mounts(self):
        """[(host path, guest path, "ro"|"rw")] from the registry entry. Host
        paths are machine-local, so these live there and never in a repo."""
        return [parse_mount_spec(spec, self.guest_project)
                for spec in self.entry.get("mounts", [])]

    @property
    def published_ports(self):
        """[(spec, bind, host port, guest port, protocol)] from the registry
        entry. Machine-local like the mounts: a host port is this machine's to
        hand out, and a committed one would collide with whatever else a
        cloner runs on it."""
        return [parse_port_spec(spec) for spec in self.entry.get("ports", [])]

    @property
    def guest_path_setting(self):
        """`guest_path` as written: the entry's, else config.toml's [defaults]."""
        return self.entry.get("guest_path", self.config.get("defaults", {})
                              .get("guest_path", GUEST_PROJECT))

    @property
    def guest_project(self):
        """Where the project is mounted inside the guest.

        "host" means the host's own path, so absolute paths in compiler errors,
        stack traces and an agent's output (an ACP client opening the files it
        names) are valid on both sides. /work keeps the host's layout, your
        username included, out of the guest. Machine-local on purpose: a host
        path in the committed sandbox.toml would be one person's home folder.
        Create-time, like every mount, and Claude Code keys its sessions and
        memory by this path, so they do not follow a change.
        """
        raw = self.guest_path_setting
        if self.is_repo and raw == "host":
            die(f"{self.name}: guest_path \"host\" means the host folder's own path, and a "
                f"sandbox cloned from {self.repo} has no host folder — fix it in "
                f"{tilde(registry_path(self))}")
        if self.is_repo and "." in str(raw):
            # The clone is a named disk volume, and msb refuses one at a path
            # with a dot in it ("invalid or reserved device id").
            die(f"{self.name}: guest_path {raw!r} has a dot in it, which a disk volume "
                f"cannot be mounted at — fix it in {tilde(registry_path(self))}")
        path = self.project if raw == "host" else raw
        problem = guest_path_problem(path)
        if problem:
            die(f"{self.name}: guest_path {raw!r}: {problem} — fix it in "
                f"{tilde(registry_path(self))}")
        return os.path.normpath(path)

    @property
    def ssh_keys(self):
        """Fingerprints this sandbox may use, or None for every key.

        Absent in the registry entry means unrestricted, which is what entries
        written before this existed get. An empty list means none.
        """
        raw = self.entry.get("ssh_keys")
        if raw is None:
            return None
        return [str(item).split()[0] for item in raw if str(item).split()]

    def _pick(self, key, fallback):
        if key in self.entry:
            return self.entry[key]
        if key in self.project_cfg:
            return self.project_cfg[key]
        return fallback

    # ------------------------------------------------------------- the image

    @property
    def image(self):
        """Resolved from the registry entry, else from the project's dev.yaml.

        Extracted from the YAML with an anchored regex rather than parsed. The
        alternative is a PyYAML dependency for one scalar. `image:` is one line
        in a file this tool generates, and a non-match is an error rather than
        a guess. Whatever the source, it must be an OCI reference: the
        positional image is the one thing a project still hands to msb, and a
        path-shaped value (`/home/you`, `./rootfs`) is not something msbctl
        lets a repo choose. See image_problem().
        """
        if "image" in self.entry:
            ref, where = self.entry["image"], registry_path(self)
        elif self.is_repo and not os.path.isfile(self.conf_path):
            # A repo without .msb/dev.yaml gets the machine's default image.
            ref, where = self.config.get("defaults", {}).get("image", ""), CONFIG_FILE
        else:
            if not os.path.isfile(self.conf_path):
                die(f"{tilde(self.conf_path)} does not exist — `msbctl add` writes it")
            ref, where = conf_image(self.conf_path), self.conf_path
            if ref is None:
                die(f"no `image:` line in {tilde(self.conf_path)}")
        problem = image_problem(ref)
        if problem:
            die(f"{self.name}: image {ref!r} in {tilde(where)}: {problem}")
        return ref

    @property
    def msb_conf(self):
        """The operator's own msb config file (`msb_conf` in the registry
        entry), or None. REGISTRY ONLY, never `_pick`: it is the escape hatch
        for msb config-file features msbctl does not model (`user`, `rlimits`,
        `security`, ...), and those are exactly the features — host mounts,
        host file copies, `${VAR}` from msb's environment — that a project must
        not be able to reach. It must not contain `${` at all: msb interpolates
        that from its own environment, which holds every bound secret."""
        raw = self.entry.get("msb_conf")
        if not raw:
            return None
        path = os.path.expanduser(str(raw))
        where = tilde(registry_path(self))
        if not os.path.isabs(path):
            die(f"{self.name}: msb_conf {raw!r} must be an absolute path (in {where})")
        if not os.path.isfile(path):
            die(f"{self.name}: msb_conf {tilde(path)} is not a file (in {where})")
        with open(path, encoding="utf-8", errors="replace") as fh:
            if "${" in fh.read():
                die(f"{self.name}: msb_conf {tilde(path)} contains `${{`, which msb would "
                    "fill in from its own environment — the one holding the bound secrets. "
                    "Write the value out instead.")
        return path

    # -------------------------------------------------------------- the rules

    @property
    def rule_groups(self):
        """The project's groups (or the registry's, which replace them), then
        this machine's own: `extra_rule_groups` in the registry entry. Those
        ADD, and are not part of the project's pinned policy — a group defined
        only in this machine's config.toml means nothing to anyone else who
        clones the project, and in their sandbox.toml it would make every other
        machine's create fail with "unknown rule group"."""
        groups = self._pick("rule_groups",
                            self.config.get("defaults", {}).get("rule_groups", []))
        groups = list(dict.fromkeys(list(groups) + self.machine_rule_groups))
        return [g for g in groups if g != "base"]

    @property
    def machine_rule_groups(self):
        return [g for g in self.entry.get("extra_rule_groups", []) if g != "base"]

    @property
    def egress_mode(self):
        """"enforce" (deny-by-default, the point of this tool) or "observe".

        OBSERVE IS A DELIBERATE, TEMPORARY DOWNGRADE, not a softer policy. It
        exists because msb cannot report a denial: it logs what it ALLOWS and
        says nothing at all about what it blocks, at any log level (re-verified
        on 0.7.7 at --debug and --trace). So there is no "warn but permit" to
        emit, and the only way to learn what a sandbox actually needs is to let
        it through and write down where it went.

        What that costs while it is on: egress is unrestricted, so a sandbox can
        reach anywhere and anything in it could exfiltrate. Secrets are NOT
        exposed by this — substitution stays host-side and bound to its named
        hosts — but everything the guest can read, it can now send. Turn it on
        to collect, run `msbctl observe <name>` to see what was reached, feed
        that to `msbctl allow`, and turn it off again.

        Create-time, like every other network setting: changing it needs a
        rebuild, not a restart.
        """
        # REGISTRY ONLY, never `_pick`: the project's sandbox.toml is committed
        # and writable from inside the sandbox, so a project that could set
        # this could switch its own deny-by-default off.
        if "egress_mode" in self.project_cfg and not getattr(self, "_warned_egress_mode", False):
            self._warned_egress_mode = True
            warn(f"{self.name}: egress_mode in {tilde(project_path(self))} is ignored — it is "
                 f"machine-local only (`msbctl observe {self.name} on` sets it in the registry entry)")
        mode = self.entry.get("egress_mode",
                              self.config.get("defaults", {}).get("egress_mode", "enforce"))
        if mode not in EGRESS_MODES:
            die(f"{self.name}: egress_mode is {mode!r}, expected one of "
                f"{', '.join(EGRESS_MODES)}")
        return mode

    @property
    def observing(self):
        return self.egress_mode == "observe"

    @property
    def extra_rules(self):
        if self.is_repo:
            # The repo's rules, then the operator's: see registry_binds.
            return list(dict.fromkeys(self.project_cfg.get("extra_rules", [])
                                      + self.entry.get("extra_rules", [])))
        return self._pick("extra_rules", [])

    @property
    def allow_private_dns(self):
        """Emit --no-dns-rebind-protection.

        msb drops DNS answers that resolve to RFC1918 addresses. That is right
        by default and wrong for a homelab that publishes private addresses in
        PUBLIC DNS: a name like `git.example.com` can be a real public record
        pointing at 192.168.x.x, so the answer is discarded and the name comes
        back NXDOMAIN inside the guest — indistinguishable from a missing
        egress rule.

        Opt-in per project rather than always on. What it costs is narrow but
        real: a hostname rule on a port other than :443 is enforced as "the
        addresses this name resolved to", so an attacker who can shape DNS
        answers could repoint such a rule at an internal address. On :443 the
        interceptor matches the SNI and this does not apply. Deny-by-default
        still holds either way — it only widens what a *name* can resolve to,
        never what is reachable without a rule.
        """
        # A machine-local group that resolves to LAN addresses brings it along,
        # from the same machine-local place: such a group does not work without
        # it, and the failure reads as a missing rule.
        private = self.config.get("defaults", {}).get("private_dns_groups", [])
        return bool(self._pick("allow_private_dns", False)
                    or any(g in private for g in self.machine_rule_groups))

    def image_or_none(self):
        """image, but None instead of dying when the conf file is missing.

        For display. A registration whose project moved or whose dev.yaml was
        deleted must still appear in the sidebar — showing it as broken is the
        point, and killing the render of every other sandbox is not.
        """
        try:
            return self.image
        except SystemExit:
            return None

    def net_rules(self):
        """base first, then each named group in order, then the project's own.

        Order is the whole point: rules are first-match-wins, so the `base`
        group's `deny@...:tcp:80` has to precede anything that might allow a
        plaintext host. Emitting base unconditionally and first means no
        sandbox can reorder its way past it.
        """
        table = self.config.get("rules", {})
        sources = [("base", table.get("base", []))]
        for group in self.rule_groups:
            if group not in table:
                die(f"{self.name}: unknown rule group {group!r}. "
                    f"Known: {', '.join(sorted(table))}")
            sources.append((group, table[group]))
        sources.append((None, self.extra_rules))
        rules = []
        for group, items in sources:
            for rule in items:
                problem = rule_problem(rule)
                if problem:
                    where = (f"rule group `{group}` (`msbctl config` shows which file)" if group
                             else f"extra_rules in {tilde(self._origin('extra_rules'))}")
                    die(f"{self.name}: {rule!r} in {where}: {problem}")
            rules.extend(items)
        return rules

    def _origin(self, key):
        """The file a `_pick` key came from: the registry entry, else sandbox.toml."""
        if key in self.entry:
            return os.path.join(REGISTRY_DIR, f"{self.name}.toml")
        return os.path.join(self.project, ".msb", "sandbox.toml")

    # ------------------------------------------------------------ the secrets

    def secret_env(self):
        """(flags, env) — the env NEVER reaches argv.

        `--secret ENV@HOST` stores only a reference to a host environment
        variable; the value is read at START time, not once at create. So this
        has to be assembled before every start, including the implicit one that
        `shell` does on a stopped sandbox. Relying on whichever terminal
        happens to have a token exported produces a sandbox whose secret
        resolves to nothing, which then fails at the point of use rather than
        at launch.
        """
        flags, env = [], {}
        # A repo sandbox always binds its token when one is stored: it is how
        # the clone authenticates and how its work gets pushed (there is no
        # agent to forward), and the binding is the fixed one, to GitHub only.
        wants_github = self.is_repo or self.project_cfg.get("secrets", {}).get(
            "github", bool(self.repo))

        if self.claude_auth == "secret":
            token = claude_tokens().get(self.claude_token)
            if token:
                env[CLAUDE_TOKEN_VAR] = token
                # Both hosts: Claude Code talks to api.anthropic.com for
                # inference and to platform.claude.com on startup. Binding only
                # the first sends the literal placeholder to the second, which
                # fails as "not logged in" rather than as anything naming the
                # cause. Both are Anthropic's own endpoints and the token is
                # minted by `claude setup-token` against them, so this widens
                # nothing: it is the same credential reaching the same party.
                # Its own hosts are also its passthrough hosts, which is not a
                # contradiction: the real token goes in the headers, and the
                # placeholder is allowed to appear in the BODY — which is where
                # it lands as soon as the agent reads it back out of its own
                # environment and it becomes part of the transcript.
                flags += ["--secret", with_transcript_passthrough(CLAUDE_SPEC)]
            elif claude_tokens():
                warn(f"{self.name}: no Claude token named {self.claude_token!r} — Claude Code "
                     "will not be logged in. Add it with `msbctl setup` → Claude login, or "
                     f"pick another with `msbctl edit {self.name}` → Claude token.")
            else:
                warn("no Claude token stored — Claude Code will not be logged in. "
                     "`msbctl setup` → Claude login.")

        if wants_github:
            token = read_env_file(os.path.join(SECRETS_DIR, f"{self.name}.env")) \
                .get("GH_TOKEN")
            if token:
                env["GH_TOKEN"] = token
                flags += ["--secret", with_transcript_passthrough(
                    "GH_TOKEN@github.com,api.github.com")]
            else:
                note(f"no GH_TOKEN for {self.name} — " + (
                    "the clone of a private repo, git push and the GitHub API need one: "
                    f"`msbctl secret set {self.name} GH_TOKEN`" if self.is_repo else
                    "the GitHub API is unavailable in this sandbox (git push over SSH still works)"))

        # Extra bindings, in msb's own `ENV[:OPTIONS]@HOST[,HOST]` syntax so a
        # hand-written one works too. Like the others, the value only ever
        # travels in the environment of the msb process.
        #
        # Where the value may come from depends on who wrote the binding. A
        # binding in the project's sandbox.toml decides which HOST a stored
        # value is sent to, and that file is committed and writable from inside
        # the sandbox: if it could reach global.env, `MY_TOKEN@attacker.example`
        # plus one egress rule would send the operator's shared token there. So
        # a project binding resolves from this sandbox's own env file only; the
        # fallback to the shared file is for bindings in the registry entry.
        # The reserved variables are never bound this way, from any layer.
        own = read_env_file(os.path.join(SECRETS_DIR, f"{self.name}.env"))
        shared = read_env_file(os.path.join(SECRETS_DIR, "global.env"))
        for spec in self.secret_binds:
            var = secret_var(spec)
            if is_reserved_var(var):
                warn(f"{self.name}: secret binding {spec!r} is ignored — {var} has a fixed binding "
                     "and cannot be bound again (a rebuild refuses this)")
                continue
            from_registry = spec in self.registry_binds
            value = own.get(var) or (shared.get(var) if from_registry else None)
            if value:
                env[var] = value
                flags += ["--secret", with_transcript_passthrough(spec)]
            elif not from_registry:
                note(f"no {var} for {self.name} — a binding from the project's sandbox.toml "
                     f"takes its value from {tilde(os.path.join(SECRETS_DIR, self.name + '.env'))} "
                     f"only: `msbctl secret add {self.name}` (skipped for now)")
            else:
                note(f"no {var} for {self.name} — `msbctl secret add {self.name}` "
                     "(skipped for now)")

        if flags:
            # Substitution happens in request HEADERS only. A placeholder sent
            # in a URL or a body is refused, and without this flag that refusal
            # arrives as an ordinary connection error with nothing naming the
            # cause. block-and-log keeps the block and makes it diagnosable —
            # it is the ONLY record there is, since the guest just sees its
            # connection drop. See AGENT_TRANSCRIPT_HOSTS for the refusal this
            # hits in practice, and why every binding above opts out of it for
            # the agent's own endpoints.
            flags += ["--secret-violation-action", "block-and-log"]
        return flags, env

    # ------------------------------------------------------------- the mounts

    def mount_flags(self):
        uid, gid = os.getuid(), os.getgid()
        if self.is_repo:
            # No host folder: the clone lives on a disk volume that outlives the
            # sandbox, so a rebuild finds `.git` there and leaves it alone. The
            # fetched policy is NOT mounted — it is what the host reads, and the
            # guest's own checkout of .msb/ changes nothing until it is pushed
            # and `msbctl policy <name> update` is run.
            return self._mounts_after_project(uid, gid, self.named_disk_flags(
                self.workspace_volume, self.guest_project,
                self._pick("workspace_disk", self.config.get("defaults", {})
                           .get("workspace_disk", "20G"))))
        flags = [
            # uid/gid presentation is what makes guest writes land as you on
            # the host. Without it you get files you cannot rm without help.
            "--mount-dir", f"{self.project}:{self.guest_project}:uid={uid},gid={gid}",
        ]
        # The project's .msb/ again, read-only, over the read-write mount (in
        # this order: spike 15). It is the policy the host reads at the next
        # rebuild. A tripwire, not the control: root in the guest can umount
        # it (spike 15 again), and the policy pin is what actually stops an edit
        # from inside the sandbox from being applied. This only makes the edit
        # fail at once, with EROFS, instead of waiting for the operator.
        if os.path.isdir(os.path.join(self.project, ".msb")):
            flags += ["--mount-dir", f"{self.project}/.msb:{self.guest_project}/.msb:ro"]
        return self._mounts_after_project(uid, gid, flags)

    def _mounts_after_project(self, uid, gid, flags):
        """Every mount but the project's own, appended to `flags`."""
        for src, dest, mode in self.extra_mounts:
            if not os.path.isdir(src):
                die(f"{self.name}: extra folder {tilde(src)} does not exist — "
                    f"fix `mounts` in {tilde(os.path.join(REGISTRY_DIR, self.name + '.toml'))}")
            # Read-only is `ro`. Read-write gets the same uid/gid presentation as
            # the project, so what the guest writes is yours on the host.
            flags += ["--mount-dir", f"{src}:{dest}:" + ("ro" if mode == "ro"
                                                         else f"uid={uid},gid={gid}")]

        if self.claude_auth == "secret":
            os.makedirs(self.state, mode=0o700, exist_ok=True)
            flags += ["--mount-dir", f"{self.state}:/root/.claude:uid={uid},gid={gid}"]
            if assemble_profile():
                flags += ["--mount-dir", f"{PROFILE_DIR}:{GUEST_PROFILE}:ro"]
            else:
                warn("there is no CLAUDE.md text to give the sandbox "
                     f"({tilde(PROFILE_SHIPPED)} is missing) — it will not be seeded")
        else:
            # Fallback for when spike 07 fails. Shares the host's real Claude
            # credentials and every project's transcripts with every sandbox.
            flags += ["-v", f"{HOME}/.claude:/root/.claude"]
            flags += ["--mount-file", f"{HOME}/.claude.json:/root/.claude.json"]

        # Disk volumes that outlive the sandbox: the package caches, and podman's
        # image storage. A real block device under podman matters too — the root is
        # an overlayfs and the kernel refuses overlay-on-overlay, which would leave
        # podman on vfs (slow, 3x the disk). Create-time only, like every mount.
        for key, size in self.caches.items():
            if key not in CACHES:
                die(f"{self.name}: unknown cache {key!r}. Known: {', '.join(CACHES)}")
            flags += self.named_disk_flags(self.cache_volume(key), f"{CACHE_MOUNT}/{key}", size)
        if self.containers_disk:
            # A named volume, not --mount-owned: an owned disk is deleted with its
            # sandbox, and pulled images are exactly what a rebuild should keep.
            flags += self.named_disk_flags(self.containers_volume, "/var/lib/containers",
                                           self.containers_disk)

        # READ-ONLY, deliberately rather than incidentally: the sandbox can
        # verify hosts you already trust and cannot silently add a new one, so
        # host-key decisions stay on the host. Without the file at all, the
        # first ssh prompts — which fails outright under `exec`.
        known = os.path.join(HOME, ".ssh", "known_hosts")
        if os.path.isfile(known):
            flags += ["--mount-file", f"{known}:/root/.ssh/known_hosts:ro"]
        else:
            warn("no ~/.ssh/known_hosts — ssh from the guest has nothing to verify")
        return flags

    # ----------------------------------------------------------- all together

    def create_flags(self):
        # The project's dev.yaml is NEVER passed to msb. msb's --conf file is
        # code, not data: it can mount host paths (relative to the file),
        # copy host files into the guest, and fill `${VAR}` from msb's own
        # environment, which is where the bound secrets are. The project folder
        # is writable from inside the sandbox, so passing it would let the guest
        # rewrite what the next rebuild executes. msbctl reads its `image:` and
        # nothing else (see conf_problems()); everything else is a flag below.
        # `msb_conf` is the operator's own file, from the registry only.
        conf = self.msb_conf
        flags = ["--conf", conf] if conf else []
        # Where the project is mounted, which a `workdir:` in an msb_conf must
        # not override: flags win over --conf.
        flags += ["--workdir", self.guest_project]
        flags += self.mount_flags()
        for key, value in self.env_vars().items():
            flags += ["--env", f"{key}={value}"]
        # The agent protocol crosses; the key never does. Paired with the socat
        # bridge ensure_bridge() starts on each boot. The host end is this
        # sandbox's own FILTERING agent, not the login agent: it shows and
        # signs only the keys the entry lists. The path is baked in at create
        # time, so it must stay stable per sandbox.
        flags += ["--vsock", f"{self.agent_sock}:{VSOCK_PORT}"]
        if self.observing:
            # Nothing is blocked and everything reachable is recorded. NOT a
            # loosened allowlist — no --net-rule at all, because a half-applied
            # policy would still block, and a blocked connection leaves no trace
            # to collect. The rules stay in the config and keep being curated by
            # `allow` and `edit`; they are simply not emitted while measuring.
            flags += ["--net-default-egress", "allow"]
            # The record itself. msb logs an intercepted connection as
            # `TLS intercept sni=<host> dst=<ip:port>` and a resolved name as a
            # dns:: line, both at DEBUG and neither at INFO — so without this
            # observe mode would unblock without observing anything. It writes
            # to the sandbox's own runtime.log, not to a terminal.
            flags += ["--log-level", "debug"]
            # Rebind protection drops answers that resolve to private addresses,
            # which is a block like any other: the name comes back NXDOMAIN, the
            # connection never happens and nothing is written down. Measuring
            # mode has to see it, so it comes off with the rest.
            flags += ["--no-dns-rebind-protection"]
        else:
            # State the default explicitly: allow rules alone do NOT close egress.
            flags += ["--net-default-egress", "deny"]
            for rule in self.net_rules():
                flags += ["--net-rule", rule]
            if self.allow_private_dns:
                flags += ["--no-dns-rebind-protection"]
        # Published ports are INBOUND, so the egress policy above has no say in
        # them, in either mode. msb binds the host side on 127.0.0.1 unless the
        # spec names an address, and dials the guest's own address rather than
        # its loopback — so the server inside must listen on 0.0.0.0. Whether
        # these merge with a `ports:` list in an operator's msb_conf or replace
        # it is unverified; set them in one place.
        for spec, *_ in self.published_ports:
            flags += ["--port", spec]
        # Without this, every HTTPS hostname rule above is a silent deny. It is
        # also what makes secret placeholder substitution possible, so the two
        # requirements coincide and neither can be dropped alone. In observe
        # mode it is also what puts a HOSTNAME rather than an address in the
        # log, which is what the rules are written in — so it stays on there
        # too, even though nothing is being enforced.
        flags += ["--tls-intercept"]
        flags += ["--root-disk", str(self.root_disk)]
        # From sandbox.toml / the registry / [defaults], never from dev.yaml,
        # which is not passed to msb. Flags also win over an msb_conf
        # (verified on 0.7.6).
        flags += ["--cpus", str(self.cpus), "--memory", str(self.memory)]
        return flags

    def versions(self):
        """Component pins: registry [versions] over config.toml [versions]."""
        merged = dict(self.config.get("versions", {}))
        merged.update(self.entry.get("versions", {}))
        return merged

    @property
    def identity(self):
        """The resolved git identity, or None if the sandbox has no preference.

        Applied with `git config --system` inside the guest, NEVER to
        /work/.git/config — that file lives on the host, is shared with every
        other tool, and a sandbox silently rewriting your repo's author is a
        worse failure than having no identity at all.

        --system is the lowest of git's three layers: it always resolves, so
        `git commit` never dies with "Please tell me who you are", while both
        ~/.gitconfig and a repo's own .git/config stay free to override it on
        purpose.

        The consequence is worth stating plainly: a repo that sets its own
        user.email still wins, so for such a repo this changes nothing. What it
        fixes is the opposite case. A repo with no identity
        of its own inherits your host-global config when you work on the host,
        and there is no host-global config inside a microVM, so `git commit`
        there fails outright. This is that fallback.
        """
        if not self.identity_name:
            return None
        table = self.config.get("identities", {})
        if self.identity_name not in table:
            die(f"unknown identity {self.identity_name!r} — config.toml defines: "
                f"{', '.join(sorted(table)) or '(none)'}")
        ident = table[self.identity_name]
        missing = [k for k in ("name", "email") if not ident.get(k)]
        if missing:
            die(f"identity {self.identity_name!r} is missing: {', '.join(missing)}")
        return ident

    @property
    def signing_fp(self):
        """Fingerprint of the key the identity signs commits with, or None."""
        pub = (self.identity or {}).get("signing_key")
        parsed = _parse_pub_line(pub) if pub else None
        return parsed[0] if parsed else None

    @property
    def signing_active(self):
        """Signing is enforced only while the sandbox can actually use the key:
        an identity that names one AND a key selection that includes it (or no
        selection at all, which shows the whole host agent). Dropping the key
        in `msbctl keys` therefore turns signing off rather than leaving a
        sandbox whose every commit fails."""
        fp = self.signing_fp
        keys = self.ssh_keys
        return bool(fp) and (keys is None or fp in keys)

    def env_vars(self):
        """Guest environment: [agent_env.<agent>] for each agent this sandbox
        installs < config.toml [env] < sandbox.toml [env] < registry.

        A MERGE, deliberately, where rule_groups is a pick. A project that adds
        one variable keeps the machine-wide set rather than silently replacing
        it — these are defaults to extend. Egress rules are the opposite case:
        a project may legitimately need a narrower set, so it overrides there.

        A project's dev.yaml cannot set any: it is not passed to msb, and
        create refuses one with an `env:` block (conf_problems()). Do not set
        a key both here and in an operator's msb_conf either: which of the two
        wins is unverified, and a telemetry switch whose value depends on an
        unverified precedence is worse than one in a single place.
        """
        merged = {}
        # Under every [env], so a project can still override an agent's default.
        for agent, _, _ in AGENTS:
            if self.wants_component(agent):
                merged.update(self.config.get("agent_env", {}).get(agent, {}))
        merged.update(self.config.get("env", {}))
        merged.update(self.project_cfg.get("env", {}))
        merged.update(self.entry.get("env", {}))
        # TOML gives real types; msb wants KEY=value strings. `true` would
        # otherwise reach the guest as the string "True", which is not what
        # anything checking for "1" is looking for.
        return {k: ("1" if v is True else "0" if v is False else str(v))
                for k, v in merged.items()}


def merge_config(base, over):
    """`over` on top of `base`. Tables merge key by key; anything else —
    including a list, so an egress group — is replaced whole. Replacing a group
    rather than splicing its hosts is deliberate: rules are first-match-wins and
    half of one is worse than either."""
    out = dict(base)
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            out[key] = merge_config(base[key], value)
        else:
            out[key] = value
    return out


def load_config():
    shipped = read_toml(DEFAULTS_FILE)
    if not shipped:
        die(f"{tilde(DEFAULTS_FILE)} is missing or empty — the checkout is damaged")
    return merge_config(shipped, read_toml(CONFIG_FILE))


def registered():
    try:
        names = [f[:-5] for f in sorted(os.listdir(REGISTRY_DIR))
                 if f.endswith(".toml")]
    except FileNotFoundError:
        names = []
    return names


# ------------------------------------------------- the sandbox of this folder
#
# Like docker compose, the current directory names a sandbox when none is given:
# the registered one whose project CONTAINS it, the deepest if projects nest (as
# git finds a repo). The registry decides, not a .msb/ folder: a clone of a
# project that commits .msb/ is not registered on this machine, and the cloned
# layout keeps .msb/ beside the checkout rather than inside it.
#
# Never a guess. A name may be OMITTED only where it is the sole positional
# argument; where something follows it, `.` stands for it instead — `.` can
# never be a sandbox name, so `msbctl observe on` cannot be misread as a
# sandbox called "on". Two entries on the same folder are an error, not a pick.

NAME_HELP = "sandbox name; omit it inside a registered project folder"
NAMES_HELP = "sandbox names; none (or .) means the one for the current folder"
DOT_HELP = "sandbox name, or . for the one whose project holds the current folder"


def sandbox_here():
    """(name, project) of the sandbox the current directory belongs to."""
    cwd = os.path.realpath(os.getcwd())
    found = []
    for name in registered():
        try:
            raw = read_toml(registry_path_for(name)).get("project")
        except SystemExit:                  # a broken entry is no reason to fail here
            continue
        if not raw:
            continue
        project = os.path.realpath(os.path.expanduser(raw))
        if cwd == project or cwd.startswith(project.rstrip(os.sep) + os.sep):
            found.append((len(project), name, project))
    if found:
        deepest = max(n for n, _, _ in found)
        hits = [(name, project) for n, name, project in found if n == deepest]
        if len(hits) > 1:
            die(f"{tilde(hits[0][1])} is the project of several sandboxes "
                f"({', '.join(n for n, _ in hits)}) — name the one you mean")
        return hits[0]
    # Nothing registered here. Say so in the most useful way.
    probe = cwd
    while True:
        if os.path.isfile(os.path.join(probe, ".msb", "sandbox.toml")):
            die(f"{tilde(probe)} has a .msb/ but no sandbox on this machine is "
                f"registered for it — `msbctl add {tilde(probe)}`, or name one")
        parent = os.path.dirname(probe)
        if parent == probe:
            break
        probe = parent
    die(f"{tilde(cwd)} is not inside a registered project — name the sandbox "
        "(`msbctl ls` lists them)")


def resolve_here(raw):
    """`raw` unless it is omitted (None) or `.`, which mean this folder's sandbox."""
    if raw not in (None, "."):
        return raw
    # Silently: a command's output should be only the command's, and the
    # sandbox it ran in is one `msbctl ls` away if it is ever in doubt.
    name, _project = sandbox_here()
    return name


def guest_workdir(box):
    """The project inside the guest, or the same subfolder of it when the
    current directory is inside the project — so `msbctl shell` from src/
    lands in /work/src (or <guest path>/src), like cd'ing."""
    cwd = os.path.realpath(os.getcwd())
    if cwd.startswith(box.project.rstrip(os.sep) + os.sep):
        return os.path.join(box.guest_project, os.path.relpath(cwd, box.project))
    return box.guest_project


# ------------------------------------------------------------------ per-boot

# ------------------------------------------------- per-sandbox filtering agent
#
# The host's login agent holds every key you own. Forwarding it hands a sandbox
# all of them, so instead each sandbox gets its own socket, served by a small
# daemon (this same file, run as `msbctl _agent-filter <name>`) that proxies to
# the real agent but only for the keys the registry entry's `ssh_keys` lists.
#
# Keys never move: signing still happens in the host agent, so passphrases,
# hardware tokens and `ssh-add -c` confirmations keep working. Only two
# requests get through at all — list identities (answer filtered) and sign
# (refused for any key not listed). Adding, removing, locking and extensions
# are refused, so the guest cannot reshape the host agent either.
#
# `ssh_keys` is re-read on every request, so `msbctl keys` takes effect
# without a restart. The upstream agent path is also a file, rewritten on each
# start, so a new login session's agent is picked up without restarting.

AGENT_FAILURE = 5
AGENTC_REQUEST_IDENTITIES = 11
AGENT_IDENTITIES_ANSWER = 12
AGENTC_SIGN_REQUEST = 13
AGENT_MAX_MSG = 256 * 1024          # OpenSSH's own limit


def key_fingerprint(blob):
    digest = hashlib.sha256(blob).digest()
    return "SHA256:" + base64.b64encode(digest).decode().rstrip("=")


def _read_exact(sock, count):
    data = b""
    while len(data) < count:
        chunk = sock.recv(count - len(data))
        if not chunk:
            return None
        data += chunk
    return data


def _read_msg(sock):
    """One agent message (type byte + body), or None on EOF or nonsense."""
    head = _read_exact(sock, 4)
    if head is None:
        return None
    (length,) = struct.unpack(">I", head)
    if length < 1 or length > AGENT_MAX_MSG:
        return None
    return _read_exact(sock, length)


def _write_msg(sock, payload):
    sock.sendall(struct.pack(">I", len(payload)) + payload)


def _take_string(buf, off):
    (size,) = struct.unpack_from(">I", buf, off)
    off += 4
    if size > len(buf) - off:
        raise ValueError("truncated string")
    return buf[off:off + size], off + size


def _filter_identities(answer, allowed):
    """Rebuild an IDENTITIES_ANSWER keeping only allowed fingerprints."""
    (count,) = struct.unpack_from(">I", answer, 1)
    off, kept = 5, []
    for _ in range(count):
        blob, off = _take_string(answer, off)
        comment, off = _take_string(answer, off)
        if allowed is None or key_fingerprint(blob) in allowed:
            kept.append(struct.pack(">I", len(blob)) + blob
                        + struct.pack(">I", len(comment)) + comment)
    return (bytes([AGENT_IDENTITIES_ANSWER]) + struct.pack(">I", len(kept))
            + b"".join(kept))


class _AgentFilter(socketserver.BaseRequestHandler):
    def handle(self):
        upstream = None
        try:
            while True:
                msg = _read_msg(self.request)
                if msg is None:
                    return
                allowed = self.server.allowed()
                kind = msg[0]
                if kind == AGENTC_SIGN_REQUEST:
                    blob, _ = _take_string(msg, 1)
                    permitted = allowed is None or key_fingerprint(blob) in allowed
                elif kind == AGENTC_REQUEST_IDENTITIES:
                    permitted = True
                else:
                    permitted = False
                if not permitted:
                    _write_msg(self.request, bytes([AGENT_FAILURE]))
                    continue
                if not self.server.upstream():
                    # No host agent (see ensure_agent_filter): an empty list, so
                    # ssh in the guest says "no identities" rather than hanging.
                    _write_msg(self.request, bytes([AGENT_IDENTITIES_ANSWER]) + struct.pack(">I", 0)
                               if kind == AGENTC_REQUEST_IDENTITIES else bytes([AGENT_FAILURE]))
                    continue
                if upstream is None:
                    upstream = socket.socket(socket.AF_UNIX)
                    upstream.connect(self.server.upstream())
                _write_msg(upstream, msg)
                reply = _read_msg(upstream)
                if reply is None:
                    _write_msg(self.request, bytes([AGENT_FAILURE]))
                    return
                if kind == AGENTC_REQUEST_IDENTITIES and reply[0] == AGENT_IDENTITIES_ANSWER:
                    reply = _filter_identities(reply, allowed)
                _write_msg(self.request, reply)
        except (OSError, ValueError, struct.error):
            return
        finally:
            if upstream is not None:
                upstream.close()


class _AgentFilterServer(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True

    def __init__(self, name):
        self.name = name
        self.sock_path = os.path.join(AGENT_DIR, f"{name}.sock")
        try:
            os.unlink(self.sock_path)
        except FileNotFoundError:
            pass  # no stale socket from an earlier run
        old = os.umask(0o077)           # the socket is created 0600
        try:
            super().__init__(self.sock_path, _AgentFilter)
        finally:
            os.umask(old)

    def allowed(self):
        entry = read_toml(os.path.join(REGISTRY_DIR, f"{self.name}.toml"))
        raw = entry.get("ssh_keys")
        if raw is None:
            return None
        return {str(item).split()[0] for item in raw if str(item).split()}

    def upstream(self):
        with open(os.path.join(AGENT_DIR, f"{self.name}.upstream"),
                  encoding="utf-8") as fh:
            return fh.read().strip()


def cmd_agent_filter(args, config):
    """The daemon. Not for humans; ensure_agent_filter() starts it."""
    os.makedirs(AGENT_DIR, mode=0o700, exist_ok=True)
    server = _AgentFilterServer(args.name)
    with open(os.path.join(AGENT_DIR, f"{args.name}.pid"), "w") as fh:
        fh.write(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        server.serve_forever()
    finally:
        try:
            os.unlink(server.sock_path)
        except FileNotFoundError:
            pass  # stop_agent_filter() got there first


def _agent_alive(path):
    probe = socket.socket(socket.AF_UNIX)
    probe.settimeout(1)
    try:
        probe.connect(path)
        return True
    except OSError:
        return False
    finally:
        probe.close()


def ensure_agent_filter(box):
    """Make sure this sandbox's selected keys are loaded and its filtering agent
    is up and points at the current host agent. Cheap and idempotent; called on
    every start."""
    upstream = os.environ.get("SSH_AUTH_SOCK", "")
    if not upstream or not os.path.exists(upstream):
        if box.ssh_keys != []:
            die("no usable SSH_AUTH_SOCK — start an agent and ssh-add a key")
        # A sandbox allowed no keys needs no agent: the filter still answers
        # (with nothing), so the --vsock baked in at create has a listener. This
        # is the usual case on a remote host, where nobody's agent is forwarded.
        upstream = ""
    # Every start path comes through here, so this is where a selected key that
    # is not loaded yet gets added, before the sandbox can ask for it.
    ensure_keys_loaded(box)
    os.makedirs(AGENT_DIR, mode=0o700, exist_ok=True)

    path = os.path.join(AGENT_DIR, f"{box.name}.upstream")
    fd, tmp = tempfile.mkstemp(dir=AGENT_DIR)
    with os.fdopen(fd, "w") as fh:
        fh.write(upstream)
    os.replace(tmp, path)

    if _agent_alive(box.agent_sock):
        return
    # The daemon gets its own copy of the descriptor; ours closes right away.
    with open(os.path.join(AGENT_DIR, f"{box.name}.log"), "ab") as log:
        subprocess.Popen([sys.executable, os.path.realpath(__file__),
                          "_agent-filter", box.name],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                         start_new_session=True)
    for _ in range(30):
        if _agent_alive(box.agent_sock):
            return
        time.sleep(0.1)
    die(f"the ssh-agent filter did not start — see "
        f"{tilde(os.path.join(AGENT_DIR, box.name + '.log'))}")


def stop_agent_filter(box):
    pidfile = os.path.join(AGENT_DIR, f"{box.name}.pid")
    try:
        with open(pidfile) as fh:
            os.kill(int(fh.read().strip()), signal.SIGTERM)
    except (OSError, ValueError):
        pass  # not running, or a stale pidfile: nothing to stop
    for suffix in ("sock", "pid", "upstream"):
        try:
            os.unlink(os.path.join(AGENT_DIR, f"{box.name}.{suffix}"))
        except FileNotFoundError:
            pass  # already gone


def _parse_pub_line(line):
    """(fingerprint, type, comment) from an authorized_keys-style public key
    line, or None."""
    parts = line.strip().split(None, 2)
    if len(parts) < 2:
        return None
    try:
        blob = base64.b64decode(parts[1], validate=True)
    except ValueError:
        return None
    return key_fingerprint(blob), parts[0], parts[2] if len(parts) > 2 else ""


# Public key lines learned while picking (an encrypted key with no .pub is only
# readable once its passphrase has been given), by fingerprint.
_PUB_CACHE = {}


def public_line(fp):
    """`type base64` (no comment) of the key with this fingerprint, from what
    the agent holds, else a key file in ~/.ssh; None if neither can say. Git
    needs the public half to name the key it asks the agent to sign with."""
    def bare(line):
        parts = line.split()
        return " ".join(parts[:2]) if len(parts) >= 2 else None

    if fp in _PUB_CACHE:
        return bare(_PUB_CACHE[fp])
    proc = subprocess.run(["ssh-add", "-L"], capture_output=True, text=True)
    for line in proc.stdout.splitlines() if proc.returncode == 0 else []:
        parsed = _parse_pub_line(line)
        if parsed and parsed[0] == fp:
            return bare(line)
    for found, _, _, path in host_ssh_files():
        if found != fp:
            continue
        if os.path.isfile(path + ".pub"):
            with open(path + ".pub", encoding="utf-8", errors="replace") as fh:
                return bare(fh.readline())
        proc = subprocess.run(["ssh-keygen", "-y", "-P", "", "-f", path],
                              capture_output=True, text=True,
                              stdin=subprocess.DEVNULL, timeout=10)
        if proc.returncode == 0:
            return bare(proc.stdout)
    return None


def host_agent_keys():
    """The keys the host agent holds, as [(fingerprint, type, comment)]."""
    proc = subprocess.run(["ssh-add", "-L"], capture_output=True, text=True)
    if proc.returncode != 0:
        return []
    return [k for k in map(_parse_pub_line, proc.stdout.splitlines()) if k]


# Names in ~/.ssh that are never private keys. Anything else is opened and
# checked for a PRIVATE KEY header, so a key called whatever you like is found.
_NOT_KEYS = {"known_hosts", "known_hosts.old", "config", "authorized_keys",
             "environment", "agent.sock"}


def host_ssh_files():
    """Private keys on disk in ~/.ssh, as [(fingerprint, type, comment, path)].
    The fingerprint is None for a key that cannot be named without its
    passphrase (see _identify_file).

    The fingerprint comes from the public half without ever prompting: the
    .pub file if there is one, else `ssh-keygen -y` with an EMPTY passphrase,
    which fails fast on an encrypted key rather than waiting at a tty. Listing
    therefore never prompts; a key that is encrypted AND has no .pub is returned
    unnamed, and is only unlocked if the operator actually picks it."""
    try:
        names = sorted(os.listdir(SSH_DIR))
    except OSError:
        return []
    found = []
    for name in names:
        path = os.path.join(SSH_DIR, name)
        if (name.endswith(".pub") or name in _NOT_KEYS or name.startswith("known_hosts")
                or not os.path.isfile(path)):
            continue
        try:
            with open(path, "rb") as fh:
                if b"PRIVATE KEY" not in fh.read(100):
                    continue
        except OSError:
            continue
        parsed = None
        if os.path.isfile(path + ".pub"):
            with open(path + ".pub", encoding="utf-8", errors="replace") as fh:
                parsed = _parse_pub_line(fh.readline())
        if not parsed:
            proc = subprocess.run(["ssh-keygen", "-y", "-P", "", "-f", path],
                                  capture_output=True, text=True,
                                  stdin=subprocess.DEVNULL, timeout=10)
            if proc.returncode == 0:
                parsed = _parse_pub_line(proc.stdout.strip())
        if parsed:
            fp, ktype, comment = parsed
            found.append((fp, ktype, comment or name, path))
        else:
            found.append((None, "", name, path))     # needs a passphrase to name
    return found


def format_ssh_keys(keys):
    """The `ssh_keys` assignment as TOML text. `keys` is [(fingerprint, label)]
    or None for unrestricted (nothing written). Labels become trailing
    comments, so the file stays readable to whoever hand-edits it."""
    if keys is None:
        return "# ssh_keys = []          # unrestricted: every key in the host agent"
    if not keys:
        return "ssh_keys = []"
    rows = [f'    "{fp}",  # {label}'.rstrip(" #") for fp, label in keys]
    return "ssh_keys = [\n" + "\n".join(rows) + "\n]"


def write_ssh_keys(box, keys):
    """Replace this entry's `ssh_keys` assignment in place (single- or
    multi-line), else add it after `autostart`. A line-level edit for the same
    reason as write_version_override(): a serializer would eat the comments."""
    path = os.path.join(REGISTRY_DIR, f"{box.name}.toml")
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()

    out, at, i = [], None, 0
    while i < len(lines):
        if re.match(r"^\s*ssh_keys\s*=", lines[i]):
            at = len(out)
            while i < len(lines) and "]" not in lines[i].split("#")[0]:
                i += 1
            i += 1
            continue
        out.append(lines[i])
        i += 1
    if at is None:
        at = next((j + 1 for j, line in enumerate(out)
                   if re.match(r"^\s*autostart\s*=", line)), None)
        if at is None:
            at = next((j for j, line in enumerate(out)
                       if line.lstrip().startswith("[")), len(out))
        out[at:at] = [""]
        at += 1
    out[at:at] = format_ssh_keys(keys).splitlines()
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")


def _known_keys():
    """Every key we can see, by fingerprint:
    {fp: {"type", "comment", "path" (or ""), "loaded" (in the agent now)}}."""
    known = {}
    for fp, ktype, comment in host_agent_keys():
        known[fp] = {"type": ktype, "comment": comment, "path": "", "loaded": True}
    for fp, ktype, comment, path in host_ssh_files():
        if fp is None:
            continue
        entry = known.setdefault(fp, {"type": ktype, "comment": comment,
                                      "path": "", "loaded": False})
        entry["path"] = path
        if not entry["comment"]:
            entry["comment"] = comment
    return known


def _describe(info):
    text = f"{info['comment'] or '(no comment)'} ({info['type']})"
    if info["path"]:
        text += f"  {tilde(info['path'])}"
    return text


def _key_labels(current):
    """{fingerprint: display label} for every known key plus any already
    selected that is gone, so nothing is silently dropped. Used by `show`."""
    labels = {fp: _describe(info) for fp, info in _known_keys().items()}
    for fp in current or []:
        labels.setdefault(fp, "(not in the agent or ~/.ssh now)")
    return labels


def _identify_file(path):
    """(fingerprint, type, comment) of a key file that needs its passphrase.
    ssh-keygen asks on the terminal; this is only ever called for a key the
    operator picked, so browsing the list never prompts."""
    note(f"{tilde(path)} is encrypted — its passphrase is needed to name it")
    proc = subprocess.run(["ssh-keygen", "-y", "-f", path],
                          stdout=subprocess.PIPE, text=True)
    parsed = _parse_pub_line(proc.stdout) if proc.returncode == 0 else None
    if parsed:
        _PUB_CACHE[parsed[0]] = proc.stdout.strip()
    return parsed


SIGNS_MARK = "  [signs commits]"


def pick_ssh_keys(current, preselect_all, signing=None, single=False):
    # `signing` is the fingerprint an identity signs commits with: that row is
    # flagged, so unticking it is a visible act (the caller warns). `single`
    # is for choosing ONE key (an identity's signing key): zero is allowed and
    # means none, more than one is asked again.
    chosen = _pick_ssh_keys(current, preselect_all, signing)
    while single and len(chosen) > 1:
        warn("pick one key, or none")
        chosen = _pick_ssh_keys([fp for fp, _ in chosen], False, signing)
    return chosen


def _pick_ssh_keys(current, preselect_all, signing):
    """One multiselect over everything usable, in two sections: keys already in
    the agent, and key files in ~/.ssh. Returns [(fingerprint, label)].

    A key that is both loaded and on disk is listed once, under the agent. Files
    in ~/.ssh are put into the agent when the sandbox starts (see
    ensure_keys_loaded). The fingerprint is how a key is stored and matched, but
    it is never shown: the label is what a person recognises."""
    known = _known_keys()
    unnamed = [(name, path) for fp, _, name, path in host_ssh_files() if fp is None]
    if not known and not unnamed:
        warn("no keys in the agent or in ~/.ssh — create one, then `msbctl keys`")
        return []

    agent, disk = [], []          # (id, row, label)
    for fp, info in known.items():
        mark = SIGNS_MARK if fp == signing else ""
        item = (fp, _describe(info) + mark, _describe(info))
        (agent if info["loaded"] else disk).append(item)
    for name, path in unnamed:
        label = f"{name}  {tilde(path)}"
        disk.append((f"file:{path}", f"{label}  (encrypted: asks for its passphrase if picked)", label))
    gone = [(fp, "(not in the agent or ~/.ssh now)" + (SIGNS_MARK if fp == signing else ""),
             "(not in the agent or ~/.ssh now)")
            for fp in current or [] if fp not in known]

    options, ids, labels = [], {}, {}
    for header, items in (("agent:" + ("" if agent else " (no keys loaded)"), agent),
                          ("~/.ssh:" + ("" if disk else " (no key files found)"), disk),
                          ("selected earlier:" if gone else "", gone)):
        if not header:
            continue
        options.append(Header(header))
        seen = set()
        for kid, row, label in sorted(items, key=lambda it: it[1].lower()):
            if row in seen:                    # two keys that read the same
                row += f"  [{kid.removeprefix('SHA256:')[:6]}]"
            seen.add(row)
            options.append(row)
            ids[row], labels[kid] = kid, label

    if preselect_all and current is None:      # unrestricted: what it sees today
        start = [row for row, kid in ids.items() if kid in {a[0] for a in agent}]
    else:
        start = [row for row, kid in ids.items() if kid in (current or [])]
    chosen = []
    for row in toggle_list("keys", options, start):
        kid = ids[row]
        if kid.startswith("file:"):
            parsed = _identify_file(kid.removeprefix("file:"))
            if not parsed:
                warn(f"could not read {tilde(kid.removeprefix('file:'))} — skipped")
                continue
            fp, ktype, comment = parsed
            chosen.append((fp, _describe({"type": ktype, "comment": comment,
                                          "path": kid.removeprefix("file:")})))
        else:
            chosen.append((kid, labels[kid]))
    return chosen


def ensure_keys_loaded(box):
    """Make sure this sandbox's selected keys are in the host agent, adding any
    that are not from ~/.ssh. ssh-add inherits the terminal, so an encrypted key
    prompts for its passphrase here. A key that cannot be added is a warning,
    not an error: the sandbox starts, just without it.

    Keys are found by fingerprint. An encrypted key with no .pub cannot be
    named without its passphrase, so when a fingerprint matches no named file
    the remaining unnamed files are tried in turn, stopping once it appears."""
    wanted = list(box.ssh_keys or [])
    if box.signing_active and box.signing_fp not in wanted:
        wanted.append(box.signing_fp)       # unrestricted, but it must still be loaded
    if not wanted:
        return
    loaded = {fp for fp, _, _ in host_agent_keys()}
    missing = [fp for fp in wanted if fp not in loaded]
    if not missing:
        return
    scanned = host_ssh_files()
    files = {fp: path for fp, _, _, path in scanned if fp}
    unnamed = [path for fp, _, _, path in scanned if fp is None]

    def add(path):
        # stderr, like warn(): this runs before `msbctl exec` hands over its stdout.
        print(f"   adding {tilde(path)} to the ssh-agent", file=sys.stderr)
        ok = subprocess.run(["ssh-add", path]).returncode == 0
        if not ok:
            warn(f"could not add {tilde(path)} — the sandbox starts without it")
        return ok

    for fp in missing:
        if fp in files:
            add(files[fp])
            continue
        for path in list(unnamed):
            if add(path):
                unnamed.remove(path)
                if fp in {k for k, _, _ in host_agent_keys()}:
                    break
        else:
            if fp not in {k for k, _, _ in host_agent_keys()}:
                warn(f"{fp} is selected but is not in the agent or in ~/.ssh — the "
                     f"sandbox starts without it (`msbctl keys {box.name}` to change)")


def cmd_keys(args, config):
    box = Sandbox(args.name, config)
    if args.all:
        write_ssh_keys(box, None)
        note(f"{box.name}: unrestricted — every key in the host agent")
        return
    current = box.ssh_keys
    say(f"SSH keys for {box.name}")
    if current is None:
        note("currently unrestricted: every key in the host agent is visible")
    note("Only the ticked keys can be listed or sign from inside the sandbox.")
    signing = box.signing_fp
    if signing:
        note(f"{box.identity_name} signs commits with the key marked{SIGNS_MARK.strip()}.")
    chosen = pick_ssh_keys(current, preselect_all=True, signing=signing)
    if signing and signing not in {fp for fp, _ in chosen} \
            and (current is None or signing in current):
        warn(f"that key signs commits for identity {box.identity_name!r}: without it "
             f"this sandbox stops signing (commits go unsigned)")
        if not confirm("drop it anyway?"):
            chosen.append((signing, _key_labels([signing]).get(signing, "")))
            note("kept")
    write_ssh_keys(box, chosen)
    note(f"{len(chosen)} key(s) saved; takes effect immediately, no restart.")
    if agent_binding(box) == "raw":
        warn(f"{box.name} was created with the RAW host agent, so this selection is not "
             f"enforced yet — `msbctl rebuild {box.name}` puts it behind the filter")
    if os.environ.get("SSH_AUTH_SOCK"):
        ensure_keys_loaded(Sandbox(box.name, config))


def ensure_bridge(box):
    """Start the guest half of the ssh-agent bridge. Per boot, not per create.

    socat is installed once by the bootstrap, but the process dies with the VM,
    which is why shell/exec both come through here rather than through create.
    Idempotent: a socket that accepts a connection is left alone. The file
    alone proves nothing — /tmp is on the persistent rootfs, so the previous
    boot's socket survives a stop/start without the socat that served it, and
    `[ -S ]` would skip the bridge and leave the guest with "connection refused".
    """
    script = (
        "command -v socat >/dev/null || exit 0\n"
        f"socat -u OPEN:/dev/null UNIX-CONNECT:{GUEST_AGENT_SOCK} 2>/dev/null && exit 0\n"
        f"setsid socat 'UNIX-LISTEN:{GUEST_AGENT_SOCK},fork,unlink-early' "
        f"'VSOCK-CONNECT:2:{VSOCK_PORT}' >/dev/null 2>&1 &\n"
        "sleep 1\n"
    )
    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c", script],
        check=False, quiet=True)




def _without_comments(text):
    return re.sub(r"<!--.*?-->", "", text, flags=re.S).strip()


def assemble_profile():
    """Build PROFILE_DIR/CLAUDE.md: the shipped text, then PROFILE_LOCAL if it has
    anything in it besides a comment. Rewritten only when the content changed, and
    atomically, since a running sandbox may be reading it. True if there is a file."""
    try:
        with open(PROFILE_SHIPPED, encoding="utf-8") as fh:
            shipped = fh.read().strip("\n")
    except FileNotFoundError:
        shipped = ""
    local = ""
    if os.path.isfile(PROFILE_LOCAL):
        with open(PROFILE_LOCAL, encoding="utf-8") as fh:
            raw = fh.read()
        if _without_comments(raw):
            local = "<!-- your additions, from ~/.config/msb/CLAUDE.local.md -->\n" + raw.strip("\n")
    text = "\n\n".join(p for p in (shipped, local) if p)
    if not text:
        return False
    text += "\n"
    os.makedirs(PROFILE_DIR, exist_ok=True)
    path = os.path.join(PROFILE_DIR, "CLAUDE.md")
    try:
        with open(path, encoding="utf-8") as fh:
            if fh.read() == text:
                return True
    except FileNotFoundError:
        pass  # first assembly: nothing to compare against
    fd, tmp = tempfile.mkstemp(dir=PROFILE_DIR)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    return True


def sandbox_profile_section(box):
    """A few lines appended to THIS sandbox's copy of CLAUDE.md naming its
    features, so the agent knows podman is there before it goes looking. From the
    current config, so after an edit that still needs a rebuild it is ahead of the VM."""
    feats = current_features(box)
    if not feats:
        return ""
    lines = ["## This sandbox", "",
             f"`{box.name}` was set up with these features, each installed and its egress allowed:", ""]
    lines += [f"- **{key}**: {desc}" for key, desc, _ in FEATURES if key in feats]
    return "\n".join(lines)


def ensure_profile(box):
    """Seed the guest's Claude state. Per boot, two files, two different rules.

    CLAUDE.md     OVERWRITTEN every start. Being centrally managed is the whole
                  point: edit it on the host and every sandbox has it next
                  start. A copy rather than a file mount overlaid inside the
                  ~/.claude directory mount — the overlay is unverified, the
                  copy is not.

    .claude.json  MERGED every start, never replaced: onboarding is set only
                  if absent, and the project and /tmp are marked trusted. Claude Code keeps
                  per-sandbox state in this file, so rewriting it wholesale
                  would quietly discard that. It lives in the sandbox's
                  writable layer and so is gone after every rebuild, which is
                  why the trust answer is re-asserted here rather than
                  remembered: the "do you trust this folder?" prompt never
                  comes back. The project is yours and the VM is the boundary,
                  so the prompt guards nothing here.
    """
    if box.claude_auth != "secret":
        return      # "mount" puts the host's real files in place; nothing to do

    script = []
    if assemble_profile():          # rebuilt per boot, so an edit lands on the next start
        script.append(f"mkdir -p /root/.claude && "
                      f"cp {GUEST_PROFILE}/CLAUDE.md /root/.claude/CLAUDE.md")
        # Per sandbox, so it cannot live in the shared, mounted file. As an
        # argument ($2), never spliced into the script.
        script.append('[ -z "$2" ] || printf \'\\n%s\\n\' "$2" >> /root/.claude/CLAUDE.md')
    else:
        warn(f"no CLAUDE.md text ({tilde(PROFILE_SHIPPED)} is missing) — nothing to seed")

    # Without this, interactive `claude` runs its first-run login flow even
    # though CLAUDE_CODE_OAUTH_TOKEN is bound and demonstrably works. The token
    # is checked on the wire; onboarding is checked locally, against this file;
    # the two are independent, and satisfying one does nothing for the other.
    #
    # `claude -p` does not consult it at all, which is exactly why spike 07
    # passes whether or not this file exists and why this gap survived to the
    # first interactive use. Verified by hand in a live sandbox.
    # python3 is there once the bootstrap has run; before that (or if it
    # failed) fall back to seeding the file if absent.
    trusted = [box.guest_project, *TRUSTED_GUEST_DIRS]
    script.append(f"if command -v python3 >/dev/null; then "
                  f"python3 -c \"$1\" {GUEST_CLAUDE_JSON} {' '.join(shq(f) for f in trusted)}; "
                  f"else [ -f {GUEST_CLAUDE_JSON} ] || "
                  f"printf '%s\\n' {shq(onboarded_json(*trusted))} > {GUEST_CLAUDE_JSON}; fi")

    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c", " ; ".join(script),
         "_", MERGE_CLAUDE_JSON, sandbox_profile_section(box)], check=False, quiet=True)


# Where ensure_identity() writes the guest's allowed-signers file for ssh
# commit signing. Under /etc like the --system config that points at it.
GUEST_ALLOWED_SIGNERS = "/etc/git/allowed_signers"


def ensure_identity(box):
    """Set the guest's global git identity. Per boot, like the profile seed, so
    editing config.toml takes effect on the next start rather than on a rebuild.
    """
    ident = box.identity
    # Signing is --system too, for the same reason as the name: a repo's own
    # config can still override it. It is switched OFF again whenever it is not
    # active (identity changed, key dropped from `msbctl keys`), because the
    # guest's /etc/gitconfig outlives the setting that wrote it.
    #
    # The allowed-signers file lists only this identity's own key, so that
    # `git log --show-signature` / `git verify-commit` can check what the
    # sandbox signed; anyone else's commits read "no principal matched", which
    # is ssh signing's normal answer for an unknown key.
    keys = ("gpg.format", "user.signingkey", "commit.gpgsign", "tag.gpgsign",
            "gpg.ssh.allowedSignersFile")
    script = ('git config --system user.name "$1" && git config --system user.email "$2"; '
              if ident else "")
    if ident and box.signing_active:
        pub = ident["signing_key"].split()
        script += ('git config --system gpg.format ssh; '
                   'git config --system user.signingkey "key::$3 $4"; '
                   'git config --system commit.gpgsign true; '
                   'git config --system tag.gpgsign true; '
                   f'mkdir -p {GUEST_ALLOWED_SIGNERS.rsplit("/", 1)[0]} && '
                   f'printf \'%s %s %s\\n\' "$2" "$3" "$4" > {GUEST_ALLOWED_SIGNERS} && '
                   f'git config --system gpg.ssh.allowedSignersFile {GUEST_ALLOWED_SIGNERS}; '
                   'command -v ssh-keygen >/dev/null || '
                   'echo "msbctl: no ssh-keygen in the guest, so commits cannot be signed '
                   '(rebuild to install openssh-client)" >&2')
        args = [ident["name"], ident["email"], pub[0], pub[1]]
    else:
        script += "; ".join(f"git config --system --unset {k}" for k in keys)
        script += f"; rm -f {GUEST_ALLOWED_SIGNERS}; true"
        args = [ident["name"], ident["email"]] if ident else []
    # Values passed as positional args, not interpolated into the command
    # string. A name with a quote or a space in it then cannot break the
    # command, and there is no quoting to get right in the first place.
    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c", script, "_", *args],
        check=False, quiet=True)
    if ident and box.signing_fp and not box.signing_active:
        warn(f"{box.name}: identity {box.identity_name!r} signs with a key this sandbox "
             f"cannot use, so commits are NOT signed — `msbctl keys {box.name}` to allow it")


def ensure_git_checkstat(box):
    """Set core.checkStat=minimal in the project's own repo, unless it already
    sets core.checkStat. Per boot, so an existing sandbox gets it on its next
    start.

    Without it, `.git/index` vanishes for ~5 s after any git command in the
    guest that writes it, whenever a host editor watches the repo (zed, and
    any IDE that polls git). The index records each file's full stat, and
    what the guest sees (uid 0, its own inode numbers) never matches what the
    host sees, so the host's `git diff` finds every entry stale and writes a
    refreshed index over the guest's. The virtiofs entry the guest still
    holds then answers ENOENT until it expires, and `git status` in that
    window reports every file deleted and untracked. --no-optional-locks /
    GIT_OPTIONAL_LOCKS=0 does not help: zed already passes it, and `git diff`
    against the work tree ignores it (git 2.55). Comparing only mtime and
    size, which both sides agree on, leaves nothing to refresh.

    It lands in the repo's .git/config, on the host too, where it is equally
    harmless. Only a top-level `.git` is touched: a linked worktree's `.git`
    file names a host path that may not exist in the guest.
    """
    if box.is_repo:
        return      # the clone is on a disk volume; no host editor watches it
    script = ('[ -e .git ] || exit 0; '
              'git config --local --get core.checkStat >/dev/null '
              '|| git config --local core.checkStat minimal')
    run(["msb", "exec", box.name, "--no-tty", "--workdir", box.guest_project,
         "--", "sh", "-c", script], check=False, quiet=True)


def ensure_podman_runtime(box):
    """Clear podman's runtime state if it is left over from an earlier boot.

    Podman keeps it under /run, assuming /run is a tmpfs a reboot empties. In
    a microsandbox guest /run is just part of the root disk, so it survives a
    stop/start, and every podman command after the restart fails with "boot
    ID differs from cached boot ID; an unhandled reboot has occurred. Please
    delete directories /run/containers/storage and /run/libpod". This does
    what that message asks, and what a reboot would have done: images,
    volumes and container definitions live in /var/lib/containers and are
    untouched, and podman marks the containers stopped on its next run.

    It runs on every `shell`/`exec`, not just after a boot, so it uses
    podman's own test: /run/libpod/alive holds the boot ID podman last ran
    under, and only one that differs from this boot's means stale state. A
    sandbox whose podman is running containers right now is left alone.
    All of /run/containers goes (netavark's aardvark-dns pid and config live
    there too; network definitions do not), and crun's and runc's state with
    it: they make the same assumption about /run.
    """
    script = ('a=/run/libpod/alive; [ -f "$a" ] || exit 0; '
              '[ "$(cat "$a")" = "$(cat /proc/sys/kernel/random/boot_id)" ] && exit 0; '
              'rm -rf /run/containers /run/libpod /run/crun /run/runc')
    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c", script],
        check=False, quiet=True)


def ensure_running(box, table=None):
    """Start a stopped sandbox; refuse to create a missing one.

    Creation is always an explicit act — it is the only operation that runs a
    bootstrap and fixes the network policy, so it should not happen as a side
    effect of asking for a shell.
    """
    state = state_of(box.name, table)
    if state == "absent":
        die(f"no sandbox named {box.name} — run: msbctl rebuild {box.name}")
    if state != "running":
        # On stderr: `msbctl exec`'s stdout belongs to its command, which may
        # be a pipe or a protocol stream (ACP) that a stray line would corrupt.
        print(f"\n{BOLD}== Starting {box.name}{RESET}", file=sys.stderr)
        _, env = box.secret_env()
        ensure_agent_filter(box)
        run(["msb", "start", box.name], env=env, to_stderr=True)
    ensure_agent_filter(box)
    ensure_bridge(box)
    ensure_profile(box)
    ensure_identity(box)
    ensure_git_checkstat(box)
    ensure_podman_runtime(box)


# ------------------------------------------------------------------ lifecycle

def warn_missing_prereqs(box):
    """Warn about hosts the bootstrap is about to need and cannot reach.

    This exists because the bootstrap's own failure is one step removed from
    the cause. Deny deb.nodesource.com and what you see is `node` failing,
    then `npm: command not found`, then claude-code failing as a CONSEQUENCE
    and being reported as an independent optional failure. Three messages, one
    missing rule, and the one that names the rule is the easiest to miss.

    An earlier version of this check looked only at api.anthropic.com — Claude
    Code's RUNTIME host — and so stayed silent when its INSTALL path was
    blocked, which is the failure that actually happens. Both halves are
    checked now; a feature needs every host in its list, not any of them.

    Warns rather than refuses, and lists everything at once: the same stance
    bootstrap.sh takes, so one round trip fixes the whole allowlist.
    """
    boot = box.project_cfg.get("bootstrap", {})
    wants_claude = boot.get("claude") is not False

    needs = []
    # node comes from NodeSource unless the image already carries it, and this
    # cannot know which — so it is listed whenever anything needs node at all.
    if wants_claude:
        needs.append(("node (for claude-code)", ["deb.nodesource.com"]))
        needs.append(("claude-code install", ["registry.npmjs.org"]))
        needs.append(("claude-code runtime", ["api.anthropic.com",
                                              "platform.claude.com"]))
    needs.append(("gh" + (" + gitleaks" if boot.get("gitleaks") else "") + " downloads",
                  ["github.com", "release-assets.githubusercontent.com"]))
    if box.is_repo:
        needs.append((f"the clone of {box.repo}", ["github.com"]))
        # The clone fails inside the bootstrap, one step removed from the cause,
        # so say it here, before anything is created.
        if box.repo_meta.get("private") and not read_env_file(
                os.path.join(SECRETS_DIR, f"{box.name}.env")).get("GH_TOKEN"):
            warn(f"{box.repo} is private and {box.name} has no GitHub token, so the clone "
                 f"will fail — `msbctl secret set {box.name} GH_TOKEN` first")

    rules = box.net_rules()
    missing = []
    for label, hosts in needs:
        absent = [h for h in hosts
                  if not any(h in rule and "allow" in rule for rule in rules)]
        if absent:
            missing.append((label, absent))
    if not missing:
        return

    warn("the bootstrap will need hosts this sandbox cannot reach:")
    for label, absent in missing:
        note(f"     {label:<24} {', '.join(absent)}")
    note("")
    note("   Add the rule group that covers them to `rule_groups` in")
    note(f"   {box.repo + ':.msb/sandbox.toml' if box.is_repo else tilde(project_path(box))} — "
         "`npm` and `claude` are")
    note("   the usual two — or set the feature false under [bootstrap].")
    note("   Continuing; the bootstrap reports what actually failed.")


# ---------------------------------------------------------- the policy pin
#
# The project's .msb/sandbox.toml decides what may leave the sandbox, which host
# a stored value is substituted toward, and what the sandbox takes from the
# host. It is also committed, and writable from inside the sandbox through the
# project mount. So what it says is not applied just because it says it: the
# values in PINNED_KEYS are recorded (a digest in the registry entry, the values
# themselves under STATE_DIR) when the operator approves them, and a create or
# rebuild that finds them changed shows the difference and asks. Without a
# terminal, or under `msbctl host serve`, it refuses: a prompt is something code
# on the other end of a pty can answer as easily as a person.
#
# Only the PROJECT layer is pinned. The registry entry and config.toml are the
# operator's own files, outside every sandbox, and are not re-approved.

PINNED_KEYS = (
    "rule_groups",          # which egress groups apply
    "extra_rules",          # and the project's own rules
    "allow_private_dns",    # whether names may resolve to LAN addresses
    "secret_binds",         # which host a stored value is substituted toward
    "secrets",              # whether GH_TOKEN is bound at all
    # Resources resolve through _pick too, so a commit saying memory = "256G"
    # or a 4T root disk lands on the next rebuild — on a host that stands alone,
    # with nobody watching it.
    "cpus", "memory", "root_disk", "containers_disk", "caches", "workspace_disk",
)
# NOT pinned, on purpose: `image`, [bootstrap] and [env] act only inside the
# guest, which is what the sandbox is for, and `conf` only names the file the
# image is read from (and must stay in the project).

POLICY_APPROVED_DIR = os.path.join(STATE_DIR, "policy-approved")


def restricted():
    """True under `msbctl host serve`: nothing that approves a policy may ask."""
    return os.environ.get("MSB_RESTRICTED") == "1"


def project_policy(box):
    """The project-layer values the pin covers. For a repo sandbox, also the
    commit they were read at, so a diff always names the commit being approved."""
    policy = {k: box.project_cfg[k] for k in PINNED_KEYS if k in box.project_cfg}
    if box.is_repo:
        policy["_commit"] = box.repo_meta.get("sha", "")
    return policy


def policy_digest(policy):
    blob = json.dumps(policy, sort_keys=True, separators=(",", ":")).encode()
    return "sha256:" + hashlib.sha256(blob).hexdigest()


def approved_path(name):
    return os.path.join(POLICY_APPROVED_DIR, f"{name}.json")


def policy_pinned(box):
    """Whether the project's current values are the approved ones."""
    return box.entry.get("policy_pin") == policy_digest(project_policy(box))


def _policy_value(value):
    return json.dumps(value) if not isinstance(value, str) else f'"{value}"'


def policy_diff(old, new):
    """Lines describing what changed from `old` to `new` (None: never recorded)."""
    if old is None:
        lines = ["first time this sandbox's policy is recorded:"]
        lines += [f"  {k} = {_policy_value(v)}" for k, v in sorted(new.items())] or ["  (nothing)"]
        return lines
    lines = []
    for key in sorted(set(old) | set(new)):
        before, after = old.get(key), new.get(key)
        if before == after:
            continue
        if key not in old:
            lines.append(f"+ {key} = {_policy_value(after)}")
        elif key not in new:
            lines.append(f"- {key} = {_policy_value(before)}")
        elif isinstance(before, list) and isinstance(after, list):
            lines.append(f"  {key}:")
            lines += [f"+   {item}" for item in after if item not in before]
            lines += [f"-   {item}" for item in before if item not in after]
        elif isinstance(before, dict) and isinstance(after, dict):
            lines.append(f"  [{key}]")
            for sub in sorted(set(before) | set(after)):
                if before.get(sub) != after.get(sub):
                    if sub in before:
                        lines.append(f"-   {sub} = {_policy_value(before[sub])}")
                    if sub in after:
                        lines.append(f"+   {sub} = {_policy_value(after[sub])}")
        else:
            lines.append(f"  {key}: {_policy_value(before)} -> {_policy_value(after)}")
    return lines


def approved_policy(name):
    """The approved values, or None if none were ever recorded for `name`."""
    path = approved_path(name)
    if not os.path.isfile(path):
        return None
    return read_json(path)


def approve_policy(box, policy=None):
    """Record `policy` (default: the project's current values) as approved."""
    policy = project_policy(box) if policy is None else policy
    os.makedirs(POLICY_APPROVED_DIR, mode=0o700, exist_ok=True)
    path = approved_path(box.name)
    fd, tmp = tempfile.mkstemp(dir=POLICY_APPROVED_DIR)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(policy, fh, indent=2, sort_keys=True)
    os.replace(tmp, path)
    digest = policy_digest(policy)
    set_toml_key(registry_path(box), "policy_pin", digest)
    box.entry["policy_pin"] = digest


def ask_approval(box, policy, why, where):
    """Show how `policy` differs from the approved one and ask. Dies where
    nobody may be asked (no terminal, or `host serve`), and when declined."""
    say(f"{box.name}: the project's policy changed since it was approved")
    note(f"from {where}, before {why}:")
    for line in policy_diff(approved_policy(box.name), policy):
        note(f"  {line}")
    if restricted() or not (sys.stdin.isatty() and sys.stdout.isatty()):
        die(f"{box.name}: policy not approved — run `msbctl policy {box.name} approve` on the "
            "host, or with your admin key")
    if not confirm(f"approve this policy for {box.name}?"):
        die("not approved, nothing changed")


def check_policy(box, why):
    """Return if the project's pinned values are the approved ones; otherwise show
    what changed and ask, or die where nobody may be asked. `why` names what
    wants to apply them ("create", "allow")."""
    if policy_pinned(box):
        return
    current = project_policy(box)
    if approved_policy(box.name) is None and not current and not box.entry.get("policy_pin"):
        approve_policy(box)        # nothing to approve: the project sets none of it
        return
    ask_approval(box, current, why, tilde(project_path(box)))
    approve_policy(box, current)
    note("approved")


def cmd_policy(args, config):
    """policy <name> [show|approve|update [REF]] — the project-layer values the pin covers."""
    box = Sandbox(args.name, config)
    if args.action in ("approve", "update") and restricted():
        die(f"`policy {args.action}` is refused here — run it on the host, or with your admin key")
    if args.ref and args.action != "update":
        die("a ref is only for `policy <name> update [REF]`")
    if args.action == "update":
        policy_update(box, args.ref)
        return
    if args.action == "approve":
        if policy_pinned(box):
            note(f"{box.name}: the project's policy is the approved one")
            return
        check_policy(box, "approving")
        return
    say(f"{box.name}  policy  [{'approved' if policy_pinned(box) else 'NOT APPROVED'}]")
    if box.is_repo:
        meta = box.repo_meta
        note(f"from {box.repo} at {meta.get('sha', '?')[:12]} "
             f"({meta.get('branch') or meta.get('ref') or '?'}), fetched {meta.get('fetched_at', '?')}")
    else:
        note(f"from {tilde(project_path(box))}")
    current = project_policy(box)
    for key in PINNED_KEYS:
        if key in current:
            note(f"  {key} = {_policy_value(current[key])}")
    if not any(k in current for k in PINNED_KEYS):
        note("  (the project sets none of the pinned keys)")
    if not policy_pinned(box):
        say("Changes since the last approval")
        for line in policy_diff(approved_policy(box.name), current):
            note(f"  {line}")
        note(f"`msbctl policy {box.name} approve` to accept them")


# ------------------------------------------------- sandboxes cloned from a repo
#
# A repo sandbox has no host folder. Its code is a clone, made by the bootstrap
# inside the sandbox, on a disk volume that outlives it. Its project layer is
# the repo's own .msb/sandbox.toml and .msb/dev.yaml, fetched from the GitHub
# contents API AT A RECORDED COMMIT into policy_dir(name), which plays the part
# a project folder plays for a folder sandbox and is never mounted. `rebuild`
# recreates at that commit and fetches nothing, so an unattended rebuild is
# possible and the pin means something; `msbctl policy <name> update` moves it,
# showing what the newer commit changes first.

POLICY_MAX_BYTES = 256 * 1024
REPO_NAME = re.compile(r"[A-Za-z0-9-]+/[A-Za-z0-9._-]+")


def policy_dir(name):
    return os.path.join(STATE_DIR, "policy", name)


def github_api(path, token=None):
    """(status, data) for a GitHub REST call. (404, None) for a 404, and
    (None, None) for any network or decode failure. Neither the token nor the
    response body ever goes into an error: http_json's single None for every
    failure cannot tell "no such file" from "GitHub is down", and a policy fetch
    must."""
    req = urllib.request.Request("https://api.github.com" + path, headers={
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "msbctl"})
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:  # noqa: S310  an https:// constant
            return resp.status, json.load(resp)
    except urllib.error.HTTPError as exc:
        return exc.code, None
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError, OSError):
        return None, None


def repo_token(name):
    """The GitHub token a policy fetch for `name` uses, or None (a public repo
    needs none). The sandbox's own first, else the machine's global one —
    except under `host serve`, where `add --repo` is allowed: a 200 against a
    404 for a repo named by the caller would tell it which private repos the
    operator's token can read."""
    own = read_env_file(os.path.join(SECRETS_DIR, f"{name}.env")).get("GH_TOKEN")
    if own or restricted():
        return own or None
    return read_env_file(GLOBAL_ENV).get("GH_TOKEN") or None


def _api_die(repo, ref, status):
    hint = (" — a private repo needs a GitHub token with Contents: read on it "
            "(`msbctl secret set <name> GH_TOKEN`)" if status == 404 else "")
    die(f"cannot read {repo}@{ref or '(default branch)'}: "
        f"{status if status is not None else 'GitHub unreachable'}{hint}")


def resolve_repo_ref(repo, ref, token):
    """(sha, branch, private) for `ref` (empty: the default branch)."""
    status, info = github_api(f"/repos/{repo}", token)
    if status != 200 or not isinstance(info, dict):
        _api_die(repo, ref, status)
    branch = ""
    target = ref or info.get("default_branch", "")
    if not ref:
        branch = target
    elif not re.fullmatch(r"[0-9a-f]{40}", ref):
        bstatus, _ = github_api(f"/repos/{repo}/branches/{urllib.parse.quote(ref, safe='')}", token)
        branch = ref if bstatus == 200 else ""
    status, commit = github_api(f"/repos/{repo}/commits/{urllib.parse.quote(target, safe='')}", token)
    if status != 200 or not isinstance(commit, dict) or not commit.get("sha"):
        _api_die(repo, ref, status)
    return commit["sha"], branch, bool(info.get("private"))


def _fetch_file(repo, path, sha, token):
    """A file's bytes at `sha`, or None if it does not exist there. Any other
    failure dies: only a 404 means "no file", never an error, or a repo whose
    policy could not be read would silently get the defaults."""
    status, data = github_api(f"/repos/{repo}/contents/{path}?ref={sha}", token)
    if status == 404:
        return None
    if status != 200 or not isinstance(data, dict):
        _api_die(repo, sha[:12], status)
    if data.get("type") != "file" or data.get("size", 0) > POLICY_MAX_BYTES:
        die(f"{repo}: {path} at {sha[:12]} is not a file under {POLICY_MAX_BYTES // 1024} KiB")
    try:
        raw = base64.b64decode(data.get("content", ""))
    except ValueError:
        die(f"{repo}: {path} at {sha[:12]} did not decode")
    if len(raw) > POLICY_MAX_BYTES:
        die(f"{repo}: {path} at {sha[:12]} is over {POLICY_MAX_BYTES // 1024} KiB")
    return raw


def fetch_repo_policy(name, repo, ref, sha=None, token=None):
    """Fetch .msb/sandbox.toml and .msb/dev.yaml of `repo` at `ref` (or exactly
    at `sha`) into a new private directory beside policy_dir(name), and return
    (that directory, meta). install_policy() swaps it in; nothing is replaced
    here, so a refused or failed fetch changes nothing."""
    token = token or repo_token(name)
    if sha:
        status, info = github_api(f"/repos/{repo}", token)
        if status != 200 or not isinstance(info, dict):
            _api_die(repo, sha[:12], status)
        branch = ref if ref and not re.fullmatch(r"[0-9a-f]{40}", ref) else ""
        private = bool(info.get("private"))
        if not ref:
            branch = info.get("default_branch", "")
    else:
        sha, branch, private = resolve_repo_ref(repo, ref, token)
    files = {}
    for path in (".msb/sandbox.toml", ".msb/dev.yaml"):
        files[path] = _fetch_file(repo, path, sha, token)
    if files[".msb/sandbox.toml"] is not None:
        try:
            tomllib.loads(files[".msb/sandbox.toml"].decode("utf-8"))
        except (UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
            die(f"{repo}: .msb/sandbox.toml at {sha[:12]} does not parse: {exc}")
    parent = os.path.dirname(policy_dir(name))
    os.makedirs(parent, mode=0o700, exist_ok=True)
    tmp = tempfile.mkdtemp(prefix=f".{name}-", dir=parent)
    os.makedirs(os.path.join(tmp, ".msb"), exist_ok=True)
    for path, raw in files.items():
        if raw is not None:
            with open(os.path.join(tmp, path), "wb") as fh:
                fh.write(raw)
    problems = conf_problems(os.path.join(tmp, ".msb", "dev.yaml"))
    if problems:
        shutil.rmtree(tmp, ignore_errors=True)
        die(f"{repo}: .msb/dev.yaml at {sha[:12]} sets what msbctl does not read: "
            + "; ".join(problems))
    meta = {"repo": repo, "ref": ref, "branch": branch, "sha": sha, "private": private,
            "fetched_at": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
    write_json(os.path.join(tmp, "meta.json"), meta)
    return tmp, meta


def install_policy(name, tmp):
    """Swap a directory fetch_repo_policy() wrote in as policy_dir(name)."""
    dest = policy_dir(name)
    old = None
    if os.path.exists(dest):
        old = dest + ".old"
        shutil.rmtree(old, ignore_errors=True)
        os.replace(dest, old)
    os.replace(tmp, dest)
    if old:
        shutil.rmtree(old, ignore_errors=True)


def policy_of_dir(path):
    """project_policy() for a fetched directory that is not installed yet."""
    cfg = read_toml(os.path.join(path, ".msb", "sandbox.toml"))
    policy = {k: cfg[k] for k in PINNED_KEYS if k in cfg}
    policy["_commit"] = read_json(os.path.join(path, "meta.json")).get("sha", "")
    return policy


def ensure_repo_policy(box):
    """Before a create: a repo sandbox whose policy directory is missing (a new
    machine, a wiped state directory) fetches it — at the approved commit if one
    was ever approved, else the tip. Only then; a rebuild never refetches."""
    if not box.is_repo or os.path.isfile(os.path.join(box.project, "meta.json")):
        return
    sha = (approved_policy(box.name) or {}).get("_commit") or None
    note(f"fetching the policy of {box.repo}" + (f" at {sha[:12]}" if sha else ""))
    tmp, _ = fetch_repo_policy(box.name, box.repo, box.entry.get("ref", ""), sha=sha)
    install_policy(box.name, tmp)
    box.reload()


def policy_update(box, ref):
    """Move a repo sandbox's policy to the tip of its ref (or of REF, which
    also becomes its ref), showing what that changes and asking first."""
    if not box.is_repo:
        die(f"{box.name} is a folder sandbox; its policy is {tilde(project_path(box))} — "
            f"`msbctl policy {box.name} approve` after changing it")
    ref = box.entry.get("ref", "") if ref is None else ref
    tmp, meta = fetch_repo_policy(box.name, box.repo, ref)
    try:
        new = policy_of_dir(tmp)
        if policy_digest(new) == box.entry.get("policy_pin"):
            note(f"{box.name}: {box.repo} at {meta['sha'][:12]} has the approved policy already")
            install_policy(box.name, tmp)
            tmp = None
        else:
            ask_approval(box, new, f"moving to {meta['sha'][:12]}", f"{box.repo}")
            install_policy(box.name, tmp)
            tmp = None
            approve_policy(box, new)
            note("approved")
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)
    if ref != box.entry.get("ref", ""):
        set_toml_key(registry_path(box), "ref", ref)
    note(f"a `msbctl rebuild {box.name}` applies it. The clone inside is not touched: it is a")
    note("git checkout, moved with git (`git fetch && git checkout ...` in the sandbox).")


def warn_local_groups_in_project(box):
    """A group only this machine defines, listed in the project's own file: it
    works here and breaks every other clone. Said, not refused — it is not a
    hole, just in the wrong file, and `msbctl edit` → Features moves it."""
    if box.is_repo:
        return
    stray = [g for g in box.project_cfg.get("rule_groups", []) if g in machine_only_groups()]
    if stray:
        warn(f"{', '.join(stray)} in {tilde(project_path(box))}: defined only in this machine's "
             f"config.toml, so every other clone fails with \"unknown rule group\" — move "
             f"{'it' if len(stray) == 1 else 'them'} to extra_rule_groups in the registry entry "
             f"(`msbctl edit {box.name}` → Features & agents does it)")


def refuse_before_create(box):
    """Everything that stops a create, checked BEFORE anything is removed: a
    rebuild or rename that tore the VM down first and then refused would leave
    nothing where a running sandbox was."""
    ensure_repo_policy(box)
    refuse_conf_problems(box)
    refuse_reserved_bindings(box)
    check_policy(box, "create")


def is_reserved_var(var):
    """Variables with a FIXED binding: GH_TOKEN (github.com, api.github.com) and
    every Claude token (Anthropic's hosts). No `secret_binds` entry, in any
    layer, may name one: a second binding `GH_TOKEN@attacker.example` would
    send the sandbox's real token wherever the binding says."""
    return (var == "GH_TOKEN" or var == CLAUDE_TOKEN_VAR
            or var.startswith(CLAUDE_TOKEN_VAR + "_"))


def reserved_binding_problems(box):
    """The `secret_binds` entries that name a reserved variable."""
    return [spec for spec in box.secret_binds if is_reserved_var(secret_var(spec))]


def refuse_reserved_bindings(box):
    bad = reserved_binding_problems(box)
    if bad:
        die(f"{box.name}: {', '.join(repr(b) for b in bad)} in "
            f"{tilde(box._origin('secret_binds'))}: GH_TOKEN and the Claude tokens have fixed "
            "bindings and cannot be bound again — remove the line")


def refuse_conf_problems(box):
    """Die if the project's dev.yaml says more than msbctl reads. Only create
    and rebuild check: an existing sandbox keeps running and starting, since
    nothing in the file reaches msb either way."""
    problems = conf_problems(box.conf_path)
    if not problems:
        return
    lines = [f"{tilde(box.conf_path)} sets what msbctl does not read, and is never passed to msb:"]
    lines += [f"  {p}" for p in problems]
    lines += ["Move `env:` to [env] in .msb/sandbox.toml, and cpus/memory there too.",
              "Anything else msb's config file can do goes in a file of your own, named by",
              f"`msb_conf` in {tilde(registry_path(box))} (registry only, never a repo)."]
    die("\n".join(lines))


def do_create(box):
    say(f"Creating {box.name}")
    refuse_before_create(box)
    warn_local_groups_in_project(box)
    warn_missing_prereqs(box)
    ensure_agent_filter(box)
    secret_flags, env = box.secret_env()
    argv = (["msb", "create", "--name", box.name]
            + box.create_flags() + secret_flags + [box.image])
    run(argv, env=env)

    say("Bootstrapping (once)")
    # Not check=True: a failed bootstrap still leaves a sandbox worth keeping
    # (to look inside, and the rest of it may work), so everything below still
    # runs. But it must not look like success either — see bootstrap_failed().
    boot = run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c",
                bootstrap_payload(box)], check=False)
    ensure_bridge(box)
    ensure_profile(box)
    ensure_identity(box)
    ensure_git_checkstat(box)
    ensure_podman_runtime(box)
    if boot.returncode != 0:
        bootstrap_failed(box, boot.returncode)
    return boot.returncode == 0


# Sandboxes whose bootstrap failed during this msbctl run. main() exits
# non-zero if any did, once the command has finished: do_create() itself must
# not exit, because rename and the edit menu still have work to do after it.
BOOTSTRAP_FAILURES = []


def bootstrap_failed(box, code):
    """Say, last and loudly, that a sandbox was created but is not set up.

    The bootstrap's own summary is easy to miss: it is in the middle of a long
    create, and errors on stderr (apt's `E:` lines) can arrive after it.
    """
    BOOTSTRAP_FAILURES.append(box.name)
    sys.stdout.flush()          # after the create's own output, even when piped
    print(f"\n{BOLD}{RED}== {box.name} is running, but its bootstrap FAILED "
          f"(exit {code}){RESET}", file=sys.stderr)
    for line in (
            "The summary above lists the steps under \"REQUIRED, FAILED\"; the",
            "reason is in that step's output, and apt's errors can come after the",
            "summary. The sandbox is kept so you can look inside:",
            f"  msbctl shell {box.name}",
            "Fix the cause (usually a missing egress rule), then:",
            f"  msbctl rebuild {box.name}"):
        print(f"   {line}", file=sys.stderr)


def bootstrap_payload(box):
    """Ship bootstrap.sh in over stdin rather than mounting it.

    The guest can only see the project and the profile directory, and bootstrap.sh
    lives in neither — this file is in the msb-manager checkout, which is
    deliberately not mounted. Writing it in and running it keeps the manager's
    own code outside every sandbox's reach.
    """
    with open(BOOTSTRAP, encoding="utf-8") as fh:
        body = fh.read()
    versions = box.versions()
    boot = box.project_cfg.get("bootstrap", {})
    env = {
        "MSB_NODE_MAJOR": str(versions.get("node", "22")),
        "MSB_GITLEAKS_VERSION": str(versions.get("gitleaks", "8.30.1")),
        "MSB_GH_VERSION": str(versions.get("gh", "2.102.0")),
        "MSB_BUN_VERSION": str(versions.get("bun", "1.4.2")),
        "MSB_EXTRA_PACKAGES": " ".join(boot.get("packages", [])),
        # Default TRUE: this manager exists to run agents, so an explicit
        # opt-out is the right shape rather than an explicit opt-in.
        "MSB_WANT_CLAUDE": "0" if boot.get("claude") is False else "1",
        "MSB_WANT_BUN": "1" if boot.get("bun") else "0",
        "MSB_WANT_GITLEAKS": "1" if boot.get("gitleaks") else "0",
        "MSB_PROJECT_DIR": box.guest_project,
        "MSB_PROJECT_SCRIPT": boot.get("script", ""),
        "MSB_CONTAINERS_STORAGE": boot.get("containers_storage", ""),
        "MSB_CACHE_LINKS": " ".join(f"{src}:{dest}" for src, dest in box.cache_links),
        # A repo sandbox's code: cloned into the workspace volume on its first
        # create, left alone after (a rebuild finds .git there).
        "MSB_CLONE_URL": f"https://github.com/{box.repo}.git" if box.is_repo else "",
        "MSB_CLONE_REF": (box.entry.get("ref") or box.repo_meta.get("branch", ""))
                         if box.is_repo else "",
    }
    exports = "\n".join(f"export {k}={shq(v)}" for k, v in env.items())
    return (f"cat >/tmp/bootstrap.sh <<'MSB_BOOTSTRAP_EOF'\n{body}\n"
            f"MSB_BOOTSTRAP_EOF\nchmod +x /tmp/bootstrap.sh\n{exports}\n"
            "/tmp/bootstrap.sh\n")


def shq(value):
    """Single-quote for sh. Values here are config-derived, never secrets."""
    return "'" + str(value).replace("'", "'\\''") + "'"


def cmd_start(args, config):
    box = Sandbox(args.name, config)
    table = msb_table()
    if state_of(box.name, table) == "absent":
        do_create(box)
    else:
        ensure_running(box, table)
    print_one(box, msb_table())


def cmd_stop(args, config):
    box = Sandbox(args.name, config)
    run(["msb", "stop", box.name], check=False)
    stop_agent_filter(box)
    note(f"{box.name} stopped — installed packages and state are kept")


def cmd_rebuild(args, config):
    box = Sandbox(args.name, config)
    say(f"Rebuilding {box.name}")
    note("network rules, mounts and the image are fixed at create time, so")
    note("changing any of them means this (cpus, memory and the root disk do not:")
    note("`msbctl resize`). Packages installed")
    note("by hand are lost; anything in bootstrap.sh comes back. Package caches,")
    note("container images and the Claude state are kept.")
    refuse_before_create(box)
    run(["msb", "stop", box.name], check=False, quiet=True)
    run(["msb", "rm", box.name], check=False, quiet=True)
    do_create(box)
    print_one(box, msb_table())


def cmd_purge(args, config):
    box = Sandbox(args.name, config)
    secret = os.path.join(SECRETS_DIR, f"{box.name}.env")
    entry = os.path.join(REGISTRY_DIR, f"{box.name}.toml")

    say(f"Purging {box.name}")
    note("This deletes, in this order:")
    note(f"  the sandbox          {box.name}")
    note(f"  its Claude state     {tilde(box.state)}")
    owned = box.owned_volumes()
    if owned:
        note(f"  its disk volumes     {', '.join(owned)}  (package caches, container images"
             + (", the clone" if box.is_repo else "") + ")")
    if box.is_repo and box.workspace_volume in owned:
        warn(f"{box.workspace_volume} holds the clone: work in it that was not pushed is lost")
    if os.path.isfile(secret):
        note(f"  its token            {tilde(secret)}  (revoke it on GitHub too)")
    if box.is_repo:
        note(f"  its fetched policy   {tilde(box.project)}")
    note(f"  its registration     {tilde(entry)}")
    note("")
    if box.is_repo:
        note(f"The repository on GitHub is not touched: {box.repo}")
    else:
        note(f"The project itself is NOT touched: {tilde(box.project)}")
    if not args.yes and not confirm(f"purge {box.name}?"):
        return

    run(["msb", "stop", box.name], check=False, quiet=True)
    run(["msb", "rm", box.name], check=False, quiet=True)
    stop_agent_filter(box)
    shutil.rmtree(box.state, ignore_errors=True)
    if box.is_repo:
        shutil.rmtree(box.project, ignore_errors=True)
    remove_sandbox_volumes(box)
    for path in (secret, entry, approved_path(box.name)):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass  # never had one, or already gone
    cache = read_json(VERSIONS_CACHE)
    cache.pop(box.name, None)
    write_json(VERSIONS_CACHE, cache)
    note(f"{box.name} purged")
    if box.repo:
        note("Revoke its PAT: https://github.com/settings/personal-access-tokens")


# ------------------------------------------------------------- rename and move
#
# msb can rename neither a sandbox nor a volume, so a new name is a new VM: the
# old one is removed and, if it existed, created again under the new name — the
# cost of a rebuild. Everything msbctl itself keys by name moves with it; the
# disk volumes stay where they are and the entry's `volumes` key keeps pointing
# at them. A new project folder is a create-time mount, so that is a rebuild too.

SANDBOX_NAME = re.compile(r"[a-z0-9][a-z0-9-]*")


def name_problem(name, renaming=None):
    """Why `name` cannot be given to a new (or the renamed) sandbox, or None."""
    if not SANDBOX_NAME.fullmatch(name):
        return "name must be lowercase letters, digits and dashes"
    if name == renaming:
        return f"it is already called {name}"
    if os.path.exists(registry_path_for(name)):
        return f"{name} is already registered ({tilde(registry_path_for(name))})"
    # A renamed sandbox still owns volumes under its old name; a second sandbox
    # taking that name would mount the same disks.
    for other in registered():
        if other != renaming and read_toml(registry_path_for(other)).get("volumes") == name:
            return f"{name} is still the disk-volume prefix of {other} (it was renamed from it)"
    if state_of(name) != "absent":
        return f"msb already has a sandbox called {name} that msbctl does not manage"
    return None


def _follow_rename_in_comments(path, old, new):
    """The entry's comments name the sandbox (`msbctl keys old`); keep them right.
    Comment lines only, and only where a command or the header names it."""
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
    command = re.compile(rf"(msbctl [a-z-]+ (?:add |rm |ls )?){re.escape(old)}(?![\w.-])")
    for i, line in enumerate(lines):
        if line.lstrip().startswith("#"):
            line = command.sub(rf"\g<1>{new}", line)
            lines[i] = re.sub(rf"^# {re.escape(old)} — ", f"# {new} — ", line)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


def rename_sandbox(box, new):
    """Move everything msbctl keeps under `box.name` to `new`, removing the old VM.
    Returns whether there was a VM, so the caller can create it again."""
    old = box.name
    moves = [(os.path.join(SECRETS_DIR, f"{old}.env"), os.path.join(SECRETS_DIR, f"{new}.env")),
             (box.state, os.path.join(STATE_DIR, "claude", new)),
             (os.path.join(AGENT_DIR, f"{old}.log"), os.path.join(AGENT_DIR, f"{new}.log")),
             (approved_path(old), approved_path(new)),
             (policy_dir(old), policy_dir(new))]
    # Checked before anything is destroyed, so a refusal leaves it all as it was.
    clash = [dst for src, dst in moves if os.path.exists(src) and os.path.exists(dst)]
    if clash:
        die(f"left over from an earlier {new}: {', '.join(tilde(p) for p in clash)} — "
            "move it out of the way first")

    existed = state_of(old) != "absent"
    if existed:
        run(["msb", "stop", old], check=False, quiet=True)
        run(["msb", "rm", old], check=False, quiet=True)
        if state_of(old) != "absent":
            die(f"could not remove the sandbox {old} — nothing has been renamed")
    stop_agent_filter(box)

    entry = registry_path_for(new)
    os.replace(registry_path(box), entry)
    set_toml_key(entry, "name", new)
    if box.owned_volumes():
        # Pinned to the volumes that exist, or dropped when renamed back to them.
        set_toml_key(entry, "volumes", None if box.volume_prefix == new else box.volume_prefix)
    else:
        set_toml_key(entry, "volumes", None)
    _follow_rename_in_comments(entry, old, new)
    for src, dst in moves:
        if os.path.exists(src):
            os.replace(src, dst)
    cache = read_json(VERSIONS_CACHE)
    if old in cache:
        cache[new] = cache.pop(old)
        write_json(VERSIONS_CACHE, cache)
    return existed


def explain_rename():
    note("msb cannot rename a sandbox, so this removes it and creates it again under")
    note("the new name, like a rebuild: packages installed by hand are lost, anything")
    note("in bootstrap.sh comes back. Settings, secrets, the Claude state, package")
    note("caches and container images all move with it.")


def cmd_rename(args, config):
    box = Sandbox(args.name, config)
    problem = name_problem(args.new, renaming=box.name)
    if problem:
        die(problem)
    say(f"Renaming {box.name} to {args.new}")
    if state_of(box.name) != "absent":
        refuse_before_create(box)
        explain_rename()
        if not args.yes and not confirm(f"rename {box.name} to {args.new}?"):
            return
    existed = rename_sandbox(box, args.new)
    note(f"renamed: {tilde(registry_path_for(args.new))}")
    if existed:
        box = Sandbox(args.new, config)
        do_create(box)
        print_one(box, msb_table())


def move_project(box, raw, config):
    """Point `box` at another project folder (typed as for `add`). True if it changed.
    The old folder may already be gone: moving a checkout is the usual reason."""
    project = resolve_project(raw, config)
    if project == box.project:
        note(f"{box.name} already uses {tilde(project)}")
        return False
    if not os.path.isdir(project):
        die(f"not a directory: {tilde(project)}")

    # The portable half of the config lives in the project. A clone of a repo
    # that commits .msb/ brings it along; a bare folder needs it copied over.
    old_msb, new_msb = os.path.join(box.project, ".msb"), os.path.join(project, ".msb")
    if not os.path.isfile(os.path.join(project, box.conf)):
        missing = ([f for f in sorted(os.listdir(old_msb))
                    if not os.path.exists(os.path.join(new_msb, f))]
                   if os.path.isdir(old_msb) else [])
        if not missing:
            die(f"{tilde(project)} has no {box.conf}, and there is none to copy from "
                f"{tilde(box.project)} — `msbctl add` it as a new sandbox instead")
        note(f"{tilde(project)} has no {box.conf}; the old folder has: {', '.join(missing)}")
        if not confirm(f"copy {'it' if len(missing) == 1 else 'them'} over?"):
            die("cancelled — nothing changed")
        os.makedirs(new_msb, exist_ok=True)
        for f in missing:
            src = os.path.join(old_msb, f)
            (shutil.copytree if os.path.isdir(src) else shutil.copy2)(src, os.path.join(new_msb, f))
        note(f"copied into {tilde(new_msb)}")

    path = registry_path(box)
    set_toml_key(path, "project", project)
    note(f"project    {tilde(project)}")
    repo = github_repo(project)
    if repo and repo != box.repo:
        set_toml_key(path, "repo", repo)
        note(f"repo       {repo}  (was {box.repo or 'none'})")
        if read_env_file(os.path.join(SECRETS_DIR, f"{box.name}.env")).get("GH_TOKEN"):
            warn(f"its GitHub token was made for {box.repo or 'another repo'} — "
                 f"`msbctl edit {box.name}` → GitHub token to replace it")
    return True


def refuse_repo_sandbox(box, what):
    if box.is_repo:
        die(f"{box.name} has no folder on this machine — it is a clone of {box.repo} inside "
            f"the sandbox, so there is nothing to {what}")


def cmd_move(args, config):
    box = Sandbox(args.name, config)
    refuse_repo_sandbox(box, "move")
    if not move_project(box, args.dir, config):
        return
    if state_of(box.name) == "absent":
        note("not created yet, so it applies at first start")
    elif args.rebuild or confirm(f"the folder is mounted at create time — rebuild {box.name} now?"):
        cmd_rebuild(verb_args("rebuild", name=box.name), config)
    else:
        note(f"until then it still sees the old folder: `msbctl rebuild {box.name}`")


# `shell` and `exec` pass every flag msbctl does not use itself straight to
# `msb exec` (split off in split_msb_flags(), before argparse sees them), so
# `-u root`, `--timeout 5m`, `-e KEY=value` and whatever later msb versions add
# work without a table here to keep in step. msbctl adds `--tty` (shell) and
# `-w` itself, and msb refuses either twice, so those are only left out when
# the caller already gave one.
MSB_EXEC_HINT = ("any other flag goes to `msb exec` as is (`msb exec --help` lists "
                 "them), e.g. -u root, --timeout 5m, -e KEY=value; give them after "
                 "the name, and for exec before --")


def split_msb_flags(argv, verb):
    """argv with the msb flags of `exec`/`shell` at argv[verb] taken out, and
    those flags. They follow the name (which may be left out); for exec they
    end at `--`. `-h` stays behind for argparse. An exec with no name before
    its flags or `--` gets `.`, this folder's sandbox."""
    head, rest = argv[:verb + 1], argv[verb + 1:]
    name = []
    if rest and not rest[0].startswith("-"):
        name, rest = rest[:1], rest[1:]
    tail = []
    if argv[verb] == "exec":
        if "--" in rest:
            cut = rest.index("--")
        elif rest and rest[0].startswith("-"):
            cut = len(rest)
        else:
            return argv, []          # `exec . make -j4`: all of it is the command
        if rest[:1] and not rest[0].startswith("-"):
            return argv, []          # `exec x git log -- file`: so is this
        rest, tail = rest[:cut], rest[cut:]
        name = name or ["."]
    helps = [a for a in rest if a in ("-h", "--help")]
    flags = [a for a in rest if a not in ("-h", "--help")]
    return head + helps + name + tail, flags


def gave_flag(flags, short, long):
    """True if `flags` already has this option, in any of its spellings."""
    return any(f == long or f.startswith(long + "=")
               or (short and f.startswith(short)) for f in flags)


def msb_exec_argv(box, flags, want_tty=False):
    cmd = ["msb", "exec", box.name]
    if want_tty and not any(gave_flag(flags, s, l) for s, l in (
            ("-t", "--tty"), (None, "--no-tty"), (None, "--stream"))):
        cmd.append("--tty")
    cmd += ["-e", f"SSH_AUTH_SOCK={GUEST_AGENT_SOCK}"]
    if not gave_flag(flags, "-w", "--workdir"):
        cmd += ["-w", guest_workdir(box)]
    return cmd + flags


def cmd_shell(args, config):
    box = Sandbox(args.name, config)
    ensure_running(box)
    os.execvp("msb", [*msb_exec_argv(box, args.msb_flags, want_tty=True), "--", "bash", "-l"])


def cmd_exec(args, config):
    box = Sandbox(args.name, config)
    # argparse.REMAINDER keeps the `--` separator, so `msbctl exec x -- ls`
    # would otherwise run a command literally named "--".
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        die("exec needs a command")
    ensure_running(box)
    os.execvp("msb", [*msb_exec_argv(box, args.msb_flags), "--", *command])


def cmd_reclaim(args, config):
    box = Sandbox(args.name, config)
    # Page cache is never returned on its own, whether written to the guest
    # disk or through a virtiofs mount, so a sandbox that builds things drifts
    # up to its memory ceiling and stays there. This gives it back in about a
    # second. Anonymous memory needs no help.
    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c",
         "sync; echo 3 > /proc/sys/vm/drop_caches; echo reclaimed"], check=False)


def cmd_code(args, config):
    box = Sandbox(args.name, config)
    refuse_repo_sandbox(box, "open (`msbctl shell` gets you into the clone)")
    editor = os.environ.get("MSB_EDITOR", "codium")
    if not shutil.which(editor):
        die(f"{editor} is not on PATH — set MSB_EDITOR to the one you use")
    # Detached: the picker that invoked this should not wait for the editor,
    # and closing the terminal should not close the editor.
    subprocess.Popen([editor, box.project],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    note(f"{editor} opening {tilde(box.project)}")
    note(f"From its terminal: msbctl shell {box.name}")


def confirm(question):
    try:
        return input(f"   {question} [y/N] ").strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


# -------------------------------------------------------------------- display

def read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
    os.replace(tmp, path)


def print_one(box, table):
    note(f"{box.name}  {state_of(box.name, table)}  {box.location}")


def _flatten(table, prefix=""):
    for key, value in table.items():
        path = f"{prefix}{key}"
        if isinstance(value, dict):
            yield from _flatten(value, path + ".")
        else:
            yield path, value


# ------------------------------------------------------------- TOML key editor
#
# `edit` has to write into files people also edit by hand, so this changes ONE key
# in place and leaves everything else — comments, ordering, other tables —
# byte-for-byte alone. Anything that would not parse afterwards is refused before it
# is written. Not a serializer: it only knows scalars and lists of strings.

_TOML_HEADER = re.compile(r"^\s*\[\[?\s*([^\[\]]+?)\s*\]\]?\s*(#.*)?$")


def toml_literal(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, list):
        if not value:
            return "[]"
        return "[\n" + "".join(f"    {toml_literal(v)},\n" for v in value) + "]"
    raise TypeError(f"cannot write {value!r} as TOML")


def _toml_region(lines, table):
    """(start, end) of the lines belonging to `table` (None: before the first
    header), or None if that table does not exist."""
    if table is None:
        return 0, next((i for i, l in enumerate(lines) if _TOML_HEADER.match(l)), len(lines))
    for i, line in enumerate(lines):
        m = _TOML_HEADER.match(line)
        if m and m.group(1).strip() == table:
            end = next((j for j in range(i + 1, len(lines)) if _TOML_HEADER.match(lines[j])),
                       len(lines))
            return i + 1, end
    return None


def _bracket_balance(text):
    text = re.sub(r'"(?:[^"\\]|\\.)*"', '""', text).split("#")[0]
    return text.count("[") - text.count("]")


def _toml_assignment(lines, start, end, key):
    for i in range(start, end):
        if re.match(rf"^\s*{re.escape(key)}\s*=", lines[i]):
            j, depth = i, _bracket_balance(lines[i].split("=", 1)[1])
            while depth > 0 and j + 1 < end:
                j += 1
                depth += _bracket_balance(lines[j])
            return i, j
    return None


def set_toml_key(path, key, value, table=None):
    """Set `key` (top level, or inside [table]) to `value` in the file at `path`;
    value None removes it. Returns True if the file changed."""
    with open(path, encoding="utf-8") as fh:
        before = fh.read()
    lines = before.splitlines()
    new = [] if value is None else f"{key} = {toml_literal(value)}".splitlines()
    region = _toml_region(lines, table)
    if region is None:
        if value is None:
            return False
        lines += ["", f"[{table}]"] + new
    else:
        start, end = region
        found = _toml_assignment(lines, start, end, key)
        if found:
            lines[found[0]:found[1] + 1] = new
        elif value is not None:
            # After the last real line of the region, not after trailing comments:
            # those are usually the banner of the NEXT table.
            at = start
            for j in range(start, end):
                if lines[j].strip() and not lines[j].lstrip().startswith("#"):
                    at = j + 1
            lines[at:at] = new
    after = "\n".join(lines) + "\n"
    if after == before:
        return False
    try:
        tomllib.loads(after)
    except tomllib.TOMLDecodeError as exc:
        die(f"refusing to write {tilde(path)}: {key} would leave it invalid ({exc})")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(after)
    return True


def remove_toml_table(path, table):
    """Delete `[table]` and its keys from a TOML file, in place. True if it existed."""
    with open(path, encoding="utf-8") as fh:
        before = fh.read()
    lines = before.splitlines()
    region = _toml_region(lines, table)
    if region is None:
        return False
    start, end = region
    del lines[start - 1:end]                       # the header line and its body
    while start - 1 < len(lines) and start - 1 > 0 and not lines[start - 1].strip() \
            and not lines[start - 2].strip():
        del lines[start - 1]                       # collapse the gap it leaves
    after = "\n".join(lines) + "\n"
    tomllib.loads(after)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(after)
    return True


def set_entry_value(box, key, literal):
    """Set a top-level `key = literal` in this sandbox's registry entry, in
    place. A line-level edit for the same reason as write_version_override():
    a serializer would discard the comments that make the file hand-editable."""
    path = os.path.join(REGISTRY_DIR, f"{box.name}.toml")
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
    new = f"{key} = {literal}"
    for i, line in enumerate(lines):
        if re.match(rf"^\s*{re.escape(key)}\s*=", line):
            lines[i] = new
            break
    else:
        at = next((j + 1 for j, line in enumerate(lines)
                   if re.match(r"^\s*autostart\s*=", line)), None)
        if at is None:
            at = next((j for j, line in enumerate(lines)
                       if line.lstrip().startswith("[")), len(lines))
        lines.insert(at, new)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


RULE_PROTOCOLS = ("any", "tcp", "udp", "icmpv4", "icmpv6")


def _split_rule_target(right):
    """`<target>[:<proto>[:<ports>]]` -> [target, proto?, ports?, anything
    extra…], splitting the way msb does: an IPv6 target is bracketed, so its
    own colons are not separators."""
    if right.startswith("["):
        target, sep, rest = right.partition("]")
        if not sep:
            return None
        target += "]"
        if rest and not rest.startswith(":"):
            return None
        return [target] + (rest[1:].split(":") if rest else [])
    return right.split(":")


def _ports_ok(ports):
    if ports == "any":
        return True
    lo, _, hi = ports.partition("-")
    return all(p.isdigit() and 1 <= int(p) <= 65535 for p in ([lo, hi] if hi else [lo]))


def rule_problem(rule):
    """What msb will refuse about a --net-rule token, or None. A shape check
    against `<action>[:<direction>]@<target>[:<proto>[:<ports>]]`, not a full
    parse: targets are left to msb, which names the bad one itself. The point
    is to say WHICH FILE holds a broken rule before msb fails the create.
    msb also takes several rules in one comma-separated token, as `base` does."""
    if "," in rule:
        parts = [part.strip() for part in rule.split(",") if part.strip()]
        return next(filter(None, map(rule_problem, parts)), None)
    left, at, right = rule.partition("@")
    if not at:
        return "no `@` — a rule is allow@TARGET[:PROTO[:PORTS]]"
    action, _, direction = left.partition(":")
    if action not in ("allow", "deny") or direction not in ("", "egress", "ingress", "any"):
        return f"{left!r} is not allow/deny[:egress|ingress|any]"
    fields = _split_rule_target(right)
    if not fields or not fields[0]:
        return "no target after `@`"
    if len(fields) > 3:
        return "fields after the ports — a rule ends at allow@TARGET:PROTO:PORTS"
    if len(fields) > 1 and fields[1] not in RULE_PROTOCOLS:
        return f"{fields[1]!r} is not a protocol ({', '.join(RULE_PROTOCOLS)})"
    if len(fields) > 2 and not _ports_ok(fields[2]):
        return f"{fields[2]!r} is not a port, a LO-HI range or `any`"
    return None


def parse_allow_target(raw):
    """One `allow` argument as a net rule. Accepts a full rule (`allow@...`),
    `host` (HTTPS), `host:port` (TCP) or `host:proto:port`; an IPv6 address
    goes in brackets, `[fd00::1]:22`. Dies on anything else rather than
    guessing: a guess once turned `10.0.0.6:tcp:2222` into a rule msb refused."""
    raw = raw.strip()
    if "@" in raw:
        rule = raw
    else:
        fields = _split_rule_target(raw)
        if raw.count(":") > 2 and re.fullmatch(r"[0-9a-fA-F:]+(/\d+)?", raw):
            die(f"{raw!r}: an IPv6 address goes in brackets, like [{raw}] or [{raw}]:22")
        if not fields or not fields[0] or len(fields) > 3:
            die(f"{raw!r}: expected host, host:port, host:tcp:port, or a full rule "
                "like allow@host:tcp:443")
        host, proto, port = (fields[0], "tcp", "443") if len(fields) == 1 else \
            (fields[0], "tcp", fields[1]) if len(fields) == 2 else fields
        rule = f"allow@{host}:{proto}:{port}"
    problem = rule_problem(rule)
    if problem:
        die(f"{raw!r}: {problem}")
    return rule


def append_toml_list(path, key, items, after_key=None):
    """Add `items` to the top-level list `key` in a TOML file, in place, keeping
    the rest of the file (comments included) untouched. Returns the items that
    were actually new. The assignment is rewritten one entry per line."""
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    current = list(tomllib.loads(text).get(key, []))
    new = [i for i in items if i not in current]
    if not new:
        return []
    block = [f"{key} = ["] + [f"    {json.dumps(i)}," for i in current + new] + ["]"]
    lines, out, at, i = text.splitlines(), [], None, 0
    while i < len(lines):
        if re.match(rf"^\s*{re.escape(key)}\s*=", lines[i]):
            at = len(out)
            while i < len(lines) and "]" not in lines[i].split("#")[0]:
                i += 1
            i += 1
            continue
        out.append(lines[i])
        i += 1
    if at is None:
        anchor = next((j + 1 for j, line in enumerate(out) if after_key and
                       re.match(rf"^\s*{re.escape(after_key)}\s*=", line)), None)
        if anchor is None:
            anchor = next((j for j, line in enumerate(out)
                           if line.lstrip().startswith("[")), len(out))
        out[anchor:anchor] = [""]
        at = anchor + 1
    out[at:at] = block
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")
    return new


def cmd_allow(args, config):
    """Add egress rules to a sandbox's policy. Rules are fixed when the sandbox
    is created (msb cannot change them live), so this records them and says a
    rebuild is needed; --rebuild does it now."""
    box = Sandbox(args.name, config)
    rules = [parse_allow_target(t) for t in args.targets]
    for rule in rules:
        if re.search(r":tcp:80(\b|$)", rule) and rule.startswith("allow"):
            die(f"{rule}: plaintext :80 is denied by `base`, which is always first, "
                "so this could never match — use the https:// URL's host instead")
    existing = box.net_rules()
    fresh = [r for r in rules if r not in existing]
    for rule in rules:
        if rule not in fresh:
            note(f"already allowed: {rule}")
    if not fresh:
        return

    # The registry entry REPLACES the project's list when it sets extra_rules
    # (see Sandbox._pick), so write wherever the list effectively lives.
    # A repo sandbox has no checkout to edit, so its own list is the
    # registry's, which ADDS to the repo's rather than replacing them.
    sandbox_toml = os.path.join(box.project, ".msb", "sandbox.toml")
    if box.is_repo or "extra_rules" in box.entry or not os.path.isfile(sandbox_toml):
        target = os.path.join(REGISTRY_DIR, f"{box.name}.toml")
    else:
        target = sandbox_toml
    # Before writing: a change someone else made to the project's policy is
    # shown and asked about on its own, not approved along with this one.
    check_policy(box, "adding rules")
    added = append_toml_list(target, "extra_rules", fresh, after_key="rule_groups")
    approve_policy(Sandbox(box.name, config))
    for rule in added:
        note(f"allowed: {rule}")
    note(f"written to {tilde(target)}")
    if args.rebuild:
        cmd_rebuild(verb_args("rebuild", name=box.name), config)
    else:
        note(f"takes effect when the sandbox is created: `msbctl rebuild {box.name}`")


# ------------------------------------------------------- the observation log
#
# msb's own log is the only record of where a sandbox went, and it is a record
# of SUCCESSES: a denied connection is logged at no level at all (checked on
# 0.7.7 at --debug and --trace), which is the whole reason observe mode has to
# unblock before it can measure. Two line shapes carry a destination, both at
# DEBUG only:
#
#   …engine::tls::proxy: TLS intercept sni=github.com dst=140.82.113.3:443
#   …engine::dns::forwarder: DNS query family is inactive … domain=github.com
#
# The first is the useful one — an intercepted connection named by its SNI,
# which is the exact form a rule is written in. The second is a RESOLUTION, not
# a connection, and it is all there is for anything that is not HTTPS: a plain
# TCP connect (:80, :22, git over ssh, a database) is never logged. So a name
# seen only in DNS was looked up, probably connected to, and on a port this
# cannot name. The report labels the two differently rather than pretending the
# second is as good as the first.
OBSERVED_TLS = re.compile(r"TLS (?:intercept|bypass) sni=(\S+) dst=(\S+)")
OBSERVED_DNS = re.compile(r"\bdomain=([A-Za-z0-9*._-]+)")
LOG_STAMP = re.compile(r"^(\d{4}-\d\d-\d\d)T([\d:]{8})")


def runtime_logs(name):
    """The sandbox's runtime.log and any rotations of it, oldest first."""
    folder = os.path.join(MSB_HOME, "sandboxes", name, "logs")
    try:
        names = os.listdir(folder)
    except OSError:
        return []
    # runtime.log.2 is older than runtime.log.1, which is older than runtime.log.
    rotated = sorted((f for f in names if re.fullmatch(r"runtime\.log\.\d+", f)),
                     key=lambda f: int(f.rsplit(".", 1)[-1]), reverse=True)
    return [os.path.join(folder, f) for f in rotated + ["runtime.log"]
            if os.path.isfile(os.path.join(folder, f))]


def observed_hosts(name):
    """{(host, port): {hits, first, last}} — where this sandbox has been.

    port is "" for a name that only ever appeared in a DNS lookup; see the note
    above OBSERVED_TLS for why that is the best available off :443.
    """
    seen = {}

    def record(host, port, when):
        key = (host.lower().rstrip("."), port)
        entry = seen.setdefault(key, {"hits": 0, "first": when, "last": when})
        entry["hits"] += 1
        entry["last"] = when

    for path in runtime_logs(name):
        try:
            fh = open(path, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                stamp = LOG_STAMP.match(line)
                when = f"{stamp.group(1)} {stamp.group(2)}" if stamp else "?"
                tls = OBSERVED_TLS.search(line)
                if tls:
                    port = tls.group(2).rsplit(":", 1)[-1]
                    record(tls.group(1), port if port.isdigit() else "", when)
                elif "::dns::" in line:
                    dns = OBSERVED_DNS.search(line)
                    if dns:
                        record(dns.group(1), "", when)
    # A host reached over TLS also shows up in DNS. Keep the connection, which
    # names a port, and drop the bare lookup that says less about the same trip.
    with_port = {host for host, port in seen if port}
    return {(host, port): v for (host, port), v in seen.items()
            if port or host not in with_port}


SECRET_VIOLATION = re.compile(r"secret violation: placeholder detected")
LOG_FIELD = re.compile(r"\b(\w+)=(\S*)")


def secret_violations(name):
    """{(var, host, location): {hits, last}} — requests msb KILLED over a secret.

    Nothing else reports these. The guest sees its TLS connection drop and calls
    it ECONNRESET; the rule set is irrelevant and allowing the host does not
    help, because this is the secret policy and not the network one. See
    AGENT_TRANSCRIPT_HOSTS. Logged at WARN, so unlike the host record this is
    there in enforce mode too, at msb's default verbosity.
    """
    hits = {}
    for path in runtime_logs(name):
        try:
            fh = open(path, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                if not SECRET_VIOLATION.search(line):
                    continue
                field = dict(LOG_FIELD.findall(line))
                stamp = LOG_STAMP.match(line)
                key = (field.get("secret_env_var", "?"),
                       field.get("host") or field.get("sni", "?"),
                       field.get("location", "?"))
                entry = hits.setdefault(key, {"hits": 0, "last": "?"})
                entry["hits"] += 1
                if stamp:
                    entry["last"] = f"{stamp.group(1)} {stamp.group(2)}"
    return hits


def report_secret_violations(box):
    """The loud half of the observe report. Returns True if anything was found."""
    hits = secret_violations(box.name)
    if not hits:
        return False
    say(f"{RED}{BOLD}Requests BLOCKED by the secret policy{RESET}")
    note("These never reached the network, whatever the egress rules say. The")
    note("guest sees only a dropped connection — an agent reports it as")
    note("`API Error: Connection dropped (ECONNRESET)`.")
    note("")
    for (var, host, where), info in sorted(hits.items(), key=lambda kv: -kv[1]["hits"]):
        note(f"  {var} placeholder in the {where} of a request to {host}"
             f"   {info['hits']} time(s), last {info['last']}")
    note("")
    note("A placeholder is the harmless stand-in text the guest sees; the real")
    note("value never left the host. It gets into an agent's requests because the")
    note("agent read it once and its transcript is resent on every turn — which is")
    note("why a fresh session works and then degrades.")
    note(f"Fixed by `msbctl rebuild {box.name}`: msbctl now lets the placeholder")
    note("through to the agent's own endpoints and nothing else.")
    return True


def rule_allows(rules, host, port):
    """Whether `rules` already permit `host` on `port`, judged BY NAME.

    First-match-wins, so this walks the list in order and the first rule whose
    target names the host decides it. Only domain and suffix targets are
    considered: `public`, `private` and bare addresses cannot be matched against
    a name without resolving it, and a resolution done here and now on the host
    is not the one msb would do in the guest at connect time. Those rules are
    skipped, so the worst this can do is call something uncovered that msb would
    in fact permit — the safe direction for a hint whose output you then read
    before running it.
    """
    for rule in rules:
        action, _, target = rule.partition("@")
        action = action.split(":")[0]           # drop an :egress/:ingress direction
        spec = target.split(":")
        name = spec[0]
        if name.startswith("suffix="):
            name = "*." + name[len("suffix="):]
        if port and len(spec) >= 3 and spec[2] and spec[2] != port:
            continue                            # a rule about a different port
        if name.startswith("*."):
            bare = name[2:].lower()
            if host != bare and not host.endswith("." + bare):
                continue
        elif name.lower() != host:
            continue
        return action == "allow"
    return False


def cmd_observe(args, config):
    """Stop blocking a sandbox and record where it goes, or read that record back.

    The workflow this exists for, in order: `on`, use the sandbox normally for a
    while, `report` to see every host it reached, `msbctl allow` the ones that
    belong, `off`. Observe mode is the measuring step, not a destination.
    """
    box = Sandbox(args.name, config)
    if args.action in ("on", "off"):
        _observe_set(box, "observe" if args.action == "on" else "enforce", args, config)
    else:
        _observe_report(box)


def _observe_set(box, mode, args, config):
    if box.egress_mode == mode:
        note(f"{box.name} is already in {mode} mode")
        return
    if mode == "observe":
        warn(f"{box.name} will have UNRESTRICTED egress until you turn this back off.")
        note("Nothing is denied, and every host it reaches is written to its")
        note("runtime.log. Your secrets stay bound to their own hosts and are not")
        note("exposed by this — but anything the guest can read, it can now send")
        note("anywhere. DNS rebind protection comes off with the rest.")
        note(f"Collect, then: `msbctl observe {box.name}` to see what it used.")
        if not args.yes and not confirm("turn observation mode on"):
            return
    # The REGISTRY, never the project file, and not edit_target(): sandbox.toml
    # is committed, so writing "observe" there would hand everyone who clones
    # the project a sandbox with no egress filtering — the one setting that must
    # not travel. It is machine-local and temporary, like mounts and identity.
    target = registry_path(box)
    set_toml_key(target, "egress_mode", mode)
    note(f"{box.name}: egress_mode = {mode}   ({tilde(target)})")
    # Network settings are fixed when msb creates the sandbox, so this is inert
    # until it is built again — exactly like `allow` and `mount`.
    if args.rebuild:
        cmd_rebuild(verb_args("rebuild", name=box.name), config)
    else:
        note(f"takes effect when the sandbox is created: `msbctl rebuild {box.name}`")


def _observe_report(box):
    seen = observed_hosts(box.name)
    logs = runtime_logs(box.name)
    say(f"{box.name}  [egress: {box.egress_mode}]")
    if not logs:
        note(f"no runtime log under {tilde(os.path.join(MSB_HOME, 'sandboxes', box.name))}")
        note("the sandbox has never been created, or msb keeps its state elsewhere")
        return
    note(f"from {tilde(logs[-1])}" + (f" (+{len(logs) - 1} rotated)" if len(logs) > 1 else ""))
    if not box.observing:
        note(f"{DIM}this sandbox is enforcing, so only what its rules already allow"
             f" could appear here{RESET}")
    if not seen:
        note("nothing recorded yet — msb only writes these lines at --log-level debug,")
        note(f"which is what observe mode turns on: `msbctl observe {box.name} on`")
        # Still worth saying: these are logged at WARN, so they show up here
        # even when nothing else does, and they are the one failure that looks
        # exactly like a missing egress rule while being nothing of the kind.
        report_secret_violations(box)
        return

    rules = box.net_rules()
    rows = []
    for (host, port), info in seen.items():
        covered = rule_allows(rules, host, port)
        rows.append((host, port or "?", str(info["hits"]), info["last"], covered))
    # Uncovered first — that is the list you are here to read — then by traffic.
    rows.sort(key=lambda r: (r[4], -int(r[2]), r[0]))

    head = ("HOST", "PORT", "HITS", "LAST SEEN", "")
    widths = [max(len(str(r[i])) for r in [head] + rows) for i in range(4)]
    # strict=False: the last heading has no width, since nothing is padded after it.
    print(f"   {BOLD}" + "  ".join(h.ljust(w) for h, w in zip(head, widths, strict=False)) + RESET)
    for host, port, hits, last, covered in rows:
        cells = "  ".join(c.ljust(w) for c, w in zip((host, port, hits, last), widths, strict=True))
        mark = f"{DIM}allowed{RESET}" if covered else f"{RED}NOT ALLOWED{RESET}"
        print(f"   {cells}  {mark}")

    # Before the allowlist advice: a blocked secret is NOT fixed by allowing
    # anything, and a host can sit here marked "allowed" while every request to
    # it is being killed. That reads as a contradiction unless this says so.
    report_secret_violations(box)

    missing = [r[0] for r in rows if not r[4]]
    if any(r[1] == "?" for r in rows):
        note("")
        note(f"{DIM}? — seen only as a DNS lookup. msb logs no port for anything but"
             f" HTTPS,{RESET}")
        note(f"{DIM}    so the port is unknown; `msbctl allow` assumes 443.{RESET}")
    note("")
    if not missing:
        note("every host reached is already covered by this sandbox's rules.")
        if box.observing:
            note(f"nothing left to collect: `msbctl observe {box.name} off --rebuild`")
        return
    note(f"{len(missing)} host(s) not covered by the current rules. To allow them:")
    note(f"   msbctl allow {box.name} " + " ".join(dict.fromkeys(missing)))
    note("Read that list before running it — it is what the sandbox reached, which")
    note("is not the same as what it ought to reach.")
    if box.observing:
        note(f"Then: `msbctl observe {box.name} off --rebuild`")


# Guest paths the manager owns. A folder mounted over or inside one of these
# would shadow the Claude state, the profile or podman's storage. The project's
# own guest path is per sandbox, so callers add it (see parse_mount_spec()).
RESERVED_GUEST = ("/root/.claude", "/opt/msb-profile", "/var/lib/containers",
                  "/root/.ssh", "/tmp/ssh-agent.sock")
# Where the project cannot go: inside the system, or over a folder whose
# contents the image needs (mounting at /home would hide every home in it).
GUEST_SYSTEM = ("/bin", "/boot", "/dev", "/etc", "/lib", "/lib32", "/lib64",
                "/proc", "/run", "/sbin", "/sys", "/usr")
GUEST_SHADOWED = ("/", "/home", "/media", "/mnt", "/opt", "/root", "/srv", "/tmp", "/var")


def _overlaps(a, b):
    a, b = a.rstrip("/") or "/", b.rstrip("/") or "/"
    return a == b or a.startswith(b + "/") or b.startswith(a + "/")


def guest_path_problem(path):
    """Why `path` cannot be where the project is mounted in the guest, or None."""
    if not path.startswith("/"):
        return "not an absolute path"
    if ":" in path:
        return "it contains ':', which msb's mount syntax cannot carry"
    path = os.path.normpath(path)
    if path in GUEST_SHADOWED:
        return f"mounting over {path} would hide what the image keeps there"
    for system in GUEST_SYSTEM:
        if path == system or path.startswith(system + "/"):
            return f"it is inside {system}, a system folder"
    for reserved in RESERVED_GUEST + (CACHE_MOUNT,):
        if _overlaps(path, reserved):
            return f"it overlaps {reserved}, which msbctl manages"
    return None


def parse_mount_spec(spec, project_dest=GUEST_PROJECT):
    """`SRC[:DEST][:ro|rw]` -> (absolute host path, guest path, "ro"|"rw").
    DEST defaults to /mnt/<name>; the mode defaults to ro, because writing to a
    host folder from a sandbox should be something you asked for."""
    parts = spec.split(":")
    mode = "ro"
    if parts[-1] in ("ro", "rw"):
        mode = parts.pop()
    if not parts or not parts[0]:
        die(f"mount {spec!r}: expected SRC[:DEST][:ro|rw]")
    src = os.path.realpath(os.path.expanduser(parts[0]))
    dest = parts[1] if len(parts) > 1 else "/mnt/" + os.path.basename(src.rstrip("/"))
    if len(parts) > 2 or not dest.startswith("/"):
        die(f"mount {spec!r}: the guest path must be absolute — SRC:/guest/path[:ro|rw]")
    if _overlaps(dest, project_dest):
        die(f"mount {spec!r}: {dest} overlaps the project, which is mounted at {project_dest}")
    for reserved in RESERVED_GUEST:
        if _overlaps(dest, reserved):
            die(f"mount {spec!r}: {dest} overlaps {reserved}, which msbctl manages")
    return src, dest, mode


def parse_port_spec(spec):
    """A published port in msb's --port syntax, `[BIND:]HOST:GUEST[/tcp|/udp]`,
    or a bare `PORT` for the same number on both sides. IPv6 binds are
    bracketed: `[::1]:8080:80`. Returns (canonical spec, bind, host port, guest
    port, protocol), the spec in its shortest form; dies on what msb refuses."""
    raw = str(spec).strip()
    body, proto = raw, "tcp"
    for suffix in ("/tcp", "/udp"):
        if raw.endswith(suffix):
            body, proto = raw[:-len(suffix)], suffix[1:]
    bind = LOOPBACK_BIND
    if body.startswith("["):
        bind, sep, body = body[1:].partition("]:")
        if not sep:
            die(f"port {raw!r}: expected [ADDR]:HOST:GUEST for an IPv6 address")
    elif body.count(":") == 2:
        bind, body = body.split(":", 1)
    parts = body.split(":")
    if len(parts) == 1:
        parts *= 2
    if len(parts) != 2 or not all(p.isdigit() for p in parts):
        die(f"port {raw!r}: expected PORT, HOST:GUEST or BIND:HOST:GUEST, optionally /udp")
    host, guest = (int(p) for p in parts)
    if not all(1 <= n <= 65535 for n in (host, guest)):
        die(f"port {raw!r}: ports run from 1 to 65535")
    try:
        bind = str(ipaddress.ip_address(bind))
    except ValueError:
        die(f"port {raw!r}: {bind!r} is not an IP address to bind on")
    shown = f"[{bind}]" if ":" in bind else bind
    canonical = f"{host}:{guest}" if bind == LOOPBACK_BIND else f"{shown}:{host}:{guest}"
    return canonical + ("/udp" if proto == "udp" else ""), bind, host, guest, proto


def port_label(bind, host, guest, proto):
    """How a published port reads to a person: where to point the browser."""
    if bind == LOOPBACK_BIND:
        where = f"localhost:{host}"
    else:
        where = f"[{bind}]:{host}" if ":" in bind else f"{bind}:{host}"
    label = f"{where} -> {guest}" + ("/udp" if proto == "udp" else "")
    if ipaddress.ip_address(bind).is_unspecified:
        label += "   (every interface: reachable from your network)"
    return label


def port_conflict(name, bind, host, proto):
    """The other registered sandbox that already publishes this host port, or
    None. A wildcard bind collides with every address on the same port."""
    wild = ipaddress.ip_address(bind).is_unspecified
    for other in registered():
        if other == name:
            continue
        try:
            specs = read_toml(registry_path_for(other)).get("ports", [])
            claims = [parse_port_spec(s)[1:] for s in specs]
        except SystemExit:
            continue        # its own problem, reported when that sandbox starts
        for o_bind, o_host, _, o_proto in claims:
            if (o_host, o_proto) == (host, proto) and (
                    o_bind == bind or wild or ipaddress.ip_address(o_bind).is_unspecified):
                return other
    return None


def pick_guest_path(project, current):
    """Wizard: where the project appears inside the sandbox. Returns the value
    for `guest_path`: "host", "/work" or an absolute path. `project` is None
    when choosing the default for new sandboxes."""
    say("Project path inside the sandbox")
    note("The same path as on the host makes absolute paths in errors and agent")
    note("output open on the host as they are; /work keeps your folder layout and")
    note("username out of the sandbox. Claude Code keeps its sessions per path.")
    custom = current if current not in ("host", GUEST_PROJECT) else ""
    options = [f"same as on the host   {project or '(each project its own)'}",
               f"{GUEST_PROJECT}",
               "custom" + (f"                {custom}" if custom else "")]
    default = 0 if current == "host" else 1 if current == GUEST_PROJECT else 2
    while True:
        choice = choose_one("project path in the sandbox", options, default)
        if choice.startswith("same"):
            value, path = "host", project
        elif choice == GUEST_PROJECT:
            value = path = GUEST_PROJECT
        else:
            value = path = os.path.normpath(ask("path inside the sandbox", custom or "/"))
        problem = guest_path_problem(path) if path else None
        if not problem:
            return value
        warn(f"{path}: {problem}")


def pick_mounts(project_dest=GUEST_PROJECT):
    """Wizard: any number of extra host folders, each read-only or read-write.
    Returns spec strings for the registry entry."""
    say("Extra folders")
    note("Other host folders to mount into the sandbox (reference repos, data).")
    note(f"The project itself is already mounted at {project_dest}.")
    specs, taken = [], set()
    while confirm("add a folder?" if not specs else "add another?"):
        raw = ask("host path")
        if not raw:
            break
        src = os.path.realpath(os.path.expanduser(raw))
        if not os.path.isdir(src):
            warn(f"{tilde(src)} is not a directory")
            continue
        dest = ask("path inside the sandbox", "/mnt/" + os.path.basename(src.rstrip("/")))
        mode = "rw" if choose_one("access", [
            "read-only    the sandbox can read it, never change it",
            "read-write   writes land in the host folder, as you"], 0).startswith("read-write") else "ro"
        spec = f"{raw.rstrip('/') or '/'}:{dest}:{mode}"
        try:
            parse_mount_spec(spec, project_dest)
        except SystemExit as exc:
            warn(str(exc).replace("msbctl: ", "", 1))
            continue
        if dest in taken:
            warn(f"{dest} is already used by another folder")
            continue
        taken.add(dest)
        specs.append(spec)
        note(f"{tilde(src)} -> {dest} ({mode})")
    return specs


def pick_ports(name, taken=()):
    """Wizard: host ports that reach a server inside the sandbox. Returns spec
    strings for the registry entry; `taken` are the ones it already has."""
    say("Published ports")
    note("A port on this machine that reaches a server inside the sandbox, so a")
    note("browser here opens http://localhost:PORT. Bound to 127.0.0.1 only. The")
    note("server inside has to listen on 0.0.0.0 — localhost alone is not reached.")
    specs = []
    while confirm("publish a port?" if not specs else "another?"):
        raw = ask("port, or HOST:GUEST (8080, 3000:5173)")
        if not raw:
            break
        try:
            spec, bind, host, guest, proto = parse_port_spec(raw)
        except SystemExit as exc:
            warn(str(exc).replace("msbctl: ", "", 1))
            continue
        if spec in taken or spec in specs:
            warn(f"{spec} is already published")
            continue
        other = port_conflict(name, bind, host, proto)
        if other:
            warn(f"{other} publishes {host} too — only one of them can hold it at a time")
        specs.append(spec)
        note(port_label(bind, host, guest, proto))
    return specs


def format_list(key, items, example):
    """`key = [...]` for a TOML template, or a commented example when empty."""
    if not items:
        return example
    return f"{key} = [\n" + "".join(f"    {json.dumps(i)},\n" for i in items) + "]"


def cmd_mount(args, config):
    """Add an extra host folder to an existing sandbox's registry entry. Mounts
    are fixed at create time, so this records it; --rebuild applies it now."""
    box = Sandbox(args.name, config)
    spec = args.spec if args.spec.rstrip().endswith(("ro", "rw")) else args.spec + (":rw" if args.rw else ":ro")
    src, dest, mode = parse_mount_spec(spec, box.guest_project)
    if not os.path.isdir(src):
        die(f"{tilde(src)} is not a directory")
    entry_path = os.path.join(REGISTRY_DIR, f"{box.name}.toml")
    if not append_toml_list(entry_path, "mounts", [f"{src}:{dest}:{mode}"], after_key="autostart"):
        note("already mounted")
        return
    note(f"{tilde(src)} -> {dest} ({mode}) recorded in {tilde(entry_path)}")
    if args.rebuild:
        cmd_rebuild(verb_args("rebuild", name=box.name), config)
    else:
        note(f"takes effect when the sandbox is created: `msbctl rebuild {box.name}`")


def cmd_port(args, config):
    """List, add or remove a sandbox's published ports. They live in the
    registry entry only, and are fixed at create time like the mounts, so a
    change is recorded here; --rebuild applies it now."""
    box = Sandbox(args.name, config)
    ports = box.published_ports
    if not args.specs and not args.rm:
        if not ports:
            note(f"no published ports — `msbctl port {box.name} 8080` adds one")
        for _, *where in ports:
            note(port_label(*where))
        return
    current = [spec for spec, *_ in ports]
    drop = []
    for raw in args.rm:
        spec = parse_port_spec(raw)[0]
        if spec in current:
            drop.append(spec)
        else:
            warn(f"{spec} is not published")
    add = []
    for raw in args.specs:
        spec, bind, host, guest, proto = parse_port_spec(raw)
        if spec in current or spec in add:
            continue
        other = port_conflict(box.name, bind, host, proto)
        if other:
            warn(f"{other} publishes {host} too — only one of them can hold it at a time")
        add.append(spec)
        note(f"recorded  {port_label(bind, host, guest, proto)}")
    for spec in drop:
        note(f"removed   {spec}")
    new = [spec for spec in current if spec not in drop] + add
    if new == current:
        note("nothing to change")
        return
    set_toml_key(registry_path(box), "ports", new or None)
    if args.rebuild:
        cmd_rebuild(verb_args("rebuild", name=box.name), config)
    else:
        note(f"takes effect when the sandbox is created: `msbctl rebuild {box.name}`")
    if add:
        note("the server inside has to listen on 0.0.0.0, not localhost")


def secret_var(spec):
    """The environment variable name in an `ENV[:OPTIONS]@HOST` binding."""
    return spec.split("@", 1)[0].split(":", 1)[0]


def store_secret_value(name, var, value):
    """Set VAR=value in this sandbox's 0600 env file, keeping its other lines.
    Never echoed and never in argv."""
    os.makedirs(SECRETS_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(SECRETS_DIR, f"{name}.env")
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except FileNotFoundError:
        lines = [f"# {name}'s secrets. Never commit this file."]
    lines = [l for l in lines if not l.startswith(f"{var}=")] + [f"{var}={value}"]
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    return path


def read_secret_hidden(prompt):
    import getpass
    try:
        return getpass.getpass(f"   {prompt} (hidden, blank to skip): ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return ""


def choose_secret(config, taken=()):
    """Pick one secret: a shipped preset or a custom one. Returns
    (spec, preset_info_or_None) or None."""
    presets = config.get("secret_presets", {})
    rows = [(f"{k:<10} {p['env']} -> {', '.join(p['hosts'])}", k) for k, p in presets.items()
            if f"{p['env']}@{','.join(p['hosts'])}" not in taken]
    rows.append(("custom     your own variable and hosts", "custom"))
    label = choose_one("secret", [r for r, _ in rows], 0)
    key = dict(rows)[label]
    if key != "custom":
        p = presets[key]
        return f"{p['env']}@{','.join(p['hosts'])}", p
    var = ask("environment variable name (e.g. MY_API_TOKEN)").strip()
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", var):
        warn("not a valid variable name")
        return None
    if is_reserved_var(var):
        warn(f"{var} has a fixed binding and cannot be bound again "
             "(the GitHub and Claude tokens have their own settings)")
        return None
    hosts = ask("hosts it may be sent to (comma-separated, e.g. api.example.com)").replace(" ", "")
    if not hosts:
        warn("a secret needs at least one host")
        return None
    where = choose_one("where may it appear", [
        "headers      Authorization etc, including Basic auth (the default)",
        "also query   in URL query strings too",
        "also body    in request bodies too"], 0)
    opt = ":query" if where.startswith("also query") else ":body" if where.startswith("also body") else ""
    return f"{var}{opt}@{hosts}", None


def unreachable_secret_hosts(config, groups, specs, extra_rules=()):
    """Hosts a secret is bound to that no egress rule allows — the secret would be
    bound to somewhere the sandbox cannot connect. Returns [(var, host)]."""
    table = config.get("rules", {})
    rules = list(table.get("base", [])) + [r for g in groups for r in table.get(g, [])] + list(extra_rules)
    allowed = [r.split("@", 1)[1].split(":")[0] for r in rules if r.startswith("allow@") and "@" in r]

    def covered(host):
        return any(host == a or (a.startswith("*.") and host.endswith(a[1:])) for a in allowed)

    return [(secret_var(sp), h) for sp in specs for h in sp.split("@", 1)[1].split(",") if not covered(h)]


def pick_secrets(config, taken=()):
    """Wizard: any number of extra secrets. Returns [(spec, value or "")]."""
    say("Secrets")
    note("Tokens the sandbox can USE but never SEE: it gets a placeholder, and the")
    note("real value is substituted on the way out, only to the hosts you name.")
    note("Stored per sandbox in a 0600 file under ~/.config/msb/secrets/.")
    out = []
    while confirm("add a secret?" if not out else "add another?"):
        picked = choose_secret(config, [s for s, _ in out] + list(taken))
        if not picked:
            continue
        spec, preset = picked
        if preset:
            note(f"create it at {preset.get('help', '(see the provider)')}")
            if preset.get("usage"):
                note(f"use it:  {preset['usage']}")
        out.append((spec, read_secret_hidden(f"paste the {secret_var(spec)} value")))
        note(f"{secret_var(spec)} -> {spec.split('@', 1)[1]}")
    return out


SECRET_MAX_BYTES = 8 * 1024


def read_secret_input(prompt, from_stdin):
    """A secret value from stdin (one trailing newline dropped) or a hidden
    prompt. Dies on an empty value, whitespace inside one, or one over 8 KiB,
    and never says what it read."""
    if from_stdin:
        value = sys.stdin.read()
        value = value[:-1] if value.endswith("\n") else value
        value = value[:-1] if value.endswith("\r") else value
    else:
        value = read_secret_hidden(prompt)
    if not value:
        die("no value given — nothing was stored")
    if any(c.isspace() for c in value):
        die("the value has whitespace in it — nothing was stored")
    if len(value.encode()) > SECRET_MAX_BYTES:
        die(f"the value is over {SECRET_MAX_BYTES // 1024} KiB — nothing was stored")
    return value


def msb_bound_secrets(name):
    """The variables msb has a binding for in this sandbox, or None if it
    cannot say. A binding is made at create time, and only for a variable that
    had a value then (secret_env() skips the rest), so a value stored later
    may have nothing in msb to substitute it."""
    proc = subprocess.run(["msb", "inspect", name, "--format", "json"],
                          capture_output=True, text=True)
    try:
        network = json.loads(proc.stdout)["config"]["network"]
        return {item["env_var"] for item in (network.get("secrets") or {}).get("secrets", [])}
    except (ValueError, KeyError, TypeError, AttributeError):
        return None


def bind_secret_live(box, config, spec, restart):
    """After a value for `spec` was stored: make the existing sandbox use it.
    Already bound, a restart is all it takes (msb reads the value at start);
    not bound yet, `msb modify --secret` adds the binding, applied at the next
    start or, with `restart`, now."""
    state = state_of(box.name)
    if state == "absent":
        note("not created yet, so it is bound at first start")
        return
    box = Sandbox(box.name, config)
    _, env = box.secret_env()
    bound = msb_bound_secrets(box.name)
    if bound is not None and secret_var(spec) in bound:
        if restart and state == "running":
            run(["msb", "stop", box.name], check=False, quiet=True)
            ensure_running(box)
            note(f"{box.name} restarted with the new value")
        else:
            note(f"used from the next start of {box.name}"
                 + ("" if state != "running" else f" (`--restart`, or `msbctl stop {box.name}` and start)"))
        return
    if ":" in spec.split("@", 1)[0]:
        note(f"it uses a non-default location, which `msb modify` cannot set: `msbctl rebuild {box.name}`")
        return
    argv = ["msb", "modify", box.name, "--secret", with_transcript_passthrough(spec)]
    if state == "running":
        argv.append("--restart" if restart else "--next-start")
    run(argv, env=env)
    note(f"bound; {'applied now' if restart and state == 'running' else 'used from the next start'}")


def secret_set(box, config, args):
    """secret set <name> VAR [--stdin] [--restart]: store a value for a variable
    this sandbox ALREADY binds (GH_TOKEN, or one of its secret_binds). Storing
    a value is not a policy change; binding a new variable, or the same one to
    another host, is `secret add`, which is."""
    var = args.var or die("secret set needs the variable: `msbctl secret set <name> VAR`")
    specs = [x for x in box.secret_binds if secret_var(x) == var and not is_reserved_var(var)]
    if var != "GH_TOKEN" and not specs:
        if is_reserved_var(var):
            die(f"{var} is not stored per sandbox — a Claude token is `msbctl setup --claude-token NAME`")
        die(f"{box.name} does not bind {var} (`msbctl secret ls {box.name}`); binding a new "
            "variable is `msbctl secret add`")
    if var != "GH_TOKEN":
        # The binding says which host the value goes to, and it comes from the
        # project: an edit nobody approved must not be bound live by this.
        check_policy(box, f"binding {var}")
    # A folder sandbox that does not bind GitHub yet: turning that on is
    # `[secrets] github = true` in the project, a pinned key. Checked before
    # anything is read or stored.
    github_off = var == "GH_TOKEN" and not (
        box.is_repo or box.project_cfg.get("secrets", {}).get("github", bool(box.repo)))
    if github_off and restricted():
        die(f"{box.name} does not bind GH_TOKEN, and turning that on changes the project's "
            f"policy — on the host: `msbctl edit {box.name}` → GitHub token")
    value = read_secret_input(f"the {var} value", args.stdin)
    path = os.path.join(SECRETS_DIR, f"{box.name}.env")
    set_env_file_value(path, var, value)
    note(f"{var} stored in {tilde(path)} (0600)")
    if var != "GH_TOKEN":
        bind_secret_live(box, config, specs[0], args.restart)
        return
    if github_off:
        project = require_project_file(box)
        check_policy(box, "binding GitHub")
        set_toml_key(project, "github", True, table="secrets")
        approve_policy(Sandbox(box.name, config))
    bind_secret_live(box, config, GH_SPEC, args.restart)


def cmd_secret(args, config):
    """secret add|rm|ls|set <name> — extra credentials for an existing sandbox. New
    ones are registered with `msb modify`, so no rebuild is needed (a restart is)."""
    box = Sandbox(args.name, config)
    if (getattr(args, "stdin", False) or getattr(args, "restart", False)) and args.action != "set":
        die("--stdin and --restart are for `msbctl secret set`")
    if args.action == "set":
        secret_set(box, config, args)
        return
    sandbox_toml = os.path.join(box.project, ".msb", "sandbox.toml")
    target = (os.path.join(REGISTRY_DIR, f"{box.name}.toml")
              if box.is_repo or "secret_binds" in box.entry or not os.path.isfile(sandbox_toml)
              else sandbox_toml)
    if args.action == "ls":
        own = read_env_file(os.path.join(SECRETS_DIR, f"{box.name}.env"))
        for spec in box.secret_binds or ["(none)"]:
            have = "value stored" if secret_var(spec) in own else "NO VALUE"
            note(f"  {spec}   {DIM}{have}{RESET}" if spec != "(none)" else "  (none)")
        return
    if args.action == "rm":
        spec = next((x for x in box.secret_binds if secret_var(x) == args.var), None)
        if not spec:
            die(f"{box.name} has no secret {args.var!r} (`msbctl secret ls {box.name}`)")
        if box.is_repo and spec not in box.registry_binds:
            require_project_file(box)       # the repo's own binding: it says where to change it
        check_policy(box, "removing a secret")
        remove_from_toml_list(target, "secret_binds", spec)
        approve_policy(Sandbox(box.name, config))
        state = state_of(box.name)
        if state != "absent":
            _, secret_vars = box.secret_env()
            # msb applies a removal LIVE: the value stops being substituted at
            # once. The guest only keeps an inert placeholder variable until its
            # next restart, so there is nothing to confirm.
            run(["msb", "modify", box.name, "--secret-rm", args.var],
                env=secret_vars, check=False)
        note(f"{args.var} removed: it is no longer substituted (the guest keeps an inert "
             "placeholder until its next restart)")
        note(f"its value is still in {tilde(os.path.join(SECRETS_DIR, box.name + '.env'))} — "
             "delete the line if you want it gone")
        return
    picked = choose_secret(config, box.secret_binds)
    if not picked:
        return
    spec, preset = picked
    if is_reserved_var(secret_var(spec)):
        die(f"{secret_var(spec)} has a fixed binding and cannot be bound again")
    check_policy(box, "adding a secret")
    if preset:
        note(f"create it at {preset.get('help', '(see the provider)')}")
        if preset.get("usage"):
            note(f"use it:  {preset['usage']}")
    value = read_secret_hidden(f"paste the {secret_var(spec)} value")
    if not value:
        note("skipped")
        return
    store_secret_value(box.name, secret_var(spec), value)
    append_toml_list(target, "secret_binds", [spec], after_key="extra_rules")
    approve_policy(Sandbox(box.name, config))
    note(f"recorded in {tilde(target)}")
    if state_of(box.name) == "absent":
        return
    if ":" in spec.split("@", 1)[0]:
        note(f"it uses a non-default location, which `msb modify` cannot set: `msbctl rebuild {box.name}`")
        return
    if confirm(f"apply now — this restarts {box.name}?"):
        # Re-read the sandbox so every binding, including the one just added,
        # contributes its variable: modify validates them all.
        _, secret_vars = Sandbox(box.name, config).secret_env()
        run(["msb", "modify", box.name, "--secret", spec, "--restart"], env=secret_vars)


def remove_from_toml_list(path, key, item):
    """Remove one item from a top-level list in a TOML file, in place."""
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    current = [i for i in tomllib.loads(text).get(key, []) if i != item]
    lines, out, at, i = text.splitlines(), [], None, 0
    while i < len(lines):
        if re.match(rf"^\s*{re.escape(key)}\s*=", lines[i]):
            at = len(out)
            while i < len(lines) and "]" not in lines[i].split("#")[0]:
                i += 1
            i += 1
            continue
        out.append(lines[i])
        i += 1
    if at is not None:
        out[at:at] = ([f"{key} = ["] + [f"    {json.dumps(x)}," for x in current] + ["]"]) if current else [f"{key} = []"]
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")


def cmd_cache(args, config):
    """cache <name> [ls | clear [key]] — the package-cache disks."""
    box = Sandbox(args.name, config)
    if not box.caches:
        note(f"{box.name} has no package caches")
        return
    vols = msb_volumes()
    if args.action == "clear":
        keys = [args.key] if args.key else list(box.caches)
        for key in keys:
            if key not in box.caches:
                die(f"{box.name} has no {key!r} cache (it has: {', '.join(box.caches)})")
        state = state_of(box.name)
        for key in keys:
            vol = box.cache_volume(key)
            if state == "running":
                # Attached, so msb will not remove it: empty it from inside. The
                # size stays what it was created with.
                run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c",
                     f"find {CACHE_MOUNT}/{key} -mindepth 1 -delete"], check=False, quiet=True)
                note(f"{key}: emptied")
            elif vol in vols:
                run(["msb", "volume", "rm", vol], check=False, quiet=True)
                note(f"{key}: removed — recreated at {box.caches[key]} on the next create")
            else:
                note(f"{key}: nothing to clear yet")
        return
    for key, size in box.caches.items():
        v = vols.get(box.cache_volume(key))
        if v:
            note(f"  {key:<8} {human_size(v['used_bytes']):>8} of {human_size(v['capacity_bytes']):<7} {CACHES[key]}")
        else:
            note(f"  {key:<8} not created yet ({size})")


# ----------------------------------------------------------------------- setup
#
# `msbctl setup`: the MACHINE-level config as a menu of sections, like `edit` is for
# one sandbox. The first time msbctl runs it walks the same sections in order
# (`--welcome`). Everything lands in ~/.config/msb/config.toml (your overrides over
# defaults.toml) or secrets/global.env; both are tracked here by section so nothing
# needs hand-editing unless you want to.

WELCOME_MARKER = os.path.join(STATE_DIR, "welcome-done")
GLOBAL_ENV = os.path.join(SECRETS_DIR, "global.env")
NAME_SLUG = re.compile(r"[a-z][a-z0-9-]*")

# Claude tokens are named, so one machine can hold several accounts (work,
# personal) and each sandbox picks one. They live in secrets/global.env, one
# variable each. The token called "main" is the plain CLAUDE_CODE_OAUTH_TOKEN,
# so the single token stored before names existed is simply "main" and keeps
# working. Whichever one a sandbox uses, the guest always sees the same
# CLAUDE_CODE_OAUTH_TOKEN placeholder: only the host-side value differs.
CLAUDE_TOKEN_VAR = "CLAUDE_CODE_OAUTH_TOKEN"   # noqa: S105  a variable name
CLAUDE_TOKEN_MAIN = "main"                      # noqa: S105  a token's name
# No hyphen: the name is upper-cased into a variable name and has to come back.
CLAUDE_TOKEN_NAME = re.compile(r"[a-z][a-z0-9_]*")


def claude_token_var(name):
    return CLAUDE_TOKEN_VAR if name == CLAUDE_TOKEN_MAIN else f"{CLAUDE_TOKEN_VAR}_{name.upper()}"


def claude_tokens(env=None):
    """{name: value} for every Claude token in secrets/global.env."""
    env = read_env_file(GLOBAL_ENV) if env is None else env
    tokens = {}
    for var, value in env.items():
        if not value:
            continue
        if var == CLAUDE_TOKEN_VAR:
            tokens[CLAUDE_TOKEN_MAIN] = value
        elif var.startswith(CLAUDE_TOKEN_VAR + "_"):
            name = var[len(CLAUDE_TOKEN_VAR) + 1:].lower()
            if CLAUDE_TOKEN_NAME.fullmatch(name):
                tokens[name] = value
    return dict(sorted(tokens.items()))


def default_claude_token(config):
    return config.get("defaults", {}).get("claude_token") or CLAUDE_TOKEN_MAIN


def ensure_local_config():
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    os.makedirs(SECRETS_DIR, mode=0o700, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        shutil.copy(os.path.join(TEMPLATES, "config.toml.in"), CONFIG_FILE)


def set_env_file_value(path, var, value):
    """Set VAR=value in a 0600 env file (None removes it), keeping the other lines
    and the comments that document it. Never echoed, never in argv."""
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except FileNotFoundError:
        lines = ["# Shared by every sandbox. 0600. NEVER commit this file."]
    lines = [l for l in lines if not re.match(rf"^\s*{re.escape(var)}=", l)]
    if value:
        lines.append(f"{var}={value}")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


def mark_welcomed():
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(WELCOME_MARKER, "w", encoding="utf-8") as fh:
        fh.write(dt.date.today().isoformat() + "\n")


def needs_welcome(config):
    """First run = never welcomed AND nothing configured yet. A machine that already
    has identities, a token or sandboxes is marked done without a word."""
    if os.path.exists(WELCOME_MARKER):
        return False
    configured = (bool(config.get("identities"))
                  or bool(claude_tokens())
                  or bool(registered()))
    if configured:
        mark_welcomed()
        return False
    return True


def maybe_welcome(config):
    """Offer the first-run setup, once, on an interactive terminal. Returns the
    (possibly reloaded) config."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()) or not needs_welcome(config):
        return config
    choice = choose_one("welcome to msbctl — first run", [
        "set up now        a few minutes: identities, Claude login, your network",
        "later             ask again next time",
        "no thanks         never ask again (`msbctl setup` still works)"], 0)
    if choice.startswith("set up"):
        cmd_setup(verb_args("setup", welcome=True), config)
        return load_config()
    if choice.startswith("no thanks"):
        mark_welcomed()
    return config


# -- identities

def _summary_identities(config):
    ids = sorted(config.get("identities", {}))
    default = config.get("defaults", {}).get("identity", "")
    return (", ".join(ids) + (f"  (default {default})" if default else "")) if ids else "none"


def pick_signing_key(current_pub):
    """Choose the ssh key an identity signs commits with, or none. Returns the
    public key line to store (git needs the key itself, not a fingerprint), or
    None. Same dialog as `msbctl keys`; the key still has to be one a sandbox is
    allowed to use, which `msbctl keys` and `msbctl add` take care of."""
    cur = _parse_pub_line(current_pub)[0] if current_pub and _parse_pub_line(current_pub) else None
    note("Sign commits with an ssh key? Tick one key to sign every commit made as this")
    note("identity (git's ssh signing; the key stays in your host agent), or none.")
    chosen = pick_ssh_keys([cur] if cur else [], preselect_all=False, signing=cur, single=True)
    if not chosen:
        return None
    pub = public_line(chosen[0][0])
    if not pub:
        warn("could not read that key's public half — no signing key saved")
        return None
    return pub


def section_identities(config, ctx):
    while True:
        config = load_config()
        local = read_toml(CONFIG_FILE).get("identities", {})
        say("Git identities")
        note("The name and email a sandbox commits as when its repo has none of its own")
        note("(a microVM has no host-global git config). Prefer the GitHub noreply form")
        note("for anything that can reach a public repo: https://github.com/settings/emails")
        for key in sorted(local):
            note(f"  {key:<12} {local[key].get('name', '?')} <{local[key].get('email', '?')}>"
                 + ("  (signs commits)" if local[key].get("signing_key") else ""))
        action = choose_one("identities", ["add or change one", "remove one",
                                           "which is the default for new sandboxes", "back"], 0)
        if action.startswith("add"):
            key = ask("short name for it (e.g. personal, work)").strip().lower()
            if not NAME_SLUG.fullmatch(key):
                warn("lowercase letters, digits and dashes, starting with a letter")
                continue
            cur = local.get(key, {})
            name = ask("your name", cur.get("name", ""))
            email = ask("email", cur.get("email", ""))
            if not name or "@" not in email:
                warn("needs a name and an email address — nothing saved")
                continue
            table = f"identities.{key}"
            signing = pick_signing_key(cur.get("signing_key"))
            set_toml_key(CONFIG_FILE, "name", name, table=table)
            set_toml_key(CONFIG_FILE, "email", email, table=table)
            set_toml_key(CONFIG_FILE, "signing_key", signing, table=table)
            note(f"saved {key}")
            if len(local) == 0 and not config.get("defaults", {}).get("identity"):
                set_toml_key(CONFIG_FILE, "identity", key, table="defaults")
                note(f"{key} is now the default for new sandboxes")
        elif action.startswith("remove"):
            if not local:
                note("none to remove")
                continue
            key = choose_one("remove which", sorted(local) + ["cancel"], 0)
            if key != "cancel":
                remove_toml_table(CONFIG_FILE, f"identities.{key}")
                if config.get("defaults", {}).get("identity") == key:
