def tilde(path):
    return path.replace(HOME, "~", 1) if path.startswith(HOME) else path


# ----------------------------------------------------------------------- toml

def read_toml(path):
    """Parse a TOML file. A missing file is an empty table, not an error."""
    try:
        with open(path, "rb") as fh:
            return tomllib.load(fh)
    except FileNotFoundError:
        return {}
    except tomllib.TOMLDecodeError as exc:
        die(f"{path}: {exc}")


def render(template_name, **values):
    """Fill {{KEY}} placeholders. Deliberately not a template engine."""
    with open(os.path.join(TEMPLATES, template_name), encoding="utf-8") as fh:
        text = fh.read()
    for key, value in values.items():
        text = text.replace("{{%s}}" % key, str(value))
    left = re.findall(r"\{\{(\w+)\}\}", text)
    if left:
        die(f"{template_name}: unfilled placeholders: {', '.join(sorted(set(left)))}")
    return text


# ---------------------------------------------------------------------- shell

def run(argv, env=None, check=True, capture=False, quiet=False, to_stderr=False):
    """Run a command. `env` is merged over os.environ, never replaces it.

    stdin is always /dev/null: `msb exec` forwards it into the guest, so the
    housekeeping execs ensure_running() does before `msbctl exec` hands over
    would otherwise eat the input piped to it (`echo x | msbctl exec . -- cat`
    printed nothing). `to_stderr` sends its stdout there instead, for steps
    that must not write into the stdout `msbctl exec` hands to its command."""
    merged = dict(os.environ)
    if env:
        merged.update(env)
    if capture:
        proc = subprocess.run(argv, env=merged, capture_output=True, text=True,
                              stdin=subprocess.DEVNULL)
    else:
        out = subprocess.DEVNULL if quiet else None
        proc = subprocess.run(argv, env=merged, stdin=subprocess.DEVNULL,
                              stdout=sys.stderr if to_stderr and not quiet else out,
                              stderr=out)
    if check and proc.returncode != 0:
        detail = (proc.stderr or "").strip() if capture else ""
        die(f"{argv[0]} failed ({proc.returncode}): {' '.join(argv[1:3])} {detail}")
    return proc


def git(project, *args):
    proc = subprocess.run(["git", "-C", project, *args],
                          capture_output=True, text=True)
    return proc.stdout.strip() if proc.returncode == 0 else ""


# ------------------------------------------------------------------- msb state

def msb_table():
    """`msb ls` as {name: state}.

    Text parsing because 0.7.6 has no machine-readable listing. Kept in ONE
    place so that a format change is one fix rather than a hunt: column 1 is
    the name, column 3 the state.
    """
    proc = subprocess.run(["msb", "ls"], capture_output=True, text=True)
    table = {}
    if proc.returncode != 0:
        return table
    for line in proc.stdout.splitlines()[1:]:
        cols = line.split()
        if len(cols) >= 3:
            table[cols[0]] = cols[2]
    return table


def state_of(name, table=None):
    table = msb_table() if table is None else table
    return table.get(name, "absent")


# --------------------------------------------------------------------- secrets

def read_env_file(path):
    """Parse KEY=VALUE. Warns if the mode is not 600 — these hold tokens."""
    if not os.path.isfile(path):
        return {}
    mode = os.stat(path).st_mode & 0o777
    if mode != 0o600:
        warn(f"{tilde(path)} is mode {mode:04o}, expected 0600")
    values = {}
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            values[key.strip()] = value.strip().strip('"').strip("'")
    return values


# ---------------------------------------------------------------------- config

class Sandbox:
    """One registered sandbox, with its three config layers already resolved.

    Precedence, lowest first: config.toml [defaults] → <project>/.msb/sandbox.toml
    → the registry entry. The registry wins because it is the machine-local
    layer and the only one that can know about this particular checkout.
    """

    def __init__(self, name, config):
        self.name = name
        self.config = config
        self.entry = read_toml(os.path.join(REGISTRY_DIR, f"{name}.toml"))
        if not self.entry:
            die(f"no sandbox named {name!r} — `msbctl ls` to see what exists")
        if "project" not in self.entry:
            die(f"{name}.toml has no `project` key — it was hand-edited into an "
                "unusable state, or written by an older msbctl")

        self.project = os.path.realpath(os.path.expanduser(self.entry["project"]))
        self.repo = self.entry.get("repo", "")
        self.autostart = bool(self.entry.get("autostart", False))
        self.project_cfg = read_toml(os.path.join(self.project, ".msb", "sandbox.toml"))

        defaults = config.get("defaults", {})
        self.conf = self._pick("conf", ".msb/dev.yaml")
        self.cpus = self._pick("cpus", defaults.get("cpus", 4))
        self.memory = self._pick("memory", defaults.get("memory", "8G"))
        self.root_disk = self._pick("root_disk", defaults.get("root_disk", "16G"))
        # Size of a dedicated disk for /var/lib/containers, or empty for none.
        self.secret_binds = self._pick("secret_binds", [])
        # {feature: size} for per-package-manager cache disks. See CACHES.
        self.caches = self._pick("caches", {})
        self.containers_disk = self._pick("containers_disk",
                                          defaults.get("containers_disk", ""))
        self.claude_auth = defaults.get("claude_auth", "secret")
        # Registry only: token names exist on this machine, not in the project.
        self.claude_token_pinned = self.entry.get("claude_token", "")
        self.claude_token = self.claude_token_pinned or default_claude_token(config)
        self.identity_name = self._pick("identity", defaults.get("identity"))

        self.conf_path = os.path.join(self.project, self.conf)
        # Disk volumes are named after the sandbox, but msb cannot rename a
        # volume, so a renamed sandbox keeps its old prefix here (`volumes` in
        # the registry entry) rather than losing its caches and images.
        self.volume_prefix = self.entry.get("volumes") or name
        self.state = os.path.join(STATE_DIR, "claude", name)
        self.agent_sock = os.path.join(AGENT_DIR, f"{name}.sock")

    def wants_component(self, comp):
        """Whether this sandbox is set up to have `comp`. Used to keep bun, gitleaks and a
        claude that was switched off, out of the version display and the probes."""
        boot = self.project_cfg.get("bootstrap", {})
        if comp == "bun":
            return bool(boot.get("bun"))
        if comp == "gitleaks":
            return bool(boot.get("gitleaks"))
        if comp == "claude":
            return boot.get("claude") is not False
        return True

    def cache_volume(self, key):
        return f"{self.volume_prefix}-cache-{key}"

    @property
    def containers_volume(self):
        return f"{self.volume_prefix}-containers"

    def owned_volumes(self, vols=None):
        """Names of the existing disk volumes that belong to this sandbox."""
        return [n for n in (msb_volumes() if vols is None else vols)
                if n.startswith(f"{self.volume_prefix}-cache-") or n == self.containers_volume]

    def named_disk_flags(self, volume, dest, size):
        """`--mount-named` for a disk volume that OUTLIVES the sandbox, so a rebuild
        keeps what is on it. The volume is created by the first mount. Its size is
        fixed at that moment and msb refuses a create that asks for a different
        one, so an existing volume's own capacity wins over the config."""
        have = msb_volumes().get(volume)
        if have and have.get("kind") == "disk" and have["capacity_bytes"] != size_bytes(size):
            warn(f"{volume} already exists at {human_size(have['capacity_bytes'])} but the config "
                 f"says {size} — keeping it as is (`msbctl cache {self.name} clear` to recreate)")
            size = f"{have['capacity_bytes'] // MIB}M"
        return ["--mount-named", f"{volume}:{dest}:kind=disk,size={size}"]

    @property
    def cache_links(self):
        """[(where the volume is mounted, where the tool looks)]."""
        return [(f"{CACHE_MOUNT}/{key}", CACHES[key]) for key in self.caches if key in CACHES]

    @property
    def extra_mounts(self):
        """[(host path, guest path, "ro"|"rw")] from the registry entry. Host
        paths are machine-local, so these live there and never in a repo."""
        return [parse_mount_spec(spec, self.guest_project)
                for spec in self.entry.get("mounts", [])]

    @property
    def published_ports(self):
        """[(spec, bind, host port, guest port, protocol)] from the registry
        entry. Machine-local like the mounts: a host port is this machine's to
        hand out, and a committed one would collide with whatever else a
        cloner runs on it."""
        return [parse_port_spec(spec) for spec in self.entry.get("ports", [])]

    @property
    def guest_path_setting(self):
        """`guest_path` as written: the entry's, else config.toml's [defaults]."""
        return self.entry.get("guest_path", self.config.get("defaults", {})
                              .get("guest_path", GUEST_PROJECT))

    @property
    def guest_project(self):
        """Where the project is mounted inside the guest.

        "host" means the host's own path, so absolute paths in compiler errors,
        stack traces and an agent's output (an ACP client opening the files it
        names) are valid on both sides. /work keeps the host's layout, your
        username included, out of the guest. Machine-local on purpose: a host
        path in the committed sandbox.toml would be one person's home folder.
        Create-time, like every mount, and Claude Code keys its sessions and
        memory by this path, so they do not follow a change.
        """
        raw = self.guest_path_setting
        path = self.project if raw == "host" else raw
        problem = guest_path_problem(path)
        if problem:
            die(f"{self.name}: guest_path {raw!r}: {problem} — fix it in "
                f"{tilde(registry_path(self))}")
        return os.path.normpath(path)

    @property
    def ssh_keys(self):
        """Fingerprints this sandbox may use, or None for every key.

        Absent in the registry entry means unrestricted, which is what entries
        written before this existed get. An empty list means none.
        """
        raw = self.entry.get("ssh_keys")
        if raw is None:
            return None
        return [str(item).split()[0] for item in raw if str(item).split()]

    def _pick(self, key, fallback):
        if key in self.entry:
            return self.entry[key]
        if key in self.project_cfg:
            return self.project_cfg[key]
        return fallback

    # ------------------------------------------------------------- the image

    @property
    def image(self):
        """Resolved from the registry entry, else from the --conf file.

        Extracted from the YAML with an anchored regex rather than parsed. The
        alternative is a PyYAML dependency for one scalar, and the alternative
        to THAT is duplicating the digest into sandbox.toml, where it would
        drift from the file msb actually reads. `image:` is one line in
        a file this tool generates, and a non-match is an error rather than a
        guess.
        """
        if "image" in self.entry:
            return self.entry["image"]
        if not os.path.isfile(self.conf_path):
            die(f"{tilde(self.conf_path)} does not exist — `msbctl add` writes it")
        with open(self.conf_path, encoding="utf-8") as fh:
            for line in fh:
                match = re.match(r"^image:\s*(\S+)\s*$", line)
                if match:
                    return match.group(1)
        die(f"no `image:` line in {tilde(self.conf_path)}")

    # -------------------------------------------------------------- the rules

    @property
    def rule_groups(self):
        groups = self._pick("rule_groups",
                            self.config.get("defaults", {}).get("rule_groups", []))
        return [g for g in groups if g != "base"]

    @property
    def egress_mode(self):
        """"enforce" (deny-by-default, the point of this tool) or "observe".

        OBSERVE IS A DELIBERATE, TEMPORARY DOWNGRADE, not a softer policy. It
        exists because msb cannot report a denial: it logs what it ALLOWS and
        says nothing at all about what it blocks, at any log level (re-verified
        on 0.7.7 at --debug and --trace). So there is no "warn but permit" to
        emit, and the only way to learn what a sandbox actually needs is to let
        it through and write down where it went.

        What that costs while it is on: egress is unrestricted, so a sandbox can
        reach anywhere and anything in it could exfiltrate. Secrets are NOT
        exposed by this — substitution stays host-side and bound to its named
        hosts — but everything the guest can read, it can now send. Turn it on
        to collect, run `msbctl observe <name>` to see what was reached, feed
        that to `msbctl allow`, and turn it off again.

        Create-time, like every other network setting: changing it needs a
        rebuild, not a restart.
        """
        mode = self._pick("egress_mode",
                          self.config.get("defaults", {}).get("egress_mode", "enforce"))
        if mode not in EGRESS_MODES:
            die(f"{self.name}: egress_mode is {mode!r}, expected one of "
                f"{', '.join(EGRESS_MODES)}")
        return mode

    @property
    def observing(self):
        return self.egress_mode == "observe"

    @property
    def extra_rules(self):
        return self._pick("extra_rules", [])

    @property
    def allow_private_dns(self):
        """Emit --no-dns-rebind-protection.

        msb drops DNS answers that resolve to RFC1918 addresses. That is right
        by default and wrong for a homelab that publishes private addresses in
        PUBLIC DNS: a name like `git.example.com` can be a real public record
        pointing at 192.168.x.x, so the answer is discarded and the name comes
        back NXDOMAIN inside the guest — indistinguishable from a missing
        egress rule.

        Opt-in per project rather than always on. What it costs is narrow but
        real: a hostname rule on a port other than :443 is enforced as "the
        addresses this name resolved to", so an attacker who can shape DNS
        answers could repoint such a rule at an internal address. On :443 the
        interceptor matches the SNI and this does not apply. Deny-by-default
        still holds either way — it only widens what a *name* can resolve to,
        never what is reachable without a rule.
        """
        return bool(self._pick("allow_private_dns", False))

    def image_or_none(self):
        """image, but None instead of dying when the conf file is missing.

        For display. A registration whose project moved or whose dev.yaml was
        deleted must still appear in the sidebar — showing it as broken is the
        point, and killing the render of every other sandbox is not.
        """
        try:
            return self.image
        except SystemExit:
            return None

    def net_rules(self):
        """base first, then each named group in order, then the project's own.

        Order is the whole point: rules are first-match-wins, so the `base`
        group's `deny@...:tcp:80` has to precede anything that might allow a
        plaintext host. Emitting base unconditionally and first means no
        sandbox can reorder its way past it.
        """
        table = self.config.get("rules", {})
        sources = [("base", table.get("base", []))]
        for group in self.rule_groups:
            if group not in table:
                die(f"{self.name}: unknown rule group {group!r}. "
                    f"Known: {', '.join(sorted(table))}")
            sources.append((group, table[group]))
        sources.append((None, self.extra_rules))
        rules = []
        for group, items in sources:
            for rule in items:
                problem = rule_problem(rule)
                if problem:
                    where = (f"rule group `{group}` (`msbctl config` shows which file)" if group
                             else f"extra_rules in {tilde(self._origin('extra_rules'))}")
                    die(f"{self.name}: {rule!r} in {where}: {problem}")
            rules.extend(items)
        return rules

    def _origin(self, key):
        """The file a `_pick` key came from: the registry entry, else sandbox.toml."""
        if key in self.entry:
            return os.path.join(REGISTRY_DIR, f"{self.name}.toml")
        return os.path.join(self.project, ".msb", "sandbox.toml")

    # ------------------------------------------------------------ the secrets

    def secret_env(self):
        """(flags, env) — the env NEVER reaches argv.

        `--secret ENV@HOST` stores only a reference to a host environment
        variable; the value is read at START time, not once at create. So this
        has to be assembled before every start, including the implicit one that
        `shell` does on a stopped sandbox. Relying on whichever terminal
        happens to have a token exported produces a sandbox whose secret
        resolves to nothing, which then fails at the point of use rather than
        at launch.
        """
        flags, env = [], {}
        wants_github = self.project_cfg.get("secrets", {}).get("github", bool(self.repo))

        if self.claude_auth == "secret":
            token = claude_tokens().get(self.claude_token)
            if token:
                env[CLAUDE_TOKEN_VAR] = token
                # Both hosts: Claude Code talks to api.anthropic.com for
                # inference and to platform.claude.com on startup. Binding only
                # the first sends the literal placeholder to the second, which
                # fails as "not logged in" rather than as anything naming the
                # cause. Both are Anthropic's own endpoints and the token is
                # minted by `claude setup-token` against them, so this widens
                # nothing: it is the same credential reaching the same party.
                # Its own hosts are also its passthrough hosts, which is not a
                # contradiction: the real token goes in the headers, and the
                # placeholder is allowed to appear in the BODY — which is where
                # it lands as soon as the agent reads it back out of its own
                # environment and it becomes part of the transcript.
                flags += ["--secret", with_transcript_passthrough(CLAUDE_SPEC)]
            elif claude_tokens():
                warn(f"{self.name}: no Claude token named {self.claude_token!r} — Claude Code "
                     "will not be logged in. Add it with `msbctl setup` → Claude login, or "
                     f"pick another with `msbctl edit {self.name}` → Claude token.")
            else:
                warn("no Claude token stored — Claude Code will not be logged in. "
                     "`msbctl setup` → Claude login.")

        if wants_github:
            token = read_env_file(os.path.join(SECRETS_DIR, f"{self.name}.env")) \
                .get("GH_TOKEN")
            if token:
                env["GH_TOKEN"] = token
                flags += ["--secret", with_transcript_passthrough(
                    "GH_TOKEN@github.com,api.github.com")]
            else:
                note(f"no GH_TOKEN for {self.name} — the GitHub API is unavailable "
                     "in this sandbox (git push over SSH still works)")

        # Extra bindings, in msb's own `ENV[:OPTIONS]@HOST[,HOST]` syntax so a
        # hand-written one works too. The value comes from this sandbox's env
        # file, else the shared one, and — like the others — only ever travels
        # in the environment of the msb process.
        own = read_env_file(os.path.join(SECRETS_DIR, f"{self.name}.env"))
        shared = read_env_file(os.path.join(SECRETS_DIR, "global.env"))
        for spec in self.secret_binds:
            var = secret_var(spec)
            value = own.get(var) or shared.get(var)
            if value:
                env[var] = value
                flags += ["--secret", with_transcript_passthrough(spec)]
            else:
                note(f"no {var} for {self.name} — `msbctl secret add {self.name}` "
                     "(skipped for now)")

        if flags:
            # Substitution happens in request HEADERS only. A placeholder sent
            # in a URL or a body is refused, and without this flag that refusal
            # arrives as an ordinary connection error with nothing naming the
            # cause. block-and-log keeps the block and makes it diagnosable —
            # it is the ONLY record there is, since the guest just sees its
            # connection drop. See AGENT_TRANSCRIPT_HOSTS for the refusal this
            # hits in practice, and why every binding above opts out of it for
            # the agent's own endpoints.
            flags += ["--secret-violation-action", "block-and-log"]
        return flags, env

    # ------------------------------------------------------------- the mounts

    def mount_flags(self):
        uid, gid = os.getuid(), os.getgid()
        flags = [
            # uid/gid presentation is what makes guest writes land as you on
            # the host. Without it you get files you cannot rm without help.
            "--mount-dir", f"{self.project}:{self.guest_project}:uid={uid},gid={gid}",
        ]

        for src, dest, mode in self.extra_mounts:
            if not os.path.isdir(src):
                die(f"{self.name}: extra folder {tilde(src)} does not exist — "
                    f"fix `mounts` in {tilde(os.path.join(REGISTRY_DIR, self.name + '.toml'))}")
            # Read-only is `ro`. Read-write gets the same uid/gid presentation as
            # the project, so what the guest writes is yours on the host.
            flags += ["--mount-dir", f"{src}:{dest}:" + ("ro" if mode == "ro"
                                                         else f"uid={uid},gid={gid}")]

        if self.claude_auth == "secret":
            os.makedirs(self.state, mode=0o700, exist_ok=True)
            flags += ["--mount-dir", f"{self.state}:/root/.claude:uid={uid},gid={gid}"]
            if assemble_profile():
                flags += ["--mount-dir", f"{PROFILE_DIR}:{GUEST_PROFILE}:ro"]
            else:
                warn("there is no CLAUDE.md text to give the sandbox "
                     f"({tilde(PROFILE_SHIPPED)} is missing) — it will not be seeded")
        else:
            # Fallback for when spike 07 fails. Shares the host's real Claude
            # credentials and every project's transcripts with every sandbox.
            flags += ["-v", f"{HOME}/.claude:/root/.claude"]
            flags += ["--mount-file", f"{HOME}/.claude.json:/root/.claude.json"]

        # Disk volumes that outlive the sandbox: the package caches, and podman's
        # image storage. A real block device under podman matters too — the root is
        # an overlayfs and the kernel refuses overlay-on-overlay, which would leave
        # podman on vfs (slow, 3x the disk). Create-time only, like every mount.
        for key, size in self.caches.items():
            if key not in CACHES:
                die(f"{self.name}: unknown cache {key!r}. Known: {', '.join(CACHES)}")
            flags += self.named_disk_flags(self.cache_volume(key), f"{CACHE_MOUNT}/{key}", size)
        if self.containers_disk:
            # A named volume, not --mount-owned: an owned disk is deleted with its
            # sandbox, and pulled images are exactly what a rebuild should keep.
            flags += self.named_disk_flags(self.containers_volume, "/var/lib/containers",
                                           self.containers_disk)

        # READ-ONLY, deliberately rather than incidentally: the sandbox can
        # verify hosts you already trust and cannot silently add a new one, so
        # host-key decisions stay on the host. Without the file at all, the
        # first ssh prompts — which fails outright under `exec`.
        known = os.path.join(HOME, ".ssh", "known_hosts")
        if os.path.isfile(known):
            flags += ["--mount-file", f"{known}:/root/.ssh/known_hosts:ro"]
        else:
            warn("no ~/.ssh/known_hosts — ssh from the guest has nothing to verify")
        return flags

    # ----------------------------------------------------------- all together

    def create_flags(self):
        flags = ["--conf", self.conf_path]
        # After --conf, which it overrides: a project's committed dev.yaml says
        # `workdir: /work`, and a sandbox mounted elsewhere must not start there.
        flags += ["--workdir", self.guest_project]
        flags += self.mount_flags()
        for key, value in self.env_vars().items():
            flags += ["--env", f"{key}={value}"]
        # The agent protocol crosses; the key never does. Paired with the socat
        # bridge ensure_bridge() starts on each boot. The host end is this
        # sandbox's own FILTERING agent, not the login agent: it shows and
        # signs only the keys the entry lists. The path is baked in at create
        # time, so it must stay stable per sandbox.
        flags += ["--vsock", f"{self.agent_sock}:{VSOCK_PORT}"]
        if self.observing:
            # Nothing is blocked and everything reachable is recorded. NOT a
            # loosened allowlist — no --net-rule at all, because a half-applied
            # policy would still block, and a blocked connection leaves no trace
            # to collect. The rules stay in the config and keep being curated by
            # `allow` and `edit`; they are simply not emitted while measuring.
            flags += ["--net-default-egress", "allow"]
            # The record itself. msb logs an intercepted connection as
            # `TLS intercept sni=<host> dst=<ip:port>` and a resolved name as a
            # dns:: line, both at DEBUG and neither at INFO — so without this
            # observe mode would unblock without observing anything. It writes
            # to the sandbox's own runtime.log, not to a terminal.
            flags += ["--log-level", "debug"]
            # Rebind protection drops answers that resolve to private addresses,
            # which is a block like any other: the name comes back NXDOMAIN, the
            # connection never happens and nothing is written down. Measuring
            # mode has to see it, so it comes off with the rest.
            flags += ["--no-dns-rebind-protection"]
        else:
            # State the default explicitly: allow rules alone do NOT close egress.
            flags += ["--net-default-egress", "deny"]
            for rule in self.net_rules():
                flags += ["--net-rule", rule]
            if self.allow_private_dns:
                flags += ["--no-dns-rebind-protection"]
        # Published ports are INBOUND, so the egress policy above has no say in
        # them, in either mode. msb binds the host side on 127.0.0.1 unless the
        # spec names an address, and dials the guest's own address rather than
        # its loopback — so the server inside must listen on 0.0.0.0. Whether
        # these merge with a `ports:` list in the project's dev.yaml or replace
        # it is unverified; set them in one place.
        for spec, *_ in self.published_ports:
            flags += ["--port", spec]
        # Without this, every HTTPS hostname rule above is a silent deny. It is
        # also what makes secret placeholder substitution possible, so the two
        # requirements coincide and neither can be dropped alone. In observe
        # mode it is also what puts a HOSTNAME rather than an address in the
        # log, which is what the rules are written in — so it stays on there
        # too, even though nothing is being enforced.
        flags += ["--tls-intercept"]
        flags += ["--root-disk", str(self.root_disk)]
        # Explicit flags, not just dev.yaml: that file is written once by the
        # wizard, so a cpus/memory override in the registry entry or sandbox.toml
        # would otherwise be resolved and shown but never reach msb. Flags win
        # over --conf (verified on 0.7.6).
        flags += ["--cpus", str(self.cpus), "--memory", str(self.memory)]
        return flags

    def versions(self):
        """Component pins: registry [versions] over config.toml [versions]."""
        merged = dict(self.config.get("versions", {}))
        merged.update(self.entry.get("versions", {}))
        return merged

    @property
    def identity(self):
        """The resolved git identity, or None if the sandbox has no preference.

        Applied with `git config --system` inside the guest, NEVER to
        /work/.git/config — that file lives on the host, is shared with every
        other tool, and a sandbox silently rewriting your repo's author is a
        worse failure than having no identity at all.

        --system is the lowest of git's three layers: it always resolves, so
        `git commit` never dies with "Please tell me who you are", while both
        ~/.gitconfig and a repo's own .git/config stay free to override it on
        purpose.

        The consequence is worth stating plainly: a repo that sets its own
        user.email still wins, so for such a repo this changes nothing. What it
        fixes is the opposite case. A repo with no identity
        of its own inherits your host-global config when you work on the host,
        and there is no host-global config inside a microVM, so `git commit`
        there fails outright. This is that fallback.
        """
        if not self.identity_name:
            return None
        table = self.config.get("identities", {})
        if self.identity_name not in table:
            die(f"unknown identity {self.identity_name!r} — config.toml defines: "
                f"{', '.join(sorted(table)) or '(none)'}")
        ident = table[self.identity_name]
        missing = [k for k in ("name", "email") if not ident.get(k)]
        if missing:
            die(f"identity {self.identity_name!r} is missing: {', '.join(missing)}")
        return ident

    @property
    def signing_fp(self):
        """Fingerprint of the key the identity signs commits with, or None."""
        pub = (self.identity or {}).get("signing_key")
        parsed = _parse_pub_line(pub) if pub else None
        return parsed[0] if parsed else None

    @property
    def signing_active(self):
        """Signing is enforced only while the sandbox can actually use the key:
        an identity that names one AND a key selection that includes it (or no
        selection at all, which shows the whole host agent). Dropping the key
        in `msbctl keys` therefore turns signing off rather than leaving a
        sandbox whose every commit fails."""
        fp = self.signing_fp
        keys = self.ssh_keys
        return bool(fp) and (keys is None or fp in keys)

    def env_vars(self):
        """Guest environment: [agent_env.<agent>] for each agent this sandbox
        installs < config.toml [env] < sandbox.toml [env] < registry.

        A MERGE, deliberately, where rule_groups is a pick. A project that adds
        one variable keeps the machine-wide set rather than silently replacing
        it — these are defaults to extend. Egress rules are the opposite case:
        a project may legitimately need a narrower set, so it overrides there.

        Do NOT also set a key here that the project's --conf dev.yaml sets in
        its own `env:` block. Which of the two wins is unverified, and a
        telemetry switch whose value depends on an unverified precedence is
        worse than one in a single place.
        """
        merged = {}
        # Under every [env], so a project can still override an agent's default.
        for agent, _, _ in AGENTS:
            if self.wants_component(agent):
                merged.update(self.config.get("agent_env", {}).get(agent, {}))
        merged.update(self.config.get("env", {}))
        merged.update(self.project_cfg.get("env", {}))
        merged.update(self.entry.get("env", {}))
        # TOML gives real types; msb wants KEY=value strings. `true` would
        # otherwise reach the guest as the string "True", which is not what
        # anything checking for "1" is looking for.
        return {k: ("1" if v is True else "0" if v is False else str(v))
                for k, v in merged.items()}


def merge_config(base, over):
    """`over` on top of `base`. Tables merge key by key; anything else —
    including a list, so an egress group — is replaced whole. Replacing a group
    rather than splicing its hosts is deliberate: rules are first-match-wins and
    half of one is worse than either."""
    out = dict(base)
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            out[key] = merge_config(base[key], value)
        else:
            out[key] = value
    return out


def load_config():
    shipped = read_toml(DEFAULTS_FILE)
    if not shipped:
        die(f"{tilde(DEFAULTS_FILE)} is missing or empty — the checkout is damaged")
    return merge_config(shipped, read_toml(CONFIG_FILE))


def registered():
    try:
        names = [f[:-5] for f in sorted(os.listdir(REGISTRY_DIR))
                 if f.endswith(".toml")]
    except FileNotFoundError:
        names = []
    return names


# ------------------------------------------------- the sandbox of this folder
#
# Like docker compose, the current directory names a sandbox when none is given:
# the registered one whose project CONTAINS it, the deepest if projects nest (as
# git finds a repo). The registry decides, not a .msb/ folder: a clone of a
# project that commits .msb/ is not registered on this machine, and the cloned
# layout keeps .msb/ beside the checkout rather than inside it.
#
# Never a guess. A name may be OMITTED only where it is the sole positional
# argument; where something follows it, `.` stands for it instead — `.` can
# never be a sandbox name, so `msbctl observe on` cannot be misread as a
# sandbox called "on". Two entries on the same folder are an error, not a pick.

NAME_HELP = "sandbox name; omit it inside a registered project folder"
NAMES_HELP = "sandbox names; none (or .) means the one for the current folder"
DOT_HELP = "sandbox name, or . for the one whose project holds the current folder"


def sandbox_here():
    """(name, project) of the sandbox the current directory belongs to."""
    cwd = os.path.realpath(os.getcwd())
    found = []
    for name in registered():
        try:
            raw = read_toml(registry_path_for(name)).get("project")
        except SystemExit:                  # a broken entry is no reason to fail here
            continue
        if not raw:
            continue
        project = os.path.realpath(os.path.expanduser(raw))
        if cwd == project or cwd.startswith(project.rstrip(os.sep) + os.sep):
            found.append((len(project), name, project))
    if found:
        deepest = max(n for n, _, _ in found)
        hits = [(name, project) for n, name, project in found if n == deepest]
        if len(hits) > 1:
            die(f"{tilde(hits[0][1])} is the project of several sandboxes "
                f"({', '.join(n for n, _ in hits)}) — name the one you mean")
        return hits[0]
    # Nothing registered here. Say so in the most useful way.
    probe = cwd
    while True:
        if os.path.isfile(os.path.join(probe, ".msb", "sandbox.toml")):
            die(f"{tilde(probe)} has a .msb/ but no sandbox on this machine is "
                f"registered for it — `msbctl add {tilde(probe)}`, or name one")
        parent = os.path.dirname(probe)
        if parent == probe:
            break
        probe = parent
    die(f"{tilde(cwd)} is not inside a registered project — name the sandbox "
        "(`msbctl ls` lists them)")


def resolve_here(raw):
    """`raw` unless it is omitted (None) or `.`, which mean this folder's sandbox."""
    if raw not in (None, "."):
        return raw
    # Silently: a command's output should be only the command's, and the
    # sandbox it ran in is one `msbctl ls` away if it is ever in doubt.
    name, _project = sandbox_here()
    return name


def guest_workdir(box):
    """The project inside the guest, or the same subfolder of it when the
    current directory is inside the project — so `msbctl shell` from src/
    lands in /work/src (or <guest path>/src), like cd'ing."""
    cwd = os.path.realpath(os.getcwd())
    if cwd.startswith(box.project.rstrip(os.sep) + os.sep):
        return os.path.join(box.guest_project, os.path.relpath(cwd, box.project))
    return box.guest_project


# ------------------------------------------------------------------ per-boot

# ------------------------------------------------- per-sandbox filtering agent
#
# The host's login agent holds every key you own. Forwarding it hands a sandbox
# all of them, so instead each sandbox gets its own socket, served by a small
# daemon (this same file, run as `msbctl _agent-filter <name>`) that proxies to
# the real agent but only for the keys the registry entry's `ssh_keys` lists.
#
# Keys never move: signing still happens in the host agent, so passphrases,
# hardware tokens and `ssh-add -c` confirmations keep working. Only two
# requests get through at all — list identities (answer filtered) and sign
# (refused for any key not listed). Adding, removing, locking and extensions
# are refused, so the guest cannot reshape the host agent either.
#
# `ssh_keys` is re-read on every request, so `msbctl keys` takes effect
# without a restart. The upstream agent path is also a file, rewritten on each
# start, so a new login session's agent is picked up without restarting.

AGENT_FAILURE = 5
AGENTC_REQUEST_IDENTITIES = 11
AGENT_IDENTITIES_ANSWER = 12
AGENTC_SIGN_REQUEST = 13
AGENT_MAX_MSG = 256 * 1024          # OpenSSH's own limit


def key_fingerprint(blob):
    digest = hashlib.sha256(blob).digest()
    return "SHA256:" + base64.b64encode(digest).decode().rstrip("=")


def _read_exact(sock, count):
    data = b""
    while len(data) < count:
        chunk = sock.recv(count - len(data))
        if not chunk:
            return None
        data += chunk
    return data


def _read_msg(sock):
    """One agent message (type byte + body), or None on EOF or nonsense."""
    head = _read_exact(sock, 4)
    if head is None:
        return None
    (length,) = struct.unpack(">I", head)
    if length < 1 or length > AGENT_MAX_MSG:
        return None
    return _read_exact(sock, length)


def _write_msg(sock, payload):
    sock.sendall(struct.pack(">I", len(payload)) + payload)


def _take_string(buf, off):
    (size,) = struct.unpack_from(">I", buf, off)
    off += 4
    if size > len(buf) - off:
        raise ValueError("truncated string")
    return buf[off:off + size], off + size


def _filter_identities(answer, allowed):
    """Rebuild an IDENTITIES_ANSWER keeping only allowed fingerprints."""
    (count,) = struct.unpack_from(">I", answer, 1)
    off, kept = 5, []
    for _ in range(count):
        blob, off = _take_string(answer, off)
        comment, off = _take_string(answer, off)
        if allowed is None or key_fingerprint(blob) in allowed:
            kept.append(struct.pack(">I", len(blob)) + blob
                        + struct.pack(">I", len(comment)) + comment)
    return (bytes([AGENT_IDENTITIES_ANSWER]) + struct.pack(">I", len(kept))
            + b"".join(kept))


class _AgentFilter(socketserver.BaseRequestHandler):
    def handle(self):
        upstream = None
        try:
            while True:
                msg = _read_msg(self.request)
                if msg is None:
                    return
                allowed = self.server.allowed()
                kind = msg[0]
                if kind == AGENTC_SIGN_REQUEST:
                    blob, _ = _take_string(msg, 1)
                    permitted = allowed is None or key_fingerprint(blob) in allowed
                elif kind == AGENTC_REQUEST_IDENTITIES:
                    permitted = True
                else:
                    permitted = False
                if not permitted:
                    _write_msg(self.request, bytes([AGENT_FAILURE]))
                    continue
                if upstream is None:
                    upstream = socket.socket(socket.AF_UNIX)
                    upstream.connect(self.server.upstream())
                _write_msg(upstream, msg)
                reply = _read_msg(upstream)
                if reply is None:
                    _write_msg(self.request, bytes([AGENT_FAILURE]))
                    return
                if kind == AGENTC_REQUEST_IDENTITIES and reply[0] == AGENT_IDENTITIES_ANSWER:
                    reply = _filter_identities(reply, allowed)
                _write_msg(self.request, reply)
        except (OSError, ValueError, struct.error):
            return
        finally:
            if upstream is not None:
                upstream.close()


class _AgentFilterServer(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True

    def __init__(self, name):
        self.name = name
        self.sock_path = os.path.join(AGENT_DIR, f"{name}.sock")
        try:
            os.unlink(self.sock_path)
        except FileNotFoundError:
            pass  # no stale socket from an earlier run
        old = os.umask(0o077)           # the socket is created 0600
        try:
            super().__init__(self.sock_path, _AgentFilter)
        finally:
            os.umask(old)

    def allowed(self):
        entry = read_toml(os.path.join(REGISTRY_DIR, f"{self.name}.toml"))
        raw = entry.get("ssh_keys")
        if raw is None:
            return None
        return {str(item).split()[0] for item in raw if str(item).split()}

    def upstream(self):
        with open(os.path.join(AGENT_DIR, f"{self.name}.upstream"),
                  encoding="utf-8") as fh:
            return fh.read().strip()


def cmd_agent_filter(args, config):
    """The daemon. Not for humans; ensure_agent_filter() starts it."""
    os.makedirs(AGENT_DIR, mode=0o700, exist_ok=True)
    server = _AgentFilterServer(args.name)
    with open(os.path.join(AGENT_DIR, f"{args.name}.pid"), "w") as fh:
        fh.write(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        server.serve_forever()
    finally:
        try:
            os.unlink(server.sock_path)
        except FileNotFoundError:
            pass  # stop_agent_filter() got there first


def _agent_alive(path):
    probe = socket.socket(socket.AF_UNIX)
    probe.settimeout(1)
    try:
        probe.connect(path)
        return True
    except OSError:
        return False
    finally:
        probe.close()


def ensure_agent_filter(box):
    """Make sure this sandbox's selected keys are loaded and its filtering agent
    is up and points at the current host agent. Cheap and idempotent; called on
    every start."""
    upstream = os.environ.get("SSH_AUTH_SOCK", "")
    if not upstream or not os.path.exists(upstream):
        die("no usable SSH_AUTH_SOCK — start an agent and ssh-add a key")
    # Every start path comes through here, so this is where a selected key that
    # is not loaded yet gets added, before the sandbox can ask for it.
    ensure_keys_loaded(box)
    os.makedirs(AGENT_DIR, mode=0o700, exist_ok=True)

    path = os.path.join(AGENT_DIR, f"{box.name}.upstream")
    fd, tmp = tempfile.mkstemp(dir=AGENT_DIR)
    with os.fdopen(fd, "w") as fh:
        fh.write(upstream)
    os.replace(tmp, path)

    if _agent_alive(box.agent_sock):
        return
    # The daemon gets its own copy of the descriptor; ours closes right away.
    with open(os.path.join(AGENT_DIR, f"{box.name}.log"), "ab") as log:
        subprocess.Popen([sys.executable, os.path.realpath(__file__),
                          "_agent-filter", box.name],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                         start_new_session=True)
    for _ in range(30):
        if _agent_alive(box.agent_sock):
            return
        time.sleep(0.1)
    die(f"the ssh-agent filter did not start — see "
        f"{tilde(os.path.join(AGENT_DIR, box.name + '.log'))}")


def stop_agent_filter(box):
    pidfile = os.path.join(AGENT_DIR, f"{box.name}.pid")
    try:
        with open(pidfile) as fh:
            os.kill(int(fh.read().strip()), signal.SIGTERM)
    except (OSError, ValueError):
        pass  # not running, or a stale pidfile: nothing to stop
    for suffix in ("sock", "pid", "upstream"):
        try:
            os.unlink(os.path.join(AGENT_DIR, f"{box.name}.{suffix}"))
        except FileNotFoundError:
            pass  # already gone


def _parse_pub_line(line):
    """(fingerprint, type, comment) from an authorized_keys-style public key
    line, or None."""
    parts = line.strip().split(None, 2)
    if len(parts) < 2:
        return None
    try:
        blob = base64.b64decode(parts[1], validate=True)
    except ValueError:
        return None
    return key_fingerprint(blob), parts[0], parts[2] if len(parts) > 2 else ""


# Public key lines learned while picking (an encrypted key with no .pub is only
# readable once its passphrase has been given), by fingerprint.
_PUB_CACHE = {}


def public_line(fp):
    """`type base64` (no comment) of the key with this fingerprint, from what
    the agent holds, else a key file in ~/.ssh; None if neither can say. Git
    needs the public half to name the key it asks the agent to sign with."""
    def bare(line):
        parts = line.split()
        return " ".join(parts[:2]) if len(parts) >= 2 else None

    if fp in _PUB_CACHE:
        return bare(_PUB_CACHE[fp])
    proc = subprocess.run(["ssh-add", "-L"], capture_output=True, text=True)
    for line in proc.stdout.splitlines() if proc.returncode == 0 else []:
        parsed = _parse_pub_line(line)
        if parsed and parsed[0] == fp:
            return bare(line)
    for found, _, _, path in host_ssh_files():
        if found != fp:
            continue
        if os.path.isfile(path + ".pub"):
            with open(path + ".pub", encoding="utf-8", errors="replace") as fh:
                return bare(fh.readline())
        proc = subprocess.run(["ssh-keygen", "-y", "-P", "", "-f", path],
                              capture_output=True, text=True,
                              stdin=subprocess.DEVNULL, timeout=10)
        if proc.returncode == 0:
            return bare(proc.stdout)
    return None


def host_agent_keys():
    """The keys the host agent holds, as [(fingerprint, type, comment)]."""
    proc = subprocess.run(["ssh-add", "-L"], capture_output=True, text=True)
    if proc.returncode != 0:
        return []
    return [k for k in map(_parse_pub_line, proc.stdout.splitlines()) if k]


# Names in ~/.ssh that are never private keys. Anything else is opened and
# checked for a PRIVATE KEY header, so a key called whatever you like is found.
_NOT_KEYS = {"known_hosts", "known_hosts.old", "config", "authorized_keys",
             "environment", "agent.sock"}


def host_ssh_files():
    """Private keys on disk in ~/.ssh, as [(fingerprint, type, comment, path)].
    The fingerprint is None for a key that cannot be named without its
    passphrase (see _identify_file).

    The fingerprint comes from the public half without ever prompting: the
    .pub file if there is one, else `ssh-keygen -y` with an EMPTY passphrase,
    which fails fast on an encrypted key rather than waiting at a tty. Listing
    therefore never prompts; a key that is encrypted AND has no .pub is returned
    unnamed, and is only unlocked if the operator actually picks it."""
    try:
        names = sorted(os.listdir(SSH_DIR))
    except OSError:
        return []
    found = []
    for name in names:
        path = os.path.join(SSH_DIR, name)
        if (name.endswith(".pub") or name in _NOT_KEYS or name.startswith("known_hosts")
                or not os.path.isfile(path)):
            continue
        try:
            with open(path, "rb") as fh:
                if b"PRIVATE KEY" not in fh.read(100):
                    continue
        except OSError:
            continue
        parsed = None
        if os.path.isfile(path + ".pub"):
            with open(path + ".pub", encoding="utf-8", errors="replace") as fh:
                parsed = _parse_pub_line(fh.readline())
        if not parsed:
            proc = subprocess.run(["ssh-keygen", "-y", "-P", "", "-f", path],
                                  capture_output=True, text=True,
                                  stdin=subprocess.DEVNULL, timeout=10)
            if proc.returncode == 0:
                parsed = _parse_pub_line(proc.stdout.strip())
        if parsed:
            fp, ktype, comment = parsed
            found.append((fp, ktype, comment or name, path))
        else:
            found.append((None, "", name, path))     # needs a passphrase to name
    return found


def format_ssh_keys(keys):
    """The `ssh_keys` assignment as TOML text. `keys` is [(fingerprint, label)]
    or None for unrestricted (nothing written). Labels become trailing
    comments, so the file stays readable to whoever hand-edits it."""
    if keys is None:
        return "# ssh_keys = []          # unrestricted: every key in the host agent"
    if not keys:
        return "ssh_keys = []"
    rows = [f'    "{fp}",  # {label}'.rstrip(" #") for fp, label in keys]
    return "ssh_keys = [\n" + "\n".join(rows) + "\n]"


def write_ssh_keys(box, keys):
    """Replace this entry's `ssh_keys` assignment in place (single- or
    multi-line), else add it after `autostart`. A line-level edit for the same
    reason as write_version_override(): a serializer would eat the comments."""
    path = os.path.join(REGISTRY_DIR, f"{box.name}.toml")
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()

    out, at, i = [], None, 0
    while i < len(lines):
        if re.match(r"^\s*ssh_keys\s*=", lines[i]):
            at = len(out)
            while i < len(lines) and "]" not in lines[i].split("#")[0]:
                i += 1
            i += 1
            continue
        out.append(lines[i])
        i += 1
    if at is None:
        at = next((j + 1 for j, line in enumerate(out)
                   if re.match(r"^\s*autostart\s*=", line)), None)
        if at is None:
            at = next((j for j, line in enumerate(out)
                       if line.lstrip().startswith("[")), len(out))
        out[at:at] = [""]
        at += 1
    out[at:at] = format_ssh_keys(keys).splitlines()
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")


def _known_keys():
    """Every key we can see, by fingerprint:
    {fp: {"type", "comment", "path" (or ""), "loaded" (in the agent now)}}."""
    known = {}
    for fp, ktype, comment in host_agent_keys():
        known[fp] = {"type": ktype, "comment": comment, "path": "", "loaded": True}
    for fp, ktype, comment, path in host_ssh_files():
        if fp is None:
            continue
        entry = known.setdefault(fp, {"type": ktype, "comment": comment,
                                      "path": "", "loaded": False})
        entry["path"] = path
        if not entry["comment"]:
            entry["comment"] = comment
    return known


def _describe(info):
    text = f"{info['comment'] or '(no comment)'} ({info['type']})"
    if info["path"]:
        text += f"  {tilde(info['path'])}"
    return text


def _key_labels(current):
    """{fingerprint: display label} for every known key plus any already
    selected that is gone, so nothing is silently dropped. Used by `show`."""
    labels = {fp: _describe(info) for fp, info in _known_keys().items()}
    for fp in current or []:
        labels.setdefault(fp, "(not in the agent or ~/.ssh now)")
    return labels


def _identify_file(path):
    """(fingerprint, type, comment) of a key file that needs its passphrase.
    ssh-keygen asks on the terminal; this is only ever called for a key the
    operator picked, so browsing the list never prompts."""
    note(f"{tilde(path)} is encrypted — its passphrase is needed to name it")
    proc = subprocess.run(["ssh-keygen", "-y", "-f", path],
                          stdout=subprocess.PIPE, text=True)
    parsed = _parse_pub_line(proc.stdout) if proc.returncode == 0 else None
    if parsed:
        _PUB_CACHE[parsed[0]] = proc.stdout.strip()
    return parsed


SIGNS_MARK = "  [signs commits]"


def pick_ssh_keys(current, preselect_all, signing=None, single=False):
    # `signing` is the fingerprint an identity signs commits with: that row is
    # flagged, so unticking it is a visible act (the caller warns). `single`
    # is for choosing ONE key (an identity's signing key): zero is allowed and
    # means none, more than one is asked again.
    chosen = _pick_ssh_keys(current, preselect_all, signing)
    while single and len(chosen) > 1:
        warn("pick one key, or none")
        chosen = _pick_ssh_keys([fp for fp, _ in chosen], False, signing)
    return chosen


def _pick_ssh_keys(current, preselect_all, signing):
    """One multiselect over everything usable, in two sections: keys already in
    the agent, and key files in ~/.ssh. Returns [(fingerprint, label)].

    A key that is both loaded and on disk is listed once, under the agent. Files
    in ~/.ssh are put into the agent when the sandbox starts (see
    ensure_keys_loaded). The fingerprint is how a key is stored and matched, but
    it is never shown: the label is what a person recognises."""
    known = _known_keys()
    unnamed = [(name, path) for fp, _, name, path in host_ssh_files() if fp is None]
    if not known and not unnamed:
        warn("no keys in the agent or in ~/.ssh — create one, then `msbctl keys`")
        return []

    agent, disk = [], []          # (id, row, label)
    for fp, info in known.items():
        mark = SIGNS_MARK if fp == signing else ""
        item = (fp, _describe(info) + mark, _describe(info))
        (agent if info["loaded"] else disk).append(item)
    for name, path in unnamed:
        label = f"{name}  {tilde(path)}"
        disk.append((f"file:{path}", f"{label}  (encrypted: asks for its passphrase if picked)", label))
    gone = [(fp, "(not in the agent or ~/.ssh now)" + (SIGNS_MARK if fp == signing else ""),
             "(not in the agent or ~/.ssh now)")
            for fp in current or [] if fp not in known]

    options, ids, labels = [], {}, {}
    for header, items in (("agent:" + ("" if agent else " (no keys loaded)"), agent),
                          ("~/.ssh:" + ("" if disk else " (no key files found)"), disk),
                          ("selected earlier:" if gone else "", gone)):
        if not header:
            continue
        options.append(Header(header))
        seen = set()
        for kid, row, label in sorted(items, key=lambda it: it[1].lower()):
            if row in seen:                    # two keys that read the same
                row += f"  [{kid.removeprefix('SHA256:')[:6]}]"
            seen.add(row)
            options.append(row)
            ids[row], labels[kid] = kid, label

    if preselect_all and current is None:      # unrestricted: what it sees today
        start = [row for row, kid in ids.items() if kid in {a[0] for a in agent}]
    else:
        start = [row for row, kid in ids.items() if kid in (current or [])]
    chosen = []
    for row in toggle_list("keys", options, start):
        kid = ids[row]
        if kid.startswith("file:"):
            parsed = _identify_file(kid.removeprefix("file:"))
            if not parsed:
                warn(f"could not read {tilde(kid.removeprefix('file:'))} — skipped")
                continue
            fp, ktype, comment = parsed
            chosen.append((fp, _describe({"type": ktype, "comment": comment,
                                          "path": kid.removeprefix("file:")})))
        else:
            chosen.append((kid, labels[kid]))
    return chosen


def ensure_keys_loaded(box):
    """Make sure this sandbox's selected keys are in the host agent, adding any
    that are not from ~/.ssh. ssh-add inherits the terminal, so an encrypted key
    prompts for its passphrase here. A key that cannot be added is a warning,
    not an error: the sandbox starts, just without it.

    Keys are found by fingerprint. An encrypted key with no .pub cannot be
    named without its passphrase, so when a fingerprint matches no named file
    the remaining unnamed files are tried in turn, stopping once it appears."""
    wanted = list(box.ssh_keys or [])
    if box.signing_active and box.signing_fp not in wanted:
        wanted.append(box.signing_fp)       # unrestricted, but it must still be loaded
    if not wanted:
        return
    loaded = {fp for fp, _, _ in host_agent_keys()}
    missing = [fp for fp in wanted if fp not in loaded]
    if not missing:
        return
    scanned = host_ssh_files()
    files = {fp: path for fp, _, _, path in scanned if fp}
    unnamed = [path for fp, _, _, path in scanned if fp is None]

    def add(path):
        # stderr, like warn(): this runs before `msbctl exec` hands over its stdout.
        print(f"   adding {tilde(path)} to the ssh-agent", file=sys.stderr)
        ok = subprocess.run(["ssh-add", path]).returncode == 0
        if not ok:
            warn(f"could not add {tilde(path)} — the sandbox starts without it")
        return ok

    for fp in missing:
        if fp in files:
            add(files[fp])
            continue
        for path in list(unnamed):
            if add(path):
                unnamed.remove(path)
                if fp in {k for k, _, _ in host_agent_keys()}:
                    break
        else:
            if fp not in {k for k, _, _ in host_agent_keys()}:
                warn(f"{fp} is selected but is not in the agent or in ~/.ssh — the "
                     f"sandbox starts without it (`msbctl keys {box.name}` to change)")


def cmd_keys(args, config):
    box = Sandbox(args.name, config)
    if args.all:
        write_ssh_keys(box, None)
        note(f"{box.name}: unrestricted — every key in the host agent")
        return
    current = box.ssh_keys
    say(f"SSH keys for {box.name}")
    if current is None:
        note("currently unrestricted: every key in the host agent is visible")
    note("Only the ticked keys can be listed or sign from inside the sandbox.")
    signing = box.signing_fp
    if signing:
        note(f"{box.identity_name} signs commits with the key marked{SIGNS_MARK.strip()}.")
    chosen = pick_ssh_keys(current, preselect_all=True, signing=signing)
    if signing and signing not in {fp for fp, _ in chosen} \
            and (current is None or signing in current):
        warn(f"that key signs commits for identity {box.identity_name!r}: without it "
             f"this sandbox stops signing (commits go unsigned)")
        if not confirm("drop it anyway?"):
            chosen.append((signing, _key_labels([signing]).get(signing, "")))
            note("kept")
    write_ssh_keys(box, chosen)
    note(f"{len(chosen)} key(s) saved; takes effect immediately, no restart.")
    if agent_binding(box) == "raw":
        warn(f"{box.name} was created with the RAW host agent, so this selection is not "
             f"enforced yet — `msbctl rebuild {box.name}` puts it behind the filter")
    if os.environ.get("SSH_AUTH_SOCK"):
        ensure_keys_loaded(Sandbox(box.name, config))


def ensure_bridge(box):
    """Start the guest half of the ssh-agent bridge. Per boot, not per create.

    socat is installed once by the bootstrap, but the process dies with the VM,
    which is why shell/exec both come through here rather than through create.
    Idempotent: a socket that accepts a connection is left alone. The file
    alone proves nothing — /tmp is on the persistent rootfs, so the previous
    boot's socket survives a stop/start without the socat that served it, and
    `[ -S ]` would skip the bridge and leave the guest with "connection refused".
    """
    script = (
        "command -v socat >/dev/null || exit 0\n"
        f"socat -u OPEN:/dev/null UNIX-CONNECT:{GUEST_AGENT_SOCK} 2>/dev/null && exit 0\n"
        f"setsid socat 'UNIX-LISTEN:{GUEST_AGENT_SOCK},fork,unlink-early' "
        f"'VSOCK-CONNECT:2:{VSOCK_PORT}' >/dev/null 2>&1 &\n"
        "sleep 1\n"
    )
    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c", script],
        check=False, quiet=True)




def _without_comments(text):
    return re.sub(r"<!--.*?-->", "", text, flags=re.S).strip()


def assemble_profile():
    """Build PROFILE_DIR/CLAUDE.md: the shipped text, then PROFILE_LOCAL if it has
    anything in it besides a comment. Rewritten only when the content changed, and
    atomically, since a running sandbox may be reading it. True if there is a file."""
    try:
        with open(PROFILE_SHIPPED, encoding="utf-8") as fh:
            shipped = fh.read().strip("\n")
    except FileNotFoundError:
        shipped = ""
    local = ""
    if os.path.isfile(PROFILE_LOCAL):
        with open(PROFILE_LOCAL, encoding="utf-8") as fh:
            raw = fh.read()
        if _without_comments(raw):
            local = "<!-- your additions, from ~/.config/msb/CLAUDE.local.md -->\n" + raw.strip("\n")
    text = "\n\n".join(p for p in (shipped, local) if p)
    if not text:
        return False
    text += "\n"
    os.makedirs(PROFILE_DIR, exist_ok=True)
    path = os.path.join(PROFILE_DIR, "CLAUDE.md")
    try:
        with open(path, encoding="utf-8") as fh:
            if fh.read() == text:
                return True
    except FileNotFoundError:
        pass  # first assembly: nothing to compare against
    fd, tmp = tempfile.mkstemp(dir=PROFILE_DIR)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    return True


def sandbox_profile_section(box):
    """A few lines appended to THIS sandbox's copy of CLAUDE.md naming its
    features, so the agent knows podman is there before it goes looking. From the
    current config, so after an edit that still needs a rebuild it is ahead of the VM."""
    feats = current_features(box)
    if not feats:
        return ""
    lines = ["## This sandbox", "",
             f"`{box.name}` was set up with these features, each installed and its egress allowed:", ""]
    lines += [f"- **{key}**: {desc}" for key, desc, _ in FEATURES if key in feats]
    return "\n".join(lines)


def ensure_profile(box):
    """Seed the guest's Claude state. Per boot, two files, two different rules.

    CLAUDE.md     OVERWRITTEN every start. Being centrally managed is the whole
                  point: edit it on the host and every sandbox has it next
                  start. A copy rather than a file mount overlaid inside the
                  ~/.claude directory mount — the overlay is unverified, the
                  copy is not.

    .claude.json  MERGED every start, never replaced: onboarding is set only
                  if absent, and the project and /tmp are marked trusted. Claude Code keeps
                  per-sandbox state in this file, so rewriting it wholesale
                  would quietly discard that. It lives in the sandbox's
                  writable layer and so is gone after every rebuild, which is
                  why the trust answer is re-asserted here rather than
                  remembered: the "do you trust this folder?" prompt never
                  comes back. The project is yours and the VM is the boundary,
                  so the prompt guards nothing here.
    """
    if box.claude_auth != "secret":
        return      # "mount" puts the host's real files in place; nothing to do

    script = []
    if assemble_profile():          # rebuilt per boot, so an edit lands on the next start
        script.append(f"mkdir -p /root/.claude && "
                      f"cp {GUEST_PROFILE}/CLAUDE.md /root/.claude/CLAUDE.md")
        # Per sandbox, so it cannot live in the shared, mounted file. As an
        # argument ($2), never spliced into the script.
        script.append('[ -z "$2" ] || printf \'\\n%s\\n\' "$2" >> /root/.claude/CLAUDE.md')
    else:
        warn(f"no CLAUDE.md text ({tilde(PROFILE_SHIPPED)} is missing) — nothing to seed")

    # Without this, interactive `claude` runs its first-run login flow even
    # though CLAUDE_CODE_OAUTH_TOKEN is bound and demonstrably works. The token
    # is checked on the wire; onboarding is checked locally, against this file;
    # the two are independent, and satisfying one does nothing for the other.
    #
    # `claude -p` does not consult it at all, which is exactly why spike 07
    # passes whether or not this file exists and why this gap survived to the
    # first interactive use. Verified by hand in a live sandbox.
    # python3 is there once the bootstrap has run; before that (or if it
    # failed) fall back to seeding the file if absent.
    trusted = [box.guest_project, *TRUSTED_GUEST_DIRS]
    script.append(f"if command -v python3 >/dev/null; then "
                  f"python3 -c \"$1\" {GUEST_CLAUDE_JSON} {' '.join(shq(f) for f in trusted)}; "
                  f"else [ -f {GUEST_CLAUDE_JSON} ] || "
                  f"printf '%s\\n' {shq(onboarded_json(*trusted))} > {GUEST_CLAUDE_JSON}; fi")

    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c", " ; ".join(script),
         "_", MERGE_CLAUDE_JSON, sandbox_profile_section(box)], check=False, quiet=True)


# Where ensure_identity() writes the guest's allowed-signers file for ssh
# commit signing. Under /etc like the --system config that points at it.
GUEST_ALLOWED_SIGNERS = "/etc/git/allowed_signers"


def ensure_identity(box):
    """Set the guest's global git identity. Per boot, like the profile seed, so
    editing config.toml takes effect on the next start rather than on a rebuild.
    """
    ident = box.identity
    # Signing is --system too, for the same reason as the name: a repo's own
    # config can still override it. It is switched OFF again whenever it is not
    # active (identity changed, key dropped from `msbctl keys`), because the
    # guest's /etc/gitconfig outlives the setting that wrote it.
    #
    # The allowed-signers file lists only this identity's own key, so that
    # `git log --show-signature` / `git verify-commit` can check what the
    # sandbox signed; anyone else's commits read "no principal matched", which
    # is ssh signing's normal answer for an unknown key.
    keys = ("gpg.format", "user.signingkey", "commit.gpgsign", "tag.gpgsign",
            "gpg.ssh.allowedSignersFile")
    script = ('git config --system user.name "$1" && git config --system user.email "$2"; '
              if ident else "")
    if ident and box.signing_active:
        pub = ident["signing_key"].split()
        script += ('git config --system gpg.format ssh; '
                   'git config --system user.signingkey "key::$3 $4"; '
                   'git config --system commit.gpgsign true; '
                   'git config --system tag.gpgsign true; '
                   f'mkdir -p {GUEST_ALLOWED_SIGNERS.rsplit("/", 1)[0]} && '
                   f'printf \'%s %s %s\\n\' "$2" "$3" "$4" > {GUEST_ALLOWED_SIGNERS} && '
                   f'git config --system gpg.ssh.allowedSignersFile {GUEST_ALLOWED_SIGNERS}; '
                   'command -v ssh-keygen >/dev/null || '
                   'echo "msbctl: no ssh-keygen in the guest, so commits cannot be signed '
                   '(rebuild to install openssh-client)" >&2')
        args = [ident["name"], ident["email"], pub[0], pub[1]]
    else:
        script += "; ".join(f"git config --system --unset {k}" for k in keys)
        script += f"; rm -f {GUEST_ALLOWED_SIGNERS}; true"
        args = [ident["name"], ident["email"]] if ident else []
    # Values passed as positional args, not interpolated into the command
    # string. A name with a quote or a space in it then cannot break the
    # command, and there is no quoting to get right in the first place.
    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c", script, "_", *args],
        check=False, quiet=True)
    if ident and box.signing_fp and not box.signing_active:
        warn(f"{box.name}: identity {box.identity_name!r} signs with a key this sandbox "
             f"cannot use, so commits are NOT signed — `msbctl keys {box.name}` to allow it")


def ensure_git_checkstat(box):
    """Set core.checkStat=minimal in the project's own repo, unless it already
    sets core.checkStat. Per boot, so an existing sandbox gets it on its next
    start.

    Without it, `.git/index` vanishes for ~5 s after any git command in the
    guest that writes it, whenever a host editor watches the repo (zed, and
    any IDE that polls git). The index records each file's full stat, and
    what the guest sees (uid 0, its own inode numbers) never matches what the
    host sees, so the host's `git diff` finds every entry stale and writes a
    refreshed index over the guest's. The virtiofs entry the guest still
    holds then answers ENOENT until it expires, and `git status` in that
    window reports every file deleted and untracked. --no-optional-locks /
    GIT_OPTIONAL_LOCKS=0 does not help: zed already passes it, and `git diff`
    against the work tree ignores it (git 2.55). Comparing only mtime and
    size, which both sides agree on, leaves nothing to refresh.

    It lands in the repo's .git/config, on the host too, where it is equally
    harmless. Only a top-level `.git` is touched: a linked worktree's `.git`
    file names a host path that may not exist in the guest.
    """
    script = ('[ -e .git ] || exit 0; '
              'git config --local --get core.checkStat >/dev/null '
              '|| git config --local core.checkStat minimal')
    run(["msb", "exec", box.name, "--no-tty", "--workdir", box.guest_project,
         "--", "sh", "-c", script], check=False, quiet=True)


def ensure_podman_runtime(box):
    """Clear podman's runtime state if it is left over from an earlier boot.

    Podman keeps it under /run, assuming /run is a tmpfs a reboot empties. In
    a microsandbox guest /run is just part of the root disk, so it survives a
    stop/start, and every podman command after the restart fails with "boot
    ID differs from cached boot ID; an unhandled reboot has occurred. Please
    delete directories /run/containers/storage and /run/libpod". This does
    what that message asks, and what a reboot would have done: images,
    volumes and container definitions live in /var/lib/containers and are
    untouched, and podman marks the containers stopped on its next run.

    It runs on every `shell`/`exec`, not just after a boot, so it uses
    podman's own test: /run/libpod/alive holds the boot ID podman last ran
    under, and only one that differs from this boot's means stale state. A
    sandbox whose podman is running containers right now is left alone.
    All of /run/containers goes (netavark's aardvark-dns pid and config live
    there too; network definitions do not), and crun's and runc's state with
    it: they make the same assumption about /run.
    """
    script = ('a=/run/libpod/alive; [ -f "$a" ] || exit 0; '
              '[ "$(cat "$a")" = "$(cat /proc/sys/kernel/random/boot_id)" ] && exit 0; '
              'rm -rf /run/containers /run/libpod /run/crun /run/runc')
    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c", script],
        check=False, quiet=True)


def ensure_running(box, table=None):
    """Start a stopped sandbox; refuse to create a missing one.

    Creation is always an explicit act — it is the only operation that runs a
    bootstrap and fixes the network policy, so it should not happen as a side
    effect of asking for a shell.
    """
    state = state_of(box.name, table)
    if state == "absent":
        die(f"no sandbox named {box.name} — run: msbctl rebuild {box.name}")
    if state != "running":
        # On stderr: `msbctl exec`'s stdout belongs to its command, which may
        # be a pipe or a protocol stream (ACP) that a stray line would corrupt.
        print(f"\n{BOLD}== Starting {box.name}{RESET}", file=sys.stderr)
        _, env = box.secret_env()
        ensure_agent_filter(box)
        run(["msb", "start", box.name], env=env, to_stderr=True)
    ensure_agent_filter(box)
    ensure_bridge(box)
    ensure_profile(box)
    ensure_identity(box)
    ensure_git_checkstat(box)
    ensure_podman_runtime(box)


# ------------------------------------------------------------------ lifecycle

def warn_missing_prereqs(box):
    """Warn about hosts the bootstrap is about to need and cannot reach.

    This exists because the bootstrap's own failure is one step removed from
    the cause. Deny deb.nodesource.com and what you see is `node` failing,
    then `npm: command not found`, then claude-code failing as a CONSEQUENCE
    and being reported as an independent optional failure. Three messages, one
    missing rule, and the one that names the rule is the easiest to miss.

    An earlier version of this check looked only at api.anthropic.com — Claude
    Code's RUNTIME host — and so stayed silent when its INSTALL path was
    blocked, which is the failure that actually happens. Both halves are
    checked now; a feature needs every host in its list, not any of them.

    Warns rather than refuses, and lists everything at once: the same stance
    bootstrap.sh takes, so one round trip fixes the whole allowlist.
    """
    boot = box.project_cfg.get("bootstrap", {})
    wants_claude = boot.get("claude") is not False

    needs = []
    # node comes from NodeSource unless the image already carries it, and this
    # cannot know which — so it is listed whenever anything needs node at all.
    if wants_claude:
        needs.append(("node (for claude-code)", ["deb.nodesource.com"]))
        needs.append(("claude-code install", ["registry.npmjs.org"]))
        needs.append(("claude-code runtime", ["api.anthropic.com",
                                              "platform.claude.com"]))
    needs.append(("gh" + (" + gitleaks" if boot.get("gitleaks") else "") + " downloads",
                  ["github.com", "release-assets.githubusercontent.com"]))

    rules = box.net_rules()
    missing = []
    for label, hosts in needs:
        absent = [h for h in hosts
                  if not any(h in rule and "allow" in rule for rule in rules)]
        if absent:
            missing.append((label, absent))
    if not missing:
        return

    warn("the bootstrap will need hosts this sandbox cannot reach:")
    for label, absent in missing:
        note(f"     {label:<24} {', '.join(absent)}")
    note("")
    note("   Add the rule group that covers them to `rule_groups` in")
    note(f"   {tilde(os.path.join(box.project, '.msb', 'sandbox.toml'))} — "
         "`npm` and `claude` are")
    note("   the usual two — or set the feature false under [bootstrap].")
    note("   Continuing; the bootstrap reports what actually failed.")


def do_create(box):
    say(f"Creating {box.name}")
    warn_missing_prereqs(box)
    ensure_agent_filter(box)
    secret_flags, env = box.secret_env()
    argv = (["msb", "create", "--name", box.name]
            + box.create_flags() + secret_flags + [box.image])
    run(argv, env=env)

    say("Bootstrapping (once)")
    # Not check=True: a failed bootstrap still leaves a sandbox worth keeping
    # (to look inside, and the rest of it may work), so everything below still
    # runs. But it must not look like success either — see bootstrap_failed().
    boot = run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c",
                bootstrap_payload(box)], check=False)
    ensure_bridge(box)
    ensure_profile(box)
    ensure_identity(box)
    ensure_git_checkstat(box)
    ensure_podman_runtime(box)
    if boot.returncode != 0:
        bootstrap_failed(box, boot.returncode)
    return boot.returncode == 0


# Sandboxes whose bootstrap failed during this msbctl run. main() exits
# non-zero if any did, once the command has finished: do_create() itself must
# not exit, because rename and the edit menu still have work to do after it.
BOOTSTRAP_FAILURES = []


def bootstrap_failed(box, code):
    """Say, last and loudly, that a sandbox was created but is not set up.

    The bootstrap's own summary is easy to miss: it is in the middle of a long
    create, and errors on stderr (apt's `E:` lines) can arrive after it.
    """
    BOOTSTRAP_FAILURES.append(box.name)
    sys.stdout.flush()          # after the create's own output, even when piped
    print(f"\n{BOLD}{RED}== {box.name} is running, but its bootstrap FAILED "
          f"(exit {code}){RESET}", file=sys.stderr)
    for line in (
            "The summary above lists the steps under \"REQUIRED, FAILED\"; the",
            "reason is in that step's output, and apt's errors can come after the",
            "summary. The sandbox is kept so you can look inside:",
            f"  msbctl shell {box.name}",
            "Fix the cause (usually a missing egress rule), then:",
            f"  msbctl rebuild {box.name}"):
        print(f"   {line}", file=sys.stderr)


def bootstrap_payload(box):
    """Ship bootstrap.sh in over stdin rather than mounting it.

    The guest can only see the project and the profile directory, and bootstrap.sh
    lives in neither — this file is in the msb-manager checkout, which is
    deliberately not mounted. Writing it in and running it keeps the manager's
    own code outside every sandbox's reach.
    """
    with open(BOOTSTRAP, encoding="utf-8") as fh:
        body = fh.read()
    versions = box.versions()
    boot = box.project_cfg.get("bootstrap", {})
    env = {
        "MSB_NODE_MAJOR": str(versions.get("node", "22")),
        "MSB_GITLEAKS_VERSION": str(versions.get("gitleaks", "8.30.1")),
        "MSB_GH_VERSION": str(versions.get("gh", "2.102.0")),
        "MSB_BUN_VERSION": str(versions.get("bun", "1.4.2")),
        "MSB_EXTRA_PACKAGES": " ".join(boot.get("packages", [])),
        # Default TRUE: this manager exists to run agents, so an explicit
        # opt-out is the right shape rather than an explicit opt-in.
        "MSB_WANT_CLAUDE": "0" if boot.get("claude") is False else "1",
        "MSB_WANT_BUN": "1" if boot.get("bun") else "0",
        "MSB_WANT_GITLEAKS": "1" if boot.get("gitleaks") else "0",
        "MSB_PROJECT_DIR": box.guest_project,
        "MSB_PROJECT_SCRIPT": boot.get("script", ""),
        "MSB_CONTAINERS_STORAGE": boot.get("containers_storage", ""),
        "MSB_CACHE_LINKS": " ".join(f"{src}:{dest}" for src, dest in box.cache_links),
    }
    exports = "\n".join(f"export {k}={shq(v)}" for k, v in env.items())
    return (f"cat >/tmp/bootstrap.sh <<'MSB_BOOTSTRAP_EOF'\n{body}\n"
            f"MSB_BOOTSTRAP_EOF\nchmod +x /tmp/bootstrap.sh\n{exports}\n"
            "/tmp/bootstrap.sh\n")


def shq(value):
    """Single-quote for sh. Values here are config-derived, never secrets."""
    return "'" + str(value).replace("'", "'\\''") + "'"


def cmd_start(args, config):
    box = Sandbox(args.name, config)
    table = msb_table()
    if state_of(box.name, table) == "absent":
        do_create(box)
    else:
        ensure_running(box, table)
    print_one(box, msb_table())


def cmd_stop(args, config):
    box = Sandbox(args.name, config)
    run(["msb", "stop", box.name], check=False)
    stop_agent_filter(box)
    note(f"{box.name} stopped — installed packages and state are kept")


def cmd_rebuild(args, config):
    box = Sandbox(args.name, config)
    say(f"Rebuilding {box.name}")
    note("network rules, mounts and the image are fixed at create time, so")
    note("changing any of them means this (cpus, memory and the root disk do not:")
    note("`msbctl resize`). Packages installed")
    note("by hand are lost; anything in bootstrap.sh comes back. Package caches,")
    note("container images and the Claude state are kept.")
    run(["msb", "stop", box.name], check=False, quiet=True)
    run(["msb", "rm", box.name], check=False, quiet=True)
    do_create(box)
    print_one(box, msb_table())


def cmd_purge(args, config):
    box = Sandbox(args.name, config)
    secret = os.path.join(SECRETS_DIR, f"{box.name}.env")
    entry = os.path.join(REGISTRY_DIR, f"{box.name}.toml")

    say(f"Purging {box.name}")
    note("This deletes, in this order:")
    note(f"  the sandbox          {box.name}")
    note(f"  its Claude state     {tilde(box.state)}")
    owned = box.owned_volumes()
    if owned:
        note(f"  its disk volumes     {', '.join(owned)}  (package caches, container images)")
    if os.path.isfile(secret):
        note(f"  its token            {tilde(secret)}  (revoke it on GitHub too)")
    note(f"  its registration     {tilde(entry)}")
    note("")
    note(f"The project itself is NOT touched: {tilde(box.project)}")
    if not args.yes and not confirm(f"purge {box.name}?"):
        return

    run(["msb", "stop", box.name], check=False, quiet=True)
    run(["msb", "rm", box.name], check=False, quiet=True)
    stop_agent_filter(box)
    shutil.rmtree(box.state, ignore_errors=True)
    remove_sandbox_volumes(box)
    for path in (secret, entry):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass  # never had one, or already gone
    cache = read_json(VERSIONS_CACHE)
    cache.pop(box.name, None)
    write_json(VERSIONS_CACHE, cache)
    note(f"{box.name} purged")
    if box.repo:
        note("Revoke its PAT: https://github.com/settings/personal-access-tokens")


# ------------------------------------------------------------- rename and move
#
# msb can rename neither a sandbox nor a volume, so a new name is a new VM: the
# old one is removed and, if it existed, created again under the new name — the
# cost of a rebuild. Everything msbctl itself keys by name moves with it; the
# disk volumes stay where they are and the entry's `volumes` key keeps pointing
# at them. A new project folder is a create-time mount, so that is a rebuild too.

SANDBOX_NAME = re.compile(r"[a-z0-9][a-z0-9-]*")


def name_problem(name, renaming=None):
    """Why `name` cannot be given to a new (or the renamed) sandbox, or None."""
    if not SANDBOX_NAME.fullmatch(name):
        return "name must be lowercase letters, digits and dashes"
    if name == renaming:
        return f"it is already called {name}"
    if os.path.exists(registry_path_for(name)):
        return f"{name} is already registered ({tilde(registry_path_for(name))})"
    # A renamed sandbox still owns volumes under its old name; a second sandbox
    # taking that name would mount the same disks.
    for other in registered():
        if other != renaming and read_toml(registry_path_for(other)).get("volumes") == name:
            return f"{name} is still the disk-volume prefix of {other} (it was renamed from it)"
    if state_of(name) != "absent":
        return f"msb already has a sandbox called {name} that msbctl does not manage"
    return None


def _follow_rename_in_comments(path, old, new):
    """The entry's comments name the sandbox (`msbctl keys old`); keep them right.
    Comment lines only, and only where a command or the header names it."""
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
    command = re.compile(rf"(msbctl [a-z-]+ (?:add |rm |ls )?){re.escape(old)}(?![\w.-])")
    for i, line in enumerate(lines):
        if line.lstrip().startswith("#"):
            line = command.sub(rf"\g<1>{new}", line)
            lines[i] = re.sub(rf"^# {re.escape(old)} — ", f"# {new} — ", line)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


def rename_sandbox(box, new):
    """Move everything msbctl keeps under `box.name` to `new`, removing the old VM.
    Returns whether there was a VM, so the caller can create it again."""
    old = box.name
    moves = [(os.path.join(SECRETS_DIR, f"{old}.env"), os.path.join(SECRETS_DIR, f"{new}.env")),
             (box.state, os.path.join(STATE_DIR, "claude", new)),
             (os.path.join(AGENT_DIR, f"{old}.log"), os.path.join(AGENT_DIR, f"{new}.log"))]
    # Checked before anything is destroyed, so a refusal leaves it all as it was.
    clash = [dst for src, dst in moves if os.path.exists(src) and os.path.exists(dst)]
    if clash:
        die(f"left over from an earlier {new}: {', '.join(tilde(p) for p in clash)} — "
            "move it out of the way first")

    existed = state_of(old) != "absent"
    if existed:
        run(["msb", "stop", old], check=False, quiet=True)
        run(["msb", "rm", old], check=False, quiet=True)
        if state_of(old) != "absent":
            die(f"could not remove the sandbox {old} — nothing has been renamed")
    stop_agent_filter(box)

    entry = registry_path_for(new)
    os.replace(registry_path(box), entry)
    set_toml_key(entry, "name", new)
    if box.owned_volumes():
        # Pinned to the volumes that exist, or dropped when renamed back to them.
        set_toml_key(entry, "volumes", None if box.volume_prefix == new else box.volume_prefix)
    else:
        set_toml_key(entry, "volumes", None)
    _follow_rename_in_comments(entry, old, new)
    for src, dst in moves:
        if os.path.exists(src):
            os.replace(src, dst)
    cache = read_json(VERSIONS_CACHE)
    if old in cache:
        cache[new] = cache.pop(old)
        write_json(VERSIONS_CACHE, cache)
    return existed


def explain_rename():
    note("msb cannot rename a sandbox, so this removes it and creates it again under")
    note("the new name, like a rebuild: packages installed by hand are lost, anything")
    note("in bootstrap.sh comes back. Settings, secrets, the Claude state, package")
    note("caches and container images all move with it.")


def cmd_rename(args, config):
    box = Sandbox(args.name, config)
    problem = name_problem(args.new, renaming=box.name)
    if problem:
        die(problem)
    say(f"Renaming {box.name} to {args.new}")
    if state_of(box.name) != "absent":
        explain_rename()
        if not args.yes and not confirm(f"rename {box.name} to {args.new}?"):
            return
    existed = rename_sandbox(box, args.new)
    note(f"renamed: {tilde(registry_path_for(args.new))}")
    if existed:
        box = Sandbox(args.new, config)
        do_create(box)
        print_one(box, msb_table())


def move_project(box, raw, config):
    """Point `box` at another project folder (typed as for `add`). True if it changed.
    The old folder may already be gone: moving a checkout is the usual reason."""
    project = resolve_project(raw, config)
    if project == box.project:
        note(f"{box.name} already uses {tilde(project)}")
        return False
    if not os.path.isdir(project):
        die(f"not a directory: {tilde(project)}")

    # The portable half of the config lives in the project. A clone of a repo
    # that commits .msb/ brings it along; a bare folder needs it copied over.
    old_msb, new_msb = os.path.join(box.project, ".msb"), os.path.join(project, ".msb")
    if not os.path.isfile(os.path.join(project, box.conf)):
        missing = ([f for f in sorted(os.listdir(old_msb))
                    if not os.path.exists(os.path.join(new_msb, f))]
                   if os.path.isdir(old_msb) else [])
        if not missing:
            die(f"{tilde(project)} has no {box.conf}, and there is none to copy from "
                f"{tilde(box.project)} — `msbctl add` it as a new sandbox instead")
        note(f"{tilde(project)} has no {box.conf}; the old folder has: {', '.join(missing)}")
        if not confirm(f"copy {'it' if len(missing) == 1 else 'them'} over?"):
            die("cancelled — nothing changed")
        os.makedirs(new_msb, exist_ok=True)
        for f in missing:
            src = os.path.join(old_msb, f)
            (shutil.copytree if os.path.isdir(src) else shutil.copy2)(src, os.path.join(new_msb, f))
        note(f"copied into {tilde(new_msb)}")

    path = registry_path(box)
    set_toml_key(path, "project", project)
    note(f"project    {tilde(project)}")
    repo = github_repo(project)
    if repo and repo != box.repo:
        set_toml_key(path, "repo", repo)
        note(f"repo       {repo}  (was {box.repo or 'none'})")
        if read_env_file(os.path.join(SECRETS_DIR, f"{box.name}.env")).get("GH_TOKEN"):
            warn(f"its GitHub token was made for {box.repo or 'another repo'} — "
                 f"`msbctl edit {box.name}` → GitHub token to replace it")
    return True


def cmd_move(args, config):
    box = Sandbox(args.name, config)
    if not move_project(box, args.dir, config):
        return
    if state_of(box.name) == "absent":
        note("not created yet, so it applies at first start")
    elif args.rebuild or confirm(f"the folder is mounted at create time — rebuild {box.name} now?"):
        cmd_rebuild(argparse.Namespace(name=box.name), config)
    else:
        note(f"until then it still sees the old folder: `msbctl rebuild {box.name}`")


# `shell` and `exec` pass every flag msbctl does not use itself straight to
# `msb exec` (split off in split_msb_flags(), before argparse sees them), so
# `-u root`, `--timeout 5m`, `-e KEY=value` and whatever later msb versions add
# work without a table here to keep in step. msbctl adds `--tty` (shell) and
# `-w` itself, and msb refuses either twice, so those are only left out when
# the caller already gave one.
MSB_EXEC_HINT = ("any other flag goes to `msb exec` as is (`msb exec --help` lists "
                 "them), e.g. -u root, --timeout 5m, -e KEY=value; give them after "
                 "the name, and for exec before --")


def split_msb_flags(argv, verb):
    """argv with the msb flags of `exec`/`shell` at argv[verb] taken out, and
    those flags. They follow the name (which may be left out); for exec they
    end at `--`. `-h` stays behind for argparse. An exec with no name before
    its flags or `--` gets `.`, this folder's sandbox."""
    head, rest = argv[:verb + 1], argv[verb + 1:]
    name = []
    if rest and not rest[0].startswith("-"):
        name, rest = rest[:1], rest[1:]
    tail = []
    if argv[verb] == "exec":
        if "--" in rest:
            cut = rest.index("--")
        elif rest and rest[0].startswith("-"):
            cut = len(rest)
        else:
            return argv, []          # `exec . make -j4`: all of it is the command
        if rest[:1] and not rest[0].startswith("-"):
            return argv, []          # `exec x git log -- file`: so is this
        rest, tail = rest[:cut], rest[cut:]
        name = name or ["."]
    helps = [a for a in rest if a in ("-h", "--help")]
    flags = [a for a in rest if a not in ("-h", "--help")]
    return head + helps + name + tail, flags


def gave_flag(flags, short, long):
    """True if `flags` already has this option, in any of its spellings."""
    return any(f == long or f.startswith(long + "=")
               or (short and f.startswith(short)) for f in flags)


def msb_exec_argv(box, flags, want_tty=False):
    cmd = ["msb", "exec", box.name]
    if want_tty and not any(gave_flag(flags, s, l) for s, l in (
            ("-t", "--tty"), (None, "--no-tty"), (None, "--stream"))):
        cmd.append("--tty")
    cmd += ["-e", f"SSH_AUTH_SOCK={GUEST_AGENT_SOCK}"]
    if not gave_flag(flags, "-w", "--workdir"):
        cmd += ["-w", guest_workdir(box)]
    return cmd + flags


def cmd_shell(args, config):
    box = Sandbox(args.name, config)
    ensure_running(box)
    os.execvp("msb", [*msb_exec_argv(box, args.msb_flags, want_tty=True), "--", "bash", "-l"])


def cmd_exec(args, config):
    box = Sandbox(args.name, config)
    # argparse.REMAINDER keeps the `--` separator, so `msbctl exec x -- ls`
    # would otherwise run a command literally named "--".
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        die("exec needs a command")
    ensure_running(box)
    os.execvp("msb", [*msb_exec_argv(box, args.msb_flags), "--", *command])


def cmd_reclaim(args, config):
    box = Sandbox(args.name, config)
    # Page cache is never returned on its own, whether written to the guest
    # disk or through a virtiofs mount, so a sandbox that builds things drifts
    # up to its memory ceiling and stays there. This gives it back in about a
    # second. Anonymous memory needs no help.
    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c",
         "sync; echo 3 > /proc/sys/vm/drop_caches; echo reclaimed"], check=False)


def cmd_code(args, config):
    box = Sandbox(args.name, config)
    editor = os.environ.get("MSB_EDITOR", "codium")
    if not shutil.which(editor):
        die(f"{editor} is not on PATH — set MSB_EDITOR to the one you use")
    # Detached: the picker that invoked this should not wait for the editor,
    # and closing the terminal should not close the editor.
    subprocess.Popen([editor, box.project],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    note(f"{editor} opening {tilde(box.project)}")
    note(f"From its terminal: msbctl shell {box.name}")


def confirm(question):
    try:
        return input(f"   {question} [y/N] ").strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


