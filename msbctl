GH_SPEC = "GH_TOKEN@github.com,api.github.com"


def _github_state(box):
    own = read_env_file(os.path.join(SECRETS_DIR, f"{box.name}.env"))
    bound = box.is_repo or box.project_cfg.get("secrets", {}).get("github", bool(box.repo))
    return bool(own.get("GH_TOKEN")), bool(bound)


def _summary_github(box):
    if not box.repo:
        return "no GitHub repo recorded"
    stored, bound = _github_state(box)
    if stored and bound:
        return "token stored and bound"
    if stored:
        return "token stored, not bound"
    return "no token (git over SSH still works)"


def section_github(box, config, ctx):
    """This sandbox's fine-grained PAT, for the GitHub API (PRs, CI reads) — git push
    over SSH does not use it. Set, replace or remove; applied to a running sandbox
    with `msb modify`, no rebuild."""
    # A repo sandbox always binds a stored token (see secret_env), so there is
    # no project switch to flip.
    project = None if box.is_repo else require_project_file(box)
    say("GitHub token")
    if not box.repo:
        raw = ask("GitHub repo this sandbox works on (owner/name or URL, blank to cancel)")
        repo = parse_github_url(raw) or raw
        if not repo:
            return
        set_toml_key(registry_path(box), "repo", repo)
        box = Sandbox(box.name, config)
    stored, bound = _github_state(box)
    note(f"repository: {box.repo}")
    note(f"token: {'stored' if stored else 'not set'}, {'bound to github.com / api.github.com' if bound else 'not bound'}")
    action = choose_one("GitHub token", ["paste a token (new or a replacement)",
                                         "remove the token", "back"], 0)
    state = state_of(box.name)
    if action.startswith("paste"):
        github_token_help(box.repo)
        if not capture_token(box.name):
            return
        if project:
            set_toml_key(project, "github", True, table="secrets")
        # A running guest keeps its current placeholder bindings until restarted.
        restart = state == "running" and confirm(f"apply now — this restarts {box.name}?")
        bind_secret_live(box, config, GH_SPEC, restart)
    elif action.startswith("remove"):
        set_env_file_value(os.path.join(SECRETS_DIR, f"{box.name}.env"), "GH_TOKEN", None)
        if project:
            set_toml_key(project, "github", False, table="secrets")
        note("removed; git over SSH is unaffected")
        if state != "absent":
            _, env = Sandbox(box.name, config).secret_env()
            # msb applies a removal live: the value stops being substituted at once.
            run(["msb", "modify", box.name, "--secret-rm", "GH_TOKEN"], env=env, check=False)


