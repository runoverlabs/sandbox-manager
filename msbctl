    return f"{box.name}, {box.location} at {box.guest_project}"


def section_place(box, config, ctx):
    say("Name & project folder")
    if box.is_repo:
        note(f"a clone of {box.repo}: there is no host folder to move")
    else:
        note("a bare name resolves as for `msbctl add`; / ~ ./ ../ are taken as written")
        raw = ask("project folder", tilde(box.project))
        if resolve_project(raw, config) != box.project and move_project(box, raw, config):
            ctx["rebuild"].add("project folder")
            box = Sandbox(box.name, config)
    current = box.guest_path_setting
    chosen = (ask("where the clone is in the sandbox (no dots)", current) if box.is_repo
              else pick_guest_path(box.project, current))
    if chosen != current and set_toml_key(registry_path(box), "guest_path", chosen):
        ctx["rebuild"].add("project path in the sandbox")
        box = Sandbox(box.name, config)
    new = ask("sandbox name", box.name)
    if new == box.name:
        return
    problem = name_problem(new, renaming=box.name)
    if problem:
        die(problem)
    if state_of(box.name) != "absent":
        refuse_before_create(box)
        explain_rename()
        if not confirm(f"rename {box.name} to {new} now?"):
            return
    existed = rename_sandbox(box, new)
    ctx["name"] = new
    note(f"renamed to {new}")
    if existed:
        # A fresh create applies everything, including what was waiting for a rebuild.
        do_create(Sandbox(new, config))
        ctx["rebuild"].clear()
        ctx["hand_edited"] = False


