def _recover_broken(name, message):
    """A file this sandbox reads no longer parses, so no menu can be built from it.
    Offer to open the files; True to retry, False to give up."""
    warn(message)
    files = [("registry entry   machine-local", registry_path_for(name))]
    try:
        with open(registry_path_for(name), encoding="utf-8") as fh:
            m = re.search(r'^\s*project\s*=\s*"([^"]+)"', fh.read(), re.M)
        if m:
            project = os.path.join(os.path.expanduser(m.group(1)), ".msb", "sandbox.toml")
            if os.path.isfile(project):
                files.append(("sandbox.toml     this project", project))
    except OSError:
        pass  # the entry is unreadable: offer it alone
    label = choose_one("fix which file", [l for l, _ in files] + ["give up"], 0)
    if label == "give up":
        return False
    edit_file(dict(files)[label])
    return True


def registry_path_for(name):
    return os.path.join(REGISTRY_DIR, f"{name}.toml")


def cmd_edit(args, config):
    name = args.name
    if not os.path.isfile(registry_path_for(name)):
        die(f"no sandbox named {name!r} — `msbctl ls` to see what exists")
    ctx = {"rebuild": set(), "hand_edited": False}
    default = 0
    while True:
        try:
            box = Sandbox(name, config)
        except SystemExit as exc:               # a file was left unparseable
            if _recover_broken(name, str(exc.code or "").replace("msbctl: ", "", 1)):
                ctx["hand_edited"] = True
                continue
            return
        rows = [f"{title:<20} {summary(box)}" for title, _, summary in EDIT_SECTIONS]
        rows += ["View the CLAUDE.md it gets", "Edit the files in your editor", "Done"]
        say(f"Edit {name}  [{state_of(name)}]")
        if ctx["rebuild"]:
            note(f"{DIM}needs a rebuild: {', '.join(sorted(ctx['rebuild']))}{RESET}")
        choice = choose_one("section", rows, default)
        default = rows.index(choice)
        if choice == "Done":
            break
        try:
            if choice.startswith("Edit the files"):
                section_files(box, config, ctx)
            elif choice.startswith("View the CLAUDE.md"):
                section_claude_md(box, config, ctx)
            else:
                EDIT_SECTIONS[default][1](box, config, ctx)
        except SystemExit as exc:               # a section's escape/die must not end the menu
            text = str(exc.code or "").replace("msbctl: ", "", 1).strip()
            if text and "cancelled" not in text:
                warn(text)
        name = ctx.get("name", name)            # "Name & folder" may have renamed it

    if not (ctx["rebuild"] or ctx["hand_edited"]):
        return
    if state_of(name) == "absent":
        note("not created yet, so everything applies at first start")
        return
    why = ", ".join(sorted(ctx["rebuild"])) or "the files you edited by hand"
    note(f"These only take effect when the sandbox is created: {why}.")
    if confirm(f"rebuild {name} now?"):
        cmd_rebuild(argparse.Namespace(name=name), config)
    else:
        note(f"later: msbctl rebuild {name}")


def cmd_resize(args, config):
    """Change cpus, memory or root disk of an EXISTING sandbox, keeping its
    state. Uses `msb modify`: the root disk grows live; cpus and memory need a
    restart, not a rebuild. Recorded in the registry entry so a later rebuild
    reproduces it."""
    box = Sandbox(args.name, config)
    state = state_of(box.name)
    if state == "absent":
        die(f"{box.name} has not been created yet — `msbctl start {box.name}`")

    cpus, memory, disk = args.cpus, args.memory, args.root_disk
    if cpus is None and memory is None and disk is None:
        say(f"Resize {box.name}")
        note(f"now: {box.cpus} cpu, {box.memory}, {box.root_disk} root disk")
        plan = {}
        pick_resources(plan, config, current=(int(box.cpus), str(box.memory)))
        cpus, memory = plan["cpus"], plan["memory"]
        note("")
        note("The root disk can only grow, never shrink.")
        disk = pick_size("root disk", ROOT_DISKS, str(box.root_disk))
    cpus = None if cpus is None or str(cpus) == str(box.cpus) else int(cpus)
    memory = None if memory is None or memory == str(box.memory) else memory
    disk = None if disk is None or disk == str(box.root_disk) else disk
    if cpus is None and memory is None and disk is None:
        note("nothing to change")
        return

    argv = ["msb", "modify", box.name]
    if cpus is not None:
        argv += ["--cpus", str(cpus)]
    if memory is not None:
        argv += ["--memory", memory]
    if disk is not None:
        argv += ["--root-disk", disk]
    # msb modify validates EVERY secret bound to the sandbox, not only a changed
    # one, and refuses if any host variable is unset — so hand it all of them.
    _, secret_vars = box.secret_env()
    run(argv + ["--dry-run"], env=secret_vars)
    needs_restart = state == "running" and (cpus is not None or memory is not None)
    if needs_restart and not args.yes and not confirm(
            f"apply — this restarts {box.name}, ending its open sessions?"):
        return
    if run(argv + (["--restart"] if needs_restart else []), env=secret_vars,
           check=False).returncode:
        die("msb modify failed — nothing recorded")
    if cpus is not None:
        set_entry_value(box, "cpus", str(cpus))
    if memory is not None:
        set_entry_value(box, "memory", f'"{memory}"')
    if disk is not None:
        set_entry_value(box, "root_disk", f'"{disk}"')
    note(f"{box.name} resized; recorded in {tilde(os.path.join(REGISTRY_DIR, box.name + '.toml'))}"
         " so a rebuild keeps it")


def cmd_config(args, config):
    """The merged configuration, each value tagged with the layer it came from."""
    local = dict(_flatten(read_toml(CONFIG_FILE)))
    shipped = dict(_flatten(read_toml(DEFAULTS_FILE)))
    say("Configuration")
    note(f"shipped  {tilde(DEFAULTS_FILE)}")
    note(f"local    {tilde(CONFIG_FILE)}"
         + ("" if os.path.exists(CONFIG_FILE) else "  (none — all defaults)"))
    note("")
    for path, value in _flatten(config):
        if path.startswith("rules.") and isinstance(value, list):
            value = f"{len(value)} rule(s)"
        elif isinstance(value, list):
            value = json.dumps(value)
        origin = ("local" if path in local else "shipped")
        if origin == "local" and path in shipped:
            origin = "local, overrides shipped"
        note(f"  {path:<34} {value}   {DIM}{origin}{RESET}")


def cmd_ls(args, config):
    names = registered()
    if not names:
        note("nothing registered yet — `msbctl add` in a project directory")
        return
    table = msb_table()
    cache = read_json(VERSIONS_CACHE)
    if args.refresh:
        cache = refresh_versions(names, config, cache)

    rows = []
    for name in names:
        box = Sandbox(name, config)
        info = cache.get(name, {})
        pending = sorted(c for c, v in info.items()
                         if isinstance(v, dict) and v.get("available")
                         and v.get("installed")
                         and v["available"] != v["installed"])
        rows.append((name, state_of(name, table), tilde(box.project),
                     ",".join(pending) or "-", "yes" if box.autostart else "no"))

    if args.porcelain:
        for row in rows:
            print("\t".join(row))
        return

    if args.picker:
        # `name<TAB>pre-padded display text`.
        #
        # The padding has to happen HERE. fzf's --with-nth renders the original
        # delimiter between the fields it shows, so a tab-separated row reaches
        # the terminal with real tabs in it and each one jumps to the next
        # 8-column stop: a 7-character name gets one space, an 8-character name
        # gets eight. Only one tab survives, between the name and the display
        # text, and --with-nth=2.. hides it.
        order = [0, 1, 3, 2]          # name, state, updates, project
        widths = [max(len(str(r[i])) for r in rows) for i in range(5)]
        for row in rows:
            shown = "  ".join(str(row[i]).ljust(widths[i]) for i in order)
            print(f"{row[0]}\t{shown.rstrip()}")
        return

    widths = [max(len(str(r[i])) for r in [("NAME", "STATE", "PROJECT",
                                            "UPDATES", "AUTOSTART")] + rows)
              for i in range(5)]
    header = ("NAME", "STATE", "PROJECT", "UPDATES", "AUTOSTART")
    print(BOLD + "  ".join(h.ljust(w) for h, w in zip(header, widths, strict=True)) + RESET)
    for row in rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(row, widths, strict=True)))


def cmd_entry(args, config):
    """Open one sandbox's registry entry in a terminal editor.

    A subcommand rather than a menu item so the picker can bind a key to it:
    choosing which sandbox to edit belongs where the sandboxes are listed, not
    on the top-level menu.
    """
    Sandbox(args.name, config)          # fails loudly if it is not registered
    edit_file(os.path.join(REGISTRY_DIR, f"{args.name}.toml"))
    note("resources, rules and [env] need `msbctl rebuild`;")
    note("identity and autostart take effect on the next start.")


def version_lines(box, info):
    """The right-hand pane's version rows for one sandbox.

    A component this sandbox does not have (bun without `bun = true`) is left
    out, including from an old cache that still holds it. One that is current
    says so instead of drawing an arrow to the same number."""
    lines = []
    for comp in sorted(k for k in info if isinstance(info[k], dict)):
        if comp != "image" and not box.wants_component(comp):
            continue
        got = info[comp]
        installed, available = got.get("installed"), got.get("available")
        if installed and available and installed == available:
            lines.append(f"{comp:<10} {installed:<22} {GREEN}up to date{RESET}")
        elif installed and available:
            mark = "  UPDATE (rebuild required — fixed at create time)" if comp == "image" else "  UPDATE"
            lines.append(f"{comp:<10} {installed:<22} -> {available}{mark}")
        elif installed:
            lines.append(f"{comp:<10} {installed:<22} {DIM}(latest unknown){RESET}")
        elif available:
            lines.append(f"{comp:<10} {'not detected':<22} {DIM}(latest {available}){RESET}")
        else:
            lines.append(f"{comp:<10} {DIM}unknown{RESET}")
    return lines


