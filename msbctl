def section_identity(box, config, ctx):
    path = registry_path(box)
    idents = sorted(config.get("identities", {}))
    if idents:
        options = ["(none)"] + idents
        current = box.identity_name if box.identity_name in idents else "(none)"
        choice = choose_one("git identity", options, options.index(current))
        set_toml_key(path, "identity", "" if choice == "(none)" else choice)
        note("applied on the next start")
