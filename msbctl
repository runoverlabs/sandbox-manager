def _summary_caches(box):
    return ", ".join(f"{k} {v}" for k, v in box.caches.items()) or "none"


def section_caches(box, config, ctx):
    keys = [k for k in current_features(box) if k in CACHES]
    if not keys:
        note("no package-manager feature is on — add one under 'Features & agents' first")
        return
    say("Package caches")
    note("A disk per package manager: fast, capped, kept across rebuilds, deleted by purge.")
    size = pick_size("cache size (each)", CACHE_SIZES,
                     next(iter(box.caches.values()), "5G"),
                     extra=[("none     no caches", None)])
    target = edit_target(box, "caches")
    wanted = {k: size for k in keys} if size else {}
    changed = False
    for key in list(box.caches):
        if key not in wanted:
            changed |= set_toml_key(target, key, None, table="caches")
    for key, value in wanted.items():
        changed |= set_toml_key(target, key, value, table="caches")
    vols = msb_volumes()
    for key in wanted:
        have = vols.get(box.cache_volume(key))
        if have and have["capacity_bytes"] != size_bytes(size):
            note(f"{key}: the existing volume stays {human_size(have['capacity_bytes'])}; "
                 f"`msbctl cache {box.name} clear {key}` to recreate it at {size}")
    if changed:
        ctx["rebuild"].add("package caches")


def _summary_containers(box):
    if box.containers_disk:
        return f"{box.containers_disk} disk"
    return "fuse-overlayfs" if boot_cfg(box).get("containers_storage") else "not set"


