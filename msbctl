def version_string():
    """`0.1.0` for a packaged install; `0.1.0+abc1234 (git checkout)` from a clone."""
    try:
        with open(VERSION_FILE, encoding="utf-8") as fh:
            base = fh.read().strip() or "unknown"
    except OSError:
        base = "unknown"
    if not IS_CHECKOUT:
        return base
    sha = subprocess.run(["git", "-C", HERE, "rev-parse", "--short", "HEAD"],
                         capture_output=True, text=True).stdout.strip()
    return f"{base}+{sha} (git checkout)" if sha else f"{base} (git checkout)"


