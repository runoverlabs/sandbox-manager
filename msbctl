def image_short(image):
    """`mcr.microsoft.com/devcontainers/base:ubuntu@sha256:edfb…` -> `base:ubuntu`.

    For display only. The pinned digest is the thing that matters and the thing
    nobody can read at a glance, so the sidebar shows the part that identifies
    the image to a human and `msbctl show` keeps the full value.
    """
    if not image:
        return "-"
    image = image.split("@", 1)[0]
    return image.rsplit("/", 1)[-1] or image


def guest_usage(name):
    """(mem_used_mb, mem_total_mb, load, cpus) read from inside the guest.

    From /proc rather than from `msb ls`, because only columns 0 and 2 of that
    table are known to this tool and guessing at the rest is how a sidebar ends
    up confidently wrong. One exec per RUNNING sandbox, which is why the menu
    renders this once into a file rather than on every cursor move.
    """
    probe = (
        "awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} "
        "END{printf \"MEM=%d/%d \", (t-a)/1024, t/1024}' /proc/meminfo; "
        "awk '{printf \"LOAD=%s \", $1}' /proc/loadavg; "
        "printf 'CPUS=%s\\n' \"$(nproc)\""
    )
    proc = subprocess.run(["msb", "exec", name, "--no-tty", "--", "sh", "-c", probe],
                          capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if proc.returncode != 0:
        return None
    out = proc.stdout.replace("\r", " ")
    fields = {}
    for token in out.split():
        key, _, value = token.partition("=")
        if value:
            fields[key] = value
    mem = fields.get("MEM", "")
    if "/" not in mem:
        return None
    used, _, total = mem.partition("/")
    try:
        return int(used), int(total), fields.get("LOAD", "?"), fields.get("CPUS", "?")
    except ValueError:
        return None


def cmd_status(args, config):
    """The sidebar. One block per sandbox, this machine's and then each
    remote's; stdout so it can be piped or cached."""
    names = registered()
    remotes = configured_remotes(config)
    if names or not remotes:
        local_status(args, config, names)
    if remotes:
        remote_status(args, config, remotes, gap=bool(names))


def remote_status(args, config, remotes, gap):
    """Each remote's sandboxes, one line each. --quick reads what `ls` last
    cached and runs no ssh; otherwise the remotes are asked first, as `ls`
    asks them (a host that just failed is left alone for a minute)."""
    if not args.quick:
        remote_ls_rows(verb_args("ls"), config)
    for index, host in enumerate(sorted(remotes)):
        if gap or index:
            print()
        cache = read_json(_remote_cache_path(host))
        rows = cache.get("sandboxes")
        age = f"  {DIM}{_age(time.time() - cache['at'])} ago{RESET}" if cache.get("at") else ""
        print(f"{BOLD}{host}{RESET}  {DIM}{remotes[host].get('ssh', '')}{RESET}{age}")
        if cache.get("failed_at", 0) > cache.get("at", 0):
            print(f"   {RED}{cache.get('reason', 'unreachable')}{RESET}")
        if rows is None:
            print(f"   {DIM}not listed yet{RESET}")
            continue
        if not rows:
            print("   nothing registered")
        pad = max((len(r.get("name", "")) for r in rows), default=0)
        for r in rows:
            mark = "●" if r.get("state") == "running" else "○"
            print(f"{mark} {host}:{r.get('name', '?')}{' ' * (pad - len(r.get('name', '')))}  "
                  f"{DIM}{r.get('state', '?')}{RESET}")
            print(f"   repo   {r.get('location', '')}")


def local_status(args, config, names):
    if not names:
        print("   nothing registered")
        print("   `msbctl add` in a project directory")
        return
    table = msb_table()
    pad = max(len(n) for n in names)
    for index, name in enumerate(names):
        if index:
            print()
        box = Sandbox(name, config)
        state = state_of(name, table)
        mark = "●" if state == "running" else "○"
        # ljust so the state column starts at the same place for every row;
        # the padding is outside the bold escape, which would otherwise count
        # toward the width.
        print(f"{BOLD}{mark} {name}{RESET}{' ' * (pad - len(name))}  "
              f"{DIM}{state}{RESET}")

        if state == "running":
            usage = guest_usage(name) if not args.quick else None
            if usage:
                used, total, load, cpus = usage
                print(f"   ram    {used}M / {total}M      cpu  load {load} on {cpus}")
            else:
                print(f"   ram    {DIM}unreadable{RESET}        cpu  {DIM}-{RESET}")
        else:
            # The ceiling, not usage: nothing is running to measure.
            print(f"   ram    {DIM}{box.memory} ceiling{RESET}     cpu  {DIM}{box.cpus}{RESET}")

        # Two lines: `name <email>` is 50+ characters and the sidebar pane is
        # ~60 wide, so one line wraps at an arbitrary point on every render.
        ident = box.identity
        if ident:
            print(f"   as     {ident['name']}")
            print(f"          {DIM}{ident['email']}{RESET}")
            if box.signing_fp:
                print(f"          {DIM}signs commits{'' if box.signing_active else ' (key not allowed: off)'}{RESET}")
        else:
            print(f"   as     {DIM}no identity — a repo without one cannot commit{RESET}")
        print(f"   image  {image_short(box.image_or_none())}")
        print(f"   {'repo' if box.is_repo else 'dir '}   {box.location}")
        if box.observing:
            # Unmissable in the sidebar: this one is not enforcing anything, and
            # a sandbox silently left that way is the failure mode of the whole
            # feature.
            print(f"   {RED}{BOLD}egress OBSERVED, NOT BLOCKED{RESET}")


