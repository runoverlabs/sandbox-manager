WELCOME_TEXT = """\
msbctl runs each project in its own microVM: egress is deny-by-default, and your
tokens never enter the VM — the sandbox holds a placeholder and the real value is
substituted on the way out. Five one-time settings make it yours. Every one is
optional, and `msbctl setup` brings you back to any of them later."""


def release_tuple(text):
    """(0, 5, 2) for "0.5.2", "v0.5.2" or a checkout's "0.5.2+abc1234 (git
    checkout)", else None."""
    found = re.match(r"v?(\d+)\.(\d+)\.(\d+)(?:$|[+ ])", str(text or ""))
    return tuple(int(g) for g in found.groups()) if found else None


def self_update_problem(version):
    """Why `self-update --version VERSION` may not run under host serve, or
    None. Only forward or the same release: the way down is to a weaker host
    serve, the very thing that decides what this key may do."""
    want, have = release_tuple(version), release_tuple(version_string())
    if want is None:
        return f"self-update --version: {version!r} is not a release like 0.5.2"
    if have is None or want < have:
        return "self-update --version can downgrade host serve itself"
    return None


def cmd_self_update(args, config):
    """Upgrade a packaged install by re-running the get.sh that shipped with it, which
    fetches the latest (or --version) release, verifies its checksum and installs it
    next to the current one. A git checkout updates with `git pull` instead.
    --json (the Kandev plugin's Update): get.sh's output goes to stderr and the
    answer is {"msbctl_version", "updated"}, the version now installed."""
    get = os.path.join(HERE, "get.sh")
    if IS_CHECKOUT or not os.path.isfile(get):
        why = ("this is a git checkout: `git pull` updates it" if IS_CHECKOUT else
               "no get.sh beside msbctl, so this is not a packaged install — reinstall with the curl command")
        if args.json:
            raise KandevError("unsupported", why)
        note(why)
        return None
    if restricted() and args.version:
        problem = self_update_problem(args.version)
        if problem and args.json:
            raise KandevError("denied", problem)
        if problem:
            die(problem)
    # Releases are tagged vX.Y.Z; a bare 0.6.0 means the same one.
    version = f"v{args.version}" if args.version and args.version[:1].isdigit() else args.version
    argv = ["sh", get] + (["--version", version] if version else [])
    before = version_string()
    if not args.json:
        note(f"installed: {before}")
        sys.stdout.flush()
    # get.sh never reads stdin; with --json, its progress is not the document.
    if subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=2 if args.json else None).returncode:
        if args.json:
            raise KandevError("unavailable", "the update failed (get.sh's output is on stderr)")
        die("the update failed (see above)")
    # The release get.sh just switched `current` to: this process is still
    # the old one, and its own VERSION never changes.
    try:
        with open(os.path.join(os.path.dirname(os.path.dirname(HERE)), "current", "VERSION"),
                  encoding="utf-8") as fh:
            after = fh.read().strip()
    except OSError:
        if args.json:
            raise KandevError("unavailable", "get.sh finished, but no installed VERSION was found") from None
        die("get.sh finished, but no installed VERSION was found")
    proxy = kandev_restart_proxy(after)
    if args.json:
        return {"msbctl_version": after, "updated": after != before, "proxy": proxy}
    if proxy["state"] == "restarted":
        note(f"restarted the Kandev proxy, which ran {before}")
    elif proxy["state"] == "failed":
        warn(f"the Kandev proxy still runs the old release: {proxy['reason']}")
    return None


def store_claude_token(args):
    """setup --claude-token NAME [--stdin]: no menu, for a host with no one at
    it — the value arrives over stdin (from a password manager, through ssh)."""
    name = args.claude_token
    if not CLAUDE_TOKEN_NAME.fullmatch(name):
        die(f"{name!r}: a Claude token's name is lowercase letters, digits and _ "
            f"(`{CLAUDE_TOKEN_MAIN}` is the default one)")
    value = read_secret_input(f"the Claude token {name!r}", args.stdin)
    set_env_file_value(GLOBAL_ENV, claude_token_var(name), value)
    note(f"Claude token {name!r} stored in {tilde(GLOBAL_ENV)} (0600); read at each sandbox's next start")
    if args.default:
        ensure_local_config()
        set_toml_key(CONFIG_FILE, "claude_token", name, table="defaults")
        note(f"{name!r} is now the default Claude token for new sandboxes")


def store_identity(args):
    """setup --identity KEY --git-name N --git-email E [--default]: what the
    identities menu writes, with no menu — how `remote setup` copies a
    laptop's identities to a host. No signing key: that needs an ssh-agent,
    and a host's sandboxes are given none."""
    key = args.identity
    if not NAME_SLUG.fullmatch(key):
        die(f"{key!r}: an identity's name is lowercase letters, digits and dashes, starting with a letter")
    if not args.git_name or "@" not in (args.git_email or ""):
        die("--identity needs --git-name and --git-email")
    if any(c in (args.git_name + args.git_email) for c in "\n\r\0"):
        die("a name or email cannot contain a line break")
    ensure_local_config()
    table = f"identities.{key}"
    set_toml_key(CONFIG_FILE, "name", args.git_name, table=table)
    set_toml_key(CONFIG_FILE, "email", args.git_email, table=table)
    note(f"identity {key}: {args.git_name} <{args.git_email}>")
    if args.default:
        set_toml_key(CONFIG_FILE, "identity", key, table="defaults")
        note(f"{key} is now the default identity for new sandboxes")


def cmd_setup(args, config):
    if getattr(args, "claude_token", None):
        store_claude_token(args)
        return
    if getattr(args, "identity", None):
        store_identity(args)
        return
    if getattr(args, "stdin", False):
        die("--stdin is for `msbctl setup --claude-token NAME --stdin`")
    if getattr(args, "default", False) or getattr(args, "git_name", None) or getattr(args, "git_email", None):
        die("--default, --git-name and --git-email go with --identity (or --claude-token)")
    ensure_local_config()
    welcome = getattr(args, "welcome", False)
    if welcome:
        say("Welcome")
        for line in WELCOME_TEXT.splitlines():
            note(line)
        for title, fn, _ in SETUP_SECTIONS:
            note("")
            if choose_one(f"next: {title}", ["set it up now", "skip"], 0) == "skip":
                continue
            try:
                fn(config, {})
            except SystemExit as exc:
                text = str(exc.code or "").replace("msbctl: ", "", 1).strip()
                if text and "cancelled" not in text:
                    warn(text)
        mark_welcomed()
        say("Done")
        note("Register your first project:   cd <project> && msbctl add")
        note("Change any of this later:      msbctl setup")
        return

    default = 0
    while True:
        try:
            config = load_config()
        except SystemExit as exc:
            warn(str(exc.code or "").replace("msbctl: ", "", 1))
            if confirm("open the file to fix it?"):
                section_local_file(None, {})
                continue
            return
        rows = [f"{title:<22} {summary(config)}" for title, _, summary in SETUP_SECTIONS]
        rows += ["Edit the file in your editor", "Done"]
        say("Setup")
        choice = choose_one("section", rows, default)
        default = rows.index(choice)
        if choice == "Done":
            return
        try:
            if choice.startswith("Edit the file"):
                section_local_file(config, {})
            else:
                SETUP_SECTIONS[default][1](config, {})
        except SystemExit as exc:
            text = str(exc.code or "").replace("msbctl: ", "", 1).strip()
            if text and "cancelled" not in text:
                warn(text)


# ----------------------------------------------------------------------- edit
#
# `msbctl edit <name>`: the wizard's sections as a menu, run one at a time against
# an EXISTING sandbox. Each section preselects what the sandbox has now, writes its
# answer back to the right file (portable settings to the project's sandbox.toml,
# machine-local ones to the registry entry), and says whether it takes effect now
# or needs a rebuild. Escape inside a section returns to the menu.

def registry_path(box):
    return os.path.join(REGISTRY_DIR, f"{box.name}.toml")


def project_path(box):
    return os.path.join(box.project, ".msb", "sandbox.toml")


def edit_target(box, name):
    """Where to write setting `name`: the registry entry if it already overrides it
    there (it would win otherwise), else the project's sandbox.toml."""
    if box.is_repo or name in box.entry or not os.path.isfile(project_path(box)):
        return registry_path(box)
    return project_path(box)


def require_project_file(box):
    if box.is_repo:
        die(f"this comes from {box.repo}'s .msb/sandbox.toml — change it there, push, then "
            f"`msbctl policy {box.name} update` and `msbctl rebuild {box.name}`")
    if not os.path.isfile(project_path(box)):
        die(f"{tilde(project_path(box))} does not exist, and these settings live there")
    return project_path(box)


def boot_cfg(box):
    return box.project_cfg.get("bootstrap", {})


def current_features(box):
    """Which FEATURES this sandbox has, derived from what is configured: a feature
    is on when all of its egress groups, packages and switches are present."""
    groups, packages, boot = set(box.rule_groups), set(boot_cfg(box).get("packages", [])), boot_cfg(box)
    return [key for key, _, spec in FEATURES
            if all(g in groups for g in spec["groups"])
            and all(p in packages for p in spec.get("packages", []))
            and (not spec.get("bun") or boot.get("bun"))
            and (not spec.get("gitleaks") or boot.get("gitleaks"))]


def _summary_features(box):
    feats = current_features(box)
    agents = [k for k, _, _ in AGENTS if box.wants_component(k)]
    return ", ".join(agents + feats) or "none"


def section_features(box, config, ctx):
    groups_all = sorted(g for g in config.get("rules", {}) if g != "base")
    project = require_project_file(box)
    cur = {"agents": [k for k, _, _ in AGENTS if box.wants_component(k)],
           "features": current_features(box)}
    plan = pick_features(groups_all, box.rule_groups, "", config, current=cur)
    # Packages a FEATURE brings are rewritten; any the operator added by hand stay.
    managed = {p for _, _, spec in FEATURES for p in spec.get("packages", [])}
    extras = [p for p in boot_cfg(box).get("packages", []) if p not in managed]
    packages = list(dict.fromkeys(plan["packages"] + extras))
    # Groups only this machine defines go to its registry entry, and every
    # other group to wherever the list lives (normally the project). This also
    # moves one an older msbctl had written into the project's list.
    portable, local = split_groups(plan["groups"])
    changed = [
        set_toml_key(edit_target(box, "rule_groups"), "rule_groups", portable),
        set_toml_key(registry_path(box), "extra_rule_groups", local or None),
        set_toml_key(project, "packages", packages, table="bootstrap"),
        set_toml_key(project, "bun", plan["bun"], table="bootstrap"),
        set_toml_key(project, "gitleaks", plan["gitleaks"], table="bootstrap"),
        set_toml_key(project, "claude", "claude" in plan["agents"], table="bootstrap"),
        # Absent is off, so a project that never had pi is not rewritten.
        set_toml_key(project, "pi", True if "pi" in plan["agents"] else None, table="bootstrap"),
    ]
    private = config.get("defaults", {}).get("private_dns_groups", [])
    if any(g in private for g in portable) and not box.allow_private_dns:
        # Such a group does not work without it, and the failure reads as a
        # missing egress rule, so it is set together with the group.
        if set_toml_key(edit_target(box, "allow_private_dns"), "allow_private_dns", True):
            note("a group you chose resolves to private addresses: set allow_private_dns")
            changed.append(True)
    if any(changed):
        ctx["rebuild"].add("features, egress groups and packages")
    if "pi" in plan["agents"] and not box.wants_component("pi"):
        section_llm(Sandbox(box.name, config), config, ctx)
    if "podman" in plan["features"] and not (box.containers_disk or boot_cfg(box).get("containers_storage")):
        note("podman has no image storage yet — see 'Container storage'")
    for key in plan["features"]:
        if key in CACHES and key not in box.caches:
            note(f"{key} has no cache disk — see 'Package caches'")


def _summary_resources(box):
    return f"{box.cpus} cpu, {box.memory}, {box.root_disk} root disk"


def section_resources(box, config, ctx):
    if state_of(box.name) != "absent":
