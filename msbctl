def llm_key_var(name):
    """The variable an endpoint's key is stored and bound under: LLM_KEY_QWEN
    for [llm.qwen]. Reserved (is_reserved_var), so no `secret_binds` entry can
    point the same value at another host."""
    return LLM_KEY_PREFIX + name.upper().replace("-", "_")


def llm_key_ref(name):
    """How pi's models.json points at an endpoint's key: `$LLM_KEY_<NAME>`.

    The `$` is not decoration. pi >=1.0 interpolates only `$NAME`/`${NAME}` and
    otherwise takes the value as the key itself, where 0.73 looked a bare name up
    in the environment. Both halves were checked against a real request: each
    version pointed at a local endpoint with each spelling, and the
    `Authorization` header carried the value only for `$NAME` on 1.4 and the bare
    name on 0.73. No spelling satisfies both, so msbctl writes what PI_PACKAGE
    resolves; a guest left on 0.73 sends the literal `$LLM_KEY_…` and gets the 401
    that names it — rebuild it.
    """
    return "$" + llm_key_var(name)


def llm_url(spec):
    """(base_url, host, port) of an endpoint, its provider's URL if it names one."""
    url = spec.get("base_url") or PI_PROVIDERS.get(spec.get("provider", ""), ("",))[0]
    parsed = urllib.parse.urlsplit(url)
    return url, (parsed.hostname or ""), (parsed.port or 443)


def llm_problem(name, spec):
    """Why an [llm.<name>] table cannot be used, or None."""
    if not NAME_SLUG.fullmatch(name):
        return "the name must be lowercase letters, digits and dashes, starting with a letter"
    if not isinstance(spec, dict):
        return "must be a table"
    unknown = [k for k in spec if k not in LLM_KEYS]
    if unknown:
        return f"unknown key(s) {', '.join(unknown)} (known: {', '.join(LLM_KEYS)})"
    provider = spec.get("provider")
    if provider is not None and provider not in PI_PROVIDERS:
        return (f"provider {provider!r} is not one msbctl knows the host of "
                f"({', '.join(PI_PROVIDERS)}); give base_url instead")
    if not provider and name in PI_PROVIDERS:
        return (f"{name} is one of pi's own providers — say provider = {name!r}, "
                "or pick another name for your server")
    if not provider and not spec.get("base_url"):
        return "needs base_url (your server) or provider (one of pi's)"
    if spec.get("base_url"):
        parsed = urllib.parse.urlsplit(str(spec["base_url"]))
        if parsed.scheme != "https":
            return ("base_url must be https:// — the key is substituted only into a TLS "
                    "connection msb intercepts, so plain http would need the real key in the VM")
        if not parsed.hostname or parsed.username or parsed.password or parsed.query:
            return "base_url must be https://HOST[:PORT]/path, with no credentials or query"
        try:
            port = parsed.port
        except ValueError:
            return "base_url has an invalid port"
        if port == 80:
            return "port 80 is denied by `base` first"
    api = spec.get("api")
    if api is not None and api not in PI_APIS:
        return f"api {api!r} is not one of {', '.join(PI_APIS)}"
    models = spec.get("models", [])
    if not isinstance(models, list) or not all(isinstance(m, str) and m for m in models):
        return "models must be a list of model ids"
    if "default_model" in spec and not (isinstance(spec["default_model"], str)
                                        and spec["default_model"]):
        return "default_model must be a model id"
    for key in ("context_window", "max_tokens"):
        if key in spec and (not isinstance(spec[key], int) or isinstance(spec[key], bool)
                            or spec[key] <= 0):
            return f"{key} must be a positive integer"
    for key in ("reasoning", "private_dns"):
        if key in spec and not isinstance(spec[key], bool):
            return f"{key} must be true or false"
    if "compat" in spec and not isinstance(spec["compat"], dict):
        return "compat must be a table (passed to pi as is)"
    if spec.get("ca_cert"):
        path = os.path.expanduser(str(spec["ca_cert"]))
        if not os.path.isabs(path) or not os.path.isfile(path):
            return f"ca_cert {spec['ca_cert']!r} must be an absolute path to a PEM file"
    return None


def llm_endpoints(config):
    """Every [llm.<name>] table in the merged config, by name."""
    table = config.get("llm", {})
    return table if isinstance(table, dict) else {}


def llm_default_model(spec):
    """The model pi should start with: `default_model`, else the first of a
    fixed `models` list, else None (the first the server lists)."""
    return spec.get("default_model") or (spec.get("models") or [None])[0]


# ------------------------------------------------------- agent tool bundles
#
# A bundle is one capability an agent in a sandbox can be given that THIS
# machine, not the project, owns: a folder under ~/.config/msb/tools holding
#
#   bundle.toml        description, the hosts egress must allow, [env]
#   pi.ts              a pi extension, copied into ~/.pi/agent/extensions/
#   claude/SKILL.md    a Claude Code skill, copied into ~/.claude/skills/msb-<name>/
#
# Why machine-local and never a project's `tools` key: a bundle names the
# operator's own endpoints, so a committed bundle name would die on every other
# clone with "unknown tool bundle" — the same reasoning as a machine-only rule
# group (machine_only_groups). And why a project cannot be trusted to ask for
# one at all: the hosts a bundle opens are decided by whoever wrote it.
#
# Why the tools exist: an egress-locked sandbox cannot reach the internet, so a
# fetch that connects out of the guest fails by design — which is what the
# built-in webfetch/websearch tools do. A bundle's endpoint fetches instead and
# returns the text, so the sandbox needs rules for two hosts rather than one per
# site it reads. State the cost with the benefit: whatever the endpoint can
# reach, every sandbox holding the bundle can read.
#
# msb-manager ships NO bundle, because it cannot know your endpoints. The format
# and a worked example are in docs/content/agent-tools.md.
#
# `pi_package` hands pi a published pi package instead of (or beside) a pi.ts:
# "name" or "name@1.2.3", an npm name and nothing else. It is installed by pi
# INSIDE the guest (`pi install npm:<spec>`), into ~/.pi/agent/npm/, which is on
# the /root/.pi mount — so it outlives a rebuild, and this side can tell whether
# it is there by reading its package.json. See sync_pi_packages(). msbctl never
# fetches a package itself, never resolves a dependency and names none: what
# goes in is what the operator wrote here.

TOOL_KEYS = ("description", "hosts", "env", "pi_package")
TOOL_VAR_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
