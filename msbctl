MODE_LABELS = {
    "enforce": "enforce   deny by default; only the rules below get through",
    "observe": "observe   NOTHING IS BLOCKED; every host reached is recorded",
}


def section_egress(box, config, ctx):
    say("Egress rules")
    note("Rule groups are under 'Features & agents'. These are the extra, per-sandbox rules.")

    # The mode comes first because it decides whether anything else here is even
    # applied. See Sandbox.egress_mode: observe exists to find out what a
    # sandbox needs, since msb will not tell you what it denied.
    mode = {v: k for k, v in MODE_LABELS.items()}[
        choose_one("egress mode", [MODE_LABELS[m] for m in EGRESS_MODES],
                   EGRESS_MODES.index(box.egress_mode))]
    if mode != box.egress_mode:
        if mode == "observe":
            warn("unrestricted egress until you switch back. Secrets stay bound to")
            warn("their hosts, but anything the guest can read it can now send.")
        # registry_path, not edit_target: see _observe_set — this one is
        # machine-local on purpose and must never be committed into a project.
        if set_toml_key(registry_path(box), "egress_mode", mode):
            ctx["rebuild"].add("egress mode")
            if mode == "observe":
                note(f"after a rebuild, use it a while then `msbctl observe {box.name}`")

    current = list(box.extra_rules)
    keep = toggle_list("keep these rules", current, current) if current else []
    raw = ask("allow more (hosts, host:port or full rules, space-separated; blank for none)")
    added = []
    for token in re.split(r"[,\s]+", raw.strip()):
        if not token:
            continue
        try:
            rule = parse_allow_target(token)
        except SystemExit as exc:
            warn(str(exc).replace("msbctl: ", "", 1) + " — skipped")
            continue
        if rule.startswith("allow") and re.search(r":tcp:80(\b|$)", rule):
            warn(f"{rule}: plaintext :80 is denied by `base` first, so it could never match — skipped")
            continue
        if rule in box.net_rules() or rule in added:
            note(f"already allowed: {rule}")
            continue
        added.append(rule)
    if set_toml_key(edit_target(box, "extra_rules"), "extra_rules", keep + added):
        ctx["rebuild"].add("egress rules")


