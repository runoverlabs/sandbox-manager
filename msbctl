def capture_token(name):
    """Read a PAT straight to the sandbox's 0600 env file. Never echoed, never in
    argv. Sets ONLY GH_TOKEN: the file also holds this sandbox's other secrets, and
    an earlier version truncated it and lost them."""
    path = os.path.join(SECRETS_DIR, f"{name}.env")
    token = read_secret_hidden("paste the token")
    if not token or any(c.isspace() for c in token):
        note("skipped — the sandbox will have no GitHub API access.")
        note(f"Add it later: msbctl edit {name}  ->  GitHub token")
        return False
    set_env_file_value(path, "GH_TOKEN", token)
    note(f"stored in {tilde(path)} (0600)")
    return True


