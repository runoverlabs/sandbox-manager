def read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
    os.replace(tmp, path)


def print_one(box, table):
    note(f"{box.name}  {state_of(box.name, table)}  {tilde(box.project)}")


def _flatten(table, prefix=""):
    for key, value in table.items():
        path = f"{prefix}{key}"
        if isinstance(value, dict):
            yield from _flatten(value, path + ".")
        else:
            yield path, value


# ------------------------------------------------------------- TOML key editor
#
# `edit` has to write into files people also edit by hand, so this changes ONE key
# in place and leaves everything else — comments, ordering, other tables —
# byte-for-byte alone. Anything that would not parse afterwards is refused before it
# is written. Not a serializer: it only knows scalars and lists of strings.

_TOML_HEADER = re.compile(r"^\s*\[\[?\s*([^\[\]]+?)\s*\]\]?\s*(#.*)?$")


def toml_literal(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, list):
        if not value:
            return "[]"
        return "[\n" + "".join(f"    {toml_literal(v)},\n" for v in value) + "]"
    raise TypeError(f"cannot write {value!r} as TOML")


def _toml_region(lines, table):
    """(start, end) of the lines belonging to `table` (None: before the first
    header), or None if that table does not exist."""
    if table is None:
        return 0, next((i for i, l in enumerate(lines) if _TOML_HEADER.match(l)), len(lines))
    for i, line in enumerate(lines):
        m = _TOML_HEADER.match(line)
        if m and m.group(1).strip() == table:
            end = next((j for j in range(i + 1, len(lines)) if _TOML_HEADER.match(lines[j])),
                       len(lines))
            return i + 1, end
    return None


def _bracket_balance(text):
    text = re.sub(r'"(?:[^"\\]|\\.)*"', '""', text).split("#")[0]
    return text.count("[") - text.count("]")


def _toml_assignment(lines, start, end, key):
    for i in range(start, end):
        if re.match(rf"^\s*{re.escape(key)}\s*=", lines[i]):
            j, depth = i, _bracket_balance(lines[i].split("=", 1)[1])
            while depth > 0 and j + 1 < end:
                j += 1
                depth += _bracket_balance(lines[j])
            return i, j
    return None


def set_toml_key(path, key, value, table=None):
    """Set `key` (top level, or inside [table]) to `value` in the file at `path`;
    value None removes it. Returns True if the file changed."""
    with open(path, encoding="utf-8") as fh:
        before = fh.read()
    lines = before.splitlines()
    new = [] if value is None else f"{key} = {toml_literal(value)}".splitlines()
    region = _toml_region(lines, table)
    if region is None:
        if value is None:
            return False
        lines += ["", f"[{table}]"] + new
    else:
        start, end = region
        found = _toml_assignment(lines, start, end, key)
        if found:
            lines[found[0]:found[1] + 1] = new
        elif value is not None:
            # After the last real line of the region, not after trailing comments:
            # those are usually the banner of the NEXT table.
            at = start
            for j in range(start, end):
                if lines[j].strip() and not lines[j].lstrip().startswith("#"):
                    at = j + 1
            lines[at:at] = new
    after = "\n".join(lines) + "\n"
    if after == before:
        return False
    try:
        tomllib.loads(after)
    except tomllib.TOMLDecodeError as exc:
        die(f"refusing to write {tilde(path)}: {key} would leave it invalid ({exc})")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(after)
    return True


def remove_toml_table(path, table):
    """Delete `[table]` and its keys from a TOML file, in place. True if it existed."""
    with open(path, encoding="utf-8") as fh:
        before = fh.read()
    lines = before.splitlines()
    region = _toml_region(lines, table)
    if region is None:
        return False
    start, end = region
    del lines[start - 1:end]                       # the header line and its body
    while start - 1 < len(lines) and start - 1 > 0 and not lines[start - 1].strip() \
            and not lines[start - 2].strip():
        del lines[start - 1]                       # collapse the gap it leaves
    after = "\n".join(lines) + "\n"
    tomllib.loads(after)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(after)
    return True


def set_entry_value(box, key, literal):
    """Set a top-level `key = literal` in this sandbox's registry entry, in
    place. A line-level edit for the same reason as write_version_override():
    a serializer would discard the comments that make the file hand-editable."""
    path = os.path.join(REGISTRY_DIR, f"{box.name}.toml")
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
    new = f"{key} = {literal}"
    for i, line in enumerate(lines):
        if re.match(rf"^\s*{re.escape(key)}\s*=", line):
            lines[i] = new
            break
    else:
        at = next((j + 1 for j, line in enumerate(lines)
                   if re.match(r"^\s*autostart\s*=", line)), None)
        if at is None:
            at = next((j for j, line in enumerate(lines)
                       if line.lstrip().startswith("[")), len(lines))
        lines.insert(at, new)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


RULE_PROTOCOLS = ("any", "tcp", "udp", "icmpv4", "icmpv6")


def _split_rule_target(right):
    """`<target>[:<proto>[:<ports>]]` -> [target, proto?, ports?, anything
    extra…], splitting the way msb does: an IPv6 target is bracketed, so its
    own colons are not separators."""
    if right.startswith("["):
        target, sep, rest = right.partition("]")
        if not sep:
            return None
        target += "]"
        if rest and not rest.startswith(":"):
            return None
        return [target] + (rest[1:].split(":") if rest else [])
    return right.split(":")


def _ports_ok(ports):
    if ports == "any":
        return True
    lo, _, hi = ports.partition("-")
    return all(p.isdigit() and 1 <= int(p) <= 65535 for p in ([lo, hi] if hi else [lo]))


def rule_problem(rule):
    """What msb will refuse about a --net-rule token, or None. A shape check
    against `<action>[:<direction>]@<target>[:<proto>[:<ports>]]`, not a full
    parse: targets are left to msb, which names the bad one itself. The point
    is to say WHICH FILE holds a broken rule before msb fails the create.
    msb also takes several rules in one comma-separated token, as `base` does."""
    if "," in rule:
        parts = [part.strip() for part in rule.split(",") if part.strip()]
        return next(filter(None, map(rule_problem, parts)), None)
    left, at, right = rule.partition("@")
    if not at:
        return "no `@` — a rule is allow@TARGET[:PROTO[:PORTS]]"
    action, _, direction = left.partition(":")
    if action not in ("allow", "deny") or direction not in ("", "egress", "ingress", "any"):
        return f"{left!r} is not allow/deny[:egress|ingress|any]"
    fields = _split_rule_target(right)
    if not fields or not fields[0]:
        return "no target after `@`"
    if len(fields) > 3:
        return "fields after the ports — a rule ends at allow@TARGET:PROTO:PORTS"
    if len(fields) > 1 and fields[1] not in RULE_PROTOCOLS:
        return f"{fields[1]!r} is not a protocol ({', '.join(RULE_PROTOCOLS)})"
    if len(fields) > 2 and not _ports_ok(fields[2]):
        return f"{fields[2]!r} is not a port, a LO-HI range or `any`"
    return None


def parse_allow_target(raw):
    """One `allow` argument as a net rule. Accepts a full rule (`allow@...`),
    `host` (HTTPS), `host:port` (TCP) or `host:proto:port`; an IPv6 address
    goes in brackets, `[fd00::1]:22`. Dies on anything else rather than
    guessing: a guess once turned `10.0.0.6:tcp:2222` into a rule msb refused."""
    raw = raw.strip()
    if "@" in raw:
        rule = raw
    else:
        fields = _split_rule_target(raw)
        if raw.count(":") > 2 and re.fullmatch(r"[0-9a-fA-F:]+(/\d+)?", raw):
            die(f"{raw!r}: an IPv6 address goes in brackets, like [{raw}] or [{raw}]:22")
        if not fields or not fields[0] or len(fields) > 3:
            die(f"{raw!r}: expected host, host:port, host:tcp:port, or a full rule "
                "like allow@host:tcp:443")
        host, proto, port = (fields[0], "tcp", "443") if len(fields) == 1 else \
            (fields[0], "tcp", fields[1]) if len(fields) == 2 else fields
        rule = f"allow@{host}:{proto}:{port}"
    problem = rule_problem(rule)
    if problem:
        die(f"{raw!r}: {problem}")
    return rule


def append_toml_list(path, key, items, after_key=None):
    """Add `items` to the top-level list `key` in a TOML file, in place, keeping
    the rest of the file (comments included) untouched. Returns the items that
    were actually new. The assignment is rewritten one entry per line."""
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    current = list(tomllib.loads(text).get(key, []))
    new = [i for i in items if i not in current]
    if not new:
        return []
    block = [f"{key} = ["] + [f"    {json.dumps(i)}," for i in current + new] + ["]"]
    lines, out, at, i = text.splitlines(), [], None, 0
    while i < len(lines):
        if re.match(rf"^\s*{re.escape(key)}\s*=", lines[i]):
            at = len(out)
            while i < len(lines) and "]" not in lines[i].split("#")[0]:
                i += 1
            i += 1
            continue
        out.append(lines[i])
        i += 1
    if at is None:
        anchor = next((j + 1 for j, line in enumerate(out) if after_key and
                       re.match(rf"^\s*{re.escape(after_key)}\s*=", line)), None)
        if anchor is None:
            anchor = next((j for j, line in enumerate(out)
                           if line.lstrip().startswith("[")), len(out))
        out[anchor:anchor] = [""]
        at = anchor + 1
    out[at:at] = block
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")
    return new


def cmd_allow(args, config):
    """Add egress rules to a sandbox's policy. Rules are fixed when the sandbox
    is created (msb cannot change them live), so this records them and says a
    rebuild is needed; --rebuild does it now."""
    box = Sandbox(args.name, config)
    rules = [parse_allow_target(t) for t in args.targets]
    for rule in rules:
        if re.search(r":tcp:80(\b|$)", rule) and rule.startswith("allow"):
            die(f"{rule}: plaintext :80 is denied by `base`, which is always first, "
                "so this could never match — use the https:// URL's host instead")
    existing = box.net_rules()
    fresh = [r for r in rules if r not in existing]
    for rule in rules:
        if rule not in fresh:
            note(f"already allowed: {rule}")
    if not fresh:
        return

    # The registry entry REPLACES the project's list when it sets extra_rules
    # (see Sandbox._pick), so write wherever the list effectively lives.
    sandbox_toml = os.path.join(box.project, ".msb", "sandbox.toml")
    if "extra_rules" in box.entry or not os.path.isfile(sandbox_toml):
        target = os.path.join(REGISTRY_DIR, f"{box.name}.toml")
    else:
        target = sandbox_toml
    added = append_toml_list(target, "extra_rules", fresh, after_key="rule_groups")
    for rule in added:
        note(f"allowed: {rule}")
    note(f"written to {tilde(target)}")
    if args.rebuild:
        cmd_rebuild(argparse.Namespace(name=box.name), config)
    else:
        note(f"takes effect when the sandbox is created: `msbctl rebuild {box.name}`")


# ------------------------------------------------------- the observation log
#
# msb's own log is the only record of where a sandbox went, and it is a record
# of SUCCESSES: a denied connection is logged at no level at all (checked on
# 0.7.7 at --debug and --trace), which is the whole reason observe mode has to
# unblock before it can measure. Two line shapes carry a destination, both at
# DEBUG only:
#
#   …engine::tls::proxy: TLS intercept sni=github.com dst=140.82.113.3:443
#   …engine::dns::forwarder: DNS query family is inactive … domain=github.com
#
# The first is the useful one — an intercepted connection named by its SNI,
# which is the exact form a rule is written in. The second is a RESOLUTION, not
# a connection, and it is all there is for anything that is not HTTPS: a plain
# TCP connect (:80, :22, git over ssh, a database) is never logged. So a name
# seen only in DNS was looked up, probably connected to, and on a port this
# cannot name. The report labels the two differently rather than pretending the
# second is as good as the first.
OBSERVED_TLS = re.compile(r"TLS (?:intercept|bypass) sni=(\S+) dst=(\S+)")
OBSERVED_DNS = re.compile(r"\bdomain=([A-Za-z0-9*._-]+)")
LOG_STAMP = re.compile(r"^(\d{4}-\d\d-\d\d)T([\d:]{8})")


def runtime_logs(name):
    """The sandbox's runtime.log and any rotations of it, oldest first."""
    folder = os.path.join(MSB_HOME, "sandboxes", name, "logs")
    try:
        names = os.listdir(folder)
    except OSError:
        return []
    # runtime.log.2 is older than runtime.log.1, which is older than runtime.log.
    rotated = sorted((f for f in names if re.fullmatch(r"runtime\.log\.\d+", f)),
                     key=lambda f: int(f.rsplit(".", 1)[-1]), reverse=True)
    return [os.path.join(folder, f) for f in rotated + ["runtime.log"]
            if os.path.isfile(os.path.join(folder, f))]


def observed_hosts(name):
    """{(host, port): {hits, first, last}} — where this sandbox has been.

    port is "" for a name that only ever appeared in a DNS lookup; see the note
    above OBSERVED_TLS for why that is the best available off :443.
    """
    seen = {}

    def record(host, port, when):
        key = (host.lower().rstrip("."), port)
        entry = seen.setdefault(key, {"hits": 0, "first": when, "last": when})
        entry["hits"] += 1
        entry["last"] = when

    for path in runtime_logs(name):
        try:
            fh = open(path, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                stamp = LOG_STAMP.match(line)
                when = f"{stamp.group(1)} {stamp.group(2)}" if stamp else "?"
                tls = OBSERVED_TLS.search(line)
                if tls:
                    port = tls.group(2).rsplit(":", 1)[-1]
                    record(tls.group(1), port if port.isdigit() else "", when)
                elif "::dns::" in line:
                    dns = OBSERVED_DNS.search(line)
                    if dns:
                        record(dns.group(1), "", when)
    # A host reached over TLS also shows up in DNS. Keep the connection, which
    # names a port, and drop the bare lookup that says less about the same trip.
    with_port = {host for host, port in seen if port}
    return {(host, port): v for (host, port), v in seen.items()
            if port or host not in with_port}


SECRET_VIOLATION = re.compile(r"secret violation: placeholder detected")
LOG_FIELD = re.compile(r"\b(\w+)=(\S*)")


def secret_violations(name):
    """{(var, host, location): {hits, last}} — requests msb KILLED over a secret.

    Nothing else reports these. The guest sees its TLS connection drop and calls
    it ECONNRESET; the rule set is irrelevant and allowing the host does not
    help, because this is the secret policy and not the network one. See
    AGENT_TRANSCRIPT_HOSTS. Logged at WARN, so unlike the host record this is
    there in enforce mode too, at msb's default verbosity.
    """
    hits = {}
    for path in runtime_logs(name):
        try:
            fh = open(path, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                if not SECRET_VIOLATION.search(line):
                    continue
                field = dict(LOG_FIELD.findall(line))
                stamp = LOG_STAMP.match(line)
                key = (field.get("secret_env_var", "?"),
                       field.get("host") or field.get("sni", "?"),
                       field.get("location", "?"))
                entry = hits.setdefault(key, {"hits": 0, "last": "?"})
                entry["hits"] += 1
                if stamp:
                    entry["last"] = f"{stamp.group(1)} {stamp.group(2)}"
    return hits


def report_secret_violations(box):
    """The loud half of the observe report. Returns True if anything was found."""
    hits = secret_violations(box.name)
    if not hits:
        return False
    say(f"{RED}{BOLD}Requests BLOCKED by the secret policy{RESET}")
    note("These never reached the network, whatever the egress rules say. The")
    note("guest sees only a dropped connection — an agent reports it as")
    note("`API Error: Connection dropped (ECONNRESET)`.")
    note("")
    for (var, host, where), info in sorted(hits.items(), key=lambda kv: -kv[1]["hits"]):
        note(f"  {var} placeholder in the {where} of a request to {host}"
             f"   {info['hits']} time(s), last {info['last']}")
    note("")
    note("A placeholder is the harmless stand-in text the guest sees; the real")
    note("value never left the host. It gets into an agent's requests because the")
    note("agent read it once and its transcript is resent on every turn — which is")
    note("why a fresh session works and then degrades.")
    note(f"Fixed by `msbctl rebuild {box.name}`: msbctl now lets the placeholder")
    note("through to the agent's own endpoints and nothing else.")
    return True


def rule_allows(rules, host, port):
    """Whether `rules` already permit `host` on `port`, judged BY NAME.

    First-match-wins, so this walks the list in order and the first rule whose
    target names the host decides it. Only domain and suffix targets are
    considered: `public`, `private` and bare addresses cannot be matched against
    a name without resolving it, and a resolution done here and now on the host
    is not the one msb would do in the guest at connect time. Those rules are
    skipped, so the worst this can do is call something uncovered that msb would
    in fact permit — the safe direction for a hint whose output you then read
    before running it.
    """
    for rule in rules:
        action, _, target = rule.partition("@")
        action = action.split(":")[0]           # drop an :egress/:ingress direction
        spec = target.split(":")
        name = spec[0]
        if name.startswith("suffix="):
            name = "*." + name[len("suffix="):]
        if port and len(spec) >= 3 and spec[2] and spec[2] != port:
            continue                            # a rule about a different port
        if name.startswith("*."):
            bare = name[2:].lower()
            if host != bare and not host.endswith("." + bare):
                continue
        elif name.lower() != host:
            continue
        return action == "allow"
    return False


def cmd_observe(args, config):
    """Stop blocking a sandbox and record where it goes, or read that record back.

    The workflow this exists for, in order: `on`, use the sandbox normally for a
    while, `report` to see every host it reached, `msbctl allow` the ones that
    belong, `off`. Observe mode is the measuring step, not a destination.
    """
    box = Sandbox(args.name, config)
    if args.action in ("on", "off"):
        _observe_set(box, "observe" if args.action == "on" else "enforce", args, config)
    else:
        _observe_report(box)


def _observe_set(box, mode, args, config):
    if box.egress_mode == mode:
        note(f"{box.name} is already in {mode} mode")
        return
    if mode == "observe":
        warn(f"{box.name} will have UNRESTRICTED egress until you turn this back off.")
        note("Nothing is denied, and every host it reaches is written to its")
        note("runtime.log. Your secrets stay bound to their own hosts and are not")
        note("exposed by this — but anything the guest can read, it can now send")
        note("anywhere. DNS rebind protection comes off with the rest.")
        note(f"Collect, then: `msbctl observe {box.name}` to see what it used.")
        if not args.yes and not confirm("turn observation mode on"):
            return
    # The REGISTRY, never the project file, and not edit_target(): sandbox.toml
    # is committed, so writing "observe" there would hand everyone who clones
    # the project a sandbox with no egress filtering — the one setting that must
    # not travel. It is machine-local and temporary, like mounts and identity.
    target = registry_path(box)
    set_toml_key(target, "egress_mode", mode)
    note(f"{box.name}: egress_mode = {mode}   ({tilde(target)})")
    # Network settings are fixed when msb creates the sandbox, so this is inert
    # until it is built again — exactly like `allow` and `mount`.
    if args.rebuild:
        cmd_rebuild(argparse.Namespace(name=box.name), config)
    else:
        note(f"takes effect when the sandbox is created: `msbctl rebuild {box.name}`")


def _observe_report(box):
    seen = observed_hosts(box.name)
    logs = runtime_logs(box.name)
    say(f"{box.name}  [egress: {box.egress_mode}]")
    if not logs:
        note(f"no runtime log under {tilde(os.path.join(MSB_HOME, 'sandboxes', box.name))}")
        note("the sandbox has never been created, or msb keeps its state elsewhere")
        return
    note(f"from {tilde(logs[-1])}" + (f" (+{len(logs) - 1} rotated)" if len(logs) > 1 else ""))
    if not box.observing:
        note(f"{DIM}this sandbox is enforcing, so only what its rules already allow"
             f" could appear here{RESET}")
    if not seen:
        note("nothing recorded yet — msb only writes these lines at --log-level debug,")
        note(f"which is what observe mode turns on: `msbctl observe {box.name} on`")
        # Still worth saying: these are logged at WARN, so they show up here
        # even when nothing else does, and they are the one failure that looks
        # exactly like a missing egress rule while being nothing of the kind.
        report_secret_violations(box)
        return

    rules = box.net_rules()
    rows = []
    for (host, port), info in seen.items():
        covered = rule_allows(rules, host, port)
        rows.append((host, port or "?", str(info["hits"]), info["last"], covered))
    # Uncovered first — that is the list you are here to read — then by traffic.
    rows.sort(key=lambda r: (r[4], -int(r[2]), r[0]))

    head = ("HOST", "PORT", "HITS", "LAST SEEN", "")
    widths = [max(len(str(r[i])) for r in [head] + rows) for i in range(4)]
    # strict=False: the last heading has no width, since nothing is padded after it.
    print(f"   {BOLD}" + "  ".join(h.ljust(w) for h, w in zip(head, widths, strict=False)) + RESET)
    for host, port, hits, last, covered in rows:
        cells = "  ".join(c.ljust(w) for c, w in zip((host, port, hits, last), widths, strict=True))
        mark = f"{DIM}allowed{RESET}" if covered else f"{RED}NOT ALLOWED{RESET}"
        print(f"   {cells}  {mark}")

    # Before the allowlist advice: a blocked secret is NOT fixed by allowing
    # anything, and a host can sit here marked "allowed" while every request to
    # it is being killed. That reads as a contradiction unless this says so.
    report_secret_violations(box)

    missing = [r[0] for r in rows if not r[4]]
    if any(r[1] == "?" for r in rows):
        note("")
        note(f"{DIM}? — seen only as a DNS lookup. msb logs no port for anything but"
             f" HTTPS,{RESET}")
        note(f"{DIM}    so the port is unknown; `msbctl allow` assumes 443.{RESET}")
    note("")
    if not missing:
        note("every host reached is already covered by this sandbox's rules.")
        if box.observing:
            note(f"nothing left to collect: `msbctl observe {box.name} off --rebuild`")
        return
    note(f"{len(missing)} host(s) not covered by the current rules. To allow them:")
    note(f"   msbctl allow {box.name} " + " ".join(dict.fromkeys(missing)))
    note("Read that list before running it — it is what the sandbox reached, which")
    note("is not the same as what it ought to reach.")
    if box.observing:
        note(f"Then: `msbctl observe {box.name} off --rebuild`")


# Guest paths the manager owns. A folder mounted over or inside one of these
# would shadow the Claude state, the profile or podman's storage. The project's
# own guest path is per sandbox, so callers add it (see parse_mount_spec()).
RESERVED_GUEST = ("/root/.claude", "/opt/msb-profile", "/var/lib/containers",
                  "/root/.ssh", "/tmp/ssh-agent.sock")
# Where the project cannot go: inside the system, or over a folder whose
# contents the image needs (mounting at /home would hide every home in it).
GUEST_SYSTEM = ("/bin", "/boot", "/dev", "/etc", "/lib", "/lib32", "/lib64",
                "/proc", "/run", "/sbin", "/sys", "/usr")
GUEST_SHADOWED = ("/", "/home", "/media", "/mnt", "/opt", "/root", "/srv", "/tmp", "/var")


def _overlaps(a, b):
    a, b = a.rstrip("/") or "/", b.rstrip("/") or "/"
    return a == b or a.startswith(b + "/") or b.startswith(a + "/")


def guest_path_problem(path):
    """Why `path` cannot be where the project is mounted in the guest, or None."""
    if not path.startswith("/"):
        return "not an absolute path"
    if ":" in path:
        return "it contains ':', which msb's mount syntax cannot carry"
    path = os.path.normpath(path)
    if path in GUEST_SHADOWED:
        return f"mounting over {path} would hide what the image keeps there"
    for system in GUEST_SYSTEM:
        if path == system or path.startswith(system + "/"):
            return f"it is inside {system}, a system folder"
    for reserved in RESERVED_GUEST + (CACHE_MOUNT,):
        if _overlaps(path, reserved):
            return f"it overlaps {reserved}, which msbctl manages"
    return None


def parse_mount_spec(spec, project_dest=GUEST_PROJECT):
    """`SRC[:DEST][:ro|rw]` -> (absolute host path, guest path, "ro"|"rw").
    DEST defaults to /mnt/<name>; the mode defaults to ro, because writing to a
    host folder from a sandbox should be something you asked for."""
    parts = spec.split(":")
    mode = "ro"
    if parts[-1] in ("ro", "rw"):
        mode = parts.pop()
    if not parts or not parts[0]:
        die(f"mount {spec!r}: expected SRC[:DEST][:ro|rw]")
    src = os.path.realpath(os.path.expanduser(parts[0]))
    dest = parts[1] if len(parts) > 1 else "/mnt/" + os.path.basename(src.rstrip("/"))
    if len(parts) > 2 or not dest.startswith("/"):
        die(f"mount {spec!r}: the guest path must be absolute — SRC:/guest/path[:ro|rw]")
    if _overlaps(dest, project_dest):
        die(f"mount {spec!r}: {dest} overlaps the project, which is mounted at {project_dest}")
    for reserved in RESERVED_GUEST:
        if _overlaps(dest, reserved):
            die(f"mount {spec!r}: {dest} overlaps {reserved}, which msbctl manages")
    return src, dest, mode


def parse_port_spec(spec):
    """A published port in msb's --port syntax, `[BIND:]HOST:GUEST[/tcp|/udp]`,
    or a bare `PORT` for the same number on both sides. IPv6 binds are
    bracketed: `[::1]:8080:80`. Returns (canonical spec, bind, host port, guest
    port, protocol), the spec in its shortest form; dies on what msb refuses."""
    raw = str(spec).strip()
    body, proto = raw, "tcp"
    for suffix in ("/tcp", "/udp"):
        if raw.endswith(suffix):
            body, proto = raw[:-len(suffix)], suffix[1:]
    bind = LOOPBACK_BIND
    if body.startswith("["):
        bind, sep, body = body[1:].partition("]:")
        if not sep:
            die(f"port {raw!r}: expected [ADDR]:HOST:GUEST for an IPv6 address")
    elif body.count(":") == 2:
        bind, body = body.split(":", 1)
    parts = body.split(":")
    if len(parts) == 1:
        parts *= 2
    if len(parts) != 2 or not all(p.isdigit() for p in parts):
        die(f"port {raw!r}: expected PORT, HOST:GUEST or BIND:HOST:GUEST, optionally /udp")
    host, guest = (int(p) for p in parts)
    if not all(1 <= n <= 65535 for n in (host, guest)):
        die(f"port {raw!r}: ports run from 1 to 65535")
    try:
        bind = str(ipaddress.ip_address(bind))
    except ValueError:
        die(f"port {raw!r}: {bind!r} is not an IP address to bind on")
    shown = f"[{bind}]" if ":" in bind else bind
    canonical = f"{host}:{guest}" if bind == LOOPBACK_BIND else f"{shown}:{host}:{guest}"
    return canonical + ("/udp" if proto == "udp" else ""), bind, host, guest, proto


def port_label(bind, host, guest, proto):
    """How a published port reads to a person: where to point the browser."""
    if bind == LOOPBACK_BIND:
        where = f"localhost:{host}"
    else:
        where = f"[{bind}]:{host}" if ":" in bind else f"{bind}:{host}"
    label = f"{where} -> {guest}" + ("/udp" if proto == "udp" else "")
    if ipaddress.ip_address(bind).is_unspecified:
        label += "   (every interface: reachable from your network)"
    return label


def port_conflict(name, bind, host, proto):
    """The other registered sandbox that already publishes this host port, or
    None. A wildcard bind collides with every address on the same port."""
    wild = ipaddress.ip_address(bind).is_unspecified
    for other in registered():
        if other == name:
            continue
        try:
            specs = read_toml(registry_path_for(other)).get("ports", [])
            claims = [parse_port_spec(s)[1:] for s in specs]
        except SystemExit:
            continue        # its own problem, reported when that sandbox starts
        for o_bind, o_host, _, o_proto in claims:
            if (o_host, o_proto) == (host, proto) and (
                    o_bind == bind or wild or ipaddress.ip_address(o_bind).is_unspecified):
                return other
    return None


def pick_guest_path(project, current):
    """Wizard: where the project appears inside the sandbox. Returns the value
    for `guest_path`: "host", "/work" or an absolute path. `project` is None
    when choosing the default for new sandboxes."""
    say("Project path inside the sandbox")
    note("The same path as on the host makes absolute paths in errors and agent")
    note("output open on the host as they are; /work keeps your folder layout and")
    note("username out of the sandbox. Claude Code keeps its sessions per path.")
    custom = current if current not in ("host", GUEST_PROJECT) else ""
    options = [f"same as on the host   {project or '(each project its own)'}",
               f"{GUEST_PROJECT}",
               "custom" + (f"                {custom}" if custom else "")]
    default = 0 if current == "host" else 1 if current == GUEST_PROJECT else 2
    while True:
        choice = choose_one("project path in the sandbox", options, default)
        if choice.startswith("same"):
            value, path = "host", project
        elif choice == GUEST_PROJECT:
            value = path = GUEST_PROJECT
        else:
            value = path = os.path.normpath(ask("path inside the sandbox", custom or "/"))
        problem = guest_path_problem(path) if path else None
        if not problem:
            return value
        warn(f"{path}: {problem}")


def pick_mounts(project_dest=GUEST_PROJECT):
    """Wizard: any number of extra host folders, each read-only or read-write.
    Returns spec strings for the registry entry."""
    say("Extra folders")
    note("Other host folders to mount into the sandbox (reference repos, data).")
    note(f"The project itself is already mounted at {project_dest}.")
    specs, taken = [], set()
    while confirm("add a folder?" if not specs else "add another?"):
        raw = ask("host path")
        if not raw:
            break
        src = os.path.realpath(os.path.expanduser(raw))
        if not os.path.isdir(src):
            warn(f"{tilde(src)} is not a directory")
            continue
        dest = ask("path inside the sandbox", "/mnt/" + os.path.basename(src.rstrip("/")))
        mode = "rw" if choose_one("access", [
            "read-only    the sandbox can read it, never change it",
            "read-write   writes land in the host folder, as you"], 0).startswith("read-write") else "ro"
        spec = f"{raw.rstrip('/') or '/'}:{dest}:{mode}"
        try:
            parse_mount_spec(spec, project_dest)
        except SystemExit as exc:
            warn(str(exc).replace("msbctl: ", "", 1))
            continue
        if dest in taken:
            warn(f"{dest} is already used by another folder")
            continue
        taken.add(dest)
        specs.append(spec)
        note(f"{tilde(src)} -> {dest} ({mode})")
    return specs


def pick_ports(name, taken=()):
    """Wizard: host ports that reach a server inside the sandbox. Returns spec
    strings for the registry entry; `taken` are the ones it already has."""
    say("Published ports")
    note("A port on this machine that reaches a server inside the sandbox, so a")
    note("browser here opens http://localhost:PORT. Bound to 127.0.0.1 only. The")
    note("server inside has to listen on 0.0.0.0 — localhost alone is not reached.")
    specs = []
    while confirm("publish a port?" if not specs else "another?"):
        raw = ask("port, or HOST:GUEST (8080, 3000:5173)")
        if not raw:
            break
        try:
            spec, bind, host, guest, proto = parse_port_spec(raw)
        except SystemExit as exc:
            warn(str(exc).replace("msbctl: ", "", 1))
            continue
        if spec in taken or spec in specs:
            warn(f"{spec} is already published")
            continue
        other = port_conflict(name, bind, host, proto)
        if other:
            warn(f"{other} publishes {host} too — only one of them can hold it at a time")
        specs.append(spec)
        note(port_label(bind, host, guest, proto))
    return specs


def format_list(key, items, example):
    """`key = [...]` for a TOML template, or a commented example when empty."""
    if not items:
        return example
    return f"{key} = [\n" + "".join(f"    {json.dumps(i)},\n" for i in items) + "]"


def cmd_mount(args, config):
    """Add an extra host folder to an existing sandbox's registry entry. Mounts
    are fixed at create time, so this records it; --rebuild applies it now."""
    box = Sandbox(args.name, config)
    spec = args.spec if args.spec.rstrip().endswith(("ro", "rw")) else args.spec + (":rw" if args.rw else ":ro")
    src, dest, mode = parse_mount_spec(spec, box.guest_project)
    if not os.path.isdir(src):
        die(f"{tilde(src)} is not a directory")
    entry_path = os.path.join(REGISTRY_DIR, f"{box.name}.toml")
    if not append_toml_list(entry_path, "mounts", [f"{src}:{dest}:{mode}"], after_key="autostart"):
        note("already mounted")
        return
    note(f"{tilde(src)} -> {dest} ({mode}) recorded in {tilde(entry_path)}")
    if args.rebuild:
        cmd_rebuild(argparse.Namespace(name=box.name), config)
    else:
        note(f"takes effect when the sandbox is created: `msbctl rebuild {box.name}`")


def cmd_port(args, config):
    """List, add or remove a sandbox's published ports. They live in the
    registry entry only, and are fixed at create time like the mounts, so a
    change is recorded here; --rebuild applies it now."""
    box = Sandbox(args.name, config)
    ports = box.published_ports
    if not args.specs and not args.rm:
        if not ports:
            note(f"no published ports — `msbctl port {box.name} 8080` adds one")
        for _, *where in ports:
            note(port_label(*where))
        return
    current = [spec for spec, *_ in ports]
    drop = []
    for raw in args.rm:
        spec = parse_port_spec(raw)[0]
        if spec in current:
            drop.append(spec)
        else:
            warn(f"{spec} is not published")
    add = []
    for raw in args.specs:
        spec, bind, host, guest, proto = parse_port_spec(raw)
        if spec in current or spec in add:
            continue
        other = port_conflict(box.name, bind, host, proto)
        if other:
            warn(f"{other} publishes {host} too — only one of them can hold it at a time")
        add.append(spec)
        note(f"recorded  {port_label(bind, host, guest, proto)}")
    for spec in drop:
        note(f"removed   {spec}")
    new = [spec for spec in current if spec not in drop] + add
    if new == current:
        note("nothing to change")
        return
    set_toml_key(registry_path(box), "ports", new or None)
    if args.rebuild:
        cmd_rebuild(argparse.Namespace(name=box.name), config)
    else:
        note(f"takes effect when the sandbox is created: `msbctl rebuild {box.name}`")
    if add:
        note("the server inside has to listen on 0.0.0.0, not localhost")


def secret_var(spec):
    """The environment variable name in an `ENV[:OPTIONS]@HOST` binding."""
    return spec.split("@", 1)[0].split(":", 1)[0]


def store_secret_value(name, var, value):
    """Set VAR=value in this sandbox's 0600 env file, keeping its other lines.
    Never echoed and never in argv."""
    os.makedirs(SECRETS_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(SECRETS_DIR, f"{name}.env")
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except FileNotFoundError:
        lines = [f"# {name}'s secrets. Never commit this file."]
    lines = [l for l in lines if not l.startswith(f"{var}=")] + [f"{var}={value}"]
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    return path


def read_secret_hidden(prompt):
    import getpass
    try:
        return getpass.getpass(f"   {prompt} (hidden, blank to skip): ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return ""


def choose_secret(config, taken=()):
    """Pick one secret: a shipped preset or a custom one. Returns
    (spec, preset_info_or_None) or None."""
    presets = config.get("secret_presets", {})
    rows = [(f"{k:<10} {p['env']} -> {', '.join(p['hosts'])}", k) for k, p in presets.items()
            if f"{p['env']}@{','.join(p['hosts'])}" not in taken]
    rows.append(("custom     your own variable and hosts", "custom"))
    label = choose_one("secret", [r for r, _ in rows], 0)
    key = dict(rows)[label]
    if key != "custom":
        p = presets[key]
        return f"{p['env']}@{','.join(p['hosts'])}", p
    var = ask("environment variable name (e.g. MY_API_TOKEN)").strip()
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", var):
        warn("not a valid variable name")
        return None
    hosts = ask("hosts it may be sent to (comma-separated, e.g. api.example.com)").replace(" ", "")
    if not hosts:
        warn("a secret needs at least one host")
        return None
    where = choose_one("where may it appear", [
        "headers      Authorization etc, including Basic auth (the default)",
        "also query   in URL query strings too",
        "also body    in request bodies too"], 0)
    opt = ":query" if where.startswith("also query") else ":body" if where.startswith("also body") else ""
    return f"{var}{opt}@{hosts}", None


def unreachable_secret_hosts(config, groups, specs, extra_rules=()):
    """Hosts a secret is bound to that no egress rule allows — the secret would be
    bound to somewhere the sandbox cannot connect. Returns [(var, host)]."""
    table = config.get("rules", {})
    rules = list(table.get("base", [])) + [r for g in groups for r in table.get(g, [])] + list(extra_rules)
    allowed = [r.split("@", 1)[1].split(":")[0] for r in rules if r.startswith("allow@") and "@" in r]

    def covered(host):
        return any(host == a or (a.startswith("*.") and host.endswith(a[1:])) for a in allowed)

    return [(secret_var(sp), h) for sp in specs for h in sp.split("@", 1)[1].split(",") if not covered(h)]


def pick_secrets(config, taken=()):
    """Wizard: any number of extra secrets. Returns [(spec, value or "")]."""
    say("Secrets")
    note("Tokens the sandbox can USE but never SEE: it gets a placeholder, and the")
    note("real value is substituted on the way out, only to the hosts you name.")
    note("Stored per sandbox in a 0600 file under ~/.config/msb/secrets/.")
    out = []
    while confirm("add a secret?" if not out else "add another?"):
        picked = choose_secret(config, [s for s, _ in out] + list(taken))
        if not picked:
            continue
        spec, preset = picked
        if preset:
            note(f"create it at {preset.get('help', '(see the provider)')}")
            if preset.get("usage"):
                note(f"use it:  {preset['usage']}")
        out.append((spec, read_secret_hidden(f"paste the {secret_var(spec)} value")))
        note(f"{secret_var(spec)} -> {spec.split('@', 1)[1]}")
    return out


def cmd_secret(args, config):
    """secret add|rm|ls <name> — extra credentials for an existing sandbox. New
    ones are registered with `msb modify`, so no rebuild is needed (a restart is)."""
    box = Sandbox(args.name, config)
    sandbox_toml = os.path.join(box.project, ".msb", "sandbox.toml")
    target = (os.path.join(REGISTRY_DIR, f"{box.name}.toml")
              if "secret_binds" in box.entry or not os.path.isfile(sandbox_toml) else sandbox_toml)
    if args.action == "ls":
        own = read_env_file(os.path.join(SECRETS_DIR, f"{box.name}.env"))
        for spec in box.secret_binds or ["(none)"]:
            have = "value stored" if secret_var(spec) in own else "NO VALUE"
            note(f"  {spec}   {DIM}{have}{RESET}" if spec != "(none)" else "  (none)")
        return
    if args.action == "rm":
        spec = next((x for x in box.secret_binds if secret_var(x) == args.var), None)
        if not spec:
            die(f"{box.name} has no secret {args.var!r} (`msbctl secret ls {box.name}`)")
        remove_from_toml_list(target, "secret_binds", spec)
        state = state_of(box.name)
        if state != "absent":
            _, secret_vars = box.secret_env()
            # msb applies a removal LIVE: the value stops being substituted at
            # once. The guest only keeps an inert placeholder variable until its
            # next restart, so there is nothing to confirm.
            run(["msb", "modify", box.name, "--secret-rm", args.var],
                env=secret_vars, check=False)
        note(f"{args.var} removed: it is no longer substituted (the guest keeps an inert "
             "placeholder until its next restart)")
        note(f"its value is still in {tilde(os.path.join(SECRETS_DIR, box.name + '.env'))} — "
             "delete the line if you want it gone")
        return
    picked = choose_secret(config, box.secret_binds)
    if not picked:
        return
    spec, preset = picked
    if preset:
        note(f"create it at {preset.get('help', '(see the provider)')}")
        if preset.get("usage"):
            note(f"use it:  {preset['usage']}")
    value = read_secret_hidden(f"paste the {secret_var(spec)} value")
    if not value:
        note("skipped")
        return
    store_secret_value(box.name, secret_var(spec), value)
    append_toml_list(target, "secret_binds", [spec], after_key="extra_rules")
    note(f"recorded in {tilde(target)}")
    if state_of(box.name) == "absent":
        return
    if ":" in spec.split("@", 1)[0]:
        note(f"it uses a non-default location, which `msb modify` cannot set: `msbctl rebuild {box.name}`")
        return
    if confirm(f"apply now — this restarts {box.name}?"):
        # Re-read the sandbox so every binding, including the one just added,
        # contributes its variable: modify validates them all.
        _, secret_vars = Sandbox(box.name, config).secret_env()
        run(["msb", "modify", box.name, "--secret", spec, "--restart"], env=secret_vars)


def remove_from_toml_list(path, key, item):
    """Remove one item from a top-level list in a TOML file, in place."""
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    current = [i for i in tomllib.loads(text).get(key, []) if i != item]
    lines, out, at, i = text.splitlines(), [], None, 0
    while i < len(lines):
        if re.match(rf"^\s*{re.escape(key)}\s*=", lines[i]):
            at = len(out)
            while i < len(lines) and "]" not in lines[i].split("#")[0]:
                i += 1
            i += 1
            continue
        out.append(lines[i])
        i += 1
    if at is not None:
        out[at:at] = ([f"{key} = ["] + [f"    {json.dumps(x)}," for x in current] + ["]"]) if current else [f"{key} = []"]
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")


def cmd_cache(args, config):
    """cache <name> [ls | clear [key]] — the package-cache disks."""
    box = Sandbox(args.name, config)
    if not box.caches:
        note(f"{box.name} has no package caches")
        return
    vols = msb_volumes()
    if args.action == "clear":
        keys = [args.key] if args.key else list(box.caches)
        for key in keys:
            if key not in box.caches:
                die(f"{box.name} has no {key!r} cache (it has: {', '.join(box.caches)})")
        state = state_of(box.name)
        for key in keys:
            vol = box.cache_volume(key)
            if state == "running":
                # Attached, so msb will not remove it: empty it from inside. The
                # size stays what it was created with.
                run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c",
                     f"find {CACHE_MOUNT}/{key} -mindepth 1 -delete"], check=False, quiet=True)
                note(f"{key}: emptied")
            elif vol in vols:
                run(["msb", "volume", "rm", vol], check=False, quiet=True)
                note(f"{key}: removed — recreated at {box.caches[key]} on the next create")
            else:
                note(f"{key}: nothing to clear yet")
        return
    for key, size in box.caches.items():
        v = vols.get(box.cache_volume(key))
        if v:
            note(f"  {key:<8} {human_size(v['used_bytes']):>8} of {human_size(v['capacity_bytes']):<7} {CACHES[key]}")
        else:
            note(f"  {key:<8} not created yet ({size})")


# ----------------------------------------------------------------------- setup
#
# `msbctl setup`: the MACHINE-level config as a menu of sections, like `edit` is for
# one sandbox. The first time msbctl runs it walks the same sections in order
# (`--welcome`). Everything lands in ~/.config/msb/config.toml (your overrides over
# defaults.toml) or secrets/global.env; both are tracked here by section so nothing
# needs hand-editing unless you want to.

WELCOME_MARKER = os.path.join(STATE_DIR, "welcome-done")
GLOBAL_ENV = os.path.join(SECRETS_DIR, "global.env")
NAME_SLUG = re.compile(r"[a-z][a-z0-9-]*")

# Claude tokens are named, so one machine can hold several accounts (work,
# personal) and each sandbox picks one. They live in secrets/global.env, one
# variable each. The token called "main" is the plain CLAUDE_CODE_OAUTH_TOKEN,
# so the single token stored before names existed is simply "main" and keeps
# working. Whichever one a sandbox uses, the guest always sees the same
# CLAUDE_CODE_OAUTH_TOKEN placeholder: only the host-side value differs.
CLAUDE_TOKEN_VAR = "CLAUDE_CODE_OAUTH_TOKEN"   # noqa: S105  a variable name
CLAUDE_TOKEN_MAIN = "main"                      # noqa: S105  a token's name
# No hyphen: the name is upper-cased into a variable name and has to come back.
CLAUDE_TOKEN_NAME = re.compile(r"[a-z][a-z0-9_]*")


def claude_token_var(name):
    return CLAUDE_TOKEN_VAR if name == CLAUDE_TOKEN_MAIN else f"{CLAUDE_TOKEN_VAR}_{name.upper()}"


def claude_tokens(env=None):
    """{name: value} for every Claude token in secrets/global.env."""
    env = read_env_file(GLOBAL_ENV) if env is None else env
    tokens = {}
    for var, value in env.items():
        if not value:
            continue
        if var == CLAUDE_TOKEN_VAR:
            tokens[CLAUDE_TOKEN_MAIN] = value
        elif var.startswith(CLAUDE_TOKEN_VAR + "_"):
            name = var[len(CLAUDE_TOKEN_VAR) + 1:].lower()
            if CLAUDE_TOKEN_NAME.fullmatch(name):
                tokens[name] = value
    return dict(sorted(tokens.items()))


def default_claude_token(config):
    return config.get("defaults", {}).get("claude_token") or CLAUDE_TOKEN_MAIN


def ensure_local_config():
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    os.makedirs(SECRETS_DIR, mode=0o700, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        shutil.copy(os.path.join(TEMPLATES, "config.toml.in"), CONFIG_FILE)


def set_env_file_value(path, var, value):
    """Set VAR=value in a 0600 env file (None removes it), keeping the other lines
    and the comments that document it. Never echoed, never in argv."""
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except FileNotFoundError:
        lines = ["# Shared by every sandbox. 0600. NEVER commit this file."]
    lines = [l for l in lines if not re.match(rf"^\s*{re.escape(var)}=", l)]
    if value:
        lines.append(f"{var}={value}")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


def mark_welcomed():
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(WELCOME_MARKER, "w", encoding="utf-8") as fh:
        fh.write(dt.date.today().isoformat() + "\n")


def needs_welcome(config):
    """First run = never welcomed AND nothing configured yet. A machine that already
    has identities, a token or sandboxes is marked done without a word."""
    if os.path.exists(WELCOME_MARKER):
        return False
    configured = (bool(config.get("identities"))
                  or bool(claude_tokens())
                  or bool(registered()))
    if configured:
        mark_welcomed()
        return False
    return True


def maybe_welcome(config):
    """Offer the first-run setup, once, on an interactive terminal. Returns the
    (possibly reloaded) config."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()) or not needs_welcome(config):
        return config
    choice = choose_one("welcome to msbctl — first run", [
        "set up now        a few minutes: identities, Claude login, your network",
        "later             ask again next time",
        "no thanks         never ask again (`msbctl setup` still works)"], 0)
    if choice.startswith("set up"):
        cmd_setup(argparse.Namespace(welcome=True), config)
        return load_config()
    if choice.startswith("no thanks"):
        mark_welcomed()
    return config


