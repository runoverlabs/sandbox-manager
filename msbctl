# Hosts that receive a coding agent's ENTIRE conversation on every single turn,
# and therefore every string it has ever seen.
#
# That makes them a special case for secrets, and getting it wrong costs a long
# debugging session. msb scans every outbound request for its own PLACEHOLDERS
# ($MSB_<VAR>, what the guest sees in place of a real token) and blocks any
# request carrying one where substitution is not permitted — bodies are not,
# only headers. The moment an agent so much as runs `env`, the literal text
# `$MSB_GH_TOKEN` is in its transcript, and from then on EVERY request it makes
# is blocked: msb tears the TLS connection down and the agent reports it as
# `API Error: Connection dropped (ECONNRESET)`, which names nothing. The tell is
# that a brand-new session works and then degrades, because a fresh transcript
# is clean and never gets clean again.
#
# `passthrough=` is the fix and it gives nothing away: it lets the PLACEHOLDER
# travel unsubstituted to these hosts. The real value is still only ever put
# into headers, still only for the secret's own bound hosts. Verified both ways
# on 0.7.7 — the passthrough host receives the literal `$MSB_<VAR>`, and header
# substitution for a bound host keeps working alongside it.
AGENT_TRANSCRIPT_HOSTS = ("api.anthropic.com", "platform.claude.com")


def with_transcript_passthrough(spec):
    """`ENV[:OPTIONS]@HOST[,HOST]` with the transcript hosts added to passthrough.

    Left alone if the spec already says `passthrough=`: that is an operator who
    wrote the binding by hand and said what they meant, and msb rejects a second,
    conflicting list anyway.
    """
    env, _, hosts = spec.rpartition("@")
    if not env or not hosts:
        return spec
    var, _, options = env.partition(":")
    if "passthrough=" in options:
        return spec
    added = "passthrough=[" + ",".join(AGENT_TRANSCRIPT_HOSTS) + "]"
    # Options are COMMA-separated (msb splits on commas outside brackets); a
    # colon here would make `query:passthrough=[...]` one option msb refuses.
    return f"{var}:{options + ',' if options else ''}{added}@{hosts}"


