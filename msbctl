class approving_edits:
    """Around an edit section that writes the project's policy: a pending
    change made by someone else is asked about first, on its own, and what the
    operator then chooses in the menu is approved as they leave it."""

    def __init__(self, box, config):
        self.box, self.config = box, config

    def __enter__(self):
        check_policy(self.box, "editing")

    def __exit__(self, kind, exc, tb):
        try:
            approve_policy(Sandbox(self.box.name, self.config))
        except SystemExit:
            pass        # the file no longer parses; _recover_broken handles that
        return False


def _recover_broken(name, message):
    """A file this sandbox reads no longer parses, so no menu can be built from it.
    Offer to open the files; True to retry, False to give up."""
    warn(message)
    files = [("registry entry   machine-local", registry_path_for(name))]
    try:
        with open(registry_path_for(name), encoding="utf-8") as fh:
            m = re.search(r'^\s*project\s*=\s*"([^"]+)"', fh.read(), re.M)
        if m:
            project = os.path.join(os.path.expanduser(m.group(1)), ".msb", "sandbox.toml")
            if os.path.isfile(project):
                files.append(("sandbox.toml     this project", project))
    except OSError:
        pass  # the entry is unreadable: offer it alone
    label = choose_one("fix which file", [l for l, _ in files] + ["give up"], 0)
    if label == "give up":
        return False
    edit_file(dict(files)[label])
    return True


def registry_path_for(name):
    return os.path.join(REGISTRY_DIR, f"{name}.toml")


def cmd_edit(args, config):
    name = args.name
    if not os.path.isfile(registry_path_for(name)):
        die(f"no sandbox named {name!r} — `msbctl ls` to see what exists")
    ctx = {"rebuild": set(), "hand_edited": False}
    default = 0
    while True:
        try:
            box = Sandbox(name, config)
        except SystemExit as exc:               # a file was left unparseable
            if _recover_broken(name, str(exc.code or "").replace("msbctl: ", "", 1)):
                ctx["hand_edited"] = True
                continue
            return
        rows = [f"{title:<20} {summary(box)}" for title, _, summary in EDIT_SECTIONS]
        rows += ["View the CLAUDE.md it gets", "Edit the files in your editor", "Done"]
        say(f"Edit {name}  [{state_of(name)}]")
        if ctx["rebuild"]:
            note(f"{DIM}needs a rebuild: {', '.join(sorted(ctx['rebuild']))}{RESET}")
        choice = choose_one("section", rows, default)
        default = rows.index(choice)
        if choice == "Done":
            break
        try:
            if choice.startswith("Edit the files"):
                with approving_edits(box, config):
                    section_files(box, config, ctx)
            elif choice.startswith("View the CLAUDE.md"):
                section_claude_md(box, config, ctx)
            elif EDIT_SECTIONS[default][1] in POLICY_SECTIONS:
                with approving_edits(box, config):
                    EDIT_SECTIONS[default][1](box, config, ctx)
            else:
                EDIT_SECTIONS[default][1](box, config, ctx)
        except SystemExit as exc:               # a section's escape/die must not end the menu
            text = str(exc.code or "").replace("msbctl: ", "", 1).strip()
            if text and "cancelled" not in text:
                warn(text)
        name = ctx.get("name", name)            # "Name & folder" may have renamed it

    if not (ctx["rebuild"] or ctx["hand_edited"]):
        return
    if state_of(name) == "absent":
        note("not created yet, so everything applies at first start")
        return
    why = ", ".join(sorted(ctx["rebuild"])) or "the files you edited by hand"
    note(f"These only take effect when the sandbox is created: {why}.")
    if confirm(f"rebuild {name} now?"):
        cmd_rebuild(verb_args("rebuild", name=name), config)
    else:
        note(f"later: msbctl rebuild {name}")


def cmd_resize(args, config):
    """Change cpus, memory or root disk of an EXISTING sandbox, keeping its
    state. Uses `msb modify`: the root disk grows live; cpus and memory need a
    restart, not a rebuild. Recorded in the registry entry so a later rebuild
    reproduces it."""
    box = Sandbox(args.name, config)
    state = state_of(box.name)
    if state == "absent":
        die(f"{box.name} has not been created yet — `msbctl start {box.name}`")

    cpus, memory, disk = args.cpus, args.memory, args.root_disk
    if cpus is None and memory is None and disk is None:
        say(f"Resize {box.name}")
        note(f"now: {box.cpus} cpu, {box.memory}, {box.root_disk} root disk")
        plan = {}
        pick_resources(plan, config, current=(int(box.cpus), str(box.memory)))
        cpus, memory = plan["cpus"], plan["memory"]
        note("")
        note("The root disk can only grow, never shrink.")
        disk = pick_size("root disk", ROOT_DISKS, str(box.root_disk))
    cpus = None if cpus is None or str(cpus) == str(box.cpus) else int(cpus)
    memory = None if memory is None or memory == str(box.memory) else memory
    disk = None if disk is None or disk == str(box.root_disk) else disk
    if cpus is None and memory is None and disk is None:
        note("nothing to change")
        return

    argv = ["msb", "modify", box.name]
    if cpus is not None:
        argv += ["--cpus", str(cpus)]
    if memory is not None:
        argv += ["--memory", memory]
    if disk is not None:
        argv += ["--root-disk", disk]
    # msb modify validates EVERY secret bound to the sandbox, not only a changed
    # one, and refuses if any host variable is unset — so hand it all of them.
    _, secret_vars = box.secret_env()
    run(argv + ["--dry-run"], env=secret_vars)
    needs_restart = state == "running" and (cpus is not None or memory is not None)
    if needs_restart and not args.yes and not confirm(
            f"apply — this restarts {box.name}, ending its open sessions?"):
        return
    if run(argv + (["--restart"] if needs_restart else []), env=secret_vars,
           check=False).returncode:
        die("msb modify failed — nothing recorded")
    if cpus is not None:
        set_entry_value(box, "cpus", str(cpus))
    if memory is not None:
        set_entry_value(box, "memory", f'"{memory}"')
    if disk is not None:
        set_entry_value(box, "root_disk", f'"{disk}"')
    note(f"{box.name} resized; recorded in {tilde(os.path.join(REGISTRY_DIR, box.name + '.toml'))}"
         " so a rebuild keeps it")


