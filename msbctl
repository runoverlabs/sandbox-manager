LANGUAGE_THRESHOLD = 0.05    # ignore anything under 5% of the repo's bytes


def github_languages(repo, config):
    """{language: bytes} from GitHub, or None — offline, rate-limited, private
    without a token, or empty. Never fatal: this only pre-ticks a menu."""
    headers = {"Accept": "application/vnd.github+json",
               "X-GitHub-Api-Version": "2022-11-28"}
    # Same optional token the version probe uses. Without one this is the
    # anonymous 60/hour, and a private repo simply reads as "no languages".
    if config.get("version_check", {}).get("use_global_token", True):
        token = read_env_file(os.path.join(SECRETS_DIR, "global.env")).get("GH_TOKEN")
        if token:
            headers["Authorization"] = f"Bearer {token}"
    data = http_json(f"https://api.github.com/repos/{repo}/languages", headers)
    if isinstance(data, dict) and data and sum(data.values()) > 0:
        return data
    return None


def suggest_features(languages):
    """(shares, {feature key: share}) for a github_languages() result. A
    feature's share is the sum over its languages, so TypeScript and JavaScript
    count together for npm. Features with no match are absent."""
    total = sum(languages.values())
    shares = {lang: n / total for lang, n in
              sorted(languages.items(), key=lambda kv: -kv[1])}
    found = {}
    for key, _, spec in FEATURES:
        share = sum(shares.get(lang, 0) for lang in spec.get("languages", []))
        if share > 0:
            found[key] = share
    return shares, found


def _detected_tag(share):
    # One decimal under 10%, so 4.9% does not read as 5% while sitting below
    # the 5% cutoff and not being preselected.
    pct = ("<0.1%" if share < 0.001 else
           f"{share:.1%}" if share < 0.10 else f"{share:.0%}")
    if share >= LANGUAGE_THRESHOLD:
        return f"  ({pct} autodetected)"
    return f"  ({pct} detected)"


def detect_features(repo, config):
    """Say what GitHub reports for `repo`; return {feature key: share} for every
    feature whose languages appear in it, however small."""
    if not repo:
        return {}
    languages = github_languages(repo, config)
    if not languages:
        note("could not read languages from GitHub (offline, private or rate "
             "limited) — using the defaults")
        return {}
    shares, found = suggest_features(languages)
    note("GitHub reports: " + ", ".join(
        f"{lang} {share:.0%}" for lang, share in shares.items()
        if share >= LANGUAGE_THRESHOLD))
    picked = [k for k, share in found.items() if share >= LANGUAGE_THRESHOLD]
    if picked:
        note("preselecting: " + ", ".join(picked) + "   (change them below)")
    else:
        note("nothing there maps to a feature — using the defaults")
    return found


def _enable_groups(key, spec, groups, plan):
    for g in spec["groups"]:
        if g in groups:
            plan["groups"].add(g)
        else:
            warn(f"{key}: config.toml has no `{g}` rule group, so its hosts "
                 "stay refused until you add one — see defaults.toml")


def pick_features(groups, default_groups, repo="", config=None, current=None):
    """Ask for coding agents first, then features — with whatever the chosen
    agents depend on locked on — then for egress groups nothing owns (your own,
    such as one for a LAN). Returns what to write into sandbox.toml.

    `current` ({"agents": [...], "features": [...]}) preselects an existing
    sandbox's choices, for editing; without it the defaults and the repo's
    detected languages decide."""
    plan = {"groups": set(), "packages": [], "bun": False, "gitleaks": False, "agents": [], "features": [],
            "root_disk": "", "cpus": 0, "memory": "", "caches": {},
            "containers_disk": "", "containers_storage": ""}

    say("Coding agents")
    alabels = {f"{key:<8} {desc}": (key, spec) for key, desc, spec in AGENTS}
    agent_on = [l for l, (k, _) in alabels.items() if not current or k in current["agents"]]
    agents = [alabels[label] for label in toggle_list("agents", list(alabels), agent_on)]
    plan["agents"] = [key for key, _ in agents]
    for key, spec in agents:
        _enable_groups(key, spec, groups, plan)

    say("Features")
    note("Each ticked feature installs what it needs and opens the egress it")
    note("needs. base (DNS, the :80 deny, Ubuntu mirrors) is always applied.")
    hints = detect_features(repo, config or {})
    flabels = {f"{key:<8} {desc}" + (_detected_tag(hints[key]) if key in hints else ""):
               (key, spec) for key, desc, spec in FEATURES}
    locked = {}
    for akey, aspec in agents:
        for need in aspec.get("requires", []):
            label = next(l for l, (k, _) in flabels.items() if k == need)
            locked.setdefault(label, akey)
    if current:
        on = [label for label, (key, _) in flabels.items() if key in current["features"]]
    else:
        on = [label for label, (key, spec) in flabels.items()
              if hints.get(key, 0) >= LANGUAGE_THRESHOLD
              or (not spec.get("opt_in")
                  and all(g in default_groups for g in spec["groups"]))]
    picked = [flabels[label] for label in
              toggle_list("features", list(flabels), on, locked)]
    plan["features"] = [key for key, _ in picked]
    for key, spec in picked:
        plan["packages"] += spec.get("packages", [])
        plan["bun"] = plan["bun"] or spec.get("bun", False)
        plan["gitleaks"] = plan["gitleaks"] or spec.get("gitleaks", False)
        _enable_groups(key, spec, groups, plan)

    owned = {g for _, _, spec in FEATURES + AGENTS for g in spec["groups"]}
    rest = [g for g in groups if g not in owned]
    if rest:
        say("Other egress groups")
        plan["groups"].update(
            toggle_list("groups", rest, [g for g in default_groups if g in rest]))
    plan["groups"] = [g for g in groups if g in plan["groups"]]
    return plan


def workspaces_root(config):
    """The configured base folder for projects, or None."""
    raw = config.get("defaults", {}).get("workspaces")
    return os.path.realpath(os.path.expanduser(raw)) if raw else None


def resolve_project(raw, config):
    """Turn what was typed into an absolute project path.

    A BARE NAME resolves inside the workspaces root, so `msbctl add myproject` is
    the whole command for the common case.

    Anything that states a location explicitly is honoured as given, so a
    project outside the workspaces stays one argument:

        /srv/thing      absolute
        ~/src/thing     home-relative
        ./thing         explicitly relative to the CWD, not the workspaces
        ../thing        likewise

    `./` is treated as a deliberate statement rather than noise: typing it is
    how you say "the one here", and silently redirecting that to the workspaces
    would be surprising. With no workspaces configured a bare name falls back to
    CWD-relative, which is what this did before the setting existed.
    """
    raw = raw.strip()
    if raw.startswith("~"):
        return os.path.realpath(os.path.expanduser(raw))
    if os.path.isabs(raw):
        return os.path.realpath(raw)
    if raw in (".", "..") or raw.startswith("./") or raw.startswith("../"):
        return os.path.realpath(raw)
    root = workspaces_root(config)
    return os.path.realpath(os.path.join(root, raw) if root else raw)


def cmd_add(args, config):
    config = maybe_welcome(config)
    say("Register a sandbox")
    # Prompted rather than taken from the cwd when not given, because the
    # common entry point is the picker's "add new" key — and that runs from
    # wherever the desktop launched it, which is never the project.
    root = workspaces_root(config)
    if root:
        note(f"a bare name resolves under {tilde(root)};")
        note("a path starting with / ~ ./ or ../ is taken as written")
    raw = args.dir or ask("project", os.getcwd())
    project = resolve_project(raw, config)
    created = False
    if not os.path.isdir(project):
        if os.path.exists(project):
            die(f"exists but is not a directory: {tilde(project)}")
        # Created, not refused. Registering a project you are about to start is
        # the common case, and making the folder by hand first is a step with
        # no decision in it. The parent must already exist, so a typo in the
        # workspaces path fails rather than building a tree nobody wanted.
        parent = os.path.dirname(project)
        if not os.path.isdir(parent):
            die(f"parent does not exist: {tilde(parent)}\n"
                f"       (from {raw!r}) — create it, or give a path under an "
                "existing directory")
        os.makedirs(project)
        created = True
    note(f"project    {tilde(project)}" + ("   (created)" if created else ""))
    name = ask("sandbox name", os.path.basename(project))
    problem = name_problem(name)
    if problem:
        die(problem)
    entry_path = os.path.join(REGISTRY_DIR, f"{name}.toml")

    found = checkouts(project)
    repo = ask("GitHub repo (owner/name or URL, blank for none)",
               github_repo(project))
    repo = parse_github_url(repo) or repo

    if repo and not found:
        # Nothing checked out yet, so this is the "new project" case: clone
        # into a subfolder named after the repo, leaving the project folder
        # itself free to hold .msb/ and anything else alongside it.
        target = os.path.join(project, repo.split("/")[-1])
        say("Clone")
        note(f"nothing checked out in {tilde(project)} yet")
        note(f"clone into {tilde(target)}?")
        note("")
        note("SSH, matching the convention that origin is an SSH remote — the")
        note("sandbox pushes through the forwarded agent, not through a token.")
        url = f"git@github.com:{repo}.git"
        if os.path.exists(target):
            note(f"{tilde(target)} already exists — leaving it alone")
        elif confirm(f"git clone {url}"):
            # On the HOST, with your own key. The sandbox does not exist yet,
            # and its PAT is for the API rather than for transport.
            proc = subprocess.run(["git", "clone", url, target])
            if proc.returncode != 0:
                warn("clone failed — registering anyway; clone it by hand and "
                     "nothing else needs redoing")
            else:
                note(f"cloned into {tilde(target)}")

    guest_path = pick_guest_path(project, config.get("defaults", {})
                                 .get("guest_path", GUEST_PROJECT))

    say("Git identity")
    idents = config.get("identities", {})
    identity = ""
    if not idents:
        note("none defined in config.toml — skipping")
    else:
        for key in sorted(idents):
            entry = idents[key]
            note(f"  {key:<12} {entry.get('name', '?')} <{entry.get('email', '?')}>")
        note("")
        note("Applied with `git config --system` in the guest, so a repo that")
        note("carries its own user.email still wins. This is the fallback for")
        note("repos that have none, which otherwise cannot commit in a microVM.")
        note("Prefer the noreply form for anything that can reach a public repo.")
        identity = ask("identity (blank for none)",
                       config.get("defaults", {}).get("identity", ""))
        if identity and identity not in idents:
            die(f"unknown identity: {identity}")

    say("SSH keys")
    note("Which keys in your host ssh-agent this sandbox may use, for git over")
    note("ssh and for signing. Nothing is ticked by default: a sandbox gets no")
    note("key until you give it one. Change later with `msbctl keys <name>`.")
    sign_pub = idents.get(identity, {}).get("signing_key") if identity else None
    sign_fp = (_parse_pub_line(sign_pub) or (None,))[0] if sign_pub else None
    if sign_fp:
        note(f"{identity} signs commits with the key marked{SIGNS_MARK.strip()}; it is ticked")
        note("for you, and without it this sandbox commits unsigned.")
    ssh_keys = pick_ssh_keys([sign_fp] if sign_fp else None, preselect_all=False, signing=sign_fp)

    groups = sorted(g for g in config.get("rules", {}) if g != "base")
    default_groups = config.get("defaults", {}).get("rule_groups", [])
    plan = pick_features(groups, default_groups, repo, config)
    pick_resources(plan, config)
    pick_disks(plan, config)
    pick_caches(plan)
    mounts = pick_mounts(project if guest_path == "host" else guest_path)
    secrets = pick_secrets(config)
    chosen = plan["groups"]
    packages = plan["packages"]
    containers_disk = plan["containers_disk"]
    root_default = config.get("defaults", {}).get("root_disk", "16G")
    containers_storage = plan["containers_storage"]

    say("Image")
    image = ask("image", config.get("defaults", {}).get("image", ""))
    if "@sha256:" not in image:
        note("not digest-pinned: a tag can move under a working setup, a digest cannot")
        digest = available_digest(image)
        if digest and confirm(f"pin to {digest}?"):
            image = f"{image}@{digest}"
        elif not digest:
            warn("could not resolve a digest — leaving the tag unpinned")

    # ------------------------------------------------------------- the tokens
    claude_token = ""
    tokens = claude_tokens()
    if len(tokens) > 1 and config.get("defaults", {}).get("claude_auth", "secret") == "secret":
        say("Claude token")
        default = default_claude_token(config)
        follow = f"the default  (now {default})"
        choice = choose_one("which Claude account this sandbox uses", [follow] + list(tokens), 0)
        claude_token = "" if choice == follow else choice

    want_github = bool(repo)
    if want_github:
        say("GitHub token")
        github_token_help(repo)
        want_github = capture_token(name)

    autostart = confirm("start this one with the others by default?")

    # ------------------------------------------------------------- write out
    os.makedirs(REGISTRY_DIR, mode=0o700, exist_ok=True)
    today = dt.date.today().isoformat()
    with open(entry_path, "w", encoding="utf-8") as fh:
        fh.write(render("registry.toml.in", NAME=name, PROJECT=project,
                        GUEST_PATH=guest_path,
                        REPO=repo, DATE=today, IDENTITY=identity,
                        CLAUDE_TOKEN=claude_token,
                        SSH_KEYS=format_ssh_keys(ssh_keys),
                        MOUNTS=format_list("mounts", mounts, '# mounts = ["~/reference:/mnt/reference:ro"]'),
                        AUTOSTART="true" if autostart else "false"))
    note(f"wrote {tilde(entry_path)}")
    for var, host in unreachable_secret_hosts(config, chosen, [sp for sp, _ in secrets]):
        warn(f"{var} is bound to {host}, but no egress rule allows it — "
             f"`msbctl allow {name} {host}` (then rebuild), or it can never be used")
    for spec, value in secrets:
        if value:
            store_secret_value(name, secret_var(spec), value)
        else:
            note(f"no value for {secret_var(spec)} — `msbctl secret add {name}` when you have it")

    msb_dir = os.path.join(project, ".msb")
    os.makedirs(msb_dir, exist_ok=True)
    defaults = config.get("defaults", {})

    sandbox_toml = os.path.join(msb_dir, "sandbox.toml")
    if os.path.exists(sandbox_toml):
        note(f"kept existing {tilde(sandbox_toml)}")
    else:
        # A group listed in `private_dns_groups` is reached by NAME, and those
        # names resolve to LAN addresses, which msb discards unless rebind protection is off. Set
        # together because the group does not work without it — and leaving the
        # operator to discover that produces an NXDOMAIN that reads as a
        # missing rule.
        private_groups = config.get("defaults", {}).get("private_dns_groups", [])
        needs_private_dns = any(g in private_groups for g in chosen)
        with open(sandbox_toml, "w", encoding="utf-8") as fh:
            fh.write(render("sandbox.toml.in",
                            RULE_GROUPS=json.dumps(chosen),
                            PACKAGES=json.dumps(packages),
                            SB_CPUS=(f'cpus = {plan["cpus"]}' if plan["cpus"] != defaults.get("cpus", 4)
                                     else f'# cpus = {defaults.get("cpus", 4)}'),
                            SB_MEMORY=(f'memory = "{plan["memory"]}"' if plan["memory"] != defaults.get("memory", "8G")
                                       else f'# memory = "{defaults.get("memory", "8G")}"'),
                            SECRET_BINDS=format_list("secret_binds", [sp for sp, _ in secrets],
                                                     '# secret_binds = ["NPM_TOKEN@registry.npmjs.org"]'),
                            CACHES=("[caches]\n" + "".join(f'{k} = "{v}"\n' for k, v in plan["caches"].items())).rstrip("\n")
                                   if plan["caches"] else '# [caches]\n# npm = "5G"',
                            ROOT_DISK=(f'root_disk = "{plan["root_disk"]}"'
                                       if plan["root_disk"] != root_default
                                       else f'# root_disk = "{root_default}"'),
                            BUN="true" if plan["bun"] else "false",
                            GITLEAKS="true" if plan["gitleaks"] else "false",
                            CLAUDE="true" if "claude" in plan["agents"] else "false",
                            CONTAINERS_DISK=(f'containers_disk = "{containers_disk}"'
                                             if containers_disk else
                                             '# containers_disk = "20G"'),
                            CONTAINERS_STORAGE=(f'containers_storage = "{containers_storage}"'
                                                if containers_storage else
                                                '# containers_storage = "fuse-overlayfs"'),
                            ALLOW_PRIVATE_DNS="true" if needs_private_dns else "false",
                            SECRET_GITHUB="true" if want_github else "false"))
        # Whether this is committable depends on the layout, and saying
        # "commit this" for a file that is not in any repo is worse than
        # saying nothing.
        inside_repo = os.path.isdir(os.path.join(project, ".git"))
        note(f"wrote {tilde(sandbox_toml)}" +
             ("  — commit this" if inside_repo else "  (outside the checkout)"))

    dev_yaml = os.path.join(msb_dir, "dev.yaml")
    if os.path.exists(dev_yaml):
        note(f"kept existing {tilde(dev_yaml)}")
    else:
        with open(dev_yaml, "w", encoding="utf-8") as fh:
            fh.write(render("dev.yaml.in", NAME=name, IMAGE=image,
                            CPUS=plan["cpus"], MEMORY=plan["memory"]))
        note(f"wrote {tilde(dev_yaml)}" +
             ("  — commit this" if inside_repo else "  (outside the checkout)"))

    say("Registered")
    note(f"Nothing has been started. When you want it:  msbctl start {name}")
    note("The first start runs the bootstrap and takes a few minutes.")


