# Where each package manager keeps what it downloads, keyed by the FEATURE that
# brings it in. Each is a NAMED DISK VOLUME (`<sandbox>-cache-<key>`): ext4, so as
# fast as the root disk, capped at the size you chose, and — unlike an owned disk —
# kept when the sandbox is removed, so a rebuild keeps it and `purge` deletes it.
#
# The volume is mounted at CACHE_MOUNT/<key>, NOT at the tool's own directory:
# msb rejects a named disk whose guest path contains a dot ("invalid or reserved
# device id", verified on 0.7.6 and 0.7.7 — `/d` and `/mnt/cache/npm` work,
# `/root/.npm` and `/mnt/.x` fail). bootstrap.sh then symlinks the tool's
# directory to the mount, which is why CACHES values are the dotted paths.
CACHES = {
    "npm": "/root/.npm",
    "bun": "/root/.bun/install/cache",
    "python": "/root/.cache/pip",
    "rust": "/root/.cargo/registry",
    "go": "/root/go/pkg/mod",
}
CACHE_MOUNT = "/mnt/cache"
CACHE_SIZES = [("small", "2G"), ("medium", "5G"), ("large", "10G")]
MIB = 1024 * 1024


def size_bytes(text):
    """`5G` / `512M` -> bytes."""
    m = re.fullmatch(r"(\d+)([MGT])", str(text).strip().upper())
    if not m:
        die(f"{text!r} is not a size like 5G or 512M")
    return int(m.group(1)) * MIB * {"M": 1, "G": 1024, "T": 1024 * 1024}[m.group(2)]


def human_size(n):
    for unit, step in (("G", 1024 ** 3), ("M", MIB), ("K", 1024)):
        if n >= step:
            return f"{n / step:.1f}{unit}"
    return f"{n}B"


def msb_volumes():
    """{name: {kind, capacity_bytes, used_bytes, ...}} from `msb volume ls`."""
    proc = subprocess.run(["msb", "volume", "ls", "--format", "json"],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        return {}
    try:
        return {v["name"]: v for v in json.loads(proc.stdout)}
    except (ValueError, KeyError, TypeError):
        return {}


def remove_sandbox_volumes(box):
    """Delete this sandbox's cache and containers volumes. Only after the sandbox
    itself is gone: msb refuses to remove a volume that is attached."""
    mine = box.owned_volumes()
    for name in mine:
        run(["msb", "volume", "rm", name], check=False, quiet=True)
    return mine


def pick_caches(plan):
    """Wizard: a size for the package caches of the features chosen, or none."""
    keys = [k for k in plan["features"] if k in CACHES]
    if not keys:
        return
    say("Package caches")
    note("A disk per package manager: as fast as the root disk, capped at the size you")
    note("pick, kept across rebuilds and deleted when the sandbox is purged. The size")
    note("is fixed when it is first created.")
    for k in keys:
        note(f"  {k:<8} {CACHES[k]}")
    size = pick_size("cache size (each)", CACHE_SIZES, "5G",
                     extra=[("none     no caches", None)])
    if size:
        plan["caches"] = {k: size for k in keys}


RESOURCES = [("small", 2, "4G"), ("medium", 4, "8G"), ("large", 8, "16G")]


def pick_resources(plan, config, current=None):
    """CPU count and memory ceiling, as one small/medium/large choice."""
    say("Resources")
    defaults = config.get("defaults", {})
    cpus, memory = current or (defaults.get("cpus", 4), defaults.get("memory", "8G"))
    note("Memory is a ceiling, not a reservation: an idle sandbox uses ~300 MB.")
    rows = [(f"{name:<8} {n} cpu, {mem}" + (("   (current)" if current else "   (usual)")
             if (n, mem) == (cpus, memory) else ""), (n, mem)) for name, n, mem in RESOURCES]
    rows.append(("custom   type values", "custom"))
    default = next((i for i, (_, v) in enumerate(rows) if v == (cpus, memory)), 1)
    label = choose_one("size", [lab for lab, _ in rows], default)
    value = dict(rows)[label]
    if value == "custom":
        while True:
            raw = ask("cpus", str(cpus))
            if raw.isdigit() and int(raw) >= 1:
                break
            warn("a whole number of cpus, at least 1")
        value = (int(raw), ask_size("memory", memory))
