def warn_missing_prereqs(box):
    """Warn about hosts the bootstrap is about to need and cannot reach.

    This exists because the bootstrap's own failure is one step removed from
    the cause. Deny deb.nodesource.com and what you see is `node` failing,
    then `npm: command not found`, then claude-code failing as a CONSEQUENCE
    and being reported as an independent optional failure. Three messages, one
    missing rule, and the one that names the rule is the easiest to miss.

    An earlier version of this check looked only at api.anthropic.com — Claude
    Code's RUNTIME host — and so stayed silent when its INSTALL path was
    blocked, which is the failure that actually happens. Both halves are
    checked now; a feature needs every host in its list, not any of them.

    Warns rather than refuses, and lists everything at once: the same stance
    bootstrap.sh takes, so one round trip fixes the whole allowlist.
    """
    boot = box.project_cfg.get("bootstrap", {})
    wants_claude = boot.get("claude") is not False
    wants_pi = bool(boot.get("pi"))

    needs = []
    # node comes from NodeSource unless the image already carries it, and this
    # cannot know which — so it is listed whenever anything needs node at all.
    if wants_claude or wants_pi:
        needs.append(("node (for the agents)", ["deb.nodesource.com"]))
    if wants_claude:
        needs.append(("claude-code install", ["registry.npmjs.org"]))
        needs.append(("claude-code runtime", ["api.anthropic.com",
                                              "platform.claude.com"]))
    if wants_pi:
        # Its runtime hosts are the [llm] endpoints, which bring their own rules.
        needs.append(("pi install", ["registry.npmjs.org"]))
    needs.append(("gh" + (" + gitleaks" if boot.get("gitleaks") else "") + " downloads",
                  ["github.com", "release-assets.githubusercontent.com"]))
    if box.is_repo:
        needs.append((f"the clone of {box.repo}", ["github.com"]))
        # The clone fails inside the bootstrap, one step removed from the cause,
        # so say it here, before anything is created.
        if box.repo_meta.get("private") and not read_env_file(
                os.path.join(SECRETS_DIR, f"{box.name}.env")).get("GH_TOKEN"):
            warn(f"{box.repo} is private and {box.name} has no GitHub token, so the clone "
                 f"will fail — `msbctl secret set {box.name} GH_TOKEN` first")

    rules = box.net_rules()
    missing = []
    for label, hosts in needs:
        absent = [h for h in hosts
                  if not any(h in rule and "allow" in rule for rule in rules)]
        if absent:
            missing.append((label, absent))
    if not missing:
        return

    warn("the bootstrap will need hosts this sandbox cannot reach:")
    for label, absent in missing:
        note(f"     {label:<24} {', '.join(absent)}")
    note("")
    note("   Add the rule group that covers them to `rule_groups` in")
    note(f"   {box.repo + ':.msb/sandbox.toml' if box.is_repo else tilde(project_path(box))} — "
         "`npm` and `claude` are")
    note("   the usual two — or set the feature false under [bootstrap].")
    note("   Continuing; the bootstrap reports what actually failed.")


# ---------------------------------------------------------- the policy pin
#
# The project's .msb/sandbox.toml decides what may leave the sandbox, which host
# a stored value is substituted toward, and what the sandbox takes from the
# host. It is also committed, and writable from inside the sandbox through the
# project mount. So what it says is not applied just because it says it: the
# values in PINNED_KEYS are recorded (a digest in the registry entry, the values
# themselves under STATE_DIR) when the operator approves them, and a create or
# rebuild that finds them changed shows the difference and asks. Without a
# terminal, or under `msbctl host serve`, it refuses: a prompt is something code
# on the other end of a pty can answer as easily as a person.
#
# Only the PROJECT layer is pinned. The registry entry and config.toml are the
# operator's own files, outside every sandbox, and are not re-approved.

PINNED_KEYS = (
    "rule_groups",          # which egress groups apply
    "extra_rules",          # and the project's own rules
    "allow_private_dns",    # whether names may resolve to LAN addresses
    "secret_binds",         # which host a stored value is substituted toward
    "secrets",              # whether GH_TOKEN is bound at all
    # Resources resolve through _pick too, so a commit saying memory = "256G"
    # or a 4T root disk lands on the next rebuild — on a host that stands alone,
    # with nobody watching it.
    "cpus", "memory", "root_disk", "containers_disk", "caches", "workspace_disk",
)
# NOT pinned, on purpose: `image`, [bootstrap] (but for `pi`, see
# project_policy()) and [env] act only inside the guest, which is what the sandbox is for, and `conf` only names the file the
# image is read from (and must stay in the project).

POLICY_APPROVED_DIR = os.path.join(STATE_DIR, "policy-approved")


def restricted():
    """True under `msbctl host serve`: nothing that approves a policy may ask."""
    return os.environ.get("MSB_RESTRICTED") in ("1", "kandev")


def kandev_key():
    """True under `host serve --kandev`: the Kandev plugin's key, whose generic
    verbs (ls, show, stop, purge) see Kandev's sandboxes and nothing else."""
    return os.environ.get("MSB_RESTRICTED") == "kandev"


def project_policy(box):
    """The project-layer values the pin covers. For a repo sandbox, also the
    commit they were read at, so a diff always names the commit being approved."""
    policy = {k: box.project_cfg[k] for k in PINNED_KEYS if k in box.project_cfg}
    # Unlike the rest of [bootstrap], pi reaches outside the guest: it brings
    # this machine's model endpoints with it — their egress, their keys and
    # perhaps allow_private_dns. Recorded only when on, so a pin taken before
    # pi existed still matches.
    if box.project_cfg.get("bootstrap", {}).get("pi"):
        policy["bootstrap.pi"] = True
    if box.is_repo:
        policy["_commit"] = box.repo_meta.get("sha", "")
    return policy


def policy_digest(policy):
    blob = json.dumps(policy, sort_keys=True, separators=(",", ":")).encode()
    return "sha256:" + hashlib.sha256(blob).hexdigest()


def approved_path(name):
    return os.path.join(POLICY_APPROVED_DIR, f"{name}.json")


def policy_pinned(box):
    """Whether the project's current values are the approved ones."""
    return box.entry.get("policy_pin") == policy_digest(project_policy(box))


def shown(value):
    """A value read from a project, as it may reach the terminal: a printable
    string as is, anything else JSON-escaped. sandbox.toml is writable from the
    guest and TOML spells ESC as \\u001b, so a raw value could move the cursor
    and erase the lines of the very diff the operator is approving."""
    if isinstance(value, str) and value.isprintable():
        return value
    return json.dumps(value)


def _policy_value(value):
    return f'"{value}"' if isinstance(value, str) and value.isprintable() else json.dumps(value)


def policy_diff(old, new):
    """Lines describing what changed from `old` to `new` (None: never recorded)."""
    if old is None:
        lines = ["first time this sandbox's policy is recorded:"]
        lines += [f"  {k} = {_policy_value(v)}" for k, v in sorted(new.items())] or ["  (nothing)"]
        return lines
    lines = []
    for key in sorted(set(old) | set(new)):
        before, after = old.get(key), new.get(key)
        if before == after:
            continue
        if key not in old:
            lines.append(f"+ {key} = {_policy_value(after)}")
        elif key not in new:
            lines.append(f"- {key} = {_policy_value(before)}")
        elif isinstance(before, list) and isinstance(after, list):
            lines.append(f"  {key}:")
            lines += [f"+   {shown(item)}" for item in after if item not in before]
            lines += [f"-   {shown(item)}" for item in before if item not in after]
        elif isinstance(before, dict) and isinstance(after, dict):
            lines.append(f"  [{key}]")
            for sub in sorted(set(before) | set(after)):
                if before.get(sub) != after.get(sub):
                    if sub in before:
                        lines.append(f"-   {shown(sub)} = {_policy_value(before[sub])}")
                    if sub in after:
                        lines.append(f"+   {shown(sub)} = {_policy_value(after[sub])}")
        else:
            lines.append(f"  {key}: {_policy_value(before)} -> {_policy_value(after)}")
    return lines


def approved_policy(name):
    """The approved values, or None if none were ever recorded for `name`."""
    path = approved_path(name)
    if not os.path.isfile(path):
        return None
    return read_json(path)


def approve_policy(box, policy=None):
    """Record `policy` (default: the project's current values) as approved."""
    policy = project_policy(box) if policy is None else policy
    os.makedirs(POLICY_APPROVED_DIR, mode=0o700, exist_ok=True)
    path = approved_path(box.name)
    fd, tmp = tempfile.mkstemp(dir=POLICY_APPROVED_DIR)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(policy, fh, indent=2, sort_keys=True)
    os.replace(tmp, path)
    digest = policy_digest(policy)
    set_toml_key(registry_path(box), "policy_pin", digest)
    box.entry["policy_pin"] = digest


def ask_approval(box, policy, why, where):
    """Show how `policy` differs from the approved one and ask. Dies where
    nobody may be asked (no terminal, or `host serve`), and when declined."""
    say(f"{box.name}: the project's policy changed since it was approved")
    note(f"from {where}, before {why}:")
    for line in policy_diff(approved_policy(box.name), policy):
        note(f"  {line}")
    if restricted() or not (sys.stdin.isatty() and sys.stdout.isatty()):
        die(f"{box.name}: policy not approved — run `msbctl policy {box.name} approve` on the "
            "host, or with your admin key")
    if not confirm(f"approve this policy for {box.name}?"):
        die("not approved, nothing changed")


def check_policy(box, why):
    """Return if the project's pinned values are the approved ones; otherwise show
    what changed and ask, or die where nobody may be asked. `why` names what
    wants to apply them ("create", "allow")."""
    if policy_pinned(box):
        return
    current = project_policy(box)
    if approved_policy(box.name) is None and not current and not box.entry.get("policy_pin"):
        approve_policy(box)        # nothing to approve: the project sets none of it
        return
    ask_approval(box, current, why, tilde(project_path(box)))
    approve_policy(box, current)
    note("approved")


def cmd_policy(args, config):
    """policy <name> [show|approve|update [REF]] — the project-layer values the pin covers."""
    box = Sandbox(args.name, config)
    if args.action in ("approve", "update") and restricted():
        die(f"`policy {args.action}` is refused here — run it on the host, or with your admin key")
    if args.ref and args.action != "update":
        die("a ref is only for `policy <name> update [REF]`")
    if args.action == "update":
        policy_update(box, args.ref)
        return
    if args.action == "approve":
        if policy_pinned(box):
            note(f"{box.name}: the project's policy is the approved one")
            return
        check_policy(box, "approving")
        return
    say(f"{box.name}  policy  [{'approved' if policy_pinned(box) else 'NOT APPROVED'}]")
    if box.is_repo:
        meta = box.repo_meta
        note(f"from {box.repo} at {meta.get('sha', '?')[:12]} "
             f"({meta.get('branch') or meta.get('ref') or '?'}), fetched {meta.get('fetched_at', '?')}")
    else:
        note(f"from {tilde(project_path(box))}")
    current = project_policy(box)
    for key in PINNED_KEYS:
        if key in current:
            note(f"  {key} = {_policy_value(current[key])}")
    if not any(k in current for k in PINNED_KEYS):
        note("  (the project sets none of the pinned keys)")
    if not policy_pinned(box):
        say("Changes since the last approval")
        for line in policy_diff(approved_policy(box.name), current):
            note(f"  {line}")
        note(f"`msbctl policy {box.name} approve` to accept them")


# ------------------------------------------------- sandboxes cloned from a repo
#
# A repo sandbox has no host folder. Its code is a clone, made by the bootstrap
# inside the sandbox, on a disk volume that outlives it. Its project layer is
# the repo's own .msb/sandbox.toml and .msb/dev.yaml, fetched from the GitHub
# contents API AT A RECORDED COMMIT into policy_dir(name), which plays the part
# a project folder plays for a folder sandbox and is never mounted. `rebuild`
# recreates at that commit and fetches nothing, so an unattended rebuild is
# possible and the pin means something; `msbctl policy <name> update` moves it,
# showing what the newer commit changes first.

POLICY_MAX_BYTES = 256 * 1024
REPO_NAME = re.compile(r"[A-Za-z0-9-]+/[A-Za-z0-9._-]+")


def policy_dir(name):
    return os.path.join(STATE_DIR, "policy", name)


def github_api(path, token=None):
    """(status, data) for a GitHub REST call. (404, None) for a 404, and
    (None, None) for any network or decode failure. Neither the token nor the
    response body ever goes into an error: http_json's single None for every
    failure cannot tell "no such file" from "GitHub is down", and a policy fetch
    must."""
    req = urllib.request.Request("https://api.github.com" + path, headers={
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "msbctl"})
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:  # noqa: S310  an https:// constant
            return resp.status, json.load(resp)
    except urllib.error.HTTPError as exc:
        return exc.code, None
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError, OSError):
        return None, None


def repo_token(name):
    """The GitHub token a policy fetch for `name` uses, or None (a public repo
    needs none). The sandbox's own first, else the machine's global one —
    except under `host serve`, where `add --repo` is allowed: a 200 against a
    404 for a repo named by the caller would tell it which private repos the
    operator's token can read."""
    own = read_env_file(os.path.join(SECRETS_DIR, f"{name}.env")).get("GH_TOKEN")
    if own or restricted():
        return own or None
    return read_env_file(GLOBAL_ENV).get("GH_TOKEN") or None


def _api_die(repo, ref, status):
    hint = (" — a private repo needs a GitHub token with Contents: read on it "
            "(`msbctl secret set <name> GH_TOKEN`)" if status == 404 else "")
    die(f"cannot read {repo}@{ref or '(default branch)'}: "
        f"{status if status is not None else 'GitHub unreachable'}{hint}")


def resolve_repo_ref(repo, ref, token):
    """(sha, branch, private) for `ref` (empty: the default branch)."""
    status, info = github_api(f"/repos/{repo}", token)
    if status != 200 or not isinstance(info, dict):
        _api_die(repo, ref, status)
    branch = ""
    target = ref or info.get("default_branch", "")
    if not ref:
        branch = target
    elif not re.fullmatch(r"[0-9a-f]{40}", ref):
        bstatus, _ = github_api(f"/repos/{repo}/branches/{urllib.parse.quote(ref, safe='')}", token)
        branch = ref if bstatus == 200 else ""
    status, commit = github_api(f"/repos/{repo}/commits/{urllib.parse.quote(target, safe='')}", token)
    if status != 200 or not isinstance(commit, dict) or not commit.get("sha"):
        _api_die(repo, ref, status)
    return commit["sha"], branch, bool(info.get("private"))


def _fetch_file(repo, path, sha, token):
    """A file's bytes at `sha`, or None if it does not exist there. Any other
    failure dies: only a 404 means "no file", never an error, or a repo whose
    policy could not be read would silently get the defaults."""
    status, data = github_api(f"/repos/{repo}/contents/{path}?ref={sha}", token)
    if status == 404:
        return None
    if status != 200 or not isinstance(data, dict):
        _api_die(repo, sha[:12], status)
    if data.get("type") != "file" or data.get("size", 0) > POLICY_MAX_BYTES:
        die(f"{repo}: {path} at {sha[:12]} is not a file under {POLICY_MAX_BYTES // 1024} KiB")
    try:
        raw = base64.b64decode(data.get("content", ""))
    except ValueError:
        die(f"{repo}: {path} at {sha[:12]} did not decode")
    if len(raw) > POLICY_MAX_BYTES:
        die(f"{repo}: {path} at {sha[:12]} is over {POLICY_MAX_BYTES // 1024} KiB")
    return raw


def fetch_repo_policy(name, repo, ref, sha=None, token=None):
    """Fetch .msb/sandbox.toml and .msb/dev.yaml of `repo` at `ref` (or exactly
    at `sha`) into a new private directory beside policy_dir(name), and return
    (that directory, meta). install_policy() swaps it in; nothing is replaced
    here, so a refused or failed fetch changes nothing."""
    token = token or repo_token(name)
    if sha:
        status, info = github_api(f"/repos/{repo}", token)
        if status != 200 or not isinstance(info, dict):
            _api_die(repo, sha[:12], status)
        branch = ref if ref and not re.fullmatch(r"[0-9a-f]{40}", ref) else ""
        private = bool(info.get("private"))
        if not ref:
            branch = info.get("default_branch", "")
    else:
        sha, branch, private = resolve_repo_ref(repo, ref, token)
    files = {}
    for path in (".msb/sandbox.toml", ".msb/dev.yaml"):
        files[path] = _fetch_file(repo, path, sha, token)
    if files[".msb/sandbox.toml"] is not None:
        try:
            tomllib.loads(files[".msb/sandbox.toml"].decode("utf-8"))
        except (UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
            die(f"{repo}: .msb/sandbox.toml at {sha[:12]} does not parse: {exc}")
    parent = os.path.dirname(policy_dir(name))
    os.makedirs(parent, mode=0o700, exist_ok=True)
    tmp = tempfile.mkdtemp(prefix=f".{name}-", dir=parent)
    os.makedirs(os.path.join(tmp, ".msb"), exist_ok=True)
    for path, raw in files.items():
        if raw is not None:
            with open(os.path.join(tmp, path), "wb") as fh:
                fh.write(raw)
    problems = conf_problems(os.path.join(tmp, ".msb", "dev.yaml"))
    if problems:
        shutil.rmtree(tmp, ignore_errors=True)
        die(f"{repo}: .msb/dev.yaml at {sha[:12]} sets what msbctl does not read: "
            + "; ".join(problems))
    meta = {"repo": repo, "ref": ref, "branch": branch, "sha": sha, "private": private,
            "fetched_at": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
    write_json(os.path.join(tmp, "meta.json"), meta)
    return tmp, meta


def install_policy(name, tmp):
    """Swap a directory fetch_repo_policy() wrote in as policy_dir(name)."""
    dest = policy_dir(name)
    old = None
    if os.path.exists(dest):
        old = dest + ".old"
        shutil.rmtree(old, ignore_errors=True)
        os.replace(dest, old)
    os.replace(tmp, dest)
    if old:
        shutil.rmtree(old, ignore_errors=True)


def policy_of_dir(path):
    """project_policy() for a fetched directory that is not installed yet."""
    cfg = read_toml(os.path.join(path, ".msb", "sandbox.toml"))
    policy = {k: cfg[k] for k in PINNED_KEYS if k in cfg}
    policy["_commit"] = read_json(os.path.join(path, "meta.json")).get("sha", "")
    return policy


def ensure_repo_policy(box):
    """Before a create: a repo sandbox whose policy directory is missing (a new
    machine, a wiped state directory) fetches it — at the approved commit if one
    was ever approved, else the tip. Only then; a rebuild never refetches."""
    if not box.is_repo or os.path.isfile(os.path.join(box.project, "meta.json")):
        return
    sha = (approved_policy(box.name) or {}).get("_commit") or None
    note(f"fetching the policy of {box.repo}" + (f" at {sha[:12]}" if sha else ""))
    tmp, _ = fetch_repo_policy(box.name, box.repo, box.entry.get("ref", ""), sha=sha)
    install_policy(box.name, tmp)
    box.reload()


def policy_update(box, ref):
    """Move a repo sandbox's policy to the tip of its ref (or of REF, which
    also becomes its ref), showing what that changes and asking first."""
    if not box.is_repo:
        die(f"{box.name} is a folder sandbox; its policy is {tilde(project_path(box))} — "
            f"`msbctl policy {box.name} approve` after changing it")
    ref = box.entry.get("ref", "") if ref is None else ref
    tmp, meta = fetch_repo_policy(box.name, box.repo, ref)
    try:
        new = policy_of_dir(tmp)
        if policy_digest(new) == box.entry.get("policy_pin"):
            note(f"{box.name}: {box.repo} at {meta['sha'][:12]} has the approved policy already")
            install_policy(box.name, tmp)
            tmp = None
        else:
            ask_approval(box, new, f"moving to {meta['sha'][:12]}", f"{box.repo}")
            install_policy(box.name, tmp)
            tmp = None
            approve_policy(box, new)
            note("approved")
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)
    if ref != box.entry.get("ref", ""):
        set_toml_key(registry_path(box), "ref", ref)
    note(f"a `msbctl rebuild {box.name}` applies it. The clone inside is not touched: it is a")
    note("git checkout, moved with git (`git fetch && git checkout ...` in the sandbox).")


def warn_local_groups_in_project(box):
    """A group only this machine defines, listed in the project's own file: it
    works here and breaks every other clone. Said, not refused — it is not a
    hole, just in the wrong file, and `msbctl edit` → Features moves it."""
    if box.is_repo:
        return
    stray = [g for g in box.project_cfg.get("rule_groups", []) if g in machine_only_groups()]
    if stray:
        warn(f"{', '.join(stray)} in {tilde(project_path(box))}: defined only in this machine's "
             f"config.toml, so every other clone fails with \"unknown rule group\" — move "
             f"{'it' if len(stray) == 1 else 'them'} to extra_rule_groups in the registry entry "
             f"(`msbctl edit {box.name}` → Features & agents does it)")


def refuse_before_create(box):
    """Everything that stops a create, checked BEFORE anything is removed: a
    rebuild or rename that tore the VM down first and then refused would leave
    nothing where a running sandbox was."""
    if box.is_kandev:
        die(f"{box.name} is a Kandev sandbox: only `msbctl kandev provision` creates one")
    ensure_repo_policy(box)
    refuse_conf_problems(box)
    refuse_reserved_bindings(box)
    check_policy(box, "create")


def is_reserved_var(var):
    """Variables with a FIXED binding: GH_TOKEN (github.com, api.github.com),
    every Claude token (Anthropic's hosts) and every model endpoint's key
    (LLM_KEY_*, its [llm] host). No `secret_binds` entry, in any layer, may name
    one: a second binding `GH_TOKEN@attacker.example` would send the sandbox's
    real token wherever the binding says."""
    return (var == "GH_TOKEN" or var == CLAUDE_TOKEN_VAR
            or var.startswith(CLAUDE_TOKEN_VAR + "_") or var.startswith(LLM_KEY_PREFIX))


def reserved_binding_problems(box):
    """The `secret_binds` entries that name a reserved variable."""
    return [spec for spec in box.secret_binds if is_reserved_var(secret_var(spec))]


def refuse_reserved_bindings(box):
    bad = reserved_binding_problems(box)
    if bad:
        die(f"{box.name}: {', '.join(repr(b) for b in bad)} in "
            f"{tilde(box._origin('secret_binds'))}: GH_TOKEN and the Claude tokens have fixed "
            "bindings and cannot be bound again — remove the line")


def refuse_conf_problems(box):
    """Die if the project's dev.yaml says more than msbctl reads. Only create
    and rebuild check: an existing sandbox keeps running and starting, since
    nothing in the file reaches msb either way."""
    problems = conf_problems(box.conf_path)
    if not problems:
        return
    lines = [f"{tilde(box.conf_path)} sets what msbctl does not read, and is never passed to msb:"]
    lines += [f"  {p}" for p in problems]
    lines += ["Move `env:` to [env] in .msb/sandbox.toml, and cpus/memory there too.",
              "Anything else msb's config file can do goes in a file of your own, named by",
              f"`msb_conf` in {tilde(registry_path(box))} (registry only, never a repo)."]
    die("\n".join(lines))


def do_create(box):
    say(f"Creating {box.name}")
    refuse_before_create(box)
    warn_local_groups_in_project(box)
    warn_missing_prereqs(box)
    ensure_agent_filter(box)
    secret_flags, env = box.secret_env()
    argv = (["msb", "create", "--name", box.name]
            + box.create_flags() + secret_flags + [box.image])
    run(argv, env=env)

    say("Bootstrapping (once)")
    # Not check=True: a failed bootstrap still leaves a sandbox worth keeping
    # (to look inside, and the rest of it may work), so everything below still
    # runs. But it must not look like success either — see bootstrap_failed().
    boot = run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c",
                bootstrap_payload(box)], check=False)
    ensure_bridge(box)
    ensure_profile(box)
    ensure_pi(box)
    ensure_identity(box)
    ensure_git_push(box)
    ensure_git_checkstat(box)
    ensure_podman_runtime(box)
    if boot.returncode != 0:
        bootstrap_failed(box, boot.returncode)
    return boot.returncode == 0


# Sandboxes whose bootstrap failed during this msbctl run. main() exits
# non-zero if any did, once the command has finished: do_create() itself must
# not exit, because rename and the edit menu still have work to do after it.
BOOTSTRAP_FAILURES = []


def bootstrap_failed(box, code):
    """Say, last and loudly, that a sandbox was created but is not set up.

    The bootstrap's own summary is easy to miss: it is in the middle of a long
    create, and errors on stderr (apt's `E:` lines) can arrive after it.
    """
    BOOTSTRAP_FAILURES.append(box.name)
    sys.stdout.flush()          # after the create's own output, even when piped
    print(f"\n{BOLD}{RED}== {box.name} is running, but its bootstrap FAILED "
          f"(exit {code}){RESET}", file=sys.stderr)
    for line in (
            "The summary above lists the steps under \"REQUIRED, FAILED\"; the",
            "reason is in that step's output, and apt's errors can come after the",
            "summary. The sandbox is kept so you can look inside:",
            f"  msbctl shell {box.name}",
            "Fix the cause (usually a missing egress rule), then:",
            f"  msbctl rebuild {box.name}"):
        print(f"   {line}", file=sys.stderr)


def bootstrap_payload(box):
    """Ship bootstrap.sh in over stdin rather than mounting it.

    The guest can only see the project and the profile directory, and bootstrap.sh
    lives in neither — this file is in the msb-manager checkout, which is
    deliberately not mounted. Writing it in and running it keeps the manager's
    own code outside every sandbox's reach.
    """
    with open(BOOTSTRAP, encoding="utf-8") as fh:
        body = fh.read()
    versions = box.versions()
    boot = box.project_cfg.get("bootstrap", {})
    env = {
        "MSB_NODE_MAJOR": str(versions.get("node", "22")),
        "MSB_GITLEAKS_VERSION": str(versions.get("gitleaks", "8.30.1")),
        "MSB_GH_VERSION": str(versions.get("gh", "2.102.0")),
        "MSB_BUN_VERSION": str(versions.get("bun", "1.4.2")),
        "MSB_EXTRA_PACKAGES": " ".join(boot.get("packages", [])),
        # Default TRUE: this manager exists to run agents, so an explicit
        # opt-out is the right shape rather than an explicit opt-in.
        "MSB_WANT_CLAUDE": "0" if boot.get("claude") is False else "1",
        # Opt-in: it needs a model endpoint of this machine's to be any use.
        "MSB_WANT_PI": "1" if boot.get("pi") else "0",
        "MSB_PI_PACKAGE": PI_PACKAGE,
        "MSB_WANT_BUN": "1" if boot.get("bun") else "0",
        "MSB_WANT_GITLEAKS": "1" if boot.get("gitleaks") else "0",
        "MSB_PROJECT_DIR": box.guest_project,
        "MSB_PROJECT_SCRIPT": boot.get("script", ""),
        "MSB_CONTAINERS_STORAGE": boot.get("containers_storage", ""),
        "MSB_CACHE_LINKS": " ".join(f"{src}:{dest}" for src, dest in box.cache_links),
        # A repo sandbox's code: cloned into the workspace volume on its first
        # create, left alone after (a rebuild finds .git there).
        "MSB_CLONE_URL": f"https://github.com/{box.repo}.git" if box.is_repo else "",
        "MSB_CLONE_REF": (box.entry.get("ref") or box.repo_meta.get("branch", ""))
                         if box.is_repo else "",
    }
    exports = "\n".join(f"export {k}={shq(v)}" for k, v in env.items())
    return (f"cat >/tmp/bootstrap.sh <<'MSB_BOOTSTRAP_EOF'\n{body}\n"
            f"MSB_BOOTSTRAP_EOF\nchmod +x /tmp/bootstrap.sh\n{exports}\n"
            "/tmp/bootstrap.sh\n")


def shq(value):
    """Single-quote for sh. Values here are config-derived, never secrets."""
    return "'" + str(value).replace("'", "'\\''") + "'"


def cmd_start(args, config):
    box = Sandbox(args.name, config)
    table = msb_table()
    if state_of(box.name, table) == "absent":
        do_create(box)
    else:
        ensure_running(box, table, packages=True)
    print_one(box, msb_table())


def cmd_stop(args, config):
    box = Sandbox(args.name, config)
    proc = run(["msb", "stop", box.name], check=False)
    if proc.returncode != 0 and state_of(box.name) == "running":
        die(f"msb stop {box.name} failed")
    if box.is_kandev:
        if box.entry.get("state") != "absent":
            kandev_set(box.name, state="stopped", agentctl_running=False)
    else:
        stop_agent_filter(box)
    note(f"{box.name} stopped — installed packages and state are kept")
    if getattr(args, "json", False):
        return show_data(Sandbox(box.name, config))
    return None


def cmd_rebuild(args, config):
    box = Sandbox(args.name, config)
    say(f"Rebuilding {box.name}")
    note("network rules, mounts and the image are fixed at create time, so")
    note("changing any of them means this (cpus, memory and the root disk do not:")
    note("`msbctl resize`). Packages installed")
    note("by hand are lost; anything in bootstrap.sh comes back. Package caches,")
    note("container images and the Claude state are kept.")
    refuse_before_create(box)
    run(["msb", "stop", box.name], check=False, quiet=True)
    run(["msb", "rm", box.name], check=False, quiet=True)
    do_create(box)
    print_one(box, msb_table())


def cmd_purge(args, config):
    """Returns {"name", "purged"} for `--json`. A name with nothing registered
    under it is not a failure: what was asked for is true, so a repeated or
    late purge succeeds. Under the Kandev key, a sandbox that is not Kandev's
    counts as nothing, and is never touched."""
    name = args.name
    entry = read_toml(registry_path_for(name)) if os.path.isfile(registry_path_for(name)) else {}
    if not entry or (kandev_key() and entry.get("source") != "kandev"):
        note(f"nothing found named {name}: nothing to purge")
        return {"name": name, "purged": False}
    box = Sandbox(name, config)
    if box.is_kandev:
        return purge_kandev(box, args)
    secret = os.path.join(SECRETS_DIR, f"{box.name}.env")
    entry = os.path.join(REGISTRY_DIR, f"{box.name}.toml")

    say(f"Purging {box.name}")
    note("This deletes, in this order:")
    note(f"  the sandbox          {box.name}")
    note(f"  its Claude state     {tilde(box.state)}")
    if os.path.isdir(box.pi_state):
        note(f"  its pi state         {tilde(box.pi_state)}  (pi's sessions)")
    owned = box.owned_volumes()
    if owned:
        note(f"  its disk volumes     {', '.join(owned)}  (package caches, container images"
             + (", the clone" if box.is_repo else "") + ")")
    if box.is_repo and box.workspace_volume in owned:
        warn(f"{box.workspace_volume} holds the clone: work in it that was not pushed is lost")
    if os.path.isfile(secret):
        note(f"  its token            {tilde(secret)}  (revoke it on GitHub too)")
    if box.is_repo:
        note(f"  its fetched policy   {tilde(box.project)}")
    note(f"  its registration     {tilde(entry)}")
    note("")
    if box.is_repo:
        note(f"The repository on GitHub is not touched: {box.repo}")
    else:
        note(f"The project itself is NOT touched: {tilde(box.project)}")
    if not args.yes and not confirm(f"purge {box.name}?"):
        return {"name": box.name, "purged": False}

    run(["msb", "stop", box.name], check=False, quiet=True)
    run(["msb", "rm", box.name], check=False, quiet=True)
    stop_agent_filter(box)
    shutil.rmtree(box.state, ignore_errors=True)
    shutil.rmtree(box.pi_state, ignore_errors=True)
    if box.is_repo:
        shutil.rmtree(box.project, ignore_errors=True)
    remove_sandbox_volumes(box)
    for path in (secret, entry, approved_path(box.name),
                 os.path.join(TOOLS_STATE_DIR, f"{box.name}.json")):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass  # never had one, or already gone
    cache = read_json(VERSIONS_CACHE)
    cache.pop(box.name, None)
    write_json(VERSIONS_CACHE, cache)
    note(f"{box.name} purged")
    if box.repo:
        note("Revoke its PAT: https://github.com/settings/personal-access-tokens")
    return {"name": box.name, "purged": True}


def purge_kandev(box, args):
    """A Kandev sandbox: its serve mappings, the VM, the entry (kandev_remove()),
    under the lock the reaper also takes. Nothing else of msbctl's exists for it."""
    rec = kandev_record(box.name, box.entry)["record"]
    if not args.yes:
        say(f"Purging {box.name}, Kandev's sandbox for environment {rec['env']}")
        note("Kandev loses the session's workspace; its next attach fails.")
        if not confirm(f"purge {box.name}?"):
            return {"name": box.name, "purged": False}
    with kandev_lock():
        entry = read_toml(registry_path_for(box.name))
        try:
            if entry.get("source") == "kandev":
                kandev_remove(box.name, entry, set(kandev_labelled()))
        except KandevError as exc:
            if getattr(args, "json", False):
                raise                   # its code (conflict, unavailable) reaches the JSON
            die(exc.message)
    note(f"{box.name} purged")
    return {"name": box.name, "purged": True}


# ------------------------------------------------------------- rename and move
#
# msb can rename neither a sandbox nor a volume, so a new name is a new VM: the
# old one is removed and, if it existed, created again under the new name — the
# cost of a rebuild. Everything msbctl itself keys by name moves with it; the
# disk volumes stay where they are and the entry's `volumes` key keeps pointing
# at them. A new project folder is a create-time mount, so that is a rebuild too.

SANDBOX_NAME = re.compile(r"[a-z0-9][a-z0-9-]*")


def name_problem(name, renaming=None):
    """Why `name` cannot be given to a new (or the renamed) sandbox, or None."""
    if not SANDBOX_NAME.fullmatch(name):
        return "name must be lowercase letters, digits and dashes"
    if name == renaming:
        return f"it is already called {name}"
    if name.startswith("k-"):
        return "names starting with k- are kept for Kandev's sandboxes"
    if os.path.exists(registry_path_for(name)):
        return f"{name} is already registered ({tilde(registry_path_for(name))})"
    # A renamed sandbox still owns volumes under its old name; a second sandbox
    # taking that name would mount the same disks.
    for other in registered():
        if other != renaming and read_toml(registry_path_for(other)).get("volumes") == name:
            return f"{name} is still the disk-volume prefix of {other} (it was renamed from it)"
    if state_of(name) != "absent":
        return f"msb already has a sandbox called {name} that msbctl does not manage"
    return None


def _follow_rename_in_comments(path, old, new):
    """The entry's comments name the sandbox (`msbctl keys old`); keep them right.
    Comment lines only, and only where a command or the header names it."""
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
    command = re.compile(rf"(msbctl [a-z-]+ (?:add |rm |ls )?){re.escape(old)}(?![\w.-])")
    for i, line in enumerate(lines):
        if line.lstrip().startswith("#"):
            line = command.sub(rf"\g<1>{new}", line)
            lines[i] = re.sub(rf"^# {re.escape(old)} — ", f"# {new} — ", line)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


def rename_sandbox(box, new):
    """Move everything msbctl keeps under `box.name` to `new`, removing the old VM.
    Returns whether there was a VM, so the caller can create it again."""
    old = box.name
    moves = [(os.path.join(SECRETS_DIR, f"{old}.env"), os.path.join(SECRETS_DIR, f"{new}.env")),
             (box.state, os.path.join(STATE_DIR, "claude", new)),
             (box.pi_state, os.path.join(STATE_DIR, "pi", new)),
             (os.path.join(AGENT_DIR, f"{old}.log"), os.path.join(AGENT_DIR, f"{new}.log")),
             # Which bundle adapters msbctl wrote; without it the renamed sandbox
             # forgets to remove them and an agent keeps a dead tool.
             (os.path.join(TOOLS_STATE_DIR, f"{old}.json"),
              os.path.join(TOOLS_STATE_DIR, f"{new}.json")),
             (approved_path(old), approved_path(new)),
             (policy_dir(old), policy_dir(new))]
    # Checked before anything is destroyed, so a refusal leaves it all as it was.
    clash = [dst for src, dst in moves if os.path.exists(src) and os.path.exists(dst)]
    if clash:
        die(f"left over from an earlier {new}: {', '.join(tilde(p) for p in clash)} — "
            "move it out of the way first")

    existed = state_of(old) != "absent"
    if existed:
        run(["msb", "stop", old], check=False, quiet=True)
        run(["msb", "rm", old], check=False, quiet=True)
        if state_of(old) != "absent":
            die(f"could not remove the sandbox {old} — nothing has been renamed")
    stop_agent_filter(box)

    entry = registry_path_for(new)
    os.replace(registry_path(box), entry)
    set_toml_key(entry, "name", new)
    if box.owned_volumes():
        # Pinned to the volumes that exist, or dropped when renamed back to them.
        set_toml_key(entry, "volumes", None if box.volume_prefix == new else box.volume_prefix)
    else:
        set_toml_key(entry, "volumes", None)
    _follow_rename_in_comments(entry, old, new)
    for src, dst in moves:
        if os.path.exists(src):
            os.replace(src, dst)
    cache = read_json(VERSIONS_CACHE)
    if old in cache:
        cache[new] = cache.pop(old)
        write_json(VERSIONS_CACHE, cache)
    return existed


def explain_rename():
    note("msb cannot rename a sandbox, so this removes it and creates it again under")
    note("the new name, like a rebuild: packages installed by hand are lost, anything")
    note("in bootstrap.sh comes back. Settings, secrets, the Claude state, package")
    note("caches and container images all move with it.")


def cmd_rename(args, config):
    box = Sandbox(args.name, config)
    problem = name_problem(args.new, renaming=box.name)
    if problem:
        die(problem)
    say(f"Renaming {box.name} to {args.new}")
    if state_of(box.name) != "absent":
        refuse_before_create(box)
        explain_rename()
        if not args.yes and not confirm(f"rename {box.name} to {args.new}?"):
            return
    existed = rename_sandbox(box, args.new)
    note(f"renamed: {tilde(registry_path_for(args.new))}")
    if existed:
        box = Sandbox(args.new, config)
        do_create(box)
        print_one(box, msb_table())


def move_project(box, raw, config):
    """Point `box` at another project folder (typed as for `add`). True if it changed.
    The old folder may already be gone: moving a checkout is the usual reason."""
    project = resolve_project(raw, config)
    if project == box.project:
        note(f"{box.name} already uses {tilde(project)}")
        return False
    if not os.path.isdir(project):
        die(f"not a directory: {tilde(project)}")

    # The portable half of the config lives in the project. A clone of a repo
    # that commits .msb/ brings it along; a bare folder needs it copied over.
    old_msb, new_msb = os.path.join(box.project, ".msb"), os.path.join(project, ".msb")
    if not os.path.isfile(os.path.join(project, box.conf)):
        missing = ([f for f in sorted(os.listdir(old_msb))
                    if not os.path.exists(os.path.join(new_msb, f))]
                   if os.path.isdir(old_msb) else [])
        if not missing:
            die(f"{tilde(project)} has no {box.conf}, and there is none to copy from "
                f"{tilde(box.project)} — `msbctl add` it as a new sandbox instead")
        note(f"{tilde(project)} has no {box.conf}; the old folder has: {', '.join(missing)}")
        if not confirm(f"copy {'it' if len(missing) == 1 else 'them'} over?"):
            die("cancelled — nothing changed")
        os.makedirs(new_msb, exist_ok=True)
        for f in missing:
            src = os.path.join(old_msb, f)
            (shutil.copytree if os.path.isdir(src) else shutil.copy2)(src, os.path.join(new_msb, f))
        note(f"copied into {tilde(new_msb)}")

    path = registry_path(box)
    set_toml_key(path, "project", project)
    note(f"project    {tilde(project)}")
    repo = github_repo(project)
    if repo and repo != box.repo:
        set_toml_key(path, "repo", repo)
        note(f"repo       {repo}  (was {box.repo or 'none'})")
        if read_env_file(os.path.join(SECRETS_DIR, f"{box.name}.env")).get("GH_TOKEN"):
            warn(f"its GitHub token was made for {box.repo or 'another repo'} — "
                 f"`msbctl edit {box.name}` → GitHub token to replace it")
    return True


def refuse_repo_sandbox(box, what):
    if box.is_repo:
        die(f"{box.name} has no folder on this machine — it is a clone of {box.repo} inside "
            f"the sandbox, so there is nothing to {what}")


def cmd_move(args, config):
    box = Sandbox(args.name, config)
    refuse_repo_sandbox(box, "move")
    if not move_project(box, args.dir, config):
        return
    if state_of(box.name) == "absent":
        note("not created yet, so it applies at first start")
    elif args.rebuild or confirm(f"the folder is mounted at create time — rebuild {box.name} now?"):
        cmd_rebuild(verb_args("rebuild", name=box.name), config)
    else:
        note(f"until then it still sees the old folder: `msbctl rebuild {box.name}`")


# `shell` and `exec` pass every flag msbctl does not use itself straight to
# `msb exec` (split off in split_msb_flags(), before argparse sees them), so
# `-u root`, `--timeout 5m`, `-e KEY=value` and whatever later msb versions add
# work without a table here to keep in step. msbctl adds `--tty` (shell) and
# `-w` itself, and msb refuses either twice, so those are only left out when
# the caller already gave one.
MSB_EXEC_HINT = ("any other flag goes to `msb exec` as is (`msb exec --help` lists "
                 "them), e.g. -u root, --timeout 5m, -e KEY=value; give them after "
                 "the name, and for exec before --")


def split_msb_flags(argv, verb):
    """argv with the msb flags of `exec`/`shell` at argv[verb] taken out, and
    those flags. They follow the name (which may be left out); for exec they
    end at `--`. `-h` stays behind for argparse. An exec with no name before
    its flags or `--` gets `.`, this folder's sandbox."""
    head, rest = argv[:verb + 1], argv[verb + 1:]
    name = []
    if rest and not rest[0].startswith("-"):
        name, rest = rest[:1], rest[1:]
    tail = []
    if argv[verb] == "exec":
        if "--" in rest:
            cut = rest.index("--")
        elif rest and rest[0].startswith("-"):
            cut = len(rest)
        else:
            return argv, []          # `exec . make -j4`: all of it is the command
        if rest[:1] and not rest[0].startswith("-"):
            return argv, []          # `exec x git log -- file`: so is this
        rest, tail = rest[:cut], rest[cut:]
        name = name or ["."]
    helps = [a for a in rest if a in ("-h", "--help")]
    flags = [a for a in rest if a not in ("-h", "--help")]
    return head + helps + name + tail, flags


def gave_flag(flags, short, long):
    """True if `flags` already has this option, in any of its spellings."""
    return any(f == long or f.startswith(long + "=")
               or (short and f.startswith(short)) for f in flags)


def msb_exec_argv(box, flags, want_tty=False):
    cmd = ["msb", "exec", box.name]
    if want_tty and not any(gave_flag(flags, s, l) for s, l in (
            ("-t", "--tty"), (None, "--no-tty"), (None, "--stream"))):
        cmd.append("--tty")
    cmd += ["-e", f"SSH_AUTH_SOCK={GUEST_AGENT_SOCK}"]
    if not gave_flag(flags, "-w", "--workdir"):
        cmd += ["-w", guest_workdir(box)]
    return cmd + flags


def cmd_shell(args, config):
    box = Sandbox(args.name, config)
    ensure_running(box)
    os.execvp("msb", [*msb_exec_argv(box, args.msb_flags, want_tty=True), "--", "bash", "-l"])


def cmd_exec(args, config):
    box = Sandbox(args.name, config)
    # argparse.REMAINDER keeps the `--` separator, so `msbctl exec x -- ls`
    # would otherwise run a command literally named "--".
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        die("exec needs a command")
    ensure_running(box)
    os.execvp("msb", [*msb_exec_argv(box, args.msb_flags), "--", *command])


def cmd_reclaim(args, config):
    box = Sandbox(args.name, config)
    # Page cache is never returned on its own, whether written to the guest
    # disk or through a virtiofs mount, so a sandbox that builds things drifts
    # up to its memory ceiling and stays there. This gives it back in about a
    # second. Anonymous memory needs no help.
    run(["msb", "exec", box.name, "--no-tty", "--", "sh", "-c",
         "sync; echo 3 > /proc/sys/vm/drop_caches; echo reclaimed"], check=False)


def confirm(question):
    try:
        return input(f"   {question} [y/N] ").strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


