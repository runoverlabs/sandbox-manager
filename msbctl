def checkouts(project):
    """Every git checkout this project contains, as absolute paths.

    TWO LAYOUTS ARE SUPPORTED and both are normal:

      the project IS the repo        <project>/.git
      the project CONTAINS repos     <project>/<name>/.git

    The second is what `msbctl add` produces when it clones into a new project
    folder, and it exists so that .msb/ sits BESIDE the checkout instead of
    inside it. One consequence worth knowing: .msb/sandbox.toml is then not
    committed to the repo and does not travel with a clone. That is a real
    trade-off, and neither layout is wrong.

    Only one level down. A deep walk would find vendored and nested repos and
    treat things this tool does not own as projects.
    """
    found = []
    if os.path.isdir(os.path.join(project, ".git")):
        found.append(project)
    try:
        entries = sorted(os.listdir(project))
    except OSError:
        return found
    for entry in entries:
        if entry.startswith("."):
            continue
        path = os.path.join(project, entry)
        if os.path.isdir(os.path.join(path, ".git")):
            found.append(path)
    return found


def parse_github_url(url):
    """owner/name from a GitHub URL, or "" .

    Handles the three forms a GitHub remote takes (https, ssh://, scp-style). A
    repository identity has to be derived rather than typed, or it is wrong
    exactly when it matters.
    """
    url = url.strip()
    for prefix in ("https://github.com/", "ssh://git@github.com/",
                   "git@github.com:"):
        if url.startswith(prefix):
            return url[len(prefix):].removesuffix(".git").rstrip("/")
    # Already in owner/name form.
    if re.fullmatch(r"[\w.-]+/[\w.-]+", url):
        return url.removesuffix(".git")
    return ""


def github_repo(project):
    """owner/name for a project, looking in every checkout it contains."""
    for checkout in checkouts(project):
        for remote in ("origin", "upstream"):
            repo = parse_github_url(git(checkout, "remote", "get-url", remote))
            if repo:
                return repo
    return ""


def ask(prompt, default=""):
    shown = f" [{default}]" if default else ""
    try:
        answer = input(f"   {prompt}{shown}: ").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit("\nmsbctl: cancelled")
    return answer or default


class Header(str):
    """A heading row inside a toggle_list: shown, but never numbered, ticked or
    landed on by the cursor. Lets one list be grouped into sections."""


def _toggle_numbered(title, options, selected, locked):
    """Pick any of `options` by toggling. Returns the chosen ones, in order.

    Type numbers (space or comma separated) to flip them, `a` for all, `n` for
    none, enter to accept. Plain input() like ask(), so it works without fzf.

    `locked` maps an option to the reason it cannot be turned off. Those stay
    ticked through `n` and through toggling, and say why.
    """
    pickable = [o for o in options if not isinstance(o, Header)]
    on = {o for o in selected if o in pickable} | set(locked)
    while True:
        n = 0
        for opt in options:
            if isinstance(opt, Header):
                note(f"  {opt}")
                continue
            n += 1
            why = f"  (needed by {locked[opt]})" if opt in locked else ""
            note(f"  [{'x' if opt in on else ' '}] {n:>2}  {opt}{why}")
        answer = ask(f"toggle {title} (numbers, a=all, n=none, enter=done)")
        if not answer:
            return [o for o in pickable if o in on]
        if answer in ("a", "n"):
            on = set(pickable) if answer == "a" else set(locked)
            continue
        for tok in answer.replace(",", " ").split():
            if tok.isdigit() and 1 <= int(tok) <= len(pickable):
                opt = pickable[int(tok) - 1]
                if opt in locked:
                    warn(f"{opt.split()[0]} stays on: needed by {locked[opt]}")
                else:
                    on ^= {opt}
            else:
                warn(f"ignoring {tok!r}")


def _read_key(fd):
    """One keypress from a raw-ish terminal, as a name. Arrow keys arrive as
    ESC [ A or ESC O A; a lone ESC is told apart by the follow-up not arriving."""
    ch = os.read(fd, 1)
    if ch == b"\x1b":
        if not select.select([fd], [], [], 0.05)[0]:
            return "esc"
        rest = os.read(fd, 2)
        return {b"[A": "up", b"OA": "up", b"[B": "down", b"OB": "down",
                b"[H": "home", b"[F": "end"}.get(rest, "")
    return {b" ": "space", b"\r": "enter", b"\n": "enter", b"\x03": "esc",
            b"k": "up", b"j": "down", b"a": "all", b"n": "none",
            b"q": "esc", b"\x04": "esc"}.get(ch, "")


def _toggle_tui(title, options, selected, locked):
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    pick = [i for i, o in enumerate(options) if not isinstance(o, Header)]
    if not pick:
        return []
    on = {o for o in selected if o in options} | set(locked)
    cur, top, msg = pick[0], 0, ""
    drawn = 0
    out = sys.stdout

    def move(delta):
        nonlocal cur
        i = cur
        while True:
            i = (i + delta) % len(options)
            if i in pick:
                cur = i
                return

    def draw():
        nonlocal drawn, top
        cols, rows = shutil.get_terminal_size()
        view = min(len(options), max(3, rows - 4))
        # Keep a heading in view when the cursor sits right under it.
        want = cur - 1 if cur > 0 and isinstance(options[cur - 1], Header) else cur
        top = min(max(top, cur - view + 1), want)
        top = max(0, min(top, len(options) - view))
        lines = [f"   {BOLD}{title}{RESET}"]
        for i in range(top, top + view):
            opt = options[i]
            if isinstance(opt, Header):
                lines.append(f"   {BOLD}{opt}{RESET}"[:cols + 8])
                continue
            why = f"  (needed by {locked[opt]})" if opt in locked else ""
            box = "[x]" if opt in on else "[ ]"
            line = f"   {'▌' if i == cur else ' '} {box} {opt}{why}"[:cols - 1]
            lines.append(f"{BOLD}{line}{RESET}" if i == cur else line)
        more = f"  ({top + 1}-{top + view} of {len(options)})" if view < len(options) else ""
        lines.append(f"   {DIM}↑↓ move   space toggle   a all   n none   "
                     f"enter done   esc cancel{more}{RESET}")
        lines.append(f"   {msg}" if msg else "")
        if drawn:
            out.write(f"\x1b[{drawn}A")
        for line in lines:
            out.write(f"\r\x1b[2K{line}\n")
        out.flush()
        drawn = len(lines)

    try:
        tty.setcbreak(fd)
        out.write("\x1b[?25l")
        while True:
            draw()
            msg = ""
            key = _read_key(fd)
            if key == "up":
                move(-1)
            elif key == "down":
                move(1)
            elif key == "home":
                cur = pick[0]
            elif key == "end":
                cur = pick[-1]
            elif key == "space":
                opt = options[cur]
                if opt in locked:
                    msg = f"{opt.split()[0]} stays on: needed by {locked[opt]}"
                else:
                    on ^= {opt}
            elif key == "all":
                on = {options[i] for i in pick}
            elif key == "none":
                on = set(locked)
            elif key == "enter":
                break
            elif key == "esc":
                out.write(f"\x1b[{drawn}A\x1b[J\x1b[?25h")
                _restore_tty(fd, saved)
                sys.exit("\nmsbctl: cancelled")
        # Collapse the menu to one line so the scrollback reads as a log.
        out.write(f"\x1b[{drawn}A\x1b[J")
        chosen = [o for o in options if o in on]
        names = ", ".join(o.split()[0] for o in chosen) or "(none)"
        out.write(f"   {title}: {names}\n")
        return chosen
    finally:
        out.write("\x1b[?25h")
        out.flush()
        _restore_tty(fd, saved)


def toggle_list(title, options, selected, locked=None):
    """Pick any of `options` by toggling. Returns the chosen ones, in order.

    On a terminal this is a navigable menu: arrows (or j/k) move, space toggles,
    enter accepts. Anywhere else — a pipe, a test — it falls back to typing
    numbers, so nothing here ever depends on the terminal being interactive.

    `locked` maps an option to the reason it cannot be turned off. Those stay
    ticked through "none" and through toggling, and say why.
    """
    locked = locked or {}
    if (sys.stdin.isatty() and sys.stdout.isatty() and options
            and os.environ.get("TERM", "dumb") != "dumb"):
        return _toggle_tui(title, options, selected, locked)
    return _toggle_numbered(title, options, selected, locked)


def _restore_tty(fd, saved):
    """Put the terminal back after a raw-mode menu. Best effort: if the tty has
    gone away (EIO) there is nothing left to restore, and failing here would
    replace the menu's real outcome with a traceback."""
    try:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
    except termios.error:
        pass  # the terminal is gone; see above


def _choose_tui(title, options, default):
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    cur, drawn, out = default, 0, sys.stdout

    def draw():
        nonlocal drawn
        cols = shutil.get_terminal_size()[0]
        lines = [f"   {BOLD}{title}{RESET}"]
        for i, opt in enumerate(options):
            line = f"   {'▌' if i == cur else ' '} ({'•' if i == cur else ' '}) {opt}"[:cols - 1]
            lines.append(f"{BOLD}{line}{RESET}" if i == cur else line)
        lines.append(f"   {DIM}↑↓ move   space/enter choose   esc cancel{RESET}")
        if drawn:
            out.write(f"\x1b[{drawn}A")
        for line in lines:
            out.write(f"\r\x1b[2K{line}\n")
        out.flush()
        drawn = len(lines)

    try:
        tty.setcbreak(fd)
        out.write("\x1b[?25l")
        while True:
            draw()
            key = _read_key(fd)
            if key == "up":
                cur = (cur - 1) % len(options)
            elif key == "down":
                cur = (cur + 1) % len(options)
            elif key == "home":
                cur = 0
            elif key == "end":
                cur = len(options) - 1
            elif key in ("space", "enter"):
                break
            elif key == "esc":
                out.write(f"\x1b[{drawn}A\x1b[J\x1b[?25h")
                _restore_tty(fd, saved)
                sys.exit("\nmsbctl: cancelled")
        out.write(f"\x1b[{drawn}A\x1b[J")
        out.write(f"   {title}: {options[cur]}\n")
        return options[cur]
    finally:
        out.write("\x1b[?25h")
        out.flush()
        _restore_tty(fd, saved)


def choose_one(title, options, default=0):
    """Pick exactly one of `options`; returns it. Same terminal-or-numbered
    split as toggle_list()."""
    if (sys.stdin.isatty() and sys.stdout.isatty()
            and os.environ.get("TERM", "dumb") != "dumb"):
        return _choose_tui(title, options, default)
    while True:
        for i, opt in enumerate(options, 1):
            note(f"  {i}) {opt}")
        raw = ask(f"{title} (number)", str(default + 1))
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1]
        warn(f"enter a number from 1 to {len(options)}")


def ask_size(prompt, default):
    """A disk size like 24G or 512M, re-asked until it is one."""
    while True:
        raw = ask(prompt, default).replace(" ", "").upper()
        if re.fullmatch(r"\d+[MG]", raw):
            return raw
        warn("a size looks like 24G or 512M")


def pick_size(title, presets, default_size, extra=()):
    """Choose a disk size from named presets, or type one. `presets` is
    [(name, size)]; `extra` is [(label, value)] prepended and returned as given
    (value None means "none"). Returns a size string, or the extra's value."""
    rows = [(f"{name:<8} {size}" + ("   (usual)" if size == default_size else ""), size)
            for name, size in presets]
    rows = [(label, value) for label, value in extra] + rows
    rows.append(("custom   type a size", "custom"))
    default = next((i for i, (_, v) in enumerate(rows) if v == default_size), 0)
    label = choose_one(title, [lab for lab, _ in rows], default)
    value = dict(rows)[label]
    return ask_size("size", default_size) if value == "custom" else value


