def _llm_status(name, spec, key):
    """One line on what an endpoint serves, asked now. Never raises."""
    try:
        ids = [m["id"] for m in fetch_llm_models(spec, key, timeout=5)]
    except LlmError as exc:
        return {"tls": "certificate not trusted here", "auth": "refused the key",
                "absent": "lists no models", "unreachable": "unreachable from here"}[exc.kind]
    want = llm_default_model(spec)
    if want and want not in ids:
        return f"{len(ids)} models served — {want!r} is NOT among them: choose a model"
    return f"{len(ids)} models served" + (f", using {want!r}" if want else "")


def section_llms(config, ctx):
    while True:
        config = load_config()
        env = read_env_file(GLOBAL_ENV)
        table = llm_endpoints(config)
        default = list(config.get("defaults", {}).get("llm", []))
        say("Model endpoints")
        note("Where pi sends its requests: your own server (vLLM, llama.cpp, Ollama, …)")
        note("or a provider pi knows. HTTPS only — the key stays on this machine and is")
        note("swapped in on the way out, which needs TLS. Keys are stored 0600 in")
        note("secrets/global.env as LLM_KEY_<NAME>. The models are asked from the source.")
        # Asked all at once: each is a network round trip with its own timeout.
        statuses = {}

        def check(name, spec, key, into):
            into[name] = _llm_status(name, spec, key)
        threads = [threading.Thread(target=check, args=(n, sp, env.get(llm_key_var(n)), statuses),
                                    daemon=True)
                   for n, sp in table.items() if not llm_problem(n, sp)]
        for t in threads:
            t.start()
        for t in threads:
            t.join(8)
        for name, spec in table.items():
            problem = llm_problem(name, spec)
            url, _, _ = llm_url(spec)
            key = "key stored" if env.get(llm_key_var(name)) else "no key"
            note(f"  {name:<12} {url}  {key}{'  (default)' if name in default else ''}")
            if problem:
                warn(f"[llm.{name}]: {problem}")
            else:
