def _summary_egress(box):
    prefix = "OBSERVED, NOT BLOCKED — " if box.observing else ""
    return (f"{prefix}{len(box.extra_rules)} extra rule(s), "
            f"groups: {', '.join(box.rule_groups) or 'none'}")


MODE_LABELS = {
    "enforce": "enforce   deny by default; only the rules below get through",
    "observe": "observe   NOTHING IS BLOCKED; every host reached is recorded",
}


def section_egress(box, config, ctx):
    say("Egress rules")
    note("Rule groups are under 'Features & agents'. These are the extra, per-sandbox rules.")

    # The mode comes first because it decides whether anything else here is even
    # applied. See Sandbox.egress_mode: observe exists to find out what a
    # sandbox needs, since msb will not tell you what it denied.
    mode = {v: k for k, v in MODE_LABELS.items()}[
        choose_one("egress mode", [MODE_LABELS[m] for m in EGRESS_MODES],
                   EGRESS_MODES.index(box.egress_mode))]
    if mode != box.egress_mode:
        if mode == "observe":
            warn("unrestricted egress until you switch back. Secrets stay bound to")
            warn("their hosts, but anything the guest can read it can now send.")
        # registry_path, not edit_target: see _observe_set — this one is
        # machine-local on purpose and must never be committed into a project.
        if set_toml_key(registry_path(box), "egress_mode", mode):
            ctx["rebuild"].add("egress mode")
            if mode == "observe":
                note(f"after a rebuild, use it a while then `msbctl observe {box.name}`")

    current = list(box.extra_rules)
    keep = toggle_list("keep these rules", current, current) if current else []
    raw = ask("allow more (hosts, host:port or full rules, space-separated; blank for none)")
    added = []
    for token in re.split(r"[,\s]+", raw.strip()):
        if not token:
            continue
        try:
            rule = parse_allow_target(token)
        except SystemExit as exc:
            warn(str(exc).replace("msbctl: ", "", 1) + " — skipped")
            continue
        if rule.startswith("allow") and re.search(r":tcp:80(\b|$)", rule):
            warn(f"{rule}: plaintext :80 is denied by `base` first, so it could never match — skipped")
            continue
        if rule in box.net_rules() or rule in added:
            note(f"already allowed: {rule}")
            continue
        added.append(rule)
    if set_toml_key(edit_target(box, "extra_rules"), "extra_rules", keep + added):
        ctx["rebuild"].add("egress rules")


def _summary_keys(box):
    keys = box.ssh_keys
    return "every key (no selection)" if keys is None else f"{len(keys)} key(s)"


def section_keys(box, config, ctx):
    cmd_keys(verb_args("keys", name=box.name, all=False), config)


def _summary_secrets(box):
    return ", ".join(secret_var(x) for x in box.secret_binds) or "none"


def section_secrets(box, config, ctx):
    while True:
        box = Sandbox(box.name, config)
        action = choose_one("secrets", ["add a secret", "remove a secret", "list", "back"], 0)
        if action.startswith("add"):
            cmd_secret(verb_args("secret", action="add", name=box.name, var=None), config)
        elif action.startswith("remove"):
            names = [secret_var(x) for x in box.secret_binds]
            if not names:
                note("none to remove")
                continue
            var = choose_one("remove which", names + ["cancel"], 0)
            if var != "cancel":
                cmd_secret(verb_args("secret", action="rm", name=box.name, var=var), config)
        elif action == "list":
            cmd_secret(verb_args("secret", action="ls", name=box.name, var=None), config)
        else:
            return


GH_SPEC = "GH_TOKEN@github.com,api.github.com"


def _github_state(box):
    own = read_env_file(os.path.join(SECRETS_DIR, f"{box.name}.env"))
    bound = box.is_repo or box.project_cfg.get("secrets", {}).get("github", bool(box.repo))
    return bool(own.get("GH_TOKEN")), bool(bound)


def _summary_github(box):
    if not box.repo:
        return "no GitHub repo recorded"
    stored, bound = _github_state(box)
    if stored and bound:
        return "token stored and bound"
    if stored:
        return "token stored, not bound"
    return "no token (git over SSH still works)"


def section_github(box, config, ctx):
    """This sandbox's fine-grained PAT, for the GitHub API (PRs, CI reads) — git push
    over SSH does not use it. Set, replace or remove; applied to a running sandbox
    with `msb modify`, no rebuild."""
    # A repo sandbox always binds a stored token (see secret_env), so there is
    # no project switch to flip.
    project = None if box.is_repo else require_project_file(box)
    say("GitHub token")
    if not box.repo:
        raw = ask("GitHub repo this sandbox works on (owner/name or URL, blank to cancel)")
        repo = parse_github_url(raw) or raw
        if not repo:
            return
        set_toml_key(registry_path(box), "repo", repo)
        box = Sandbox(box.name, config)
    stored, bound = _github_state(box)
    note(f"repository: {box.repo}")
    note(f"token: {'stored' if stored else 'not set'}, {'bound to github.com / api.github.com' if bound else 'not bound'}")
    action = choose_one("GitHub token", ["paste a token (new or a replacement)",
                                         "remove the token", "back"], 0)
    state = state_of(box.name)
    if action.startswith("paste"):
        github_token_help(box.repo)
        if not capture_token(box.name):
            return
        if project:
            set_toml_key(project, "github", True, table="secrets")
        # A running guest keeps its current placeholder bindings until restarted.
        restart = state == "running" and confirm(f"apply now — this restarts {box.name}?")
        bind_secret_live(box, config, GH_SPEC, restart)
    elif action.startswith("remove"):
        set_env_file_value(os.path.join(SECRETS_DIR, f"{box.name}.env"), "GH_TOKEN", None)
        if project:
            set_toml_key(project, "github", False, table="secrets")
        note("removed; git over SSH is unaffected")
        if state != "absent":
            _, env = Sandbox(box.name, config).secret_env()
            # msb applies a removal live: the value stops being substituted at once.
            run(["msb", "modify", box.name, "--secret-rm", "GH_TOKEN"], env=env, check=False)


def _summary_claude_token(box):
    if box.claude_auth != "secret":
        return f"claude_auth = {box.claude_auth!r}, no token"
    stored = box.claude_token in claude_tokens()
    which = box.claude_token if box.claude_token_pinned else f"the default ({box.claude_token})"
    return which + ("" if stored else " — NOT STORED")


def section_claude_token(box, config, ctx):
    """Which named Claude token this sandbox logs in with. The value is read on
    every start, so a change is a restart, never a rebuild."""
    say("Claude token")
    tokens = claude_tokens()
    if box.claude_auth != "secret":
        note(f"claude_auth is {box.claude_auth!r}, so no token is bound")
        return
    if not tokens:
        note("no Claude tokens stored yet — `msbctl setup` → Claude login")
        return
    default = default_claude_token(config)
    follow = f"the default  (now {default})"
    options = [follow] + list(tokens)
    current = box.claude_token_pinned if box.claude_token_pinned in tokens else follow
    choice = choose_one("Claude token", options, options.index(current))
    pin = "" if choice == follow else choice
    if pin == box.claude_token_pinned:
        return
    set_toml_key(registry_path(box), "claude_token", pin)
    state = state_of(box.name)
    if state != "running":
        note("used from its next start")
        return
    if not confirm(f"apply now — this restarts {box.name}?"):
        note("saved; used from the next restart")
        return
    # msb reads a secret's value at start, so a restart is the whole change: the
    # binding and the guest's placeholder stay the same, only the value differs.
    run(["msb", "stop", box.name], check=False, quiet=True)
    ensure_running(Sandbox(box.name, config))


def _summary_git_push(box):
    if box.git_push == "gh":
        return "gh (https)" + ("" if box.github_token_bound else ", NO GitHub token")
    if not box.push_fp:
        return "ssh, any allowed key"
    return "ssh, " + ("its own key" if box.entry.get("push_key") else
                      f"{box.identity_name}'s key") + ("" if box.push_active else ", NOT allowed")


def section_git_push(box, config, ctx):
    path = registry_path(box)
    ident = box.identity or {}
    mode = pick_git_push(box.git_push, box.identity_name, ident)
    set_toml_key(path, "git_push", mode)
    if mode == "ssh":
        own = box.entry.get("push_key")
        rows = ([f"{box.identity_name}'s push key"] if ident.get("push_key") else []) \
            + ["a key for this sandbox only"] \
            + ([] if ident.get("push_key") else ["none: offer every allowed key"])
        pick = choose_one("push with", rows, rows.index("a key for this sandbox only") if own else 0)
        if pick.startswith("a key"):
            set_toml_key(path, "push_key", pick_push_key(own, ident.get("signing_key")))
        else:
            set_toml_key(path, "push_key", None)
        box = Sandbox(box.name, config)
        fp, keys = box.push_fp, box.ssh_keys
        if fp and keys is not None and fp not in keys and confirm(
                "this sandbox is not allowed that key — allow it (or git push fails)?"):
            labels = _key_labels(keys + [fp])
            write_ssh_keys(box, [(k, labels.get(k, "")) for k in keys + [fp]])
            if os.environ.get("SSH_AUTH_SOCK"):
                ensure_keys_loaded(Sandbox(box.name, config))
    else:
        box = Sandbox(box.name, config)
        if not box.github_token_bound:
            note("no GitHub token is bound, so git over https cannot authenticate —")
            note("set one under GitHub token.")
    if state_of(box.name) == "running":
        ensure_git_push(Sandbox(box.name, config))
        note("applied")
    else:
        note("applied on the next start")


