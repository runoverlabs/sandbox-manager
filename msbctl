class approving_edits:
    """Around anything that writes the project's policy: a pending change made
    by someone else is asked about first, on its own, and what msbctl then
    writes is approved as it leaves.

    The guest can write sandbox.toml while the section waits on the operator,
    so leaving approves unasked only if the file still holds exactly what msbctl
    wrote last (_OWN_WRITES). Otherwise — the guest, or the operator in an
    editor — the change is shown and asked about, and where nobody may be asked
    it stays unapproved for the next start to ask."""

    def __init__(self, box, config, why="editing"):
        self.box, self.config, self.why = box, config, why

    def __enter__(self):
        # Read before checking: a write in between then reads as foreign.
        self.path = os.path.realpath(project_path(self.box))
        try:
            with open(self.path, encoding="utf-8") as fh:
                _OWN_WRITES[self.path] = fh.read()
        except OSError:
            _OWN_WRITES[self.path] = None
        try:
            check_policy(Sandbox(self.box.name, self.config), self.why)
        except BaseException:
            _OWN_WRITES.pop(self.path, None)
            raise
        return self

    def __exit__(self, kind, exc, tb):
        own = _OWN_WRITES.pop(self.path, None)
        try:
            box = Sandbox(self.box.name, self.config)
            with open(self.path, encoding="utf-8") as fh:
                current = fh.read()
        except OSError:
            current = None
        except SystemExit:
            return False    # the file no longer parses; _recover_broken handles that
        if policy_pinned(box):
            return False
        if own is not None and current == own:
            try:
                box.project_cfg = tomllib.loads(own)    # the text compared, not a later read
                approve_policy(box)
                return False
            except tomllib.TOMLDecodeError:
                pass

        try:
            policy = project_policy(box)
            ask_approval(box, policy, "applying it", tilde(project_path(box)))
            approve_policy(box, policy)
            note("approved")
        except SystemExit as stop:
            warn(f"{str(stop.code or '').replace('msbctl: ', '', 1)} — the next start asks again")
        return False


def _recover_broken(name, message):
    """A file this sandbox reads no longer parses, so no menu can be built from it.
    Offer to open the files; True to retry, False to give up."""
    warn(message)
    files = [("registry entry   machine-local", registry_path_for(name))]
    try:
        with open(registry_path_for(name), encoding="utf-8") as fh:
            m = re.search(r'^\s*project\s*=\s*"([^"]+)"', fh.read(), re.M)
        if m:
            project = os.path.join(os.path.expanduser(m.group(1)), ".msb", "sandbox.toml")
            if os.path.isfile(project):
                files.append(("sandbox.toml     this project", project))
    except OSError:
        pass  # the entry is unreadable: offer it alone
    label = choose_one("fix which file", [l for l, _ in files] + ["give up"], 0)
    if label == "give up":
        return False
    edit_file(dict(files)[label])
    return True


def registry_path_for(name):
    return os.path.join(REGISTRY_DIR, f"{name}.toml")


def cmd_edit(args, config):
    name = args.name
    if not os.path.isfile(registry_path_for(name)):
        die(f"no sandbox named {name!r} — `msbctl ls` to see what exists")
    ctx = {"rebuild": set(), "hand_edited": False}
    default = 0
    while True:
        try:
            box = Sandbox(name, config)
        except SystemExit as exc:               # a file was left unparseable
            if _recover_broken(name, str(exc.code or "").replace("msbctl: ", "", 1)):
                ctx["hand_edited"] = True
                continue
            return
        rows = [f"{title:<20} {summary(box)}" for title, _, summary in EDIT_SECTIONS]
        rows += ["View the CLAUDE.md it gets", "Edit the files in your editor", "Done"]
        say(f"Edit {name}  [{state_of(name)}]")
        if ctx["rebuild"]:
            note(f"{DIM}needs a rebuild: {', '.join(sorted(ctx['rebuild']))}{RESET}")
        choice = choose_one("section", rows, default)
        default = rows.index(choice)
        if choice == "Done":
            break
        try:
            if choice.startswith("Edit the files"):
                with approving_edits(box, config):
                    section_files(box, config, ctx)
            elif choice.startswith("View the CLAUDE.md"):
                section_claude_md(box, config, ctx)
            elif EDIT_SECTIONS[default][1] in POLICY_SECTIONS:
                with approving_edits(box, config):
                    EDIT_SECTIONS[default][1](box, config, ctx)
            else:
                EDIT_SECTIONS[default][1](box, config, ctx)
        except SystemExit as exc:               # a section's escape/die must not end the menu
            text = str(exc.code or "").replace("msbctl: ", "", 1).strip()
            if text and "cancelled" not in text:
                warn(text)
        name = ctx.get("name", name)            # "Name & folder" may have renamed it

    if not (ctx["rebuild"] or ctx["hand_edited"]):
        return
    if state_of(name) == "absent":
        note("not created yet, so everything applies at first start")
        return
    why = ", ".join(sorted(ctx["rebuild"])) or "the files you edited by hand"
    note(f"These only take effect when the sandbox is created: {why}.")
    if confirm(f"rebuild {name} now?"):
        cmd_rebuild(verb_args("rebuild", name=name), config)
    else:
        note(f"later: msbctl rebuild {name}")


def cmd_resize(args, config):
    """Change cpus, memory or root disk of an EXISTING sandbox, keeping its
    state. Uses `msb modify`: the root disk grows live; cpus and memory need a
    restart, not a rebuild. Recorded in the registry entry so a later rebuild
    reproduces it."""
    box = Sandbox(args.name, config)
    state = state_of(box.name)
    if state == "absent":
        die(f"{box.name} has not been created yet — `msbctl start {box.name}`")

    cpus, memory, disk = args.cpus, args.memory, args.root_disk
    if cpus is None and memory is None and disk is None:
        say(f"Resize {box.name}")
        note(f"now: {box.cpus} cpu, {box.memory}, {box.root_disk} root disk")
        plan = {}
        pick_resources(plan, config, current=(int(box.cpus), str(box.memory)))
        cpus, memory = plan["cpus"], plan["memory"]
        note("")
        note("The root disk can only grow, never shrink.")
        disk = pick_size("root disk", ROOT_DISKS, str(box.root_disk))
    cpus = None if cpus is None or str(cpus) == str(box.cpus) else int(cpus)
    memory = None if memory is None or memory == str(box.memory) else memory
    disk = None if disk is None or disk == str(box.root_disk) else disk
    if cpus is None and memory is None and disk is None:
        note("nothing to change")
        return

    argv = ["msb", "modify", box.name]
    if cpus is not None:
        argv += ["--cpus", str(cpus)]
    if memory is not None:
        argv += ["--memory", memory]
    if disk is not None:
        argv += ["--root-disk", disk]
    # msb modify validates EVERY secret bound to the sandbox, not only a changed
    # one, and refuses if any host variable is unset — so hand it all of them.
    _, secret_vars = box.secret_env()
    run(argv + ["--dry-run"], env=secret_vars)
    needs_restart = state == "running" and (cpus is not None or memory is not None)
    if needs_restart and not args.yes and not confirm(
            f"apply — this restarts {box.name}, ending its open sessions?"):
        return
    if run(argv + (["--restart"] if needs_restart else []), env=secret_vars,
           check=False).returncode:
        die("msb modify failed — nothing recorded")
    if cpus is not None:
        set_entry_value(box, "cpus", str(cpus))
    if memory is not None:
        set_entry_value(box, "memory", f'"{memory}"')
    if disk is not None:
        set_entry_value(box, "root_disk", f'"{disk}"')
    note(f"{box.name} resized; recorded in {tilde(os.path.join(REGISTRY_DIR, box.name + '.toml'))}"
         " so a rebuild keeps it")


def cmd_config(args, config):
    """The merged configuration, each value tagged with the layer it came from."""
    local = dict(_flatten(read_toml(CONFIG_FILE)))
    shipped = dict(_flatten(read_toml(DEFAULTS_FILE)))
    say("Configuration")
    note(f"shipped  {tilde(DEFAULTS_FILE)}")
    note(f"local    {tilde(CONFIG_FILE)}"
         + ("" if os.path.exists(CONFIG_FILE) else "  (none — all defaults)"))
    note("")
    for path, value in _flatten(config):
        if path.startswith("rules.") and isinstance(value, list):
            value = f"{len(value)} rule(s)"
        elif isinstance(value, list):
            value = json.dumps(value)
        origin = ("local" if path in local else "shipped")
        if origin == "local" and path in shipped:
            origin = "local, overrides shipped"
        note(f"  {path:<34} {value}   {DIM}{origin}{RESET}")


def print_json(data):
    """Machine-readable output: one JSON document on stdout, and nothing else."""
    json.dump(data, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")


def cmd_ls(args, config):
    if args.json:
        return ls_data(args, config)        # main() prints it (json_document())
    names = registered()
    remotes = configured_remotes(config)
    if remotes:
        ls_with_remotes(args, config, names)
        return
    if not names:
        note("nothing registered yet — `msbctl add` in a project directory")
        return
    rows = [(r["name"], r["state"], r["location"], ",".join(r["updates"]) or "-",
             "yes" if r["autostart"] else "no") for r in ls_rows(args, config, names)]

    if args.porcelain:
        for row in rows:
            print("\t".join(row))
        return

    if args.picker:
        # `name<TAB>pre-padded display text`.
        #
        # The padding has to happen HERE. fzf's --with-nth renders the original
        # delimiter between the fields it shows, so a tab-separated row reaches
        # the terminal with real tabs in it and each one jumps to the next
        # 8-column stop: a 7-character name gets one space, an 8-character name
        # gets eight. Only one tab survives, between the name and the display
        # text, and --with-nth=2.. hides it.
        order = [0, 1, 3, 2]          # name, state, updates, project
        widths = [max(len(str(r[i])) for r in rows) for i in range(5)]
        for row in rows:
            shown = "  ".join(str(row[i]).ljust(widths[i]) for i in order)
            print(f"{row[0]}\t{shown.rstrip()}")
        return

    widths = [max(len(str(r[i])) for r in [("NAME", "STATE", "PROJECT",
                                            "UPDATES", "AUTOSTART")] + rows)
              for i in range(5)]
    header = ("NAME", "STATE", "PROJECT", "UPDATES", "AUTOSTART")
    print(BOLD + "  ".join(h.ljust(w) for h, w in zip(header, widths, strict=True)) + RESET)
    for row in rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(row, widths, strict=True)))


def ls_with_remotes(args, config, names):
    """`ls` across this machine and every remote. A HOST column comes first
    (`local` for this one); --porcelain and --picker keep their columns and
    write a remote sandbox as host:name, which every verb understands. This
    machine's rows are there only if it can run sandboxes itself: a laptop
    that only drives remotes (any Mac) has no msb at all."""
    local = ls_rows(args, config, names) if shutil.which("msb") else []
    rows = [("local", r["name"], r["state"], r["location"],
             ",".join(r["updates"]) or "-", "yes" if r["autostart"] else "no") for r in local]
    for host, r, mark in remote_ls_rows(args, config):
        if r is None:
            if args.porcelain:
                print(f"msbctl: {host}: {mark}", file=sys.stderr)
            else:
                rows.append((host, "-", mark, "", "", ""))
            continue
        state = r.get("state", "?") + (f" ({mark})" if mark else "")
        rows.append((host, f"{host}:{r.get('name', '?')}" if args.porcelain or args.picker
                     else r.get("name", "?"), state, r.get("location", ""),
                     ",".join(r.get("updates", [])) or "-", "yes" if r.get("autostart") else "no"))
    if args.porcelain:
        for row in rows:
            print("\t".join(row[1:]))
        return
    if args.picker:
        # As in cmd_ls: padded here, one tab between the name and the text.
        # The first field is what every action is given, so a remote row's is
        # host:name; an unreachable host's line gets one no verb accepts.
        shown = [(r[0], r[1].split(":")[-1], r[2], r[4], r[3]) for r in rows]
        widths = [max(len(str(d[i])) for d in shown) for i in range(5)]
        for row, d in zip(rows, shown, strict=True):
            key = row[1] if row[1] != "-" else f"{row[0]}:-"
            print(f"{key}\t" + "  ".join(str(d[i]).ljust(widths[i]) for i in range(5)).rstrip())
        return
    header = ("HOST", "NAME", "STATE", "PROJECT", "UPDATES", "AUTOSTART")
    widths = [max(len(str(r[i])) for r in [header] + rows) for i in range(6)]
    print(BOLD + "  ".join(h.ljust(w) for h, w in zip(header, widths, strict=True)).rstrip() + RESET)
    for row in rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(row, widths, strict=True)).rstrip())


def ls_rows(args, config, names):
    """One dict per sandbox: what `ls` shows, in every format."""
    table = msb_table()
    cache = read_json(VERSIONS_CACHE)
    if args.refresh:
        cache = refresh_versions(names, config, cache)
    rows = []
    for name in names:
        box = Sandbox(name, config)
        info = cache.get(name, {})
        pending = sorted(c for c, v in info.items()
                         if isinstance(v, dict) and v.get("available")
                         and v.get("installed")
                         and v["available"] != v["installed"])
        rows.append({"name": name, "state": state_of(name, table), "source": box.source,
                     "location": box.location, "repo": box.repo,
                     "ref": box.entry.get("ref", "") if box.is_repo else "",
                     "autostart": box.autostart, "updates": pending})
        if box.is_kandev:
            rows[-1]["kandev"] = kandev_record(name, box.entry, table)["record"]
    return rows


def ls_data(args, config):
    """`ls --json`: {"msbctl": version, "sandboxes": [...]}. Never a secret.
    Under the Kandev key, Kandev's sandboxes only: the operator's names and
    folders are none of its business."""
    names = [n for n, _ in kandev_entries()] if kandev_key() else registered()
    return {"msbctl": version_string(), "sandboxes": ls_rows(args, config, names)}


def cmd_entry(args, config):
    """Open one sandbox's registry entry in a terminal editor.

    A subcommand rather than a menu item so the picker can bind a key to it:
    choosing which sandbox to edit belongs where the sandboxes are listed, not
    on the top-level menu.
    """
    Sandbox(args.name, config)          # fails loudly if it is not registered
    edit_file(os.path.join(REGISTRY_DIR, f"{args.name}.toml"))
    note("resources, rules and [env] need `msbctl rebuild`;")
    note("identity and autostart take effect on the next start.")


def version_lines(box, info):
    """The right-hand pane's version rows for one sandbox.

    A component this sandbox does not have (bun without `bun = true`) is left
    out, including from an old cache that still holds it. One that is current
    says so instead of drawing an arrow to the same number."""
    lines = []
    for comp in sorted(k for k in info if isinstance(info[k], dict)):
        if comp != "image" and not box.wants_component(comp):
            continue
        got = info[comp]
        installed, available = got.get("installed"), got.get("available")
        if installed and available and installed == available:
            lines.append(f"{comp:<10} {installed:<22} {GREEN}up to date{RESET}")
        elif installed and available:
            mark = "  UPDATE (rebuild required — fixed at create time)" if comp == "image" else "  UPDATE"
            lines.append(f"{comp:<10} {installed:<22} -> {available}{mark}")
        elif installed:
            lines.append(f"{comp:<10} {installed:<22} {DIM}(latest unknown){RESET}")
        elif available:
            lines.append(f"{comp:<10} {'not detected':<22} {DIM}(latest {available}){RESET}")
        else:
            lines.append(f"{comp:<10} {DIM}unknown{RESET}")
    return lines


def llm_rows(box):
    """pi's endpoints for display: name, base_url, whether a key is stored.
    Never the key. A broken [llm] table is shown, not fatal."""
    if not box.wants_component("pi"):
        return []
    own = read_env_file(os.path.join(SECRETS_DIR, f"{box.name}.env"))
    shared = read_env_file(GLOBAL_ENV)
    table = llm_endpoints(box.config)
    rows = []
    for name in box.llm_names:
        spec = table.get(name)
        problem = "not defined in config.toml" if spec is None else llm_problem(name, spec)
        var = llm_key_var(name)
        rows.append({"name": name, "base_url": "" if problem else llm_url(spec)[0],
                     "model": None if problem else llm_default_model(spec),
                     "key_stored": bool(own.get(var) or shared.get(var)),
                     "problem": problem})
    return rows


def show_data(box, table=None):
    """`show --json`: what one sandbox resolves to. Says whether each secret is
    STORED, never what it is: no value is ever put in here. For a Kandev
    sandbox, its record, with agentctl checked live."""
    if box.is_kandev:
        record = kandev_record(box.name, box.entry, table, live=True)["record"]
        return {"name": box.name, "source": "kandev", "state": record["state"],
                "location": box.location, "kandev": record}
    own = read_env_file(os.path.join(SECRETS_DIR, f"{box.name}.env"))
    shared = read_env_file(GLOBAL_ENV)
    secrets = []
    for spec in box.secret_binds:
        var = secret_var(spec)
        from_registry = spec in box.registry_binds
        secrets.append({"var": var, "hosts": spec.rpartition("@")[2].split(","),
                        "origin": "registry" if from_registry else "project",
                        "reserved": is_reserved_var(var),
                        "stored": bool(own.get(var) or (from_registry and shared.get(var)))})
    data = {
        "name": box.name, "state": state_of(box.name, table), "source": box.source,
        "location": box.location, "repo": box.repo,
        "ref": box.entry.get("ref", "") if box.is_repo else "",
        "image": box.image_or_none(), "cpus": box.cpus, "memory": str(box.memory),
        "root_disk": str(box.root_disk), "guest_path": box.guest_project,
        "egress_mode": box.egress_mode, "rule_groups": box.rule_groups,
        "extra_rules": box.extra_rules,
        "ports": [spec for spec, *_ in box.published_ports],
        "port_urls": {spec: port_url(bind, host, proto)
                      for spec, bind, host, _, proto in box.published_ports
                      if proto == "tcp"},
        "policy_approved": policy_pinned(box),
        "claude_token": {"name": box.claude_token,
                         "stored": box.claude_token in claude_tokens(shared)},
        "github_token_stored": bool(own.get("GH_TOKEN")),
        "git_push": box.git_push,
        "secrets": secrets,
        "agents": [key for key, _, _ in AGENTS if box.wants_component(key)],
        "llm": llm_rows(box),
        # bundle_status, not bundles: a bundle deleted or broken since create is
        # a row with its problem, not a `show --json` that fails for ls fan-out.
        "tools": [{"name": name, "description": "" if problem else spec["description"],
                   "hosts": [] if problem else [f"{h}:{p}" for h, p in bundle_hosts(spec)],
                   "env": [] if problem else sorted(bundle_env(spec)),
                   "adapters": sorted(bundle_adapters(folder, spec)),
                   "pi_package": "" if problem else spec.get("pi_package", ""),
                   "installed": (pi_package_installed(box, split_pi_package(spec["pi_package"])[0])
                                 if not problem and spec.get("pi_package") else None),
                   "problem": problem}
                  for name, spec, folder, problem in box.bundle_status],
    }
    if box.is_repo:
        data["commit"] = box.repo_meta.get("sha", "")
    return data


def cmd_show(args, config):
    if args.json:
        return show_data(Sandbox(args.name, config))     # main() prints it
    box = Sandbox(args.name, config)
    table = msb_table()
    info = read_json(VERSIONS_CACHE).get(box.name, {})

    say(f"{box.name}  [{state_of(box.name, table)}]")
    if box.is_kandev:
        rec = kandev_record(box.name, box.entry, table)["record"]
        note(f"source     Kandev, environment {rec['env']} (Kandev owns it)")
        note(f"image      {rec['image']}")
        note(f"resources  {box.entry.get('cpus')} cpu, {box.entry.get('memory')}, "
             f"{box.entry.get('root_disk')} disk")
        if box.entry.get("workspace_disk"):
            note(f"workspace  {box.entry['workspace_disk']} disk at {KANDEV_WORKSPACE}, "
                 "deleted with the sandbox")
        note(f"expires    {rec['expires_at']}  (created {rec['created_at']})")
        note("ports      " + ", ".join(
            f"{g} <- {port_link(LOOPBACK_BIND, h, 'tcp', f'127.0.0.1:{h}')}"
            for g, h in rec["ports"].items()))
        note(f"secrets    {', '.join(secret_var(b) for b in box.entry.get('secret_binds', [])) or 'none'}"
             "  (values only ever in Kandev's requests)")
        say("Egress")
        for rule in box.net_rules():
            note(f"  {rule}")
        return
    if box.is_repo:
        meta = box.repo_meta
        note(f"source     {box.location}, cloned inside the sandbox ({box.workspace_volume})")
        note(f"policy     .msb/ at {meta.get('sha', '(not fetched yet)')[:12]}"
             f"{'' if policy_pinned(box) else '  NOT APPROVED — `msbctl policy ' + box.name + '`'}")
    else:
        note(f"project    {tilde(box.project)}")
    note(f"in guest   {box.guest_project}")
    if not box.is_repo:
        note(f"repo       {box.repo or '(no GitHub remote)'}")
    note(f"conf       {box.conf}  (read for the image only)")
    for problem in conf_problems(box.conf_path):
        warn(f"{box.conf} {problem} — ignored by msbctl, and a rebuild will refuse")
    if box.msb_conf:
        note(f"msb_conf   {tilde(box.msb_conf)}")
    note(f"image      {box.image}")
    note(f"resources  {box.cpus} cpu, {box.memory} ceiling, {box.root_disk} disk")
    note(f"autostart  {'yes' if box.autostart else 'no'}")
    for row in llm_rows(box):
        note(f"pi model   {row['name']:<10} {row['problem'] or row['base_url']}  "
             f"{row['model'] or '(first served)'}  "
             f"{'key stored' if row['key_stored'] else 'no key'}")
    for name, spec, folder, problem in box.bundle_status:
        if problem:
            warn(f"tool       {name}: {problem} — `msbctl start` refuses until it is fixed")
            continue
        adapters = sorted(bundle_adapters(folder, spec))
        note(f"tool       {name:<10} {spec['description']}  "
             f"{', '.join(f'{h}:{p}' for h, p in bundle_hosts(spec))}  "
             f"{'for ' + ', '.join(adapters) if adapters else 'NO ADAPTER — nothing to install'}")
        if spec.get("pi_package"):
            have = pi_package_installed(box, split_pi_package(spec["pi_package"])[0])
            line = (f"tool       {'':<10} pi package {spec['pi_package']}: "
                    + (f"{have} installed" if have else "not installed yet — the next start installs it"))
            (note if have else warn)(line)
    # The env and rules below without a broken bundle, flagged just above:
    # Sandbox.bundles would die on it, and `show` is where the operator comes
    # to find out why.
    box.bundles = [(name, spec, folder) for name, spec, folder, problem
                   in box.bundle_status if not problem]
    if box.containers_disk:
        note(f"containers {box.containers_disk} disk at /var/lib/containers")
    vols = msb_volumes()
    for key, size in box.caches.items():
        v = vols.get(box.cache_volume(key))
        usage = f"{human_size(v['used_bytes'])} of {human_size(v['capacity_bytes'])}" if v else f"not created yet ({size})"
        note(f"cache      {key:<8} {usage}  -> {CACHES.get(key, '?')}")
    for src, dest, mode in box.extra_mounts:
        note(f"folder     {tilde(src)} -> {dest} ({mode})")
    for _, *where in box.published_ports:
        note(f"port       {port_label(*where, link=True)}")

    say("Versions")
    if not info:
        note("not probed yet — `msbctl ls --refresh`")
    else:
        for line in version_lines(box, info):
            note(line)
        if info.get("checked"):
            note(f"{DIM}probed {info['checked']}{RESET}")

    env = box.env_vars()
    if env:
        say("Environment")
        for key, value in sorted(env.items()):
            note(f"  {key}={value}")
        note(f"{DIM}fixed at create time — `msbctl rebuild` to change{RESET}")

    say("Egress")
    if box.observing:
        # The loudest surface there is: this preview pane is what the picker
        # shows for whatever row is under the cursor, so a sandbox left in
        # observation mode announces it every time you look at the list.
        note(f"{RED}{BOLD}OBSERVATION MODE — nothing is blocked{RESET}")
        note(f"{RED}every host is reachable and is being recorded; "
             f"`msbctl observe {box.name}` to read it{RESET}")
        note(f"{DIM}the rules below are kept but NOT enforced{RESET}")
    note(f"groups     base + {', '.join(box.rule_groups) or '(none)'}"
         + (f"  ({', '.join(box.machine_rule_groups)} from this machine only)"
            if box.machine_rule_groups else ""))
    warn_local_groups_in_project(box)
    note(f"private DNS answers {'allowed' if box.allow_private_dns or box.observing else 'DROPPED (rebind protection on)'}")
    for rule in box.net_rules():
        note(f"  {rule}")

    say("Credentials")
    ident = box.identity
    if ident:
        note(f"  git  {ident['name']} <{ident['email']}>  "
             f"({box.identity_name}, --system — a repo's own .git/config wins)")
        if box.signing_active:
            note("       commits signed with an ssh key served by the agent")
        elif box.signing_fp:
            note(f"       NOT signing: {box.identity_name} names a key this sandbox may not "
                 f"use — `msbctl keys {box.name}`")
    else:
        note("  git  no identity set; a repo without one cannot commit here")
    note(f"  push {_summary_git_push(box)}  (`msbctl edit {box.name}` → Git push)")
    if box.claude_auth == "secret":
        missing = "" if box.claude_token in claude_tokens() else f"  {RED}NOT STORED{RESET}"
        note(f"  claude  token {box.claude_token!r}"
             f"{'' if box.claude_token_pinned else ' (the default)'}{missing}")
    secret_flags, _ = box.secret_env()
    bound = [secret_flags[i + 1] for i, f in enumerate(secret_flags)
             if f == "--secret"]
    for binding in bound or ["(none bound)"]:
        note(f"  {binding}")
    for line in ssh_agent_lines(box):
        note(line)


def agent_binding(box):
    """How this sandbox is ACTUALLY wired to an ssh-agent, from msb itself rather
    than from the registry: "filtered" (its own filter socket), "raw" (some other
    host socket — typically the login agent, baked in before filtering existed),
    "none", or "absent" when it has not been created."""
    if state_of(box.name) == "absent":
        return "absent"
    proc = subprocess.run(["msb", "inspect", box.name, "--format", "json"],
                          capture_output=True, text=True)
    try:
        routes = json.loads(proc.stdout)["config"]["vsock"]["routes"]
    except (ValueError, KeyError, TypeError):
        return "unknown"
    sockets = [r.get("host_socket") for r in routes if r.get("port") == VSOCK_PORT]
    if not sockets:
        return "none"
    return "filtered" if sockets[0] == box.agent_sock else "raw"


def ssh_agent_lines(box):
    """What `show` says about ssh keys: the truth about the running sandbox
    first, then what the registry has selected."""
    binding = agent_binding(box)
    keys = box.ssh_keys
    if binding == "raw":
        lines = ["ssh-agent: the RAW host agent — every key in it, and the guest can add or "
                 "remove keys.",
                 f"           Created before key filtering existed; `msbctl rebuild {box.name}` "
                 "puts it behind the filter."]
        if keys is not None:
            lines.append(f"           (the {len(keys)}-key selection recorded for it is NOT enforced "
                         "until then)")
        return lines
    if binding == "none":
        return ["ssh-agent: not forwarded (no vsock route)"]
    where = "will be filtered" if binding == "absent" else "filtered"
    if keys is None:
        return [f"ssh-agent: {where}, but no keys are selected, so every key in the host agent is "
                "visible (listing and signing only) — `msbctl keys` to choose"]
    labels = _key_labels(keys)
    lines = [f"ssh-agent: {where}, {len(keys)} key(s); the key itself never crosses"]
    lines += [f"  {labels.get(fp, '')}" + (SIGNS_MARK if fp == box.signing_fp else "")
              for fp in keys]
    return lines


# ------------------------------------------------------------------- versions

def http_json(url, headers=None, timeout=15):
    # https only: a registry's token realm is a URL the registry picks, and
    # urllib would as happily open http:// (or file://) as https://.
    if not url.startswith("https://"):
        return None
    req = urllib.request.Request(url, headers=headers or {})  # noqa: S310  checked above
    req.add_header("User-Agent", "msbctl")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310  checked above
            return json.load(resp)
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError):
        return None


def available_npm(package):
    data = http_json(f"https://registry.npmjs.org/{package}/latest")
    return data.get("version") if data else None


def available_release(repo, token=None):
    headers = {"Accept": "application/vnd.github+json",
               "X-GitHub-Api-Version": "2022-11-28"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    data = http_json(f"https://api.github.com/repos/{repo}/releases/latest", headers)
    # Tags are "v1.2.3" for most, "bun-v1.2.3" for bun: keep from the first digit.
    return (re.sub(r"^[^0-9]*", "", data.get("tag_name", "")) or None) if data else None


def available_node(major):
    """Newest release on the given major line, from the canonical dist index."""
    data = http_json("https://nodejs.org/dist/index.json")
    if not data:
        return None
    for entry in data:
        version = entry.get("version", "").lstrip("v")
        if version.split(".")[0] == str(major):
            return version
    return None


def available_digest(image):
    """Current digest for an image's TAG, via the registry v2 API.

    Anonymous pull: the registry answers the first request with a 401 carrying
    a WWW-Authenticate challenge naming a token service, which hands out a
    bearer for public repositories without credentials. Done with urllib rather
    than skopeo so that this has no dependency a workstation can lose.
    """
    ref = image.split("@", 1)[0]
    if "/" not in ref:
        return None
    host, _, path = ref.partition("/")
    if "." not in host and ":" not in host:          # docker.io shorthand
        host, path = "registry-1.docker.io", f"library/{ref}"
    repo, _, tag = path.rpartition(":")
    if not repo:
        repo, tag = path, "latest"

    url = f"https://{host}/v2/{repo}/manifests/{tag}"
    accept = ("application/vnd.oci.image.index.v1+json,"
              "application/vnd.docker.distribution.manifest.list.v2+json,"
              "application/vnd.oci.image.manifest.v1+json,"
              "application/vnd.docker.distribution.manifest.v2+json")

    def head(bearer=None):
        req = urllib.request.Request(url, method="HEAD")
        req.add_header("Accept", accept)
        req.add_header("User-Agent", "msbctl")
        if bearer:
            req.add_header("Authorization", f"Bearer {bearer}")
        return urllib.request.urlopen(req, timeout=15)  # noqa: S310  https:// url

    try:
        try:
            resp = head()
        except urllib.error.HTTPError as exc:
            if exc.code != 401:
                return None
            challenge = exc.headers.get("WWW-Authenticate", "")
            fields = dict(re.findall(r'(\w+)="([^"]*)"', challenge))
            realm = fields.get("realm")
            if not realm:                  # http_json() refuses a non-https realm
                return None
            query = "&".join(f"{k}={v}" for k, v in (
                ("service", fields.get("service", "")),
                ("scope", fields.get("scope", f"repository:{repo}:pull"))) if v)
            token = http_json(f"{realm}?{query}")
            if not token:
                return None
            resp = head(token.get("token") or token.get("access_token"))
        with resp:
            return resp.headers.get("Docker-Content-Digest")
    except (urllib.error.URLError, TimeoutError):
        return None


# component -> (how to read it in the guest, how to parse that output)
GUEST_PROBES = {
    "claude":   ("claude --version", r"([0-9]+\.[0-9]+\.[0-9]+)"),
    "pi":       ("pi --version", r"([0-9]+\.[0-9]+\.[0-9]+)"),
    "node":     ("node --version", r"v?([0-9][0-9.]*)"),
    "gitleaks": ("gitleaks version", r"([0-9][0-9.]*)"),
    "gh":       ("gh --version", r"gh version ([0-9][0-9.]*)"),
    "bun":      ("bun --version", r"([0-9][0-9.]*)"),
}


def probe_installed(name, table):
    """Read versions from inside a RUNNING sandbox.

    A stopped one keeps whatever was last seen: starting a VM to answer a
    display question would make `ls --refresh` boot every registered sandbox,
    which is exactly the behaviour the picker-only design was chosen to avoid.
    """
    if state_of(name, table) != "running":
        return {}
    script = "; ".join(f"echo {comp}=$({cmd} 2>/dev/null | head -1)"
                       for comp, (cmd, _) in GUEST_PROBES.items())
    proc = subprocess.run(["msb", "exec", name, "--no-tty", "--", "sh", "-c", script],
                          capture_output=True, text=True, stdin=subprocess.DEVNULL)
    found = {}
    for line in proc.stdout.splitlines():
        comp, _, raw = line.partition("=")
        if comp in GUEST_PROBES and raw.strip():
            match = re.search(GUEST_PROBES[comp][1], raw)
            if match:
                found[comp] = match.group(1)
    return found


def refresh_versions(names, config, cache):
    say("Probing versions")
    # Kandev's sandboxes run Kandev's image and are not msbctl's to probe.
    names = [n for n in names if read_toml(registry_path_for(n)).get("source") != "kandev"]
    table = msb_table()
    token = None
    if config.get("version_check", {}).get("use_global_token", True):
        token = read_env_file(os.path.join(SECRETS_DIR, "global.env")).get("GH_TOKEN")

    # Upstream lookups are per-component, not per-sandbox: three sandboxes on
    # the same gitleaks pin must not cost three calls against an anonymous
    # api.github.com quota of 60/hour.
    boxes = {name: Sandbox(name, config) for name in names}

    def needed(comp):
        return any(b.wants_component(comp) for b in boxes.values())

    upstream = {"gh": available_release("cli/cli", token)}
    # Only what some selected sandbox actually has: bun would otherwise cost a
    # GitHub call per refresh and show up as "?" in sandboxes that never had it.
    if needed("gitleaks"):
        upstream["gitleaks"] = available_release("gitleaks/gitleaks", token)
    if needed("claude"):
        upstream["claude"] = available_npm("@anthropic-ai/claude-code")
    if needed("pi"):
        upstream["pi"] = available_npm(PI_PACKAGE)
    if needed("bun"):
        upstream["bun"] = available_release("oven-sh/bun", token)
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    for name in names:
        box = boxes[name]
        installed = probe_installed(name, table)
        previous = cache.get(name, {})
        entry = {"checked": stamp}

        node_major = str(box.versions().get("node", "22"))
        per_sandbox = {c: v for c, v in upstream.items() if box.wants_component(c)}
        per_sandbox["node"] = available_node(node_major)

        for comp, available in per_sandbox.items():
            was = previous.get(comp, {}) if isinstance(previous.get(comp), dict) else {}
            entry[comp] = {
                # Keep the last known value for a stopped sandbox rather than
                # showing a blank that looks like "not installed".
                "installed": installed.get(comp) or was.get("installed"),
                "available": available or was.get("available"),
            }

        pinned = box.image
        current = pinned.split("@", 1)[1] if "@" in pinned else None
        entry["image"] = {"installed": current, "available": available_digest(pinned)}
        cache[name] = entry
        note(f"{name}: {'probed' if installed else 'using cached guest values (not running)'}")

    write_json(VERSIONS_CACHE, cache)
    return cache


