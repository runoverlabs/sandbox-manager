def text_editor():
    """A TERMINAL editor. The menu runs inside a terminal and edits small
    config files, where $VISUAL/$EDITOR is the convention and a detached GUI
    window would leave the menu waiting on nothing.
    """
    for candidate in (os.environ.get("VISUAL"), os.environ.get("EDITOR"),
                      "nano", "vi"):
        if candidate and shutil.which(candidate.split()[0]):
            return candidate
    return None


def edit_file(path, *, must_exist=True):
    if must_exist and not os.path.exists(path):
        note(f"{tilde(path)} does not exist")
        return
    editor = text_editor()
    if not editor:
        note("no terminal editor found — set $EDITOR. The file is:")
        note(f"  {path}")
        return
    subprocess.run([*editor.split(), path])


MENU = [
    ("add",      "register a new project"),
    ("manage",   "manage sandboxes        (list, start, stop, rebuild, …)"),
    ("config",   "setup                   identities, Claude login, your network, defaults"),
    ("remotes",  "remote hosts            other machines, over ssh"),
    ("claudemd", "edit your CLAUDE.md additions"),
    ("refresh",  "refresh version info"),
    ("quit",     "quit"),
]


def menu_choose_fzf(config, sidebar):
    """Up/down selection with the sandbox summary pinned beside it.

    The preview is the SAME command for every row — it is a sidebar, not a
    per-item preview — and it reads a file rather than regenerating, because
    producing it costs one `msb exec` per running sandbox and fzf re-runs a
    preview on each cursor move. ctrl-r rewrites the file and redraws.
    """
    rows = "".join(f"{key}\t{label}\n" for key, label in MENU)
    proc = subprocess.run(
        ["fzf",
         "--ansi", "--delimiter=\t", "--with-nth=2",
         "--prompt=msbctl> ", "--pointer=▌",
         "--header=↑↓ choose   enter run   ^r refresh   esc quit",
         "--header-first",
         "--preview", f"cat {shlex_quote(sidebar)}",
         "--preview-window=right,56%,border-left",
         "--bind", f"ctrl-r:execute-silent({shlex_quote(sys.argv[0])} status > "
                   f"{shlex_quote(sidebar)})+refresh-preview",
         "--no-sort", "--no-info", "--reverse"],
        input=rows, capture_output=True, text=True)
    if proc.returncode != 0 or not proc.stdout.strip():
        return "quit"
    return proc.stdout.split("\t", 1)[0].strip()


def shlex_quote(value):
    """Single-quote for sh. Local rather than importing shlex, to keep the
    stdlib surface this tool depends on as small as it already is."""
    return "'" + value.replace("'", "'\\''") + "'"


def write_sidebar(path, config):
    with open(path, "w", encoding="utf-8") as fh:
        stdout, sys.stdout = sys.stdout, fh
        try:
            cmd_status(verb_args("status", quick=False), config)
        finally:
            sys.stdout = stdout


def cmd_menu(args, config):
    """What bare `msbctl` does. A loop, so an action returns here afterwards."""
    config = maybe_welcome(config)
    picker = shutil.which("msb-picker") or os.path.join(HERE, "msb-picker")
    use_fzf = bool(shutil.which("fzf"))
    sidebar = os.path.join(STATE_DIR, "sidebar.txt")
    os.makedirs(STATE_DIR, exist_ok=True)

    while True:
        names = registered()
        table = msb_table()
        running = sum(1 for n in names if state_of(n, table) == "running")

        if use_fzf:
            write_sidebar(sidebar, config)
            choice = menu_choose_fzf(config, sidebar)
        else:
            # Same actions, no dependency. The sidebar prints above the list
            # instead of beside it.
            cmd_status(verb_args("status", quick=True), config)
            say("msbctl")
            note(f"{len(names)} registered, {running} running" if names
                 else "nothing registered yet — start with 1")
            note("")
            for index, (_, label) in enumerate(MENU[:-1], 1):
                note(f"  {index}) {label}")
            note("  q) quit")
            note("")
            answer = ask("choice", "2" if names else "1").lower()
            if answer in ("q", "quit", "exit"):
                choice = "quit"
            elif answer.isdigit() and 1 <= int(answer) <= len(MENU) - 1:
                choice = MENU[int(answer) - 1][0]
            else:
                choice = answer

        if choice == "quit":
            return
        elif choice == "add":
            # Its own try: a cancelled or failed wizard should return to the
            # menu, not take the whole program down with it.
            try:
                cmd_add(verb_args("add", dir=None), config)
            except SystemExit as exc:
                if exc.code:
                    warn(str(exc.code).replace("msbctl: ", "", 1))
        elif choice == "manage":
            if not names and not configured_remotes(config):
                note("nothing to manage yet")
            elif not os.path.exists(picker):
                note(f"msb-picker not found at {picker} — run install.sh")
            elif not shutil.which("fzf"):
                note("fzf is not installed (sudo dnf install fzf). Meanwhile:")
                note("  msbctl ls      and      msbctl start|stop|show <name>")
            else:
                subprocess.run([picker])
        elif choice == "config":
            try:
                cmd_setup(verb_args("setup", welcome=False), config)
            except SystemExit as exc:
                if exc.code:
                    warn(str(exc.code).replace("msbctl: ", "", 1))
            config = load_config()
            note("egress rules, [env] and the image are fixed at create time —")
            note("`msbctl rebuild <name>` for those. Identity applies on restart.")
        elif choice == "remotes":
            remotes_menu(config)
            config = load_config()
        elif choice == "claudemd":
            if not os.path.exists(PROFILE_LOCAL):
                os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
                with open(PROFILE_LOCAL, "w", encoding="utf-8") as fh:
                    fh.write("<!-- Your additions to the CLAUDE.md every sandbox gets. msb-manager "
                             "ships the central text;\n     whatever you write here is appended after "
                             "it on every sandbox start. -->\n")
            edit_file(PROFILE_LOCAL)
            note("appended to msb-manager's own text and copied into every sandbox on its next start.")
        elif choice == "refresh":
            cmd_ls(verb_args("ls", refresh=True, porcelain=False, picker=False), config)
        else:
            note(f"not an option: {choice}")


def preflight(args):
    """Die unless this machine can run sandboxes: `msb` on PATH and /dev/kvm.

    Checked for every subcommand, including `add`. Registering a project from
    inside a container would write a registry entry naming a path that only
    exists in that container, which fails later and confusingly.
    The ssh-agent filter daemon needs neither (it only proxies a socket), and
    `config` only reads files. One function, so the tests and the screenshot
    harness replace exactly this and nothing else.
    """
    if args.func in (cmd_agent_filter, cmd_config, cmd_setup, cmd_self_update):
        return
    # `host check` reports a missing msb or /dev/kvm itself; the other host
    # verbs need neither (serve re-runs msbctl, which checks then). `kandev`
    # answers in JSON whatever happens, and `kandev health` reports both.
    if args.func in (cmd_host, cmd_remote, cmd_kandev):
        return
    # A sandbox on a remote needs ssh here, not msb; nor does `ls` once there
    # are remotes (this machine's rows simply are not shown without msb).
    if remote_names(args) and len(remote_names(args)) == len(
            [args.name] if getattr(args, "name", None) else list(getattr(args, "names", None) or [])):
        return
    if args.func is cmd_add and getattr(args, "remote", None):
        return
    # With remotes, `add` asks where first and checks this machine only if it
    # is the answer, and the menu works from a laptop with no msb at all.
    if args.func in (cmd_ls, cmd_status, cmd_add, cmd_menu) and configured_remotes():
        return
    if local_problem():
        die(local_problem())


def local_problem():
    """Why this machine cannot run sandboxes, or None."""
    if not shutil.which("msb"):
        return "msb is not on PATH"
    if not os.path.exists("/dev/kvm"):
        return "no /dev/kvm — msbctl runs on the host, not inside a container"
    return None


def verb_args(verb, **values):
    """The arguments `msbctl <verb>` parses to with every option at its
    default, then `values`. For calling a cmd_* handler from inside msbctl: a
    hand-built Namespace misses whatever option is added to the verb later,
    and the handler dies on it (the menu's "add" did, when --repo arrived)."""
    sub = next(a for a in build_parser()._actions
               if isinstance(a, argparse._SubParsersAction)).choices[verb]
    args = argparse.Namespace(**sub._defaults)
    for action in sub._actions:
        if action.dest is not argparse.SUPPRESS and action.default is not argparse.SUPPRESS:
            setattr(args, action.dest, action.default)
    if "name" in values and hasattr(args, "names"):
        # A verb taking several names gets one at a time, as main() hands them.
        args.names = [values["name"]]
        args.name = None
    for key, value in values.items():
        if not hasattr(args, key):
            raise TypeError(f"msbctl {verb} has no {key!r}")
        setattr(args, key, value)
    return args


def build_parser():
    """The whole command line. One function, so `host serve` validates a
    command with exactly the parser that will then run it."""
    parser = argparse.ArgumentParser(
        prog="msbctl", description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    # Not required: bare `msbctl` opens the menu instead of printing usage.
    parser.set_defaults(func=cmd_menu)
    parser.add_argument("--version", action="version", version=f"msbctl {version_string()}")
    sub = parser.add_subparsers(dest="cmd")

    p = sub.add_parser("add", help="register a project folder, or a repo to clone (--repo)")
    p.add_argument("dir", nargs="?")
    p.add_argument("--repo", metavar="OWNER/NAME|URL",
                   help="no host folder: clone this GitHub repo inside the sandbox")
    p.add_argument("--ref", help="with --repo: branch, tag or commit (default: the default branch)")
    # dest is not `name`: main() resolves every args.name against the cwd.
    p.add_argument("--name", dest="new_name",
                   help="with --repo: the sandbox name (default: the repo's)")
    p.add_argument("--guest-path", metavar="PATH", help="with --repo: where the clone is (default /work)")
    p.add_argument("--workspace-disk", metavar="SIZE", help="with --repo: the clone's volume size")
    p.add_argument("--identity", help="with --repo: an [identities] name")
    p.add_argument("--claude-token", metavar="NAME", help="with --repo: a stored Claude token's name")
    p.add_argument("--autostart", action="store_true", help="with --repo: start it with the others")
    p.add_argument("-y", "--yes", action="store_true", help="with --repo: no confirmation")
    p.add_argument("--remote", metavar="HOST",
                   help="register it on a remote instead (`msbctl remote ls`); the rest is sent there")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("ls", help="one line per sandbox")
    p.add_argument("--refresh", action="store_true", help="re-probe versions")
    p.add_argument("--porcelain", action="store_true", help="tab-separated, for scripts")
    p.add_argument("--picker", action="store_true",
                   help="name<TAB>padded display text, for msb-picker")
    p.add_argument("--json", action="store_true", help="one JSON document, for scripts")
    p.set_defaults(func=cmd_ls)

    p = sub.add_parser("entry", help="edit a sandbox's registry entry")
    p.add_argument("name", nargs="?", help=NAME_HELP)
    p.set_defaults(func=cmd_entry)

    p = sub.add_parser("status", help="one block per sandbox; the menu sidebar")
    p.add_argument("--quick", action="store_true",
                   help="skip the per-guest /proc read (no ram/cpu figures)")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("show", help="everything about one sandbox")
    p.add_argument("name", nargs="?", help=NAME_HELP)
    p.add_argument("--json", action="store_true", help="one JSON document; no secret values")
    p.set_defaults(func=cmd_show)

    # `names` (plural) marks a verb as repeatable: main() loops over them. The
    # picker's --multi hands every selected row to one invocation, and these
    # are the verbs where doing several in turn is meaningful.
    for verb, func, helptext in (
            ("start", cmd_start, "create if absent, start if stopped"),
            ("stop", cmd_stop, "stop; state is kept"),
            ("reclaim", cmd_reclaim, "return the guest page cache to the host"),
    ):
        p = sub.add_parser(verb, help=helptext)
        p.add_argument("names", nargs="*", metavar="name", help=NAMES_HELP)
        if verb == "start":
            p.add_argument("--autostart", action="store_true",
                           help="no names: every sandbox whose entry says autostart = true")
        if verb == "stop":
            p.add_argument("--json", action="store_true",
                           help="one JSON document: what `show --json` says of each, after")
        p.set_defaults(func=func)

    # Single-name on purpose: each of these hands the terminal to one thing.
    p = sub.add_parser("shell", help="interactive shell",
                       usage="msbctl shell [name] [msb exec flags…]",
                       epilog=MSB_EXEC_HINT)
    p.add_argument("name", nargs="?", help=NAME_HELP)
    p.set_defaults(func=cmd_shell, msb_flags=[])

    # Repeatable. rebuild does not prompt; purge still does, per sandbox, and
    # the confirmation names what it is about to destroy, so it must stay
    # per-sandbox rather than becoming one blanket yes for a multi-selection.
    p = sub.add_parser("rebuild", help="destroy and recreate")
    p.add_argument("names", nargs="*", metavar="name", help=NAMES_HELP)
    p.set_defaults(func=cmd_rebuild)

    p = sub.add_parser("purge", help="destroy and deregister (a name with nothing under it is fine)")
    p.add_argument("names", nargs="*", metavar="name", help=NAMES_HELP)
    p.add_argument("-y", "--yes", action="store_true", help="skip the prompt")
    p.add_argument("--json", action="store_true",
                   help='with -y: one JSON document, {"purged": [...], "absent": [...]}')
    p.set_defaults(func=cmd_purge)

    p = sub.add_parser("rename", help="give a sandbox a new name (recreates it, keeps its state)")
    p.add_argument("name", help=DOT_HELP)
    p.add_argument("new", metavar="new-name")
    p.add_argument("-y", "--yes", action="store_true", help="skip the prompt")
    p.set_defaults(func=cmd_rename)

    p = sub.add_parser("move", help="point a sandbox at another project folder (then rebuild)")
    p.add_argument("name", help=DOT_HELP)
    p.add_argument("dir", help="as for `add`: a bare name resolves under the workspaces")
    p.add_argument("--rebuild", action="store_true", help="rebuild now so it takes effect")
    p.set_defaults(func=cmd_move)

    p = sub.add_parser("config", help="show the merged configuration and where each value is from")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("secret", help="add, remove or list extra secrets for a sandbox")
    p.add_argument("action", choices=["add", "rm", "ls", "set"])
    p.add_argument("name", help=DOT_HELP)
    p.add_argument("var", nargs="?", help="for rm and set: the variable name")
    p.add_argument("--stdin", action="store_true",
                   help="for set: read the value from stdin (one trailing newline dropped)")
    p.add_argument("--restart", action="store_true",
                   help="for set: restart a running sandbox so the value is used now")
    p.set_defaults(func=cmd_secret)

    p = sub.add_parser("policy", help="show or approve the project policy a sandbox is pinned to")
    p.add_argument("name", help=DOT_HELP)
    p.add_argument("action", nargs="?", choices=["show", "approve", "update"], default="show")
    p.add_argument("ref", nargs="?", help="for update: a branch, tag or commit to move to")
    p.set_defaults(func=cmd_policy)

    p = sub.add_parser("allow", help="add egress rules to a sandbox (host, host:port, or a full rule)")
    p.add_argument("name", help=DOT_HELP)
    p.add_argument("targets", nargs="+", metavar="target")
    p.add_argument("--rebuild", action="store_true", help="rebuild now so it takes effect")
    p.set_defaults(func=cmd_allow)

    p = sub.add_parser("observe", help="stop blocking a sandbox and record where it goes, "
                                       "or read that record back")
    p.add_argument("name", help=DOT_HELP)
    p.add_argument("action", nargs="?", choices=["report", "on", "off"], default="report",
                   help="report (default): the hosts reached so far; on/off: switch the mode")
    p.add_argument("--rebuild", action="store_true", help="rebuild now so it takes effect")
    p.add_argument("-y", "--yes", action="store_true",
                   help="skip the confirmation when turning observation on")
    p.set_defaults(func=cmd_observe)

    p = sub.add_parser("mount", help="add an extra host folder to a sandbox (read-only unless --rw)")
    p.add_argument("name", help=DOT_HELP)
    p.add_argument("spec", metavar="SRC[:DEST][:ro|rw]")
    p.add_argument("--rw", action="store_true", help="read-write (default: read-only)")
    p.add_argument("--rebuild", action="store_true", help="rebuild now so it takes effect")
    p.set_defaults(func=cmd_mount)

    p = sub.add_parser("port", help="publish a host port to a server in a sandbox, or list/remove them")
    p.add_argument("name", help=DOT_HELP)
    p.add_argument("specs", nargs="*", metavar="PORT|[BIND:]HOST:GUEST[/udp]",
                   help="none: list them. A bare PORT is the same on both sides")
    p.add_argument("--rm", action="append", default=[], metavar="PORT",
                   help="stop publishing this one (repeatable)")
    p.add_argument("--rebuild", action="store_true", help="rebuild now so it takes effect")
    p.set_defaults(func=cmd_port)

    p = sub.add_parser("cache", help="show or empty a sandbox's package-cache disks")
    p.add_argument("name", help=DOT_HELP)
    p.add_argument("action", nargs="?", choices=["ls", "clear"], default="ls")
    p.add_argument("key", nargs="?", help="for clear: one cache (default: all)")
    p.set_defaults(func=cmd_cache)

    p = sub.add_parser("self-update", help="upgrade a packaged install to the latest release")
    p.add_argument("--version", help="a specific release, e.g. v0.2.0 (default: the latest)")
    p.add_argument("--json", action="store_true",
                   help='install, then print {"msbctl_version", "updated"}; get.sh\'s output goes to stderr')
    p.set_defaults(func=cmd_self_update)

    p = sub.add_parser("setup", help="your machine-level settings: identities, Claude login,"
                       " model endpoints, agent tools, network, defaults")
    p.add_argument("--welcome", action="store_true", help="the guided first-run walk-through")
    p.add_argument("--claude-token", metavar="NAME",
                   help="no menu: store a Claude token under this name (main is the default)")
    p.add_argument("--stdin", action="store_true", help="with --claude-token: read it from stdin")
    p.add_argument("--identity", metavar="KEY",
                   help="no menu: add or change a git identity (with --git-name and --git-email)")
    p.add_argument("--git-name", metavar="NAME", help="with --identity: the name commits carry")
    p.add_argument("--git-email", metavar="EMAIL", help="with --identity: the email commits carry")
    p.add_argument("--default", action="store_true",
                   help="with --identity or --claude-token: also make it the default for new sandboxes")
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser("edit", help="edit an existing sandbox, one wizard section at a time")
    p.add_argument("name", nargs="?", help=NAME_HELP)
    p.set_defaults(func=cmd_edit)

    p = sub.add_parser("resize", help="change cpus, memory or root disk of a sandbox, keeping its state")
    p.add_argument("name", nargs="?", help=NAME_HELP)
    p.add_argument("--cpus", type=int)
    p.add_argument("--memory", metavar="SIZE")
    p.add_argument("--root-disk", metavar="SIZE", help="grow only")
    p.add_argument("-y", "--yes", action="store_true", help="skip the restart prompt")
    p.set_defaults(func=cmd_resize)

    p = sub.add_parser("keys", help="choose which ssh keys a sandbox can use")
    p.add_argument("name", nargs="?", help=NAME_HELP)
    p.add_argument("--all", action="store_true",
                   help="remove the restriction: every host key")
    p.set_defaults(func=cmd_keys)

    p = sub.add_parser("host", help="run this machine as a remote host: serve, authorize, check, autostart, kandev")
    p.add_argument("action", choices=["serve", "authorize", "check", "autostart", "kandev"])
    p.add_argument("arg", nargs="?", metavar="KEY|install|reap|proxy|rotate-lease-key|configure",
                   help="authorize: one public key line, quoted; autostart: install; "
                   "kandev: install, reap (one pass), proxy (the TLS proxy, long-running), "
                   "rotate-lease-key (the old key is still accepted for 15 minutes) "
                   "or configure (set [kandev] keys in config.toml)")
    p.add_argument("--admin", action="store_true",
                   help="authorize: no forced command (use a FIDO2 sk- key)")
    p.add_argument("--kandev", action="store_true",
                   help="authorize, serve: the Kandev plugin's key, which runs `msbctl kandev` verbs only")
    p.add_argument("--replace", action="store_true",
                   help="authorize: rewrite the key's existing line instead of refusing")
    p.add_argument("--json", action="store_true", help="check, kandev configure: one JSON document")
    p.add_argument("--enabled", action=argparse.BooleanOptionalAction, default=None,
                   help="kandev configure: [kandev] enabled")
    p.add_argument("--serve", metavar="MODE", help="kandev configure: proxy, tailscale or none")
    p.add_argument("--proxy-listen", metavar="IP", help="kandev configure: the address the proxy binds")
    p.add_argument("--base-url", metavar="URL", help="kandev configure: https://host[:port]")
    p.add_argument("--allow-extra", action="append", metavar="ENTRY",
                   help="kandev configure: the whole allow_extra list, one entry per flag; "
                   "'' alone empties it")
    p.add_argument("--private-name", dest="private_names", action="append", metavar="HOST",
                   help="kandev configure: the whole private_names list, one host per flag; "
                   "'' alone empties it")
    p.set_defaults(func=cmd_host)

    p = sub.add_parser("kandev", help="this host's Kandev sandboxes, for the Kandev plugin (JSON only)",
                       description="Verbs the Kandev plugin runs over ssh. Each prints one JSON "
                       "document; secrets, the agentctl binary, its nonce and a TLS key come on stdin. "
                       "Listing, inspecting, stopping and removing Kandev's sandboxes are "
                       "`ls`, `show`, `stop` and `purge` with --json; updating msbctl is "
                       "`self-update --json`.")
    p.add_argument("verb", choices=list(KANDEV_VERBS))
    p.add_argument("env", nargs="?", metavar="ENV", help="the Kandev environment id (tls: install)")
    p.add_argument("port", nargs="?", metavar="PORT", help="lease: the guest port")
    p.add_argument("--at", metavar="TIME", help="expiry: the new expires_at, RFC 3339")
    p.set_defaults(func=cmd_kandev)

    p = sub.add_parser("remote", help="the other machines this one drives over ssh: add, setup, ls, test, rm")
    p.add_argument("action", choices=["add", "setup", "ls", "test", "rm"])
    p.add_argument("name", nargs="?", help="the remote's name, as in NAME:sandbox")
    p.add_argument("dest", nargs="?", help="for add: user@host, as ssh takes it")
    p.set_defaults(func=cmd_remote)

    p = sub.add_parser("_agent-filter", help=argparse.SUPPRESS)
    p.add_argument("name")
    p.set_defaults(func=cmd_agent_filter)

    p = sub.add_parser("exec", help="run a command in a sandbox",
                       usage="msbctl exec [name|.] [msb exec flags…] [--] command…",
                       epilog=MSB_EXEC_HINT)
    p.add_argument("name", help=DOT_HELP)
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_exec, msb_flags=[])

    p = sub.add_parser("update", help="update components in place")
    p.add_argument("names", nargs="*", metavar="name", help=NAMES_HELP)
    p.add_argument("-c", "--components", nargs="+", default=["claude"],
                   metavar="component",
                   help="claude (default), pi, gh, gitleaks, bun, apt")
    p.set_defaults(func=cmd_update)

    return parser


def split_cli(argv):
    """(argv for argparse, msb exec flags). msb's own flags for `exec`/`shell`
    are taken out before argparse, which would otherwise reject them or take a
    flag's value for the name; this also turns `msbctl exec -- cmd` into
    `exec . -- cmd`."""
    verb = next((i for i, a in enumerate(argv) if not a.startswith("-")), None)
    if verb is not None and argv[verb] in ("exec", "shell"):
        return split_msb_flags(argv, verb)
    return argv, []


def parse_cli(argv, parser=None):
    argv, msb_flags = split_cli(argv)
    args = (parser or build_parser()).parse_args(argv)
    if msb_flags:
        args.msb_flags = msb_flags
    return args


def main():
    args = parse_cli(sys.argv[1:])
    preflight(args)

    try:
        try:
            config = load_config()
        except SystemExit:
            if args.func not in (cmd_setup, cmd_self_update):   # these can still work with a broken config.toml
                raise
            config = None
        raw_argv = sys.argv[1:]
        # host:name — after parsing, from the name's own slot only: argv is
        # never scanned for the shape, since a port spec (3000:5173) and an
        # allow target (mirror:443) have it too.
        if args.func not in (cmd_agent_filter, cmd_remote):
            if args.func is cmd_add and getattr(args, "remote", None):
                add_remote_forward(args, config, raw_argv)
            if getattr(args, "name", None) and split_remote(args.name):
                exec_remote(args, config, raw_argv)
            args.raw_names = list(getattr(args, "names", None) or [])
        if getattr(args, "autostart", False):
            if args.names:
                die("start --autostart takes no names")
            # The autostart set: each one not already running. The same loop as
            # named starts, so one broken entry does not stop the rest.
            table = msb_table()
            args.names = [n for n in registered()
                          if read_toml(registry_path_for(n)).get("autostart") is True
                          and state_of(n, table) != "running"]
            if not args.names:
                note("nothing in the autostart set needs starting")
                return
        elif args.func not in (cmd_agent_filter, cmd_remote):
            if hasattr(args, "name"):
                args.name = resolve_here(args.name)
            if hasattr(args, "names"):
                args.names = [n if split_remote(n) else resolve_here(n) for n in args.names or [None]]
        if getattr(args, "json", False) and args.func in JSON_VERBS:
            json_document(lambda: json_verb(args, config))
        if not hasattr(args, "names"):
            kandev_guard(args)
            args.func(args, config)
            if BOOTSTRAP_FAILURES:
                sys.exit(f"msbctl: bootstrap failed for {', '.join(BOOTSTRAP_FAILURES)} — see above")
        else:
            # Every failure is reported, not just the first. Same stance as
            # bootstrap.sh: with several sandboxes selected, one broken entry
            # must not silently skip the rest of the selection.
            failed = []
            for name in args.names:
                args.name = name
                try:
                    if split_remote(name):
                        run_remote_verb(args, config, raw_argv, name)
                    else:
                        kandev_guard(args)
                        args.func(args, config)
                except SystemExit as exc:
                    if exc.code:
                        failed.append(str(exc.code).replace("msbctl: ", "", 1))
            failed += [f"bootstrap failed for {n} — see above" for n in BOOTSTRAP_FAILURES]
            if failed:
                sys.exit("msbctl: " + "; ".join(failed))
    except KeyboardInterrupt:
        sys.exit("\nmsbctl: interrupted")


if __name__ == "__main__":
    main()
