def machine_only_groups():
    """Groups this machine defines that msb-manager does not ship: a name in
    your config.toml's [rules] and not in defaults.toml's. Those belong in the
    registry entry's `extra_rule_groups`, never a project's sandbox.toml. A
    shipped group you redefined keeps its name everywhere, so it stays portable."""
    shipped = read_toml(DEFAULTS_FILE).get("rules", {})
    return {g for g in _local_groups() if g not in shipped}


def split_groups(groups):
    """(portable, machine-only) — the project's list and the registry's."""
    local = machine_only_groups()
    return [g for g in groups if g not in local], [g for g in groups if g in local]


