def checkouts(project):
    """Every git checkout this project contains, as absolute paths.

    TWO LAYOUTS ARE SUPPORTED and both are normal:

      the project IS the repo        <project>/.git
      the project CONTAINS repos     <project>/<name>/.git

    The second is what `msbctl add` produces when it clones into a new project
    folder, and it exists so that .msb/ sits BESIDE the checkout instead of
    inside it. One consequence worth knowing: .msb/sandbox.toml is then not
    committed to the repo and does not travel with a clone. That is a real
    trade-off, and neither layout is wrong.

    Only one level down. A deep walk would find vendored and nested repos and
    treat things this tool does not own as projects.
    """
    found = []
    if os.path.isdir(os.path.join(project, ".git")):
        found.append(project)
    try:
        entries = sorted(os.listdir(project))
    except OSError:
        return found
    for entry in entries:
        if entry.startswith("."):
            continue
        path = os.path.join(project, entry)
        if os.path.isdir(os.path.join(path, ".git")):
            found.append(path)
    return found


def parse_github_url(url):
    """owner/name from a GitHub URL, or "" .

    Handles the three forms a GitHub remote takes (https, ssh://, scp-style). A
    repository identity has to be derived rather than typed, or it is wrong
    exactly when it matters.
    """
    url = url.strip()
    for prefix in ("https://github.com/", "ssh://git@github.com/",
                   "git@github.com:"):
        if url.startswith(prefix):
            return url[len(prefix):].removesuffix(".git").rstrip("/")
    # Already in owner/name form.
    if re.fullmatch(r"[\w.-]+/[\w.-]+", url):
        return url.removesuffix(".git")
    return ""


def github_repo(project):
    """owner/name for a project, looking in every checkout it contains."""
    for checkout in checkouts(project):
        for remote in ("origin", "upstream"):
            repo = parse_github_url(git(checkout, "remote", "get-url", remote))
            if repo:
                return repo
    return ""


def ask(prompt, default=""):
    shown = f" [{default}]" if default else ""
    try:
        answer = input(f"   {prompt}{shown}: ").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit("\nmsbctl: cancelled")
    return answer or default


class Header(str):
    """A heading row inside a toggle_list: shown, but never numbered, ticked or
    landed on by the cursor. Lets one list be grouped into sections."""


def _toggle_numbered(title, options, selected, locked):
    """Pick any of `options` by toggling. Returns the chosen ones, in order.

    Type numbers (space or comma separated) to flip them, `a` for all, `n` for
    none, enter to accept. Plain input() like ask(), so it works without fzf.

    `locked` maps an option to the reason it cannot be turned off. Those stay
    ticked through `n` and through toggling, and say why.
    """
    pickable = [o for o in options if not isinstance(o, Header)]
    on = {o for o in selected if o in pickable} | set(locked)
    while True:
        n = 0
        for opt in options:
            if isinstance(opt, Header):
                note(f"  {opt}")
                continue
            n += 1
            why = f"  (needed by {locked[opt]})" if opt in locked else ""
            note(f"  [{'x' if opt in on else ' '}] {n:>2}  {opt}{why}")
        answer = ask(f"toggle {title} (numbers, a=all, n=none, enter=done)")
        if not answer:
            return [o for o in pickable if o in on]
        if answer in ("a", "n"):
            on = set(pickable) if answer == "a" else set(locked)
            continue
        for tok in answer.replace(",", " ").split():
            if tok.isdigit() and 1 <= int(tok) <= len(pickable):
                opt = pickable[int(tok) - 1]
                if opt in locked:
                    warn(f"{opt.split()[0]} stays on: needed by {locked[opt]}")
                else:
                    on ^= {opt}
            else:
                warn(f"ignoring {tok!r}")


def _read_key(fd):
    """One keypress from a raw-ish terminal, as a name. Arrow keys arrive as
    ESC [ A or ESC O A; a lone ESC is told apart by the follow-up not arriving."""
    ch = os.read(fd, 1)
    if ch == b"\x1b":
        if not select.select([fd], [], [], 0.05)[0]:
            return "esc"
        rest = os.read(fd, 2)
        return {b"[A": "up", b"OA": "up", b"[B": "down", b"OB": "down",
                b"[H": "home", b"[F": "end"}.get(rest, "")
    return {b" ": "space", b"\r": "enter", b"\n": "enter", b"\x03": "esc",
            b"k": "up", b"j": "down", b"a": "all", b"n": "none",
            b"q": "esc", b"\x04": "esc"}.get(ch, "")


def _toggle_tui(title, options, selected, locked):
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    pick = [i for i, o in enumerate(options) if not isinstance(o, Header)]
    if not pick:
        return []
    on = {o for o in selected if o in options} | set(locked)
    cur, top, msg = pick[0], 0, ""
    drawn = 0
    out = sys.stdout

    def move(delta):
        nonlocal cur
        i = cur
        while True:
            i = (i + delta) % len(options)
            if i in pick:
                cur = i
                return

    def draw():
        nonlocal drawn, top
        cols, rows = shutil.get_terminal_size()
        view = min(len(options), max(3, rows - 4))
        # Keep a heading in view when the cursor sits right under it.
        want = cur - 1 if cur > 0 and isinstance(options[cur - 1], Header) else cur
        top = min(max(top, cur - view + 1), want)
        top = max(0, min(top, len(options) - view))
        lines = [f"   {BOLD}{title}{RESET}"]
        for i in range(top, top + view):
            opt = options[i]
            if isinstance(opt, Header):
                lines.append(f"   {BOLD}{opt}{RESET}"[:cols + 8])
                continue
            why = f"  (needed by {locked[opt]})" if opt in locked else ""
            box = "[x]" if opt in on else "[ ]"
            line = f"   {'▌' if i == cur else ' '} {box} {opt}{why}"[:cols - 1]
            lines.append(f"{BOLD}{line}{RESET}" if i == cur else line)
        more = f"  ({top + 1}-{top + view} of {len(options)})" if view < len(options) else ""
        lines.append(f"   {DIM}↑↓ move   space toggle   a all   n none   "
                     f"enter done   esc cancel{more}{RESET}")
        lines.append(f"   {msg}" if msg else "")
        if drawn:
            out.write(f"\x1b[{drawn}A")
        for line in lines:
            out.write(f"\r\x1b[2K{line}\n")
        out.flush()
        drawn = len(lines)

    try:
        tty.setcbreak(fd)
        out.write("\x1b[?25l")
        while True:
            draw()
            msg = ""
            key = _read_key(fd)
            if key == "up":
                move(-1)
            elif key == "down":
                move(1)
            elif key == "home":
                cur = pick[0]
            elif key == "end":
                cur = pick[-1]
            elif key == "space":
                opt = options[cur]
                if opt in locked:
                    msg = f"{opt.split()[0]} stays on: needed by {locked[opt]}"
                else:
                    on ^= {opt}
            elif key == "all":
                on = {options[i] for i in pick}
            elif key == "none":
                on = set(locked)
            elif key == "enter":
                break
            elif key == "esc":
                out.write(f"\x1b[{drawn}A\x1b[J\x1b[?25h")
                _restore_tty(fd, saved)
                sys.exit("\nmsbctl: cancelled")
        # Collapse the menu to one line so the scrollback reads as a log.
        out.write(f"\x1b[{drawn}A\x1b[J")
        chosen = [o for o in options if o in on]
        names = ", ".join(o.split()[0] for o in chosen) or "(none)"
        out.write(f"   {title}: {names}\n")
        return chosen
    finally:
        out.write("\x1b[?25h")
        out.flush()
        _restore_tty(fd, saved)


def toggle_list(title, options, selected, locked=None):
    """Pick any of `options` by toggling. Returns the chosen ones, in order.

    On a terminal this is a navigable menu: arrows (or j/k) move, space toggles,
    enter accepts. Anywhere else — a pipe, a test — it falls back to typing
    numbers, so nothing here ever depends on the terminal being interactive.

    `locked` maps an option to the reason it cannot be turned off. Those stay
    ticked through "none" and through toggling, and say why.
    """
    locked = locked or {}
    if (sys.stdin.isatty() and sys.stdout.isatty() and options
            and os.environ.get("TERM", "dumb") != "dumb"):
        return _toggle_tui(title, options, selected, locked)
    return _toggle_numbered(title, options, selected, locked)


def _restore_tty(fd, saved):
    """Put the terminal back after a raw-mode menu. Best effort: if the tty has
    gone away (EIO) there is nothing left to restore, and failing here would
    replace the menu's real outcome with a traceback."""
    try:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
    except termios.error:
        pass  # the terminal is gone; see above


def _choose_tui(title, options, default):
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    cur, drawn, out = default, 0, sys.stdout

    def draw():
        nonlocal drawn
        cols = shutil.get_terminal_size()[0]
        lines = [f"   {BOLD}{title}{RESET}"]
        for i, opt in enumerate(options):
            line = f"   {'▌' if i == cur else ' '} ({'•' if i == cur else ' '}) {opt}"[:cols - 1]
            lines.append(f"{BOLD}{line}{RESET}" if i == cur else line)
        lines.append(f"   {DIM}↑↓ move   space/enter choose   esc cancel{RESET}")
        if drawn:
            out.write(f"\x1b[{drawn}A")
        for line in lines:
            out.write(f"\r\x1b[2K{line}\n")
        out.flush()
        drawn = len(lines)

    try:
        tty.setcbreak(fd)
        out.write("\x1b[?25l")
        while True:
            draw()
            key = _read_key(fd)
            if key == "up":
                cur = (cur - 1) % len(options)
            elif key == "down":
                cur = (cur + 1) % len(options)
            elif key == "home":
                cur = 0
            elif key == "end":
                cur = len(options) - 1
            elif key in ("space", "enter"):
                break
            elif key == "esc":
                out.write(f"\x1b[{drawn}A\x1b[J\x1b[?25h")
                _restore_tty(fd, saved)
                sys.exit("\nmsbctl: cancelled")
        out.write(f"\x1b[{drawn}A\x1b[J")
        out.write(f"   {title}: {options[cur]}\n")
        return options[cur]
    finally:
        out.write("\x1b[?25h")
        out.flush()
        _restore_tty(fd, saved)


def choose_one(title, options, default=0):
    """Pick exactly one of `options`; returns it. Same terminal-or-numbered
    split as toggle_list()."""
    if (sys.stdin.isatty() and sys.stdout.isatty()
            and os.environ.get("TERM", "dumb") != "dumb"):
        return _choose_tui(title, options, default)
    while True:
        for i, opt in enumerate(options, 1):
            note(f"  {i}) {opt}")
        raw = ask(f"{title} (number)", str(default + 1))
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1]
        warn(f"enter a number from 1 to {len(options)}")


def ask_size(prompt, default):
    """A disk size like 24G or 512M, re-asked until it is one."""
    while True:
        raw = ask(prompt, default).replace(" ", "").upper()
        if re.fullmatch(r"\d+[MG]", raw):
            return raw
        warn("a size looks like 24G or 512M")


def pick_size(title, presets, default_size, extra=()):
    """Choose a disk size from named presets, or type one. `presets` is
    [(name, size)]; `extra` is [(label, value)] prepended and returned as given
    (value None means "none"). Returns a size string, or the extra's value."""
    rows = [(f"{name:<8} {size}" + ("   (usual)" if size == default_size else ""), size)
            for name, size in presets]
    rows = [(label, value) for label, value in extra] + rows
    rows.append(("custom   type a size", "custom"))
    default = next((i for i, (_, v) in enumerate(rows) if v == default_size), 0)
    label = choose_one(title, [lab for lab, _ in rows], default)
    value = dict(rows)[label]
    return ask_size("size", default_size) if value == "custom" else value


ROOT_DISKS = [("small", "8G"), ("medium", "16G"), ("large", "32G")]
CONTAINER_DISKS = [("small", "10G"), ("medium", "20G"), ("large", "40G")]


# Where each package manager keeps what it downloads, keyed by the FEATURE that
# brings it in. Each is a NAMED DISK VOLUME (`<sandbox>-cache-<key>`): ext4, so as
# fast as the root disk, capped at the size you chose, and — unlike an owned disk —
# kept when the sandbox is removed, so a rebuild keeps it and `purge` deletes it.
#
# The volume is mounted at CACHE_MOUNT/<key>, NOT at the tool's own directory:
# msb rejects a named disk whose guest path contains a dot ("invalid or reserved
# device id", verified on 0.7.6 and 0.7.7 — `/d` and `/mnt/cache/npm` work,
# `/root/.npm` and `/mnt/.x` fail). bootstrap.sh then symlinks the tool's
# directory to the mount, which is why CACHES values are the dotted paths.
CACHES = {
    "npm": "/root/.npm",
    "bun": "/root/.bun/install/cache",
    "python": "/root/.cache/pip",
    "rust": "/root/.cargo/registry",
    "go": "/root/go/pkg/mod",
}
CACHE_MOUNT = "/mnt/cache"
CACHE_SIZES = [("small", "2G"), ("medium", "5G"), ("large", "10G")]
MIB = 1024 * 1024


def size_bytes(text):
    """`5G` / `512M` -> bytes."""
    m = re.fullmatch(r"(\d+)([MGT])", str(text).strip().upper())
    if not m:
        die(f"{text!r} is not a size like 5G or 512M")
    return int(m.group(1)) * MIB * {"M": 1, "G": 1024, "T": 1024 * 1024}[m.group(2)]


def human_size(n):
    for unit, step in (("G", 1024 ** 3), ("M", MIB), ("K", 1024)):
        if n >= step:
            return f"{n / step:.1f}{unit}"
    return f"{n}B"


def msb_volumes():
    """{name: {kind, capacity_bytes, used_bytes, ...}} from `msb volume ls`."""
    proc = subprocess.run(["msb", "volume", "ls", "--format", "json"],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        return {}
    try:
        return {v["name"]: v for v in json.loads(proc.stdout)}
    except (ValueError, KeyError, TypeError):
        return {}


def remove_sandbox_volumes(box):
    """Delete this sandbox's cache and containers volumes. Only after the sandbox
    itself is gone: msb refuses to remove a volume that is attached."""
    mine = box.owned_volumes()
    for name in mine:
        run(["msb", "volume", "rm", name], check=False, quiet=True)
    return mine


def pick_caches(plan):
    """Wizard: a size for the package caches of the features chosen, or none."""
    keys = [k for k in plan["features"] if k in CACHES]
    if not keys:
        return
    say("Package caches")
    note("A disk per package manager: as fast as the root disk, capped at the size you")
    note("pick, kept across rebuilds and deleted when the sandbox is purged. The size")
    note("is fixed when it is first created.")
    for k in keys:
        note(f"  {k:<8} {CACHES[k]}")
    size = pick_size("cache size (each)", CACHE_SIZES, "5G",
                     extra=[("none     no caches", None)])
    if size:
        plan["caches"] = {k: size for k in keys}


RESOURCES = [("small", 2, "4G"), ("medium", 4, "8G"), ("large", 8, "16G")]


def pick_resources(plan, config, current=None):
    """CPU count and memory ceiling, as one small/medium/large choice."""
    say("Resources")
    defaults = config.get("defaults", {})
    cpus, memory = current or (defaults.get("cpus", 4), defaults.get("memory", "8G"))
    note("Memory is a ceiling, not a reservation: an idle sandbox uses ~300 MB.")
    rows = [(f"{name:<8} {n} cpu, {mem}" + (("   (current)" if current else "   (usual)")
             if (n, mem) == (cpus, memory) else ""), (n, mem)) for name, n, mem in RESOURCES]
    rows.append(("custom   type values", "custom"))
    default = next((i for i, (_, v) in enumerate(rows) if v == (cpus, memory)), 1)
    label = choose_one("size", [lab for lab, _ in rows], default)
    value = dict(rows)[label]
    if value == "custom":
        while True:
            raw = ask("cpus", str(cpus))
            if raw.isdigit() and int(raw) >= 1:
                break
            warn("a whole number of cpus, at least 1")
        value = (int(raw), ask_size("memory", memory))
    plan["cpus"], plan["memory"] = value


def pick_disks(plan, config):
    """Root disk size, then — if podman is in — where its images live: a
    dedicated disk, or none, in which case fuse-overlayfs on the root disk."""
    say("Disk")
    default = config.get("defaults", {}).get("root_disk", "16G")
    note("The root disk holds the OS, packages and everything the agent installs;")
    note("the default writable layer is only ~4G, which `npm ci` can exhaust.")
    plan["root_disk"] = pick_size("root disk", ROOT_DISKS, default)

    if "podman" not in plan["features"]:
        return
    note("")
    pick_container_storage(plan)


def pick_container_storage(plan, current="20G"):
    """Where podman keeps images: a dedicated disk (a named volume, so it survives a
    rebuild), or none, in which case fuse-overlayfs on the root disk."""
    note("podman cannot keep images on the overlayfs root. Either give it its own")
    note("disk, or none and it uses fuse-overlayfs on the root disk, where images")
    note("share the root disk's space (a little slower, no extra disk).")
    size = pick_size("container disk", CONTAINER_DISKS, current,
                     extra=[("none     fuse-overlayfs on the root disk", None)])
    if size is None:
        plan["packages"].append("fuse-overlayfs")
        plan["containers_storage"] = "fuse-overlayfs"
        plan["containers_disk"] = ""
    else:
        plan["containers_disk"] = size
        plan["containers_storage"] = ""


# A feature is a named bundle: egress groups it needs, apt packages, and
# bootstrap switches. `languages` are GitHub's names for what it is used for;
# a repo that is mostly one of them gets the feature preselected. Ticking one in the wizard applies all of them together,
# so nobody installs bun and then discovers bun.sh is refused.
FEATURES = [
    ("github", "git over https/ssh and the GitHub API",
     {"groups": ["github"]}),
    ("npm",    "npm registry and Node packages",
     {"groups": ["npm"],
      "languages": ["JavaScript", "TypeScript", "Vue", "Svelte", "Astro"]}),
    ("bun",    "the bun runtime",
     {"groups": ["bun"], "bun": True}),
    # Opt-in: never preselected, even though its egress group is a default one.
    ("gitleaks", "gitleaks, a secret scanner",
     {"groups": ["github"], "gitleaks": True, "opt_in": True}),
    # Toolchains come from apt, not the language's own installer: the Ubuntu
    # mirrors are already allowed, so no extra host is needed to get a compiler.
    # No ruff, golangci-lint or staticcheck: none is packaged for Ubuntu.
    ("python", "PyPI, venv/pip, flake8, mypy",
     {"groups": ["python"], "languages": ["Python", "Jupyter Notebook"],
      "packages": ["python3-venv", "python3-pip", "flake8", "mypy"]}),
    ("rust",   "crates.io, rustc, cargo, clippy, rustfmt",
     {"groups": ["rust"], "languages": ["Rust"],
      "packages": ["rustc", "cargo", "rust-clippy", "rustfmt"]}),
    ("go",     "the Go module proxy, go (vet, gofmt included)",
     {"groups": ["go"], "languages": ["Go"], "packages": ["golang-go"]}),
    ("podman", "containers inside the sandbox (podman)",
     {"groups": ["containers"], "packages": ["podman", "nftables"]}),
    # Whatever installs Playwright (npm, pip) fetches its browsers separately,
    # from its own CDN, so this is its own feature rather than part of npm or
    # python. No language says "uses Playwright", so nothing preselects it.
    ("browsers", "headless browser downloads for Playwright",
     {"groups": ["playwright"]}),
]


# Coding agents: a second, separate list because "which agent runs here" is a
# different question from "which toolchains it can fetch". Each installs its own
# agent and opens its own egress. A new one gets a row here plus an installer
# step in bootstrap.sh (and a GUEST_PROBES/UPDATERS row). Preselected,
# because this manager exists to run agents — but unticking all is valid, and
# then nothing agent-shaped is installed. `requires` names FEATURES the agent
# cannot work without; the wizard asks for agents first and locks those on.
AGENTS = [
    # Installed with npm, from a node that comes from deb.nodesource.com — both
    # in the `npm` group — so it cannot be off while claude is on.
    ("claude", "Claude Code", {"groups": ["claude"], "requires": ["npm"]}),
    # No group: its egress is the [llm] endpoints it is given (see PI_PACKAGE).
    # Opt-in, preselected only once [defaults] llm names an endpoint.
    ("pi", "pi, for your own models or any provider",
     {"groups": [], "requires": ["npm"], "opt_in": True}),
]


LANGUAGE_THRESHOLD = 0.05    # ignore anything under 5% of the repo's bytes


def github_languages(repo, config):
    """{language: bytes} from GitHub, or None — offline, rate-limited, private
    without a token, or empty. Never fatal: this only pre-ticks a menu."""
    headers = {"Accept": "application/vnd.github+json",
               "X-GitHub-Api-Version": "2022-11-28"}
    # Same optional token the version probe uses. Without one this is the
    # anonymous 60/hour, and a private repo simply reads as "no languages".
    if config.get("version_check", {}).get("use_global_token", True):
        token = read_env_file(os.path.join(SECRETS_DIR, "global.env")).get("GH_TOKEN")
        if token:
            headers["Authorization"] = f"Bearer {token}"
    data = http_json(f"https://api.github.com/repos/{repo}/languages", headers)
    if isinstance(data, dict) and data and sum(data.values()) > 0:
        return data
    return None


def suggest_features(languages):
    """(shares, {feature key: share}) for a github_languages() result. A
    feature's share is the sum over its languages, so TypeScript and JavaScript
    count together for npm. Features with no match are absent."""
    total = sum(languages.values())
    shares = {lang: n / total for lang, n in
              sorted(languages.items(), key=lambda kv: -kv[1])}
    found = {}
    for key, _, spec in FEATURES:
        share = sum(shares.get(lang, 0) for lang in spec.get("languages", []))
        if share > 0:
            found[key] = share
    return shares, found


def _detected_tag(share):
    # One decimal under 10%, so 4.9% does not read as 5% while sitting below
    # the 5% cutoff and not being preselected.
    pct = ("<0.1%" if share < 0.001 else
           f"{share:.1%}" if share < 0.10 else f"{share:.0%}")
    if share >= LANGUAGE_THRESHOLD:
        return f"  ({pct} autodetected)"
    return f"  ({pct} detected)"


def detect_features(repo, config):
    """Say what GitHub reports for `repo`; return {feature key: share} for every
    feature whose languages appear in it, however small."""
    if not repo:
        return {}
    languages = github_languages(repo, config)
    if not languages:
        note("could not read languages from GitHub (offline, private or rate "
             "limited) — using the defaults")
        return {}
    shares, found = suggest_features(languages)
    note("GitHub reports: " + ", ".join(
        f"{lang} {share:.0%}" for lang, share in shares.items()
        if share >= LANGUAGE_THRESHOLD))
    picked = [k for k, share in found.items() if share >= LANGUAGE_THRESHOLD]
    if picked:
        note("preselecting: " + ", ".join(picked) + "   (change them below)")
    else:
        note("nothing there maps to a feature — using the defaults")
    return found


def _enable_groups(key, spec, groups, plan):
    for g in spec["groups"]:
        if g in groups:
            plan["groups"].add(g)
        else:
            warn(f"{key}: config.toml has no `{g}` rule group, so its hosts "
                 "stay refused until you add one — see defaults.toml")


def pick_features(groups, default_groups, repo="", config=None, current=None):
    """Ask for coding agents first, then features — with whatever the chosen
    agents depend on locked on — then for egress groups nothing owns (your own,
    such as one for a LAN). Returns what to write into sandbox.toml.

    `current` ({"agents": [...], "features": [...]}) preselects an existing
    sandbox's choices, for editing; without it the defaults and the repo's
    detected languages decide."""
    plan = {"groups": set(), "packages": [], "bun": False, "gitleaks": False, "agents": [], "features": [],
            "root_disk": "", "cpus": 0, "memory": "", "caches": {},
            "containers_disk": "", "containers_storage": ""}

    say("Coding agents")
    alabels = {f"{key:<8} {desc}": (key, spec) for key, desc, spec in AGENTS}
    has_llm = bool((config or {}).get("defaults", {}).get("llm"))
    agent_on = [l for l, (k, spec) in alabels.items()
                if (k in current["agents"] if current
                    else not spec.get("opt_in") or (k == "pi" and has_llm))]
    agents = [alabels[label] for label in toggle_list("agents", list(alabels), agent_on)]
    plan["agents"] = [key for key, _ in agents]
    for key, spec in agents:
        _enable_groups(key, spec, groups, plan)

    say("Features")
    note("Each ticked feature installs what it needs and opens the egress it")
    note("needs. base (DNS, the :80 deny, Ubuntu mirrors) is always applied.")
    hints = detect_features(repo, config or {})
    flabels = {f"{key:<8} {desc}" + (_detected_tag(hints[key]) if key in hints else ""):
               (key, spec) for key, desc, spec in FEATURES}
    locked = {}
    for akey, aspec in agents:
        for need in aspec.get("requires", []):
            label = next(l for l, (k, _) in flabels.items() if k == need)
            locked.setdefault(label, akey)
    if current:
        on = [label for label, (key, _) in flabels.items() if key in current["features"]]
    else:
        on = [label for label, (key, spec) in flabels.items()
              if hints.get(key, 0) >= LANGUAGE_THRESHOLD
              or (not spec.get("opt_in")
                  and all(g in default_groups for g in spec["groups"]))]
    picked = [flabels[label] for label in
              toggle_list("features", list(flabels), on, locked)]
    plan["features"] = [key for key, _ in picked]
    for key, spec in picked:
        plan["packages"] += spec.get("packages", [])
        plan["bun"] = plan["bun"] or spec.get("bun", False)
        plan["gitleaks"] = plan["gitleaks"] or spec.get("gitleaks", False)
        _enable_groups(key, spec, groups, plan)

    owned = {g for _, _, spec in FEATURES + AGENTS for g in spec["groups"]}
    rest = [g for g in groups if g not in owned]
    if rest:
        say("Other egress groups")
        plan["groups"].update(
            toggle_list("groups", rest, [g for g in default_groups if g in rest]))
    plan["groups"] = [g for g in groups if g in plan["groups"]]
    return plan


def workspaces_root(config):
    """The configured base folder for projects, or None."""
    raw = config.get("defaults", {}).get("workspaces")
    return os.path.realpath(os.path.expanduser(raw)) if raw else None


def resolve_project(raw, config):
    """Turn what was typed into an absolute project path.

    A BARE NAME resolves inside the workspaces root, so `msbctl add myproject` is
    the whole command for the common case.

    Anything that states a location explicitly is honoured as given, so a
    project outside the workspaces stays one argument:

        /srv/thing      absolute
        ~/src/thing     home-relative
        ./thing         explicitly relative to the CWD, not the workspaces
        ../thing        likewise

    `./` is treated as a deliberate statement rather than noise: typing it is
    how you say "the one here", and silently redirecting that to the workspaces
    would be surprising. With no workspaces configured a bare name falls back to
    CWD-relative, which is what this did before the setting existed.
    """
    raw = raw.strip()
    if raw.startswith("~"):
        return os.path.realpath(os.path.expanduser(raw))
    if os.path.isabs(raw):
        return os.path.realpath(raw)
    if raw in (".", "..") or raw.startswith("./") or raw.startswith("../"):
        return os.path.realpath(raw)
    root = workspaces_root(config)
    return os.path.realpath(os.path.join(root, raw) if root else raw)


REPO_ONLY_FLAGS = ("ref", "new_name", "guest_path", "workspace_disk", "identity", "claude_token",
                   "autostart", "yes")


def add_where(args, config):
    """Which machine a new sandbox goes on: None for this one, else a remote's
    name. Asked only at a terminal, with remotes configured and no folder
    given (a folder is on this machine by definition)."""
    remotes = configured_remotes(config)
    if not remotes or args.dir or not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None
    here = "this machine" + ("" if not local_problem() else f"   ({local_problem()})")
    rows = {f"{n:<14} {remotes[n].get('ssh', '?')}": n for n in sorted(remotes)}
    choice = choose_one("where should it run", [here] + list(rows), 0 if not local_problem() else 1)
    return rows.get(choice)


def add_on_remote(remote, args, config):
    """A new sandbox on a remote: the repo and the name asked here, the rest by
    the host's own `add --repo` over ssh, which fetches the repo's policy,
    shows it, asks for its GitHub token and registers it there."""
    dest = remote_dest(remote, config)
    # Before any question: a host without msbctl would only fail at the end.
    probe = subprocess.run(ssh_argv(dest, tty=False, batch=True)
                           + [shlex.join([remote_program(remote, config), "--version"])],
                           capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if probe.returncode == 127:
        warn(f"{remote} has no msbctl that an ssh command can find")
        if not confirm(f"set {remote} up now (`msbctl remote setup {remote}`)?"):
            die(f"nothing registered; `msbctl remote setup {remote}` first")
        remote_setup(remote, config)
        config = load_config()
    elif probe.returncode:
        die(f"{remote}: {_short_reason(probe, remote)}")
    say(f"A sandbox on {remote}")
    note("There is no folder of yours on that machine, so the code is cloned inside")
    note("the sandbox, from GitHub, and work leaves it by `git push`.")
    here = parse_github_url(git(os.getcwd(), "remote", "get-url", "origin")) or ""
    raw = args.repo or ask("GitHub repo (owner/name or URL)", here)
    repo = (parse_github_url(raw) or raw).strip().removesuffix(".git")
    if not REPO_NAME.fullmatch(repo) or ".." in repo:
        die(f"{raw!r} is not a GitHub repo (owner/name, or its URL)")
    default_name = re.sub(r"[^a-z0-9-]+", "-", repo.split("/")[1].lower()).strip("-")
    name = args.new_name or ask("sandbox name", default_name)
    if not SANDBOX_NAME.fullmatch(name):
        die(f"{name!r}: a sandbox name is lowercase letters, digits and dashes")
    program = remote_program(remote, config)
    command = [program, "add", "--repo", repo, "--name", name]
    for flag in REPO_ONLY_FLAGS:
        value = getattr(args, flag, None)
        if flag != "new_name" and value:
            option = f"--{flag.replace('_', '-')}"
            command += [option] if value is True else [option, str(value)]
    note(f"the rest is asked by {remote} itself")
    sys.stdout.flush()
    proc = subprocess.run(ssh_argv(dest, wants_tty()) + [shlex.join(command)])
    if proc.returncode:
        die(f"{remote}: add failed (exit {proc.returncode})")
    note(f"from this machine it is {remote}:{name}, for every msbctl verb")
    if wants_tty() and confirm(f"start {remote}:{name} now? (the first start clones and bootstraps)"):
        subprocess.run(ssh_argv(dest, True) + [shlex.join([program, "start", name])])


def cmd_add(args, config):
    remote = add_where(args, config)
    if remote:
        add_on_remote(remote, args, config)
        return
    if local_problem():
        die(local_problem())
    if args.repo:
        cmd_add_repo(args, config)
        return
    given = [f"--{f.replace('new_', '').replace('_', '-')}" for f in REPO_ONLY_FLAGS
             if getattr(args, f, None)]
    if given:
        die(f"{', '.join(given)}: only with --repo (the folder wizard asks for these)")
    config = maybe_welcome(config)
    say("Register a sandbox")
    # Prompted rather than taken from the cwd when not given, because the
    # common entry point is the picker's "add new" key — and that runs from
    # wherever the desktop launched it, which is never the project.
    root = workspaces_root(config)
    if root:
        note(f"a bare name resolves under {tilde(root)};")
        note("a path starting with / ~ ./ or ../ is taken as written")
    raw = args.dir or ask("project", os.getcwd())
    project = resolve_project(raw, config)
    created = False
    if not os.path.isdir(project):
        if os.path.exists(project):
            die(f"exists but is not a directory: {tilde(project)}")
        # Created, not refused. Registering a project you are about to start is
        # the common case, and making the folder by hand first is a step with
        # no decision in it. The parent must already exist, so a typo in the
        # workspaces path fails rather than building a tree nobody wanted.
        parent = os.path.dirname(project)
        if not os.path.isdir(parent):
            die(f"parent does not exist: {tilde(parent)}\n"
                f"       (from {raw!r}) — create it, or give a path under an "
                "existing directory")
        os.makedirs(project)
        created = True
    note(f"project    {tilde(project)}" + ("   (created)" if created else ""))
    name = ask("sandbox name", os.path.basename(project))
    problem = name_problem(name)
    if problem:
        die(problem)
    entry_path = os.path.join(REGISTRY_DIR, f"{name}.toml")

    found = checkouts(project)
    repo = ask("GitHub repo (owner/name or URL, blank for none)",
               github_repo(project))
    repo = parse_github_url(repo) or repo

    if repo and not found:
        # Nothing checked out yet, so this is the "new project" case: clone
        # into a subfolder named after the repo, leaving the project folder
        # itself free to hold .msb/ and anything else alongside it.
        target = os.path.join(project, repo.split("/")[-1])
        say("Clone")
        note(f"nothing checked out in {tilde(project)} yet")
        note(f"clone into {tilde(target)}?")
        note("")
        note("SSH, on this machine with your own key. Inside the sandbox git rewrites")
        note("the URL to however it pushes (the Git push step below), so the checkout's")
        note("origin stays one this machine can use.")
        url = f"git@github.com:{repo}.git"
        if os.path.exists(target):
            note(f"{tilde(target)} already exists — leaving it alone")
        elif confirm(f"git clone {url}"):
            # On the HOST, with your own key. The sandbox does not exist yet,
            # and its PAT is for the API rather than for transport.
            proc = subprocess.run(["git", "clone", url, target])
            if proc.returncode != 0:
                warn("clone failed — registering anyway; clone it by hand and "
                     "nothing else needs redoing")
            else:
                note(f"cloned into {tilde(target)}")

    guest_path = pick_guest_path(project, config.get("defaults", {})
                                 .get("guest_path", GUEST_PROJECT))

    say("Git identity")
    idents = config.get("identities", {})
    identity = ""
    if not idents:
        note("none defined in config.toml — skipping")
    else:
        for key in sorted(idents):
            entry = idents[key]
            note(f"  {key:<12} {entry.get('name', '?')} <{entry.get('email', '?')}>")
        note("")
        note("Applied with `git config --system` in the guest, so a repo that")
        note("carries its own user.email still wins. This is the fallback for")
        note("repos that have none, which otherwise cannot commit in a microVM.")
        note("Prefer the noreply form for anything that can reach a public repo.")
        identity = ask("identity (blank for none)",
                       config.get("defaults", {}).get("identity", ""))
        if identity and identity not in idents:
            die(f"unknown identity: {identity}")

    git_push = pick_git_push(config.get("defaults", {}).get("git_push", "gh"),
                             identity, idents.get(identity, {}) if identity else {})

    say("SSH keys")
    note("Which keys in your host ssh-agent this sandbox may use, for git over")
    note("ssh and for signing. Nothing is ticked by default: a sandbox gets no")
    note("key until you give it one. Change later with `msbctl keys <name>`.")
    sign_pub = idents.get(identity, {}).get("signing_key") if identity else None
    sign_fp = (_parse_pub_line(sign_pub) or (None,))[0] if sign_pub else None
    if sign_fp:
        note(f"{identity} signs commits with the key marked{SIGNS_MARK.strip()}; it is ticked")
        note("for you, and without it this sandbox commits unsigned.")
    push_pub = idents.get(identity, {}).get("push_key") if identity and git_push == "ssh" else None
    push_fp = (_parse_pub_line(push_pub) or (None,))[0] if push_pub else None
    if push_fp and push_fp != sign_fp:
        note(f"{identity} pushes with the other key ticked for you; without it git push fails.")
    ticked = [fp for fp in (sign_fp, push_fp) if fp]
    ssh_keys = pick_ssh_keys(list(dict.fromkeys(ticked)) or None, preselect_all=False,
                             signing=sign_fp)

    groups = sorted(g for g in config.get("rules", {}) if g != "base")
    default_groups = config.get("defaults", {}).get("rule_groups", [])
    plan = pick_features(groups, default_groups, repo, config)
    llm = None                       # follow [defaults] llm
    if "pi" in plan["agents"]:
        say("Models for pi")
        default_llm = list(config.get("defaults", {}).get("llm", []))
        picked = pick_llms(config, default_llm)
        if picked is not None and picked != default_llm:
            llm = picked
    pick_resources(plan, config)
    pick_disks(plan, config)
    pick_caches(plan)
    mounts = pick_mounts(project if guest_path == "host" else guest_path)
    secrets = pick_secrets(config)
    # This machine's own groups go in the registry entry, not the project.
    chosen, local_groups = split_groups(plan["groups"])
    packages = plan["packages"]
    containers_disk = plan["containers_disk"]
    root_default = config.get("defaults", {}).get("root_disk", "16G")
    containers_storage = plan["containers_storage"]

    say("Image")
    image = ask("image", config.get("defaults", {}).get("image", ""))
    if "@sha256:" not in image:
        note("not digest-pinned: a tag can move under a working setup, a digest cannot")
        digest = available_digest(image)
        if digest and confirm(f"pin to {digest}?"):
            image = f"{image}@{digest}"
        elif not digest:
            warn("could not resolve a digest — leaving the tag unpinned")

    # ------------------------------------------------------------- the tokens
    claude_token = ""
    tokens = claude_tokens()
    if len(tokens) > 1 and config.get("defaults", {}).get("claude_auth", "secret") == "secret":
        say("Claude token")
        default = default_claude_token(config)
        follow = f"the default  (now {default})"
        choice = choose_one("which Claude account this sandbox uses", [follow] + list(tokens), 0)
        claude_token = "" if choice == follow else choice

    want_github = bool(repo)
    if want_github:
        say("GitHub token")
        github_token_help(repo)
        want_github = capture_token(name)

    autostart = confirm("start this one with the others by default?")

    # ------------------------------------------------------------- write out
    os.makedirs(REGISTRY_DIR, mode=0o700, exist_ok=True)
    today = dt.date.today().isoformat()
    with open(entry_path, "w", encoding="utf-8") as fh:
        fh.write(render("registry.toml.in", NAME=name, PROJECT=project,
                        GUEST_PATH=guest_path,
                        REPO=repo, DATE=today, IDENTITY=identity,
                        GIT_PUSH=git_push, CLAUDE_TOKEN=claude_token,
                        LLM=(f"llm = {json.dumps(llm)}" if llm is not None
                             else '# llm = ["qwen"]'),
                        SSH_KEYS=format_ssh_keys(ssh_keys),
                        MOUNTS=format_list("mounts", mounts, '# mounts = ["~/reference:/mnt/reference:ro"]'),
                        EXTRA_RULE_GROUPS=format_list("extra_rule_groups", local_groups,
                                                      '# extra_rule_groups = ["homelab"]'),
                        AUTOSTART="true" if autostart else "false"))
    note(f"wrote {tilde(entry_path)}")
    for var, host in unreachable_secret_hosts(config, chosen + local_groups, [sp for sp, _ in secrets]):
        warn(f"{var} is bound to {host}, but no egress rule allows it — "
             f"`msbctl allow {name} {host}` (then rebuild), or it can never be used")
    for spec, value in secrets:
        if value:
            store_secret_value(name, secret_var(spec), value)
        else:
            note(f"no value for {secret_var(spec)} — `msbctl secret add {name}` when you have it")

    msb_dir = os.path.join(project, ".msb")
    os.makedirs(msb_dir, exist_ok=True)
    defaults = config.get("defaults", {})

    # Whether a written file is committable depends on the layout, and saying
    # "commit this" for a file that is not in any repo is worse than saying
    # nothing.
    inside_repo = os.path.isdir(os.path.join(project, ".git"))
    sandbox_toml = os.path.join(msb_dir, "sandbox.toml")
    # The policy is approved below only if the wizard wrote it from what was
    # just chosen. One kept from a clone is somebody else's, and the first
    # create shows it and asks.
    wrote_policy = not os.path.exists(sandbox_toml)
    if os.path.exists(sandbox_toml):
        note(f"kept existing {tilde(sandbox_toml)}")
    else:
        # A group listed in `private_dns_groups` is reached by NAME, and those
        # names resolve to LAN addresses, which msb discards unless rebind protection is off. Set
        # together because the group does not work without it — and leaving the
        # operator to discover that produces an NXDOMAIN that reads as a
        # missing rule.
        private_groups = config.get("defaults", {}).get("private_dns_groups", [])
        needs_private_dns = any(g in private_groups for g in chosen)
        with open(sandbox_toml, "w", encoding="utf-8") as fh:
            fh.write(render("sandbox.toml.in",
                            RULE_GROUPS=json.dumps(chosen),
                            PACKAGES=json.dumps(packages),
                            SB_CPUS=(f'cpus = {plan["cpus"]}' if plan["cpus"] != defaults.get("cpus", 4)
                                     else f'# cpus = {defaults.get("cpus", 4)}'),
                            SB_MEMORY=(f'memory = "{plan["memory"]}"' if plan["memory"] != defaults.get("memory", "8G")
                                       else f'# memory = "{defaults.get("memory", "8G")}"'),
                            SECRET_BINDS=format_list("secret_binds", [sp for sp, _ in secrets],
                                                     '# secret_binds = ["NPM_TOKEN@registry.npmjs.org"]'),
                            CACHES=("[caches]\n" + "".join(f'{k} = "{v}"\n' for k, v in plan["caches"].items())).rstrip("\n")
                                   if plan["caches"] else '# [caches]\n# npm = "5G"',
                            ROOT_DISK=(f'root_disk = "{plan["root_disk"]}"'
                                       if plan["root_disk"] != root_default
                                       else f'# root_disk = "{root_default}"'),
                            BUN="true" if plan["bun"] else "false",
                            GITLEAKS="true" if plan["gitleaks"] else "false",
                            CLAUDE="true" if "claude" in plan["agents"] else "false",
                            PI="true" if "pi" in plan["agents"] else "false",
                            CONTAINERS_DISK=(f'containers_disk = "{containers_disk}"'
                                             if containers_disk else
                                             '# containers_disk = "20G"'),
                            CONTAINERS_STORAGE=(f'containers_storage = "{containers_storage}"'
                                                if containers_storage else
                                                '# containers_storage = "fuse-overlayfs"'),
                            ALLOW_PRIVATE_DNS="true" if needs_private_dns else "false",
                            SECRET_GITHUB="true" if want_github else "false"))
        note(f"wrote {tilde(sandbox_toml)}" +
             ("  — commit this" if inside_repo else "  (outside the checkout)"))

    dev_yaml = os.path.join(msb_dir, "dev.yaml")
    if os.path.exists(dev_yaml):
        note(f"kept existing {tilde(dev_yaml)}")
    else:
        with open(dev_yaml, "w", encoding="utf-8") as fh:
            fh.write(render("dev.yaml.in", IMAGE=image))
        note(f"wrote {tilde(dev_yaml)}" +
             ("  — commit this" if inside_repo else "  (outside the checkout)"))

    if wrote_policy:
        approve_policy(Sandbox(name, config))
    say("Registered")
    note(f"Nothing has been started. When you want it:  msbctl start {name}")
    note("The first start runs the bootstrap and takes a few minutes.")


def cmd_add_repo(args, config):
    """add --repo OWNER/NAME: a sandbox with no host folder. Its code is cloned
    inside the sandbox at the first create; its policy is the repo's .msb/,
    fetched here and approved at the commit it was read at. Flags answer the
    questions; without a terminal, whatever no flag says takes its default.
    Nothing is written into any folder."""
    if args.dir:
        die("give a folder or --repo, not both")
    raw = args.repo.strip()
    repo = (parse_github_url(raw) or raw).removesuffix(".git")
    if not REPO_NAME.fullmatch(repo) or ".." in repo:
        die(f"{raw!r} is not a GitHub repo (owner/name, or its URL)")
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    defaults = config.get("defaults", {})
    say(f"Register a sandbox cloned from {repo}")

    default_name = re.sub(r"[^a-z0-9-]+", "-", repo.split("/")[1].lower()).strip("-")
    name = args.new_name or (ask("sandbox name", default_name) if interactive else default_name)
    problem = name_problem(name)
    if problem:
        die(problem)
    ref = args.ref if args.ref is not None else (
        ask("branch, tag or commit (blank: the default branch)") if interactive else "")
    # /work even when [defaults] guest_path is "host": there is no host path.
    guest_path = args.guest_path or GUEST_PROJECT
    problem = ("there is no host folder to mirror" if guest_path == "host"
               else "a disk volume cannot be mounted at a path with a dot" if "." in guest_path
               else guest_path_problem(guest_path))
    if problem:
        die(f"--guest-path {guest_path}: {problem}")
    workspace_disk = args.workspace_disk
    if workspace_disk:
        size_bytes(workspace_disk)              # dies on a malformed size
    idents = config.get("identities", {})
    identity = args.identity
    if identity is None:
        identity = (ask("git identity (blank for none)", defaults.get("identity", ""))
                    if interactive and idents else defaults.get("identity", "") or "")
    if identity and identity not in idents:
        die(f"unknown identity {identity!r} — config.toml defines: {', '.join(sorted(idents)) or '(none)'}")
    tokens = claude_tokens()
    claude_token = args.claude_token or ""
    if claude_token and claude_token not in tokens:
        die(f"no Claude token named {claude_token!r} is stored (`msbctl setup` → Claude login)")
    if not args.claude_token and interactive and len(tokens) > 1:
        follow = f"the default  (now {default_claude_token(config)})"
        choice = choose_one("which Claude account this sandbox uses", [follow] + list(tokens), 0)
        claude_token = "" if choice == follow else choice
    autostart = args.autostart or (interactive and not args.yes
                                   and confirm("start this one with the others by default?"))

    # Kept in memory until the sandbox is registered, so declining leaves
    # nothing behind; used for the fetch, in a header, and nowhere else.
    token = None
    if interactive:
        say("GitHub token")
        github_token_help(repo)
        token = read_secret_hidden("paste the token") or None
        if token and any(c.isspace() for c in token):
            die("that token has whitespace in it — nothing was stored")
    tmp, meta = fetch_repo_policy(name, repo, ref, token=token)
    try:
        cfg = read_toml(os.path.join(tmp, ".msb", "sandbox.toml"))
        say("What the repo asks for")
        note(f"commit       {meta['sha'][:12]}  ({meta['branch'] or ref or 'detached'})"
             f"{'  private' if meta['private'] else ''}")
        note(f"rule groups  base + {', '.join(map(shown, cfg.get('rule_groups', defaults.get('rule_groups', [])))) or '(none)'}")
        for rule in cfg.get("extra_rules", []):
            note(f"extra rule   {shown(rule)}")
        for spec in cfg.get("secret_binds", []):
            note(f"secret       {shown(spec)}")
        for key in ("cpus", "memory", "root_disk", "containers_disk", "workspace_disk"):
            if key in cfg:
                note(f"{key:<12} {shown(cfg[key])}")
        image = conf_image(os.path.join(tmp, ".msb", "dev.yaml"))
        note(f"image        {shown(image) if image else defaults.get('image', '?') + '  (the default)'}")
        if not os.path.isfile(os.path.join(tmp, ".msb", "sandbox.toml")):
            note("(no .msb/sandbox.toml in the repo: the machine's defaults apply)")
        if restricted():
            # Under host serve the caller is the laptop, which may name any repo:
            # its policy must not bind a variable that already has a value here
            # (a fresh name has none, so ordinary use never meets this).
            own = read_env_file(os.path.join(SECRETS_DIR, f"{name}.env"))
            stored = [secret_var(sp) for sp in cfg.get("secret_binds", []) if secret_var(sp) in own]
            if stored:
                die(f"{repo}'s policy binds {', '.join(stored)}, which already has a value stored "
                    f"for {name} — refused here; add it on the host")
        if meta["private"] and not token:
            warn(f"{repo} is private and there is no token for {name}: the clone will fail "
                 f"until `msbctl secret set {name} GH_TOKEN`")
        if interactive and not args.yes and not confirm(f"register {name} with this policy?"):
            die("cancelled — nothing was written")

        os.makedirs(REGISTRY_DIR, mode=0o700, exist_ok=True)
        with open(registry_path_for(name), "w", encoding="utf-8") as fh:
            fh.write(render("registry-repo.toml.in", NAME=name, REPO=repo, REF=ref,
                            DATE=dt.date.today().isoformat(), GUEST_PATH=guest_path,
                            IDENTITY=identity, CLAUDE_TOKEN=claude_token,
                            AUTOSTART="true" if autostart else "false",
                            WORKSPACE_DISK=(f'workspace_disk = "{workspace_disk}"' if workspace_disk
                                            else f'# workspace_disk = "{defaults.get("workspace_disk", "20G")}"')))
        install_policy(name, tmp)
        tmp = None
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)
    if token:
        set_env_file_value(os.path.join(SECRETS_DIR, f"{name}.env"), "GH_TOKEN", token)
    # The operator ran add with these arguments and, at a terminal, said yes to
    # what was shown: that is the approval.
    approve_policy(Sandbox(name, config))
    note(f"wrote {tilde(registry_path_for(name))}")
    say("Registered")
    note(f"Nothing has been started. When you want it:  msbctl start {name}")
    note("The first start clones the repo and runs the bootstrap; it takes a few minutes.")


def github_token_help(repo):
    """What to create at GitHub, once per project. There is no API for it."""
    note("GitHub has no API for creating fine-grained PATs, so this part is")
    note("manual, once per project. Create one with exactly:")
    note("")
    note(f"  Repository access   Only select repositories -> {repo}")
    note("  Contents            Read and write")
    note("  Pull requests       Read and write")
    note("  Actions             Read-only")
    note("  Metadata            Read-only (forced)")
    note("")
    note("Expiry is yours to choose; anything up to 366 days.")
    url = "https://github.com/settings/personal-access-tokens/new"
    # Over ssh (a laptop adding a sandbox here), a browser would open on this
    # machine's screen rather than the caller's.
    if shutil.which("xdg-open") and not os.environ.get("SSH_CONNECTION") and confirm("open that page now?"):
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        note(url)


def capture_token(name):
    """Read a PAT straight to the sandbox's 0600 env file. Never echoed, never in
    argv. Sets ONLY GH_TOKEN: the file also holds this sandbox's other secrets, and
    an earlier version truncated it and lost them."""
    path = os.path.join(SECRETS_DIR, f"{name}.env")
    token = read_secret_hidden("paste the token")
    if not token or any(c.isspace() for c in token):
        note("skipped — the sandbox will have no GitHub API access.")
        note(f"Add it later: msbctl edit {name}  ->  GitHub token")
        return False
    set_env_file_value(path, "GH_TOKEN", token)
    note(f"stored in {tilde(path)} (0600)")
    return True


# ------------------------------------------------------------- a remote host
#
# A remote host is an ordinary install, driven over ssh: `ssh host msbctl ...`.
# The laptop is the adversary in this design (code run as the operator there:
# an agent outside any sandbox, a compromised dependency), so the key it uses
# every day must not be able to READ a stored secret or RE-AIM one at a host of
# its choosing — and a plain shell does both (`cat secrets/global.env`). So
# that key gets a forced command, `msbctl host serve`, which runs msbctl verbs
# only, from an allowlist that looks at the arguments too, and with
# MSB_RESTRICTED=1 so nothing it runs approves a policy change by prompting:
# behind a pty, code on the laptop can answer a prompt as easily as you can.
# Policy changes are made on the host itself, or with a second key the laptop's
# agent does not hold (a FIDO2 `sk-` key). `msbctl host authorize` writes both
# kinds of authorized_keys line. Hardening, not a permission system: the table
# below is the whole of it, and is meant to be read in one sitting.

HOST_EXIT_REFUSED = 126

# What `msb exec` accepts (msb 0.7.7, crates/cli/lib/commands/exec.rs). Every
# one acts inside the guest. Anything else is refused until it has been read:
# a future msb flag must not pass unreviewed.
MSB_EXEC_VALUE_FLAGS = ("-e", "--env", "-w", "--workdir", "-u", "--user", "--timeout", "--rlimit")
MSB_EXEC_BARE_FLAGS = ("-t", "--tty", "--no-tty", "--no-stdin", "-q", "--quiet", "--stream")


def _msb_flags_problem(flags):
    i = 0
    while i < len(flags):
        flag = flags[i]
        name = flag.split("=", 1)[0] if flag.startswith("--") else flag
        if name in MSB_EXEC_BARE_FLAGS and "=" not in flag:
            i += 1
        elif name in MSB_EXEC_VALUE_FLAGS:
            if "=" not in flag:
                if i + 1 >= len(flags):
                    return f"{flag} needs a value"
                i += 1
            i += 1
        else:
            return f"msb exec flag {flag!r} is not one host serve passes on"
    return None


def restricted_problem(argv, kandev=False):
    """None if `msbctl <argv>` may run under `host serve`, else the reason.
    Each refusal says what it would let a compromised laptop do.

    The two keys are disjoint. The Kandev plugin's key (`--kandev`) runs
    `kandev` verbs only. Those DO set egress and secret bindings, which the
    everyday key may never do: a Kandev profile is the policy for its own
    sandboxes, and they can reach nothing else (see kandev). The everyday key
    runs no `kandev` verb, since one could create a sandbox with any egress."""
    if argv in (["--version"], ["-V"]):
        return None
    if kandev:
        if not argv or argv[0] not in ("kandev", "ls", "show", "stop", "purge", "self-update"):
            return "this key runs `msbctl kandev` verbs, and ls, show, stop, purge and self-update with --json"
        try:
            with contextlib.redirect_stderr(io.StringIO()), contextlib.redirect_stdout(io.StringIO()):
                args = build_parser().parse_args(argv)
        except SystemExit:
            return "the command line does not parse"
        if args.func is cmd_kandev:
            return None
        # The generic verbs, in the one shape the plugin uses: JSON, explicit
        # names, nothing that re-probes or prompts. Under this key they see
        # only Kandev's sandboxes (kandev_guard(), ls_data(), cmd_purge()).
        if not args.json:
            return f"{argv[0]}: only with --json"
        if args.func is cmd_self_update:
            # As for the everyday key: the Update button, never a downgrade.
            return self_update_problem(args.version) if args.version else None
        if args.func is cmd_ls:
            return None if not (args.refresh or args.porcelain or args.picker) else "ls: only --json"
        names = [args.name] if args.func is cmd_show else list(args.names or [])
        if len(names) != 1 or not names[0] or not SANDBOX_NAME.fullmatch(names[0]):
            return f"{argv[0]}: name exactly one sandbox"
        if args.func is cmd_purge and not args.yes:
            return "purge: only with -y"
        return None
    if argv and argv[0] == "kandev":
        return "kandev verbs are for the Kandev plugin's key (`host authorize --kandev`)"
    try:
        split, flags = split_cli(argv)
    except (ValueError, IndexError):
        return "the command line does not parse"
    problem = _msb_flags_problem(flags)
    if problem:
        return problem
    try:
        with contextlib.redirect_stderr(io.StringIO()), contextlib.redirect_stdout(io.StringIO()):
            args = build_parser().parse_args(split)
    except SystemExit as exc:
        # -h prints help and exits 0: harmless, and the child prints it again.
        return None if exc.code == 0 and ("-h" in split or "--help" in split) else \
            "the command line does not parse"
    func = args.func
    names = list(getattr(args, "names", None) or [])
    if hasattr(args, "name"):
        names.append(args.name)
    elif hasattr(args, "names") and not names and not getattr(args, "autostart", False):
        names = [None]                  # omitted: the folder's sandbox
    for name in names:
        # `.` and an omitted name mean "the folder I am in", which on the host
        # is nothing the caller chose; a path-like name is never a sandbox.
        if name is None:
            return "name the sandbox: the host's current folder means nothing to the caller"
        if not SANDBOX_NAME.fullmatch(name):
            return f"{name!r} is not a sandbox name"
    if func is cmd_rename and not SANDBOX_NAME.fullmatch(args.new):
        return f"{args.new!r} is not a sandbox name"

    # Allowed as they are: they read, start, stop, or act inside a sandbox, and
    # anything among them that would apply a changed policy (create, rebuild,
    # rename) refuses under MSB_RESTRICTED. `purge` destroys unpushed work and
    # leaks nothing, so it is outside the threat as stated.
    plain = (cmd_ls, cmd_status, cmd_show, cmd_config, cmd_start, cmd_stop, cmd_reclaim,
             cmd_shell, cmd_exec, cmd_update, cmd_resize, cmd_rebuild, cmd_purge, cmd_rename)
    if func in plain:
        return None
    if func is cmd_self_update:
        # Only forward: the latest release is how a remote gets upgraded without
        # the admin key; an older --version is the way DOWN, to a weaker host serve.
        return self_update_problem(args.version) if args.version else None
    if func is cmd_cache:
        return None if args.action in ("ls", "clear") else "cache: only ls and clear"
    if func is cmd_observe:
        # `on` lifts deny-by-default: everything the guest reads it could send.
        return None if args.action in ("report", "off") else \
            "observe on turns off egress filtering"
    if func is cmd_secret:
        # `add` binds a variable to a host, which decides where a stored value
        # is sent. Storing a value (`set`) is not reading one.
        return None if args.action in ("ls", "set", "rm") else \
            "secret add binds a stored value to a host"
    if func is cmd_setup:
        # The menu edits identities, egress groups and defaults. Storing a
        # Claude token is how one reaches the host at all.
        # Identities and defaults are the host's configuration, not a credential.
        only_token = (args.claude_token and args.stdin and not args.welcome and not args.default
                      and not args.identity and not args.git_name and not args.git_email)
        return None if only_token else "setup: only --claude-token NAME --stdin"
    if func is cmd_add:
        # A folder `add` mounts a host path of the caller's choosing.
        return None if args.repo else "add: only --repo (a folder add mounts a host path)"
    if func is cmd_policy:
        return None if args.action == "show" else f"policy {args.action} changes what is approved"
    if func is cmd_host:
        return None if args.action == "check" else f"host {args.action} is for the host itself"
    # allow: a new egress rule. mount: a host path. port: a host port. keys:
    # which of the host's ssh keys a sandbox may sign with. move/entry/edit:
    # rewrite the registry and the policy.
    # _agent-filter: the host's ssh-agent. The menu: all of the above.
    return f"`{getattr(args, 'cmd', None) or 'the menu'}` is not allowed with this key"


def host_serve(kandev=False):
    """The forced command: validate SSH_ORIGINAL_COMMAND and run it, restricted.
    `kandev`: the Kandev plugin's key, which runs `kandev` verbs and nothing
    else — and the everyday key runs no `kandev` verb (restricted_problem())."""
    def refuse(reason):
        print(f"msbctl host serve: refused: {reason}", file=sys.stderr)
        sys.exit(HOST_EXIT_REFUSED)

    raw = os.environ.get("SSH_ORIGINAL_COMMAND")
    if raw is None:
        # Also what an interactive login with this key gets: there is no shell.
        refuse("this key runs msbctl commands only and gets no shell "
               "(`ssh host msbctl ls`); see `msbctl host authorize`")

    try:
        argv = shlex.split(raw)
    except ValueError:
        refuse("the command does not parse as shell words")
    # A path to msbctl too: a laptop that recorded one (`remote_program()`)
    # before the key was restricted. It names nothing; this msbctl runs.
    if not argv or not REMOTE_PROGRAM.fullmatch(argv[0]):
        refuse("only msbctl commands")
    argv = argv[1:]
    problem = restricted_problem(argv, kandev=kandev)
    if problem:
        refuse(problem)
    os.environ["MSB_RESTRICTED"] = "kandev" if kandev else "1"
    # sshd runs a forced command with its own minimal PATH, so an msb in
    # ~/.local/bin (where get.sh puts it) would not be found by any verb.
    here = os.path.dirname(os.path.realpath(__file__))
    os.environ["PATH"] = os.pathsep.join(
        [os.path.join(HOME, ".local", "bin"), here, os.environ.get("PATH", "")])
    me = os.path.realpath(__file__)
    os.execv(sys.executable, [sys.executable, me, *argv])


def authorized_keys_path():
    return os.path.join(SSH_DIR, "authorized_keys")


def host_authorize(args):
    parsed = _parse_pub_line(args.arg or "")
    if not parsed or "\n" in args.arg:
        die("give one public key line, in quotes: \"ssh-ed25519 AAAA... comment\"")
    _, ktype, comment = parsed
    blob = args.arg.split()[1]
    comment = re.sub(r"[^\w@.: ()+-]", "", comment)    # it lands on an options-bearing line
    path = authorized_keys_path()
    os.makedirs(SSH_DIR, mode=0o700, exist_ok=True)
    os.chmod(SSH_DIR, 0o700)
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except FileNotFoundError:
        text = ""
    existing = text.splitlines()
    present = [line for line in existing if blob in line.split()]
    if present and not args.replace:
        die(f"that key is already in {tilde(path)}:\n  {present[0]}\n"
            "--replace rewrites that line; or edit the file by hand")
    if args.admin and args.kandev:
        die("--admin and --kandev are two different keys")
    if args.admin:
        if not ktype.startswith("sk-"):
            warn("a plain key as the admin key: if the laptop's ssh-agent holds it, the")
            warn("code this host is guarded against can use it without asking. A FIDO2")
            warn("`sk-` key (or one loaded with `ssh-add -c`) needs a touch or a yes.")
            if not confirm("authorize it unrestricted anyway?"):
                die("cancelled — nothing written")
        line = f"{ktype} {blob} {comment}".rstrip()
    else:
        # As found on PATH, not resolved: a packaged install's `current` link
        # moves on self-update, and the line must follow it.
        me = shutil.which("msbctl")
        if not me:
            me = os.path.realpath(__file__)
            warn(f"msbctl is not on PATH; the line names {me}, which an upgrade may move")
        # The Kandev plugin never needs a terminal, so its line has no pty.
        line = (f'restrict,command="{me} host serve --kandev" {ktype} {blob} {comment}' if args.kandev
                else f'restrict,pty,command="{me} host serve" {ktype} {blob} {comment}').rstrip()
    if present:
        # Every line naming the key goes, so none of them still grants what the
        # new one does not; written whole and renamed, so a failure halfway
        # cannot leave sshd reading half a file.
        kept = [old for old in existing if old not in present] + [line]
        tmp = path + ".msbctl-new"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("\n".join(kept) + "\n")
        os.replace(tmp, path)
    else:
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as fh:
            fh.write(("" if not text or text.endswith("\n") else "\n") + line + "\n")
    os.chmod(path, 0o600)
    note(f"{'replaced in' if present else 'added to'} {tilde(path)}:")
    note(f"  {line}")
    if args.kandev:
        note("this key can run `msbctl kandev` verbs, and nothing else")
    elif not args.admin:
        note("this key can run msbctl verbs from host serve's allowlist, and nothing else")


def _check(name, ok, detail):
    return {"check": name, "ok": ok, "detail": detail}


def host_checks():
    """The hygiene report. Heuristics, each labelled as such: none of these can
    prove the host is safe, only point at what plainly is not."""
    out = []
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or str(os.getuid())
    try:
        import grp
        groups = {grp.getgrgid(g).gr_name for g in os.getgroups()}
    except (ImportError, KeyError):
        groups = set()
    admin = sorted(groups & {"sudo", "wheel", "admin"})
    out.append(_check("user", os.getuid() != 0 and not admin,
                      f"{user}, uid {os.getuid()}" + (f", in {', '.join(admin)} (can become root)"
                                                     if admin else "") +
                      (" — root" if os.getuid() == 0 else "")))
    home_mode = os.stat(HOME).st_mode & 0o777
    out.append(_check("home", home_mode & 0o077 == 0, f"{tilde(HOME)} is {home_mode:04o}"))
    if os.path.isdir(SECRETS_DIR):
        loose = [f for f in sorted(os.listdir(SECRETS_DIR))
                 if os.stat(os.path.join(SECRETS_DIR, f)).st_mode & 0o077]
        dmode = os.stat(SECRETS_DIR).st_mode & 0o777
        out.append(_check("secrets", dmode == 0o700 and not loose,
                          f"{tilde(SECRETS_DIR)} {dmode:04o}" +
                          (f"; not 0600: {', '.join(loose)}" if loose else ", every file 0600")))
    else:
        out.append(_check("secrets", True, "no secrets stored yet"))

    def read(path):
        try:
            with open(path, encoding="utf-8") as fh:
                return fh.read().strip()
        except OSError:
            return None
    dumpable = read("/proc/sys/fs/suid_dumpable")
    out.append(_check("core dumps", dumpable == "0", f"fs.suid_dumpable = {dumpable}"))
    pattern = read("/proc/sys/kernel/core_pattern") or ""
    out.append(_check("core pattern", None if pattern.startswith("|") else True,
                      pattern + (" (a pipe: dumps may land on disk unless its Storage=none)"
                                 if pattern.startswith("|") else "")))
    swaps = [line.split()[0] for line in (read("/proc/swaps") or "").splitlines()[1:] if line.split()]
    # zram is compressed memory, not a disk; anything else must sit on dm-crypt.
    plain = [sw for sw in swaps if not sw.startswith("/dev/zram") and not _on_dm_crypt(sw)]
    out.append(_check("swap", not plain, "none" if not swaps else
                      f"{', '.join(swaps)}" + (f" — not encrypted: {', '.join(plain)}" if plain
                                              else " (in memory, or on dm-crypt)")))
    mounts = [line.split()[:2] for line in (read("/proc/mounts") or "").splitlines() if line.split()]
    best = max((m for m in mounts if HOME == m[1] or HOME.startswith(m[1].rstrip("/") + "/")),
               key=lambda m: len(m[1]), default=None)
    crypt = best is not None and _on_dm_crypt(best[0])
    out.append(_check("disk", crypt, f"{tilde(HOME)} is on {best[0] if best else '?'}"
                      f" ({best[1] if best else '?'}): "
                      + ("dm-crypt found below it" if crypt else
                         "no dm-crypt found below it — is the disk encrypted some other way?")))
    keys = []
    for line in (read(authorized_keys_path()) or "").splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            keys.append(line)
    open_keys = [line for line in keys if "host serve" not in line
                 and not any(part.startswith("sk-") for part in line.split()[:3])]
    out.append(_check("authorized_keys", not open_keys,
                      f"{len(keys)} key(s); " + (f"{len(open_keys)} can get a shell and are not sk- keys"
                                                 if open_keys else "each is host serve or an sk- key")))
    out.append(_check("restricted", None, "yes: this key runs under host serve"
                      if restricted() else "no: this session is unrestricted"))
    linger = os.path.exists(f"/var/lib/systemd/linger/{user}")
    unit = os.path.exists(os.path.join(SYSTEMD_USER_DIR, "default.target.wants", AUTOSTART_UNIT))
    out.append(_check("autostart", linger and unit,
                      f"linger {'on' if linger else 'off'}, {AUTOSTART_UNIT} "
                      f"{'enabled' if unit else 'not enabled'} (`msbctl host autostart install`)"))
    msb = shutil.which("msb")
    version = run(["msb", "--version"], capture=True, check=False).stdout.strip() if msb else ""
    out.append(_check("msb", bool(msb) and os.path.exists("/dev/kvm"),
                      f"{version or 'not found'}{' at ' + msb if msb else ''}, "
                      f"/dev/kvm {'present' if os.path.exists('/dev/kvm') else 'MISSING'}"))
    out.append(_check("msbctl", True, version_string()))
    return out


def _on_dm_crypt(device):
    """Whether a block device is, or sits on, a dm-crypt (LUKS) mapping: its
    device-mapper chain, walked through /sys, has a CRYPT- uuid. LVM alone is
    device-mapper too and encrypts nothing, so the name is not enough."""
    try:
        start = os.path.basename(os.path.realpath(device))
    except OSError:
        return False
    seen, todo = set(), [start]
    while todo:
        dev = todo.pop()
        if dev in seen:
            continue
        seen.add(dev)
        try:
            with open(f"/sys/class/block/{dev}/dm/uuid", encoding="utf-8") as fh:
                if fh.read().startswith("CRYPT-"):
                    return True
        except OSError:
            pass  # not a device-mapper device
        try:
            todo += os.listdir(f"/sys/class/block/{dev}/slaves")
        except OSError:
            pass  # a leaf: nothing below it
    return False


def host_check(args):
    checks = host_checks()
    if args.json:
        print_json({"msbctl": version_string(), "restricted": restricted(), "checks": checks})
        return
    say("Host check (heuristics: they point at what is plainly wrong, and prove nothing)")
    for c in checks:
        mark = {True: "ok  ", False: "WARN", None: "info"}[c["ok"]]
        note(f"{mark}  {c['check']:<16} {c['detail']}")


SYSTEMD_USER_DIR = os.path.join(HOME, ".config", "systemd", "user")
AUTOSTART_UNIT = "msb-autostart.service"


def host_autostart(args):
    if args.arg != "install":
        die("host autostart: the only action is `install`")
    me = shutil.which("msbctl") or os.path.realpath(__file__)
    os.makedirs(SYSTEMD_USER_DIR, exist_ok=True)
    path = os.path.join(SYSTEMD_USER_DIR, AUTOSTART_UNIT)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(f"""# Written by `msbctl host autostart install`. Starts every sandbox whose
# registry entry says autostart = true, after a reboot, with nobody logged in
# (that part needs `loginctl enable-linger`, once, as root).
[Unit]
Description=Start the msb-manager autostart sandboxes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH={os.path.join(HOME, '.local', 'bin')}:/usr/local/bin:/usr/bin:/bin
ExecStart={me} start --autostart

[Install]
WantedBy=default.target
""")
    note(f"wrote {tilde(path)}")
    if shutil.which("systemctl"):
        run(["systemctl", "--user", "daemon-reload"], check=False)
        run(["systemctl", "--user", "enable", AUTOSTART_UNIT], check=False)
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or "<user>"
    if not os.path.exists(f"/var/lib/systemd/linger/{user}"):
        note("a user unit runs with nobody logged in only with lingering on; once, as root:")
        note(f"  loginctl enable-linger {user}")


def cmd_host(args, config):
    """host serve|authorize|check|autostart|kandev — running this machine as a remote."""
    if args.action == "serve":
        host_serve(kandev=args.kandev)
    elif restricted() and args.action != "check":
        die(f"host {args.action} is for the host itself")
    elif args.kandev and args.action not in ("authorize", "serve"):
        die("--kandev goes with host authorize or host serve")
    elif (any(getattr(args, attr) is not None for attr, _ in KANDEV_CONFIGURE_KEYS)
          and (args.action, args.arg) != ("kandev", "configure")):
        die("--enabled, --serve, --proxy-listen, --base-url, --allow-extra and --private-name "
            "go with host kandev configure")
    elif args.action == "authorize":
        host_authorize(args)
    elif args.action == "check":
        host_check(args)
    elif args.action == "autostart":
        host_autostart(args)
    elif args.action == "kandev":
        host_kandev(args, config)


# ----------------------------------------------------------------- kandev
#
# This machine as a sandbox host for Kandev. The Kandev plugin drives it the
# way a laptop drives a remote: `ssh host msbctl kandev <verb> …`, through
# `host serve --kandev`, which admits these verbs, plus `ls`, `show`, `stop`,
# `purge` and `self-update` with --json, and nothing else. `kandev` holds only what needs
# Kandev's own input; listing, inspecting, stopping and removing are the
# generic verbs, which under that key see Kandev's sandboxes alone. Each run
# prints ONE JSON document on stdout (json_document()) and exits. The one
# long-running piece is the host's own TLS proxy (`host kandev proxy`).
#
# Three rules shape everything below:
#
#   Kandev's sandboxes are a world of their own. They are found only through
#   registry entries with `source = "kandev"` (and the msb label for orphans),
#   by Kandev environment id or, for the generic verbs under the Kandev key,
#   by name among those entries alone. Nothing the plugin runs reaches one of
#   the operator's sandboxes, whatever it is called, and the operator's verbs
#   may only look at, shell into, stop and purge Kandev's (kandev_guard()).
#
#   No secret value goes into argv, a file, stdout or a log. Profile secrets,
#   registry passwords and agentctl's bootstrap nonce arrive on stdin and go
#   into the environment of one `msb` process, or the stdin of one `msb exec`.
#
#   None of msbctl's credential plumbing. Kandev delivers agent and git
#   credentials itself, through agentctl; msbctl's bootstrap, CLAUDE.md seed,
#   git identity, git_push rewrites, ssh-agent filter, Claude token and
#   GH_TOKEN binding would fight it, so a kandev entry gets none of them.

KANDEV_PROTOCOL = 1
# agentctl's control port (fixed by Kandev) and the instance-port range it is
# told to use: the only guest ports Kandev ever leases. Two spares, because
# agentctl skips a port that is still bound after a restart.
KANDEV_GUEST_PORTS = (8765, 41001, 41002, 41003)
KANDEV_ENV = re.compile(r"[A-Za-z0-9_-]{1,128}")
# Short enough for msb's hostname (64 bytes) and its runtime socket paths.
KANDEV_NAME_MAX = 40
KANDEV_ERROR_CODES = ("invalid_config", "denied", "unsupported", "not_found", "expired",
                      "conflict", "unavailable", "rate_limited", "cleanup_pending")
KANDEV_EXIT_ERROR = 3
KANDEV_HEADER_MAX = 64 * 1024
KANDEV_AGENTCTL_MAX = 512 * 1024 * 1024
KANDEV_LEASE_SECONDS = 600
# How long the proxy accepts a lease's token: past the expires_at it reports.
# Kandev refreshes a lease only 30 s before expires_at, and a 401 does not make
# it ask again, so a token must outlive the expiry it was given with.
KANDEV_LEASE_VALID = 900
KANDEV_STUCK_CREATE = 15 * 60       # past Kandev's own 10-minute provision deadline
KANDEV_ORPHAN_AGE = 3600
KANDEV_AGENTCTL_WAIT = 30
KANDEV_OWNER_LABEL = "msbctl.owner=kandev"
KANDEV_LOCK = os.path.join(STATE_DIR, "kandev.lock")
GUEST_AGENTCTL = "/opt/kandev/agentctl"
# Where Kandev creates every session's agentctl instance and starts the agent
# (pluginExecutorWorkspacePath, fixed). Nothing else creates it, so each Kandev
# sandbox gets its own disk there. An OWNED disk (`--mount-owned`): msb deletes
# it with the VM, so nothing of a workspace outlives its sandbox, whichever way
# the sandbox goes (purge, the reaper's expiry, an orphan's `msb rm -f`) and
# with no second step that could fail. Never a host directory: that is virtiofs
# (slow for git and builds, and it has corrupted git's index), has no quota, and
# puts what untrusted code wrote on the host's own filesystem. Verified on msb
# 0.7.7: an empty ext4 of the size asked (no lost+found), root-writable, kept
# across stop and start, gone after `msb rm` and `msb rm -f`.
KANDEV_WORKSPACE = "/workspace"
KANDEV_WORKSPACE_MAX_GIB = 500
# What `health` lists for the plugin to require, within protocol 1. 0.4.0
# ignored unknown request keys, so the plugin cannot tell from a provision that
# went through whether it got what it asked for: it asks here first.
KANDEV_FEATURES = ("workspace_disk", "private_names")
# What a sandbox with `private_names` denies in place of msb's DNS rebind
# protection, which it has to turn off: every destination group msb knows but
# `public` (the gateway, cloud metadata, loopback, RFC 1918 + CGNAT + ULA,
# link-local, multicast) and the reserved IPv4 ranges msb's rebind filter also
# drops. One token, as `base` writes several; emitted after the requested names
# and every address rule, before every other hostname rule (kandev_private_order).
KANDEV_PRIVATE_DENY = ",".join(
    f"deny@{target}" for target in (
        "host", "meta", "loopback", "private", "link-local", "multicast",
        "0.0.0.0/8", "192.0.0.0/24", "192.0.2.0/24", "192.88.99.0/24", "198.18.0.0/15",
        "198.51.100.0/24", "203.0.113.0/24", "240.0.0.0/4"))
KANDEV_REAP_UNIT = "msb-kandev-reap"
KANDEV_PROXY_UNIT = "msb-kandev-proxy"
KANDEV_SERVE_MODES = ("proxy", "tailscale", "none")
# The proxy's certificate: leaf then its issuer in cert.pem, key.pem 0600.
# Written only by `kandev tls install`; the plugin owns the CA and renewal.
KANDEV_TLS_DIR = os.path.join(CONFIG_DIR, "kandev", "tls")
KANDEV_TLS_CERT = os.path.join(KANDEV_TLS_DIR, "cert.pem")
KANDEV_TLS_KEY = os.path.join(KANDEV_TLS_DIR, "key.pem")
# Beside the per-sandbox dirs (STATE_DIR/kandev/k-…), which a dot never names.
# `host kandev rotate-lease-key` moves the key to .prev, which the proxy keeps
# accepting for KANDEV_LEASE_VALID after the change (its mtime), so no lease
# already handed out stops working.
KANDEV_LEASE_KEY = os.path.join(STATE_DIR, "kandev", "lease.key")
KANDEV_LEASE_KEY_PREV = KANDEV_LEASE_KEY + ".prev"
# The header a lease's token travels in. Not Authorization: Kandev refuses a
# lease that sets it, and sets it itself on every request, for agentctl.
KANDEV_LEASE_HEADER = "X-Msb-Lease"
# Held by the running proxy: one proxy per host, and how `health` knows it runs.
KANDEV_PROXY_LOCK = os.path.join(STATE_DIR, "kandev", "proxy.lock")
KANDEV_HEAD_MAX = 16 * 1024
KANDEV_HEAD_WAIT = 10
KANDEV_TOKEN_SKEW = 30
KANDEV_PROXY_SCAN = 2               # seconds: a destroyed sandbox's port refuses within this
KANDEV_PROXY_MAX_CONNS = 512
KANDEV_UNAUTHORIZED = b"HTTP/1.1 401 Unauthorized\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
KANDEV_BAD_GATEWAY = b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
# Names a Kandev secret or env var may not take, beyond is_reserved_var().
# Credentials Kandev itself delivers, agentctl's own settings, and anything
# that would change how msb (or the dynamic loader) behaves: secret values are
# put in the environment of the `msb` process.
KANDEV_RESERVED_NAMES = {"GITHUB_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "PATH",
                         "HOME", "USER", "LOGNAME", "SHELL", "TMPDIR", "PWD", "TERM", "LANG"}
KANDEV_RESERVED_PREFIXES = ("AGENTCTL_", "MSB_", "MSBCTL_", "LD_", "SSH_", "XDG_", "LC_")
ENV_NAME = re.compile(r"[A-Z_][A-Z0-9_]{0,63}")
HOSTNAME = re.compile(r"(\*\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9-]{2,63}")


class KandevError(Exception):
    """A failure with one of Kandev's provider error codes. `message` is for
    the host's own logs: the plugin never forwards it."""

    def __init__(self, code, message, retry_after=None):
        super().__init__(message)
        if code not in KANDEV_ERROR_CODES:
            raise ValueError(f"not a Kandev error code: {code}")
        self.code, self.message, self.retry_after = code, message, retry_after


def _kandev_try(fn, *args):
    """fn(*args), with msbctl's die() turned into invalid_config."""
    try:
        return fn(*args)
    except SystemExit as exc:
        raise KandevError("invalid_config", str(exc.code).replace("msbctl: ", "", 1)) from None


def utc_now():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def iso(when):
    return when.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(text, what="a timestamp"):
    if not isinstance(text, str):
        raise KandevError("invalid_config", f"{what} is not an RFC 3339 string")
    try:
        when = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        raise KandevError("invalid_config", f"{what} {text!r} is not RFC 3339") from None
    if when.tzinfo is None:
        raise KandevError("invalid_config", f"{what} {text!r} has no time zone")
    return when.astimezone(dt.timezone.utc)


def kandev_settings(config):
    """[kandev], checked. Every problem is invalid_config, naming the key."""
    raw = config.get("kandev", {})

    def bad(key, why):
        raise KandevError("invalid_config", f"[kandev] {key}: {why} (`msbctl config` shows where it is set)")

    out = {"enabled": raw.get("enabled", False)}
    if not isinstance(out["enabled"], bool):
        bad("enabled", "true or false")
    for key in ("max_sandboxes", "max_cpus"):
        value = raw.get(key, 0)
        if not isinstance(value, int) or isinstance(value, bool) or value < 0:
            bad(key, "a whole number, 0 or more")
        out[key] = value
    memory = str(raw.get("max_memory", "0M"))
    if not re.fullmatch(r"\d+[MGT]", memory.upper()):
        bad("max_memory", f"{memory!r} is not a size like 96G")
    out["max_memory_mib"] = size_bytes(memory) // MIB

    def pool(key, default):
        found = re.fullmatch(r"(\d+)-(\d+)", str(raw.get(key, default)))
        if not found or not 1024 <= int(found.group(1)) <= int(found.group(2)) <= 65535 \
                or int(found.group(2)) - int(found.group(1)) + 1 < len(KANDEV_GUEST_PORTS):
            bad(key, f"a range like {default}, within 1024-65535, of at least 4 ports")
        return int(found.group(1)), int(found.group(2))

    out["port_pool"] = pool("port_pool", "20000-29999")
    out["proxy_port_pool"] = pool("proxy_port_pool", "30000-39999")
    if out["port_pool"][0] <= out["proxy_port_pool"][1] and out["proxy_port_pool"][0] <= out["port_pool"][1]:
        bad("proxy_port_pool", "must not overlap port_pool")
    listen = str(raw.get("proxy_listen", "")).strip()
    if listen:
        try:
            listen = str(ipaddress.ip_address(listen))
        except ValueError:
            bad("proxy_listen", f"{listen!r} is not an IP address (the tailnet or LAN one to bind)")
    out["proxy_listen"] = listen
    base = str(raw.get("base_url", "")).rstrip("/")
    if base:
        parts = urllib.parse.urlsplit(base)
        if (parts.scheme != "https" or not parts.hostname or parts.username or parts.password
                or parts.path or parts.query or parts.fragment):
            bad("base_url", "https://host[:port] with no path, query or credentials — Kandev "
                "refuses any other lease URL")
    out["base_url"] = base
    out["serve"] = raw.get("serve", "proxy")
    if out["serve"] not in KANDEV_SERVE_MODES:
        bad("serve", '"proxy", "tailscale" or "none"')
    groups = raw.get("rule_groups", [])
    known = config.get("rules", {})
    if not isinstance(groups, list) or any(g not in known for g in groups):
        bad("rule_groups", f"a list of rule groups; known: {', '.join(sorted(known))}")
    out["rule_groups"] = [g for g in groups if g != "base"]
    extra = raw.get("allow_extra", [])
    entries = [kandev_allow_entry(p) if isinstance(p, str) else None
               for p in (extra if isinstance(extra, list) else [None])]
    if None in entries:
        bad("allow_extra", 'a list of "*", hostname patterns ("pypi.org", "*.example.com"), '
            'addresses ("192.168.2.6"), address:port ("192.168.2.6:8788", "[fd00::1]:22") '
            'and CIDRs ("192.168.2.0/24")')
    for entry, text in zip(entries, extra, strict=True):
        if entry[0] == "net" and entry[1].prefixlen < KANDEV_CIDR_MIN[entry[1].version]:
            bad("allow_extra", f"{text} is wider than /{KANDEV_CIDR_MIN[entry[1].version]}")
    out["allow_extra"] = extra
    out["allow_extra_entries"] = entries
    names = raw.get("private_names", [])
    if not isinstance(names, list) or any(
            not isinstance(n, str) or not HOSTNAME.fullmatch(n.strip().lower())
            or n.strip().startswith("*.") for n in names):
        bad("private_names", 'a list of exact hostnames ("git.example.com"), no patterns or addresses')
    out["private_names"] = [n.strip().lower() for n in names]
    return out


# The widest CIDR [kandev] allow_extra may name, per IP version, as the
# plugin's own range limits: past this it is "*" by another name.
KANDEV_CIDR_MIN = {4: 8, 6: 32}


def kandev_allow_entry(text):
    """One [kandev] allow_extra entry as (kind, value, port), or None if it is
    not one: ("any", None, None) for "*"; ("host", pattern, None) for a
    hostname or *.suffix, any port; ("net", network, port or None) for an
    address (a /32 or /128), an address:port, or a CIDR (any port). Addresses are tried first: "10.0.0.10"
    also has the shape of a hostname."""
    text = text.strip()
    if text == "*":
        return ("any", None, None)
    body, port = text, None
    found = (re.fullmatch(r"\[([0-9A-Fa-f:.]+)\]:(\d{1,5})", text)
             or re.fullmatch(r"([0-9.]+):(\d{1,5})", text))
    if found:
        body, port = found.group(1), int(found.group(2))
        if not 1 <= port <= 65535:
            return None
    elif text.startswith("[") and text.endswith("]"):
        body = text[1:-1]
    try:
        # strict: "192.168.2.6/24" is a typo for one of two things, not a guess.
        net = ipaddress.ip_network(body, strict=True)
    except ValueError:
        if port is None and HOSTNAME.fullmatch(text.lower()):
            return ("host", text.lower(), None)
        return None
    if port is not None and "/" in body:
        return None                     # a CIDR is any port; a port goes with one address
    return ("net", net, port)


def kandev_target_allowed(target, entries):
    """Whether a request's egress target (host, host:port or host:proto:port,
    already checked by parse_allow_target()) is admitted by allow_extra. A
    hostname pattern matches the host part on any port and never an address;
    an address or CIDR matches an address (or narrower CIDR) inside it, on any
    port, and an address:port only that one port, never a range or `any`."""
    fields = _split_rule_target(target.strip())
    host = fields[0].lower()
    ports = "443" if len(fields) == 1 else fields[-1]
    try:
        net = ipaddress.ip_network(host.strip("[]"), strict=False)
    except ValueError:
        net = None
    for kind, value, port in entries:
        if kind == "any":
            return True
        if kind == "host" and net is None and (
                host == value or (value.startswith("*.") and host.endswith(value[1:]))):
            return True
        if kind == "net" and net is not None and net.version == value.version \
                and net.subnet_of(value) and (port is None or (ports.isdigit() and int(ports) == port)):
            return True
    return False


def kandev_name(env):
    """The msb sandbox name for a Kandev environment id. `k-<env>` when that
    is already a valid, short sandbox name (no lowercasing, so two ids that
    differ only in case cannot meet), else `k-` and 24 hex digits of its hash."""
    name = f"k-{env}"
    if SANDBOX_NAME.fullmatch(name) and len(name) <= KANDEV_NAME_MAX:
        return name
    return "k-" + hashlib.sha256(env.encode()).hexdigest()[:24]


def kandev_check_env(env):
    if not isinstance(env, str) or not KANDEV_ENV.fullmatch(env):
        raise KandevError("invalid_config", "an environment id is 1-128 of A-Z a-z 0-9 _ -")
    return env


def kandev_entries():
    """[(name, entry)] for every Kandev entry, and nothing else."""
    found = []
    for name in registered():
        try:
            entry = read_toml(registry_path_for(name))
        except SystemExit:
            continue
        if entry.get("source") == "kandev":
            found.append((name, entry))
    return found


def kandev_lookup(env):
    """(name, entry) of the Kandev entry for `env`, or None. A file under that
    name that is not Kandev's — an operator sandbox called k-something — is
    reported as absent here, never touched."""
    name = kandev_name(kandev_check_env(env))
    entry = read_toml(registry_path_for(name)) if os.path.exists(registry_path_for(name)) else {}
    if entry.get("source") == "kandev" and entry.get("kandev_env") == env:
        return name, entry
    return None


def kandev_need(env):
    found = kandev_lookup(env)
    if not found:
        raise KandevError("not_found", "no kandev entry for that environment")
    return found


@contextlib.contextmanager
def kandev_lock():
    """Host-wide, for everything that allocates capacity or ports or removes
    what the reaper also removes."""
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(KANDEV_LOCK, "a", encoding="utf-8") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def kandev_set(name, **values):
    """Rewrite single keys of a Kandev entry, atomically: the proxy reads the
    entries while this runs, and a half-written one would close its ports."""
    path = registry_path_for(name)
    tmp = f"{path}.{os.getpid()}.new"
    shutil.copyfile(path, tmp)
    try:
        for key, value in values.items():
            set_toml_key(tmp, key, value)
        os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.remove(tmp)


def host_platform():
    """`linux-amd64` / `linux-arm64`: a guest runs this machine's architecture."""
    machine = os.uname().machine
    arch = {"x86_64": "amd64", "amd64": "amd64", "aarch64": "arm64", "arm64": "arm64"}.get(machine, machine)
    return f"linux-{arch}"


def kandev_ports(entry):
    """{guest port: host port} from the entry's `ports` specs."""
    out = {}
    for spec in entry.get("ports", []):
        _, host, guest, _ = parse_port_spec(spec)[1:]
        out[int(guest)] = int(host)
    return out


def kandev_probe(host_port, timeout=1.0):
    """Whether something answers HTTP on the published port. A bare connect
    proves nothing — msb's host listener accepts whether or not the guest
    does — so it waits for the first byte of a reply."""
    try:
        with socket.create_connection(("127.0.0.1", host_port), timeout=timeout) as sock:
            sock.settimeout(timeout)
            sock.sendall(b"GET / HTTP/1.0\r\nHost: localhost\r\n\r\n")
            return bool(sock.recv(1))
    except OSError:
        return False


def kandev_state(name, entry, table):
    vm = state_of(name, table)
    if entry.get("state") == "creating":
        return "creating"
    if vm == "absent":
        return "absent"
    return "running" if vm == "running" else "stopped"


def kandev_record(name, entry, table=None, live=False):
    """The document provision, start and expiry return, and `kandev` in what
    `ls --json` and `show --json` (agentctl checked live) say of one.
    Names, ports and timestamps only: no value of any kind of secret."""
    table = msb_table() if table is None else table
    state = kandev_state(name, entry, table)
    ports = kandev_ports(entry)
    running = bool(entry.get("agentctl_running", False))
    if live:
        running = state == "running" and KANDEV_GUEST_PORTS[0] in ports \
            and kandev_probe(ports[KANDEV_GUEST_PORTS[0]])
    return {"record": {
        "env": entry.get("kandev_env", ""), "name": name,
        "operation_id": entry.get("operation_id", ""), "input_digest": entry.get("input_digest", ""),
        "state": state, "platform": host_platform(), "image": entry.get("image", ""),
        "created_at": entry.get("created_at", ""), "expires_at": entry.get("expires_at", ""),
        "max_expires_at": entry.get("max_expires_at", ""),
        "generation": int(entry.get("generation", 0)),
        "ports": {str(g): h for g, h in sorted(ports.items())},
        "agentctl": {"running": running, "sha256": entry.get("agentctl_sha256", "")},
    }}


def kandev_usage(table):
    """(sandboxes, cpus, memory MiB) used by Kandev entries that are not absent."""
    count = cpus = mem = 0
    for name, entry in kandev_entries():
        if kandev_state(name, entry, table) == "absent":
            continue
        count += 1
        cpus += int(entry.get("cpus", 0))
        mem += size_bytes(entry.get("memory", "0M")) // MIB
    return count, cpus, mem


def kandev_read_header(allow_empty=False):
    """The one JSON header line on stdin (binary-safe: agentctl's bytes follow)."""
    line = sys.stdin.buffer.readline(KANDEV_HEADER_MAX + 1)
    if not line and allow_empty:
        return {}
    if len(line) > KANDEV_HEADER_MAX or not line.endswith(b"\n"):
        raise KandevError("invalid_config", "stdin must start with one JSON line of at most 64 KiB")
    try:
        header = json.loads(line)
    except ValueError:
        raise KandevError("invalid_config", "the stdin header is not JSON") from None
    if not isinstance(header, dict):
        raise KandevError("invalid_config", "the stdin header is not a JSON object")
    return header


def kandev_name_problem(name):
    if not isinstance(name, str) or not ENV_NAME.fullmatch(name):
        return f"{name!r} is not a variable name (A-Z, 0-9, _)"
    if is_reserved_var(name) or name in KANDEV_RESERVED_NAMES \
            or name.startswith(KANDEV_RESERVED_PREFIXES):
        return f"{name} is reserved"
    return None


def kandev_bound_values(raw, field="secrets"):
    """({name: value}, [(name, [hosts])]) from a request, checked. Two
    structures on purpose: what is written to the entry is built from the
    second alone, which never held a value."""
    if raw is None:
        return {}, []
    if not isinstance(raw, list):
        raise KandevError("invalid_config", f"{field} must be a list")
    values, bindings, seen = {}, [], set()
    for item in raw:
        if not isinstance(item, dict):
            raise KandevError("invalid_config", f"each of {field} is an object")
        name, value, hosts = item.get("name"), item.get("value"), item.get("hosts")
        problem = kandev_name_problem(name)
        if problem:
            raise KandevError("invalid_config", f"secret {problem}")
        if name in seen:
            raise KandevError("invalid_config", f"secret {name} is given twice")
        seen.add(name)
        if not isinstance(value, str) or not value or len(value) > 8192 or "\0" in value:
            raise KandevError("invalid_config", f"secret {name}: a value of 1 to 8192 characters")
        if hosts is not None and (not isinstance(hosts, list) or not hosts or any(
                not isinstance(h, str) or not HOSTNAME.fullmatch(h) for h in hosts)):
            raise KandevError("invalid_config", f"secret {name}: hosts is a list of hostnames")
        values[name] = value
        bindings.append((name, list(hosts or [])))
    return values, bindings


def kandev_registry(raw, image):
    """(registry host, username, password) for a private pull, or None."""
    if raw is None:
        return None
    if not isinstance(raw, dict) or not all(isinstance(raw.get(k), str) and raw.get(k)
                                            for k in ("username", "password")):
        raise KandevError("invalid_config", "registry needs a username and a password")
    if len(raw["password"]) > 8192 or "\n" in raw["username"]:
        raise KandevError("invalid_config", "registry credentials are too long or malformed")
    first = image.split("/", 1)[0]
    if "/" not in image or not ("." in first or ":" in first or first == "localhost"):
        raise KandevError("invalid_config", "a private image must name its registry "
                          "(ghcr.io/…, registry.example.com/…)")
    return first, raw["username"], raw["password"]


def msb_config_file():
    """Where msb reads its own config.json (MSB_CONFIG_PATH, else MSB_HOME)."""
    if os.environ.get("MSB_CONFIG_PATH"):
        return os.environ["MSB_CONFIG_PATH"]
    return os.path.join(os.environ.get("MSB_HOME", os.path.join(HOME, ".microsandbox")), "config.json")


def kandev_pull(image, registry):
    """`msb pull`, with private-registry credentials if there are any.

    msb takes registry credentials from its OS keyring (`msb registry login`,
    which stores them) or from `registries.hosts.<host>.auth` in its config
    file, whose `password_env` names an environment variable. So the password
    goes into the environment of this one `msb pull`, and msb is pointed with
    MSB_CONFIG_PATH at a throwaway copy of its config that adds the username
    and the variable's NAME. Nothing secret is written; the copy is deleted.
    The create that follows uses `--pull never`, so the credential is never
    part of a sandbox's own configuration."""
    env = {}
    tmpdir = None
    try:
        if registry:
            host, user, password = registry
            current = {}
            try:
                with open(msb_config_file(), encoding="utf-8") as fh:
                    current = json.load(fh)
            except (OSError, ValueError):
                current = {}    # no config of the operator's, or none msb could read either
            hosts = current.setdefault("registries", {}).setdefault("hosts", {})
            hosts.setdefault(host, {})["auth"] = {"username": user,
                                                  "password_env": "MSBCTL_REGISTRY_PASSWORD"}
            tmpdir = tempfile.mkdtemp(prefix="msbctl-pull-")
            path = os.path.join(tmpdir, "config.json")
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                json.dump(current, fh)
            env = {"MSB_CONFIG_PATH": path, "MSBCTL_REGISTRY_PASSWORD": password}
        proc = run(["msb", "pull", image], env=env, check=False, quiet=True)
    finally:
        if tmpdir:
            shutil.rmtree(tmpdir, ignore_errors=True)
    if proc.returncode != 0:
        raise KandevError("unavailable", f"msb pull {image} failed")


def kandev_egress(raw, settings):
    """Net rules for a request's `egress_allow`, each allowed by allow_extra."""
    if raw is None:
        return []
    if not isinstance(raw, list) or any(not isinstance(t, str) for t in raw):
        raise KandevError("invalid_config", "egress_allow must be a list of strings")
    rules = []
    for target in raw:
        if "@" in target:
            raise KandevError("invalid_config", f"{target!r}: give a host or host:port, not a rule")
        rule = _kandev_try(parse_allow_target, target)
        if not kandev_target_allowed(target, settings["allow_extra_entries"]):
            raise KandevError("invalid_config", f"{target} is not allowed by [kandev] allow_extra")
        rules.append(rule)
    return rules


def kandev_private_names(raw, settings, egress_allow):
    """A request's `private_names`: hosts that may resolve to a private address,
    each listed in [kandev] private_names and reachable through the request's
    own `egress_allow` (this only lets a name resolve; what it may reach is
    allow_extra's to say). Empty when absent."""
    if raw is None:
        return []
    if not isinstance(raw, list) or any(not isinstance(n, str) for n in raw):
        raise KandevError("invalid_config", "private_names must be a list of hostnames")
    allowed = {_split_rule_target(t.strip())[0].lower() for t in egress_allow or []
               if isinstance(t, str)}
    names = []
    for name in (n.strip().lower() for n in raw):
        if name not in settings["private_names"]:
            raise KandevError("invalid_config", f"{name} is not allowed by [kandev] private_names")
        if name not in allowed:
            raise KandevError("invalid_config", f"private_names: {name} is not in egress_allow")
        if name not in names:
            names.append(name)
    return names


def kandev_private_order(rules, base_count, names):
    """`rules` (net_rules(): `base` first, `base_count` tokens of it) reordered
    for a sandbox whose DNS rebind protection is off: base, then the rules for
    `names`, then every rule that names an address (the Kandev API pin, address
    egress, an operator group's LAN host: none depends on a DNS answer), then
    KANDEV_PRIVATE_DENY, then every other rule. First match wins, so another
    allowed name that answers with a private address is refused at connect.
    Moving an address rule ahead of a hostname rule changes nothing unless the
    two disagree about one connection; no shipped group has a deny that could."""
    base, first, addresses, rest = rules[:base_count], [], [], []
    for token in (t.strip() for rule in rules[base_count:] for t in rule.split(",") if t.strip()):
        target = _split_rule_target(token.partition("@")[2])[0].lower()
        try:
            ipaddress.ip_network(target.strip("[]"), strict=False)
            is_address = True
        except ValueError:
            is_address = False
        (first if target in names else addresses if is_address else rest).append(token)
    return base + first + addresses + [KANDEV_PRIVATE_DENY] + rest


def kandev_api(raw):
    """(host, address, port, rule) for the Kandev API. The host is resolved
    HERE and the rule names that one address, so the guest needs no DNS answer
    for it: a MagicDNS name resolves to 100.x, which msb's DNS rebind protection
    would otherwise drop, and turning that protection off for the whole VM is
    the alternative this avoids. The name goes in the guest's /etc/hosts."""
    if not isinstance(raw, dict) or not isinstance(raw.get("host"), str):
        raise KandevError("invalid_config", "kandev_api needs a host")
    host, port = raw["host"].strip().lower(), raw.get("port", 443)
    if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
        raise KandevError("invalid_config", "kandev_api.port is 1-65535")
    try:
        addr = str(ipaddress.ip_address(host))
    except ValueError:
        if not HOSTNAME.fullmatch(host) or host.startswith("*."):
            raise KandevError("invalid_config", f"kandev_api.host {host!r} is not a hostname") from None
        try:
            infos = socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_STREAM)
        except OSError:
            raise KandevError("unavailable", f"cannot resolve {host} on this host") from None
        addr = infos[0][4][0]
    target = f"[{addr}]" if ":" in addr else addr
    return host, addr, port, f"allow@{target}:tcp:{port}"


def kandev_pin_api(name, entry):
    """Put the Kandev API's name in the guest's /etc/hosts, at the address its
    egress rule names. On every boot: msb writes a fresh /etc/hosts each time
    a sandbox starts, so a line added once is gone after a restart."""
    host, addr = entry.get("kandev_api", ""), entry.get("kandev_api_ip", "")
    if not host or host == addr:
        return
    proc = run(["msb", "exec", name, "--no-tty", "--", "sh", "-c",
                'grep -qs " $2$" /etc/hosts || printf "%s %s\\n" "$1" "$2" >> /etc/hosts',
                "_", addr, host], check=False, quiet=True)
    if proc.returncode != 0:
        raise KandevError("unavailable", "could not write the Kandev API host into the guest")


def registry_host_ports():
    """Every host port a registry entry publishes or proxies, of any source,
    running or not: a stopped sandbox's ports are taken again when it starts."""
    used = set()
    for name in registered():
        try:
            entry = read_toml(registry_path_for(name))
        except SystemExit:
            continue
        for spec in entry.get("ports", []):
            try:
                used.add(int(parse_port_spec(spec)[2]))
            except (SystemExit, ValueError):
                continue
        if entry.get("source") == "kandev":
            used.update(kandev_proxy_ports(entry).values())
    return used


def kandev_alloc_ports(settings):
    """Four free host ports from the pool: not named by any registry entry (any
    source, so the operator's own published ports are avoided too) and free to
    bind right now. Under kandev_lock()."""
    used = registry_host_ports()
    got = []
    low, high = settings["port_pool"]
    for port in range(low, high + 1):
        if port in used:
            continue
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            try:
                sock.bind(("127.0.0.1", port))
            except OSError:
                continue
        got.append(port)
        if len(got) == len(KANDEV_GUEST_PORTS):
            return got
    raise KandevError("rate_limited", "no free host ports left in [kandev] port_pool", 30)


def kandev_proxy_ports(entry):
    """{guest port: public TLS port} from the entry's `proxy_ports` specs."""
    out = {}
    for spec in entry.get("proxy_ports", []):
        found = re.fullmatch(r"(\d{1,5}):(\d{1,5})", str(spec))
        if found:                       # anything else is no one's port
            out[int(found.group(2))] = int(found.group(1))
    return out


def kandev_alloc_proxy_ports(settings):
    """Four public TLS ports from proxy_port_pool: named by no Kandev entry and
    not in use on proxy_listen. Under kandev_lock(). An address that is not up
    yet (tailscale still starting) proves nothing either way, so only "in use"
    rules a port out; the proxy binds it once the address exists."""
    used = registry_host_ports()
    listen = settings["proxy_listen"]
    got = []
    low, high = settings["proxy_port_pool"]
    for port in range(low, high + 1):
        if port in used:
            continue
        if listen:
            family = socket.AF_INET6 if ":" in listen else socket.AF_INET
            with socket.socket(family, socket.SOCK_STREAM) as sock:
                try:
                    sock.bind((listen, port))
                except OSError as exc:
                    if exc.errno == errno.EADDRINUSE:
                        continue
        got.append(port)
        if len(got) == len(KANDEV_GUEST_PORTS):
            return got
    raise KandevError("rate_limited", "no free ports left in [kandev] proxy_port_pool", 30)


def kandev_entry_serve(entry):
    """(mode, strict): how this entry's ports were served when it was made.
    An entry from before msbctl recorded it got the tailscale mappings if
    tailscale was there; removing those is then best effort."""
    if entry.get("serve") in KANDEV_SERVE_MODES:
        return entry["serve"], True
    return ("tailscale" if shutil.which("tailscale") else "none"), False


def kandev_serve(mode, name, ports, on, strict=True):
    """Map (or unmap) each published port under base_url, for serve =
    "tailscale"; the proxy needs nothing here, it reads the entries. A failure
    to remove one is fatal to the destroy: a stale path would later route to
    whichever sandbox gets the same host port."""
    if mode != "tailscale":
        return
    if not shutil.which("tailscale"):
        if strict:
            raise KandevError("unavailable", "tailscale is not on PATH ([kandev] serve)")
        return
    for guest, host in sorted(ports.items()):
        path = f"/vm/{name}/p/{guest}"
        argv = (["tailscale", "serve", "--bg", "--https=443", f"--set-path={path}",
                 f"http://127.0.0.1:{host}"] if on else
                ["tailscale", "serve", "--https=443", f"--set-path={path}", "off"])
        proc = run(argv, check=False, capture=True)
        if proc.returncode != 0 and on:
            raise KandevError("unavailable", f"tailscale serve {path} failed")
        if proc.returncode != 0 and not on and strict \
                and "not found" not in (proc.stderr or "").lower():
            raise KandevError("unavailable", f"tailscale serve {path} off failed")


def kandev_proxy_running():
    """Whether `msbctl host kandev proxy` runs: it holds KANDEV_PROXY_LOCK for life."""
    return kandev_proxy_version() is not None


def kandev_proxy_version():
    """The release the running proxy is (it writes version_string() into the
    lock it holds), "" for one older than 0.6.1, which writes nothing, or
    None when no proxy runs."""
    try:
        fh = open(KANDEV_PROXY_LOCK, encoding="utf-8")
    except OSError:
        return None
    with fh:
        try:
            fcntl.flock(fh, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except OSError:
            return fh.read(200).strip()
        fcntl.flock(fh, fcntl.LOCK_UN)
        return None


def kandev_restart_proxy(installed, wait=10.0):
    """Restart the proxy's service if it runs another release than `installed`,
    so an update reaches it: systemd keeps the old process, and its old code,
    until then. Its open connections are cut; Kandev reconnects, with leases
    that still hold. Returns {"state", "version"}: state is "current",
    "not_running", "restarted" or "failed" (with "reason")."""
    before = kandev_proxy_version()
    if before is None:
        return {"state": "not_running"}
    if before == installed:
        return {"state": "current", "version": before}
    if not shutil.which("systemctl"):
        return {"state": "failed", "version": before, "reason": "no systemctl to restart it with"}
    proc = run(["systemctl", "--user", "try-restart", f"{KANDEV_PROXY_UNIT}.service"],
               check=False, capture=True)
    if proc.returncode:
        return {"state": "failed", "version": before,
                "reason": f"systemctl --user try-restart {KANDEV_PROXY_UNIT}.service failed: "
                f"{(proc.stderr or '').strip()[:200]}"}
    deadline = time.monotonic() + wait
    now = kandev_proxy_version()
    while now != installed and time.monotonic() < deadline:
        time.sleep(0.2)
        now = kandev_proxy_version()
    if now == installed:
        return {"state": "restarted", "version": now}
    return {"state": "failed", "version": now or "",
            "reason": f"after a restart the proxy runs {now or 'nothing'}, not {installed}: on the host, "
            f"`systemctl --user restart {KANDEV_PROXY_UNIT}.service`, or `msbctl host kandev install` "
            "if its unit runs an old path"}


def kandev_serve_ok(settings, tls):
    """health's `serve`. `tls` is (document, problem) from kandev_tls_status()."""
    mode = settings["serve"]
    if mode == "none":
        return {"ok": True, "mode": "none"}
    if mode == "proxy":
        running = kandev_proxy_running()
        reasons = [why for bad, why in (
            (not settings["proxy_listen"], "[kandev] proxy_listen is not set"),
            (not settings["base_url"], "[kandev] base_url is not set"),
            (not tls[0]["installed"], "no certificate yet: the plugin installs one with `kandev tls install`"),
            (tls[0]["installed"] and tls[1], tls[1]),
            (not running, "the proxy is not running (`msbctl host kandev install` sets it up)"),
        ) if bad]
        # The proxy's own release: one behind msbctl_version missed a restart
        # after an update (`kandev restart-proxy`).
        version = kandev_proxy_version() if running else None
        return {"ok": not reasons, "mode": "proxy", "listen": settings["proxy_listen"],
                "running": running, **({"version": version} if version is not None else {}),
                **({"reason": reasons[0]} if reasons else {})}
    if not shutil.which("tailscale"):
        return {"ok": False, "mode": "tailscale", "reason": "tailscale is not on PATH"}
    proc = run(["tailscale", "status", "--json"], check=False, capture=True)
    try:
        status = json.loads(proc.stdout or "{}")
    except ValueError:
        status = {}
    reason = None
    if status.get("BackendState") != "Running" or not (status.get("Self") or {}).get("DNSName"):
        reason = "tailscale is not running with a DNS name"
    elif not status.get("CertDomains"):
        # headscale, for one: a DNS name, but no certificates, so `tailscale
        # serve --https` fails. serve = "proxy" is the way there.
        reason = 'this tailnet issues no certificates (no CertDomains); use serve = "proxy"'
    return {"ok": not reason, "mode": "tailscale", **({"reason": reason} if reason else {})}


# ------------------------------------------------- certificate and tokens
#
# The Kandev plugin is a small certificate authority: it issues each host a
# certificate under a root, name-constrained to the hosts' domain, that only
# the Kandev server trusts. The host never makes a key (the stdlib cannot);
# `kandev tls install` receives the pair on stdin, checks it and stores it, and
# the proxy serves it. What msbctl must read from a certificate (validity,
# names, issuer) it reads with the small DER walker below.

def _der(buf, pos):
    """(tag, content start, content end) of the DER element at `pos`."""
    if pos + 2 > len(buf):
        raise ValueError("truncated")
    tag, length, pos = buf[pos], buf[pos + 1], pos + 2
    if length & 0x80:
        count = length & 0x7F
        if not 1 <= count <= 4 or pos + count > len(buf):
            raise ValueError("bad length")
        length, pos = int.from_bytes(buf[pos:pos + count], "big"), pos + count
    if pos + length > len(buf):
        raise ValueError("truncated")
    return tag, pos, pos + length


def _der_children(buf, start, end):
    """[(tag, start, end, whole start)] of a constructed element's content."""
    out, pos = [], start
    while pos < end:
        tag, s, e = _der(buf, pos)
        out.append((tag, s, e, pos))
        pos = e
    return out


def _der_time(buf, tag, s, e):
    text = buf[s:e].decode("ascii")
    if tag == 0x17:                     # UTCTime, YYMMDDHHMMSSZ
        year = int(text[:2])
        text = f"{19 if year >= 50 else 20}{text}"
    elif tag != 0x18:                   # GeneralizedTime, YYYYMMDDHHMMSSZ
        raise ValueError("not a time")
    return dt.datetime.strptime(text, "%Y%m%d%H%M%SZ").replace(tzinfo=dt.timezone.utc)


OID_SAN = bytes.fromhex("551d11")       # 2.5.29.17 subjectAltName
OID_CN = bytes.fromhex("550403")        # 2.5.4.3 commonName


def cert_info(der):
    """What msbctl needs of one DER certificate: validity, DNS and IP names,
    the common name, and the issuer and subject Names as raw DER."""
    _, s, e = _der(der, 0)
    tbs_tag, ts, te = _der(der, s)
    if tbs_tag != 0x30:
        raise ValueError("not a certificate")
    fields = _der_children(der, ts, te)
    if fields and fields[0][0] == 0xA0:            # [0] version
        fields = fields[1:]
    _serial, _alg, issuer, validity, subject = fields[:5]
    times = _der_children(der, validity[1], validity[2])
    info = {"not_before": _der_time(der, *times[0][:3]), "not_after": _der_time(der, *times[1][:3]),
            "issuer": der[issuer[3]:issuer[2]], "subject": der[subject[3]:subject[2]],
            "dns": [], "ips": [], "cn": ""}
    for rdn in _der_children(der, subject[1], subject[2]):
        for _tag, a, b, _ in _der_children(der, rdn[1], rdn[2]):
            oid, value = _der_children(der, a, b)[:2]
            if der[oid[1]:oid[2]] == OID_CN:
                info["cn"] = der[value[1]:value[2]].decode("utf-8", "replace")
    for tag, a, b, _ in fields[6:]:
        if tag != 0xA3:                             # [3] extensions
            continue
        for ext in _der_children(der, *_der_children(der, a, b)[0][1:3]):
            parts = _der_children(der, ext[1], ext[2])
            if der[parts[0][1]:parts[0][2]] != OID_SAN:
                continue
            value = parts[-1]                       # OCTET STRING holding GeneralNames
            names = _der(der, value[1])
            for ntag, na, nb, _ in _der_children(der, names[1], names[2]):
                if ntag == 0x82:                    # dNSName
                    info["dns"].append(der[na:nb].decode("ascii", "replace").lower())
                elif ntag == 0x87:                  # iPAddress
                    info["ips"].append(str(ipaddress.ip_address(der[na:nb])))
    return info


def pem_certificates(text):
    """The DER of each CERTIFICATE block in `text`, in order."""
    out = []
    for body in re.findall(r"-----BEGIN CERTIFICATE-----(.*?)-----END CERTIFICATE-----", text, re.S):
        out.append(base64.b64decode("".join(body.split()), validate=True))
    return out


def cert_covers(info, host):
    """Whether the leaf names `host`, as a Go client checks it: SANs only."""
    try:
        return str(ipaddress.ip_address(host)) in info["ips"]
    except ValueError:
        pass
    host = host.lower().rstrip(".")
    for name in info["dns"]:
        if name == host or (name.startswith("*.") and "." in host
                            and host.split(".", 1)[1] == name[2:]):
            return True
    return False


def kandev_chain_problem(cert_pem, host, now=None):
    """(None, (leaf info, issuer DER)) or (the problem, None) for a cert.pem."""
    try:
        chain = pem_certificates(cert_pem)
        infos = [cert_info(der) for der in chain]
    except (ValueError, IndexError, UnicodeDecodeError, binascii.Error):
        return "cert_pem is not a PEM certificate chain", None
    if len(chain) < 2:
        return "cert_pem needs the leaf, then the certificate that issued it", None
    leaf = infos[0]
    if leaf["issuer"] != infos[1]["subject"]:
        return "the second certificate did not issue the leaf", None
    now = now or utc_now()
    if not leaf["not_before"] <= now <= leaf["not_after"]:
        return f"the certificate is valid {iso(leaf['not_before'])} to {iso(leaf['not_after'])}, not now", \
            (leaf, chain[1])
    if host and not cert_covers(leaf, host):
        return f"the certificate does not name {host} (subjectAltName)", (leaf, chain[1])
    return None, (leaf, chain[1])


def kandev_tls_status(settings):
    """(health's `tls` document, the problem with it or None)."""
    try:
        with open(KANDEV_TLS_CERT, encoding="utf-8") as fh:
            text = fh.read()
        installed = os.path.exists(KANDEV_TLS_KEY)
    except (OSError, UnicodeDecodeError):
        installed = False
    if not installed:
        return {"installed": False}, "no certificate installed"
    host = urllib.parse.urlsplit(settings["base_url"]).hostname or ""
    problem, found = kandev_chain_problem(text, host)
    if not found:
        return {"installed": True}, problem
    leaf, issuer = found
    return {"installed": True, "subject": (leaf["dns"] or leaf["ips"] or [leaf["cn"]])[0],
            "not_after": iso(leaf["not_after"]),
            "issuer_sha256": hashlib.sha256(issuer).hexdigest()}, problem


def kandev_lease_key(create=True):
    """The 32-byte HMAC key lease tokens are signed with, made on first use.
    Shared by `lease` and the proxy through this file alone. None if absent
    and not `create`."""
    for _ in range(2):
        try:
            with open(KANDEV_LEASE_KEY, "rb") as fh:
                key = fh.read()
        except FileNotFoundError:
            if not create:
                return None
            os.makedirs(os.path.dirname(KANDEV_LEASE_KEY), mode=0o700, exist_ok=True)
            tmp = f"{KANDEV_LEASE_KEY}.{os.getpid()}"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "wb") as fh:
                fh.write(os.urandom(32))
            # A link never replaces one a racer wrote first; theirs is read below.
            with contextlib.suppress(FileExistsError):
                os.link(tmp, KANDEV_LEASE_KEY)
            os.unlink(tmp)
            continue
        if len(key) != 32:
            raise KandevError("unavailable", f"{tilde(KANDEV_LEASE_KEY)} is not 32 bytes")
        return key
    raise KandevError("unavailable", "could not create the lease key")


def kandev_lease_keys(now=None):
    """The keys a token may be signed with: the current one, and the previous
    one for KANDEV_LEASE_VALID after a rotation."""
    keys = [k for k in [kandev_lease_key(create=False)] if k]
    try:
        changed = os.stat(KANDEV_LEASE_KEY_PREV).st_mtime
        if (time.time() if now is None else now) - changed <= KANDEV_LEASE_VALID:
            with open(KANDEV_LEASE_KEY_PREV, "rb") as fh:
                prev = fh.read()
            if len(prev) == 32:
                keys.append(prev)
    except OSError:
        pass                            # no rotation yet: the current key alone
    return keys


def kandev_rotate_lease_key():
    """`host kandev rotate-lease-key`: a new key; the old one becomes .prev,
    accepted for KANDEV_LEASE_VALID from now. A key rotated again within that
    time drops the one before it, so rotate at most every 15 minutes."""
    with kandev_lock():
        if os.path.exists(KANDEV_LEASE_KEY):
            os.replace(KANDEV_LEASE_KEY, KANDEV_LEASE_KEY_PREV)
            os.utime(KANDEV_LEASE_KEY_PREV)     # the change time, not the key's age
        kandev_lease_key(create=True)
    note(f"new lease key; the previous one is accepted for {KANDEV_LEASE_VALID // 60} more minutes")


def kandev_incarnation(entry):
    """What a token is bound to besides name and port: this sandbox as it was
    provisioned. Its created_at, and a random value provision draws, since two
    provisions under one name can share a second. Not the generation: Kandev
    keeps using a lease until it refreshes it, so a token must survive a
    stop and start; only a destroy and a new provision retire it."""
    return f"{entry.get('created_at', '')}|{entry.get('incarnation', '')}"


def kandev_token(key, name, guest, incarnation, valid_until):
    """v1.<valid_until>.<base64url HMAC-SHA256(name|guest port|incarnation|valid_until)>"""
    msg = f"{name}|{int(guest)}|{incarnation}|{int(valid_until)}".encode()
    mac = base64.urlsafe_b64encode(hmac.new(key, msg, hashlib.sha256).digest()).rstrip(b"=")
    return f"v1.{int(valid_until)}.{mac.decode()}"


def kandev_token_ok(keys, token, name, guest, incarnation, now=None):
    """Whether `token` is a lease for this sandbox incarnation and guest port,
    signed with one of `keys`, not past valid_until by more than the allowed
    clock skew."""
    found = re.fullmatch(r"v1\.(\d{1,12})\.[A-Za-z0-9_-]{43}", token or "")
    if not found:
        return False
    valid_until = int(found.group(1))
    if (time.time() if now is None else now) > valid_until + KANDEV_TOKEN_SKEW:
        return False
    return any(hmac.compare_digest(kandev_token(key, name, guest, incarnation, valid_until), token)
               for key in keys)


def kandev_labelled(fmt_json=False):
    """Names (or rows) of every VM carrying the Kandev owner label."""
    argv = ["msb", "ls", "--label", KANDEV_OWNER_LABEL] + (["--format", "json"] if fmt_json else ["-q"])
    proc = run(argv, check=False, capture=True)
    if proc.returncode != 0:
        raise KandevError("unavailable", "msb ls --label failed")
    if fmt_json:
        try:
            return json.loads(proc.stdout or "[]")
        except ValueError:
            raise KandevError("unavailable", "msb ls returned no JSON") from None
    return [n.strip() for n in proc.stdout.splitlines() if n.strip()]


# ------------------------------------------------------------- the verbs

# What health.host reads, as names a test can point elsewhere.
OS_RELEASE = "/etc/os-release"
PROC_MEMINFO = "/proc/meminfo"
PROC_UPTIME = "/proc/uptime"


def kandev_host_facts():
    """health.host: this machine as the operator's host list shows it. Not the
    [kandev] limits (placement reads capacity), and nothing secret. Each field
    is left out when it cannot be read, never guessed."""
    facts = {}

    def text(value):
        return "".join(c for c in value if c.isprintable())[:120]

    with contextlib.suppress(OSError, ValueError):
        with open(OS_RELEASE, encoding="utf-8") as fh:
            for line in fh:
                key, _, value = line.strip().partition("=")
                if key == "PRETTY_NAME":
                    words = shlex.split(value)
                    if words:
                        facts["os"] = text(words[0])
    with contextlib.suppress(OSError):
        facts["kernel"] = text(os.uname().release)
    if os.cpu_count():
        facts["cpus"] = os.cpu_count()
    with contextlib.suppress(OSError, ValueError):
        with open(PROC_MEMINFO, encoding="utf-8") as fh:
            mem = {k: int(v.split()[0]) for k, _, v in (line.partition(":") for line in fh)
                   if k in ("MemTotal", "MemAvailable")}
        for key, field in (("MemTotal", "memory_total_mib"), ("MemAvailable", "memory_available_mib")):
            if key in mem:
                facts[field] = mem[key] // 1024             # kB
    with contextlib.suppress(OSError):
        facts["load_1m"] = round(os.getloadavg()[0], 2)
    # The filesystem msb keeps its sandboxes and their owned disks on; before
    # msb has made its directory, the one it will be made in.
    where = MSB_HOME
    while not os.path.exists(where) and os.path.dirname(where) != where:
        where = os.path.dirname(where)
    with contextlib.suppress(OSError):
        usage = shutil.disk_usage(where)
        facts["disk_total_gib"] = round(usage.total / (1024 * MIB), 2)
        facts["disk_free_gib"] = round(usage.free / (1024 * MIB), 2)
    with contextlib.suppress(OSError, ValueError, IndexError):
        with open(PROC_UPTIME, encoding="utf-8") as fh:
            facts["uptime_seconds"] = int(float(fh.read().split()[0]))
    return facts


def kandev_restart_proxy_verb(args, config, settings):
    """`kandev restart-proxy`: finish an update the old release could not, by
    restarting the proxy if it runs another release than this one. A no-op
    when it is current, so it never cuts connections for nothing."""
    proxy = kandev_restart_proxy(version_string())
    if proxy["state"] == "failed":
        raise KandevError("unavailable", proxy["reason"])
    return {"proxy": proxy}


def kandev_health(args, config, settings):
    table = msb_table()
    count, cpus, mem = kandev_usage(table)
    tls = kandev_tls_status(settings)
    return {
        "protocol": KANDEV_PROTOCOL, "features": list(KANDEV_FEATURES),
        "msbctl_version": version_string(),
        "msb_version": local_msb_version() or "",
        "kvm": os.access("/dev/kvm", os.R_OK | os.W_OK), "enabled": settings["enabled"],
        "platform": host_platform(), "base_url": settings["base_url"],
        "capacity": {"max_sandboxes": settings["max_sandboxes"], "sandboxes": count,
                     "max_cpus": settings["max_cpus"], "cpus": cpus,
                     "max_memory_mib": settings["max_memory_mib"], "memory_mib": mem},
        "serve": kandev_serve_ok(settings, tls),
        "tls": tls[0],
        # The operator's own policy, not a secret: the plugin's Test checks its
        # default egress against it, since one refused entry refuses a whole
        # provision and would make every profile fail on this host.
        "egress": {"allow_extra": list(settings["allow_extra"]),
                   "private_names": list(settings["private_names"])},
        "host": kandev_host_facts(),
    }



def _int_field(req, key, low, high, default=None):
    value = req.get(key, default)
    if not isinstance(value, int) or isinstance(value, bool) or not low <= value <= high:
        raise KandevError("invalid_config", f"{key} is a whole number, {low}-{high}")
    return value


def kandev_provision(args, config, settings):
    env = kandev_check_env(args.env)
    req = kandev_read_header()
    op, digest = req.get("operation_id"), req.get("input_digest")
    if not all(isinstance(v, str) and v and len(v) <= 256 for v in (op, digest)):
        raise KandevError("invalid_config", "operation_id and input_digest are required")
    name = kandev_name(env)

    def existing():
        found = kandev_lookup(env)
        if found:
            if found[1].get("operation_id") == op and found[1].get("input_digest") == digest:
                return kandev_record(*found)
            raise KandevError("conflict", "this environment was provisioned by another operation "
                              "or with different input")
        if os.path.exists(registry_path_for(name)):
            raise KandevError("conflict", f"{name} is a sandbox that is not Kandev's")
        for _other, entry in kandev_entries():
            if entry.get("operation_id") == op:
                raise KandevError("conflict", "that operation_id belongs to another environment")
        return None

    # Idempotency first, before anything is checked or allocated.
    again = existing()
    if again:
        return again

    image = req.get("image")
    if image_problem(image) or "@sha256:" not in str(image):
        raise KandevError("invalid_config", "image must be a digest-pinned OCI reference")
    cpus = _int_field(req, "cpus", 1, 64)
    mem = _int_field(req, "memory_mib", 256, 1024 * 1024)
    disk = _int_field(req, "disk_gib", 1, 4096, 20)
    # Required: a sandbox without it starts agents in a directory that does
    # not exist ("fork/exec <agent>: no such file or directory").
    workspace = _int_field(req, "workspace_gib", 1, KANDEV_WORKSPACE_MAX_GIB)
    expires = parse_iso(req.get("expires_at"), "expires_at")
    if expires <= utc_now():
        raise KandevError("invalid_config", "expires_at is in the past")
    values, bindings = kandev_bound_values(req.get("secrets"))
    if any(not hosts for _, hosts in bindings):
        raise KandevError("invalid_config", "every secret needs the hosts it may be sent to")
    guest_env = req.get("env") or []
    if not isinstance(guest_env, list):
        raise KandevError("invalid_config", "env must be a list")
    env_pairs = []
    for item in guest_env:
        if not isinstance(item, dict) or not isinstance(item.get("value"), str):
            raise KandevError("invalid_config", "each env item is {name, value}")
        problem = kandev_name_problem(item.get("name"))
        if problem or item["name"] in values:
            raise KandevError("invalid_config", f"env {problem or item['name'] + ' is also a secret'}")
        if "\n" in item["value"] or "\0" in item["value"] or len(item["value"]) > 4096:
            raise KandevError("invalid_config", f"env {item['name']}: one line of at most 4096 characters")
        env_pairs.append((item["name"], item["value"]))
    egress = kandev_egress(req.get("egress_allow"), settings)
    private = kandev_private_names(req.get("private_names"), settings, req.get("egress_allow"))
    api_host, api_addr, api_port, api_rule = kandev_api(req.get("kandev_api"))
    registry = kandev_registry(req.get("registry"), image)

    with kandev_lock():
        table = msb_table()
        again = existing()
        if again:
            return again
        count, used_cpus, used_mem = kandev_usage(table)
        if (count + 1 > settings["max_sandboxes"] or used_cpus + cpus > settings["max_cpus"]
                or used_mem + mem > settings["max_memory_mib"]):
            raise KandevError("rate_limited", "this host is at its [kandev] limits", 30)
        host_ports = kandev_alloc_ports(settings)
        ports = [f"127.0.0.1:{h}:{g}" for h, g in zip(host_ports, KANDEV_GUEST_PORTS, strict=True)]
        public = []
        if settings["serve"] == "proxy":
            public = [f"{p}:{g}" for p, g in zip(kandev_alloc_proxy_ports(settings), KANDEV_GUEST_PORTS,
                                                 strict=True)]
        binds = [f"{n}@{','.join(h)}" for n, h in bindings]
        now = utc_now()
        os.makedirs(REGISTRY_DIR, mode=0o700, exist_ok=True)
        # The entry FIRST: a crash between here and the end leaves something
        # `reap` finds, never a VM nobody knows about.
        with open(registry_path_for(name), "w", encoding="utf-8") as fh:
            fh.write(render(
                "registry-kandev.toml.in", NAME=name, DATE=now.date().isoformat(),
                ENV=toml_literal(env), OPERATION=toml_literal(op), DIGEST=toml_literal(digest),
                IMAGE=toml_literal(image), CPUS=cpus, MEMORY=f"{mem}M", DISK=f"{disk}G",
                WORKSPACE=f"{workspace}G",
                CREATED=iso(now), EXPIRES=iso(expires), INCARNATION=os.urandom(8).hex(),
                PORTS=format_list("ports", ports, ""), SERVE=toml_literal(settings["serve"]),
                PROXY_PORTS=f"proxy_ports = {toml_literal(public)}", API=toml_literal(api_host),
                API_IP=toml_literal(api_addr),
                RULE_GROUPS=f"rule_groups = {toml_literal(settings['rule_groups'])}",
                EXTRA_RULES=f"extra_rules = {toml_literal(egress + [api_rule])}",
                BINDINGS=f"secret_binds = {toml_literal(binds)}",
                PRIVATE=f"private_names = {toml_literal(private)}"))

    box = Sandbox(name, config)
    rules = _kandev_try(box.net_rules)
    if private:
        rules = kandev_private_order(rules, len(config.get("rules", {}).get("base", [])), private)
    kandev_pull(image, registry)
    seconds = int((expires - utc_now()).total_seconds()) + 300
    argv = ["msb", "create", "--name", name, "--pull", "never",
            "--cpus", str(cpus), "--memory", f"{mem}M", "--root-disk", f"{disk}G",
            "--net-default-egress", "deny"]
    for rule in rules:
        argv += ["--net-rule", rule]
    # As every msbctl sandbox: hostname rules and secret substitution both
    # need the interceptor. Ports bind 127.0.0.1 only; base_url is the way in.
    argv += ["--tls-intercept"]
    if private:
        # msb has no per-name exemption: off for the VM, and KANDEV_PRIVATE_DENY
        # in the rules above stands in for it for every name but those.
        argv += ["--no-dns-rebind-protection"]
    argv += ["--mount-owned", f"{KANDEV_WORKSPACE}:kind=disk,size={workspace}G"]
    for spec in ports:
        argv += ["--port", spec]
    for key, value in env_pairs:
        argv += ["--env", f"{key}={value}"]
    for spec in binds:
        argv += ["--secret", with_transcript_passthrough(spec)]
    if binds:
        argv += ["--secret-violation-action", "block-and-log"]
    argv += ["--label", KANDEV_OWNER_LABEL, "--label", f"kandev.env={env}",
             "--max-duration", f"{seconds}s", image]
    proc = run(argv, env=values, check=False, quiet=True)
    if proc.returncode != 0:
        raise KandevError("unavailable", "msb create failed — the entry is left for reap or destroy")
    entry = read_toml(registry_path_for(name))
    kandev_pin_api(name, entry)
    kandev_serve(settings["serve"], name, kandev_ports(entry), True)
    kandev_set(name, state="running", generation=1, agentctl_running=False)
    return kandev_record(name, read_toml(registry_path_for(name)))


def kandev_agentctl(args, config, settings):
    name, entry = kandev_need(args.env)
    header = kandev_read_header()
    sha, size = header.get("sha256"), header.get("size")
    if not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{64}", sha):
        raise KandevError("invalid_config", "sha256 is 64 lowercase hex digits")
    if not isinstance(size, int) or isinstance(size, bool) or not 0 < size <= KANDEV_AGENTCTL_MAX:
        raise KandevError("invalid_config", "size is 1 byte to 512 MiB")
    nonce = header.get("nonce")
    if not isinstance(nonce, str) or not nonce or len(nonce) > 4096 or re.search(r"[\0\n\r]", nonce):
        raise KandevError("invalid_config", "nonce is one line")
    ports = kandev_ports(entry)
    runtime = header.get("runtime_port", KANDEV_GUEST_PORTS[0])
    if runtime not in ports:
        raise KandevError("invalid_config", "runtime_port is not one of this sandbox's ports")
    extra_args = header.get("args", [f"-port={runtime}"])
    if not isinstance(extra_args, list) or any(
            not isinstance(a, str) or len(a) > 4096 or "\0" in a for a in extra_args):
        raise KandevError("invalid_config", "args is a list of strings")
    agent_env = header.get("env", {})
    if not isinstance(agent_env, dict) or any(
            not re.fullmatch(r"AGENTCTL_[A-Z0-9_]+", k) or k == "AGENTCTL_BOOTSTRAP_NONCE"
            or not isinstance(v, str) or re.search(r"[\0\n]", v) for k, v in agent_env.items()):
        raise KandevError("invalid_config", "env keys are AGENTCTL_*, values one line")
    # Exactly `size` bytes, then the digest, before anything reaches the guest.
    blob, digest = bytearray(), hashlib.sha256()
    while len(blob) < size:
        chunk = sys.stdin.buffer.read(min(1 << 20, size - len(blob)))
        if not chunk:
            raise KandevError("invalid_config", "stdin ended before `size` bytes")
        blob += chunk
        digest.update(chunk)
    if digest.hexdigest() != sha:
        raise KandevError("invalid_config", "the binary does not match its sha256")
    if state_of(name) != "running":
        raise KandevError("unavailable", "the sandbox is not running")
    if entry.get("agentctl_sha256") == sha and kandev_probe(ports[runtime]):
        kandev_set(name, agentctl_running=True)
        return kandev_record(name, read_toml(registry_path_for(name)))
    parent = GUEST_AGENTCTL.rsplit("/", 1)[0]
    write = subprocess.run(
        ["msb", "exec", name, "--no-tty", "--", "sh", "-c",
         f"mkdir -p {parent} && cat > {GUEST_AGENTCTL}.new && chmod 0755 {GUEST_AGENTCTL}.new "
         f"&& mv -f {GUEST_AGENTCTL}.new {GUEST_AGENTCTL}"],
        input=bytes(blob), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if write.returncode != 0:
        raise KandevError("unavailable", "could not write agentctl into the guest")
    # The nonce is the first line of this exec's stdin and nowhere else; the
    # rest of the environment is not secret. setsid, so agentctl outlives the
    # exec and the ssh session that ran msbctl (spike 16).
    start = ("read -r n; "
             "[ -f /run/agentctl.pid ] && kill \"$(cat /run/agentctl.pid)\" 2>/dev/null; "
             "AGENTCTL_BOOTSTRAP_NONCE=\"$n\" setsid \"$0\" \"$@\" </dev/null "
             ">/var/log/agentctl.log 2>&1 & echo $! > /run/agentctl.pid")
    flags = []
    for key, value in sorted(agent_env.items()):
        flags += ["-e", f"{key}={value}"]
    launch = subprocess.run(["msb", "exec", name, "--no-tty", *flags, "--", "sh", "-c", start,
                             GUEST_AGENTCTL, *extra_args],
                            input=(nonce + "\n").encode(), stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)
    if launch.returncode != 0:
        raise KandevError("unavailable", "could not start agentctl")
    kandev_set(name, agentctl_sha256=sha, agentctl_version=str(header.get("version", ""))[:64],
               agentctl_running=False)
    deadline = time.monotonic() + KANDEV_AGENTCTL_WAIT
    while time.monotonic() < deadline:
        if kandev_probe(ports[runtime]):
            kandev_set(name, agentctl_running=True)
            return kandev_record(name, read_toml(registry_path_for(name)))
        time.sleep(0.5)
    raise KandevError("unavailable", "agentctl did not answer on its control port")


def kandev_start(args, config, settings):
    name, entry = kandev_need(args.env)
    req = kandev_read_header(allow_empty=True)
    if state_of(name) == "running":
        return kandev_record(name, entry)
    if state_of(name) == "absent":
        raise KandevError("not_found", "the sandbox's VM is gone")
    given, _ = kandev_bound_values(req.get("secrets"))
    bound = [secret_var(spec) for spec in entry.get("secret_binds", [])]
    if sorted(given) != sorted(bound):
        # Never a half-bound start: a missing value would reach the guest's
        # requests as the literal placeholder.
        raise KandevError("invalid_config", "start needs exactly the secrets the sandbox binds")
    proc = run(["msb", "start", name], env=given, check=False, quiet=True)
    if proc.returncode != 0:
        raise KandevError("unavailable", "msb start failed")
    kandev_pin_api(name, entry)
    kandev_set(name, state="running", generation=int(entry.get("generation", 0)) + 1,
               agentctl_running=False)
    return kandev_record(name, read_toml(registry_path_for(name)))



def kandev_expiry(args, config, settings):
    name, entry = kandev_need(args.env)
    when = parse_iso(args.at, "--at")
    ceiling = parse_iso(entry.get("max_expires_at"), "max_expires_at")
    kandev_set(name, expires_at=iso(min(when, ceiling)))
    return kandev_record(name, read_toml(registry_path_for(name)))


def kandev_lease(args, config, settings):
    name, entry = kandev_need(args.env)
    try:
        port = int(args.port)
    except (TypeError, ValueError):
        raise KandevError("invalid_config", "lease needs a guest port") from None
    if port not in kandev_ports(entry):
        raise KandevError("not_found", "that port is not one of this sandbox's")
    if not settings["base_url"]:
        raise KandevError("unavailable", "[kandev] base_url is not set")
    if kandev_state(name, entry, msb_table()) != "running":
        raise KandevError("unavailable", "the sandbox is not running")
    expires = utc_now() + dt.timedelta(seconds=KANDEV_LEASE_SECONDS)
    generation = int(entry.get("generation", 0))
    if kandev_entry_serve(entry)[0] != "proxy":
        return {"lease": {"base_url": f"{settings['base_url']}/vm/{name}/p/{port}",
                          "expires_at": iso(expires), "generation": str(generation)}}
    # Through the proxy: its own port per guest port, so no path, and a token
    # it checks before a byte reaches the guest. This output is now
    # secret-bearing: the plugin treats it so, and nothing here logs it.
    public = kandev_proxy_ports(entry).get(port)
    if not public:
        raise KandevError("unavailable", "this sandbox has no proxy port for that guest port")
    if not settings["proxy_listen"] or not os.path.exists(KANDEV_TLS_CERT):
        raise KandevError("unavailable", "the proxy has no proxy_listen or no certificate yet")
    host = urllib.parse.urlsplit(settings["base_url"]).hostname
    host = f"[{host}]" if ":" in host else host
    # Reported to expire at `expires`, accepted until valid_until: Kandev asks
    # for a new lease only 30 s before expires_at, whatever answers it gets.
    valid_until = int(expires.timestamp()) + KANDEV_LEASE_VALID - KANDEV_LEASE_SECONDS
    token = kandev_token(kandev_lease_key(), name, port, kandev_incarnation(entry), valid_until)
    return {"lease": {"base_url": f"https://{host}:{public}", "expires_at": iso(expires),
                      "generation": str(generation),
                      "headers": {KANDEV_LEASE_HEADER: token}}}


def kandev_remove(name, entry, labelled):
    """Serve mappings, then the VM, then the entry: each step only once the one
    before it worked, so a failure leaves the entry for a retry or the reaper.
    A VM under this name that does not carry the Kandev label is not Kandev's
    and is never removed."""
    mode, strict = kandev_entry_serve(entry)
    kandev_serve(mode, name, kandev_ports(entry), False, strict=strict)
    if state_of(name) != "absent":
        if name not in labelled:
            raise KandevError("conflict", f"{name} exists without the Kandev label — left alone")
        if run(["msb", "rm", "-f", name], check=False, quiet=True).returncode != 0:
            raise KandevError("unavailable", "msb rm failed — the entry is kept for a retry")
    os.remove(registry_path_for(name))


def kandev_reap(args, config, settings):
    """One pass: expiry, stuck creates, gone VMs, orphans. Exits; the systemd
    timer from `host kandev install` runs it every minute."""
    out = {"destroyed": [], "marked_absent": [], "orphans_removed": [], "errors": []}
    with kandev_lock():
        table = msb_table()
        rows = kandev_labelled(fmt_json=True)
        labelled = {r.get("name") for r in rows}
        now = utc_now()
        for name, entry in kandev_entries():
            try:
                state = kandev_state(name, entry, table)
                expired = parse_iso(entry.get("expires_at"), "expires_at") <= now
                stuck = state == "creating" and (
                    now - parse_iso(entry.get("created_at"), "created_at")).total_seconds() > KANDEV_STUCK_CREATE
                if expired or stuck:
                    kandev_remove(name, entry, labelled)
                    out["destroyed"].append(name)
                elif state == "absent" and entry.get("state") != "absent":
                    kandev_set(name, state="absent", agentctl_running=False)
                    out["marked_absent"].append(name)
            except KandevError:
                out["errors"].append(name)
        # Listed before this pass removed anything: what it just destroyed is
        # not an orphan.
        known = set(registered()) | set(out["destroyed"])
        for row in rows:
            name = row.get("name")
            if not name or name in known:
                continue
            try:
                created = re.sub(r"\.\d+", "", str(row.get("created_at", "")))
                age = (now - parse_iso(created, "created_at")).total_seconds()
            except KandevError:
                continue
            if age > KANDEV_ORPHAN_AGE:
                if run(["msb", "rm", "-f", name], check=False, quiet=True).returncode == 0:
                    out["orphans_removed"].append(name)
                else:
                    out["errors"].append(name)
    return out


def kandev_tls(args, config, settings):
    """`kandev tls install`: the proxy's certificate and key, from stdin.
    Checked whole before either file changes: the key matches the leaf, the
    leaf is valid now and names base_url's host, its issuer follows it. The
    key crosses ssh once, on stdin, and is never printed."""
    if args.env != "install":
        raise KandevError("invalid_config", "kandev tls: the only action is `install`")
    req = kandev_read_header()
    cert_pem, key_pem = req.get("cert_pem"), req.get("key_pem")
    if not all(isinstance(v, str) and v for v in (cert_pem, key_pem)):
        raise KandevError("invalid_config", "cert_pem and key_pem are required")
    if "PRIVATE KEY-----" not in key_pem or "ENCRYPTED" in key_pem:
        raise KandevError("invalid_config", "key_pem is not an unencrypted PEM private key")
    host = urllib.parse.urlsplit(settings["base_url"]).hostname
    if not host:
        raise KandevError("invalid_config", "set [kandev] base_url first: the certificate must name its host")
    problem, _ = kandev_chain_problem(cert_pem, host)
    if problem:
        raise KandevError("invalid_config", problem)
    os.makedirs(KANDEV_TLS_DIR, mode=0o700, exist_ok=True)
    temps = {}
    try:
        for path, text, mode in ((KANDEV_TLS_KEY, key_pem, 0o600), (KANDEV_TLS_CERT, cert_pem, 0o644)):
            temps[path] = f"{path}.{os.getpid()}.new"
            fd = os.open(temps[path], os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.write(text)
        try:
            # A password callback, so an encrypted key fails rather than asks.
            ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER).load_cert_chain(
                temps[KANDEV_TLS_CERT], temps[KANDEV_TLS_KEY], password=lambda: b"")
        except ssl.SSLError:
            raise KandevError("invalid_config", "key_pem does not match the leaf certificate") from None
        # The key first: the proxy reloads on a change, and a load that fails
        # halfway keeps the pair it had.
        for path in (KANDEV_TLS_KEY, KANDEV_TLS_CERT):
            os.replace(temps.pop(path), path)
    finally:
        for tmp in temps.values():
            with contextlib.suppress(OSError):
                os.remove(tmp)
    return {"tls": kandev_tls_status(settings)[0]}


# ------------------------------------------------------------- the proxy
#
# `msbctl host kandev proxy`, the long-running half of serve = "proxy" (a systemd
# user service from `host kandev install`). One TLS listener per published
# guest port, on proxy_listen:<public port>; a connection is spliced to that
# port's 127.0.0.1:<host port> once its first request head carries, in one
# X-Msb-Lease header, a lease token for this sandbox incarnation and guest
# port. Every byte is forwarded as it came, Authorization (Kandev's token for
# agentctl) included. One port per lease means a pooled connection can only
# ever reach one VM port, so there is no HTTP parsing past that first head and
# no path routing: WebSockets and streaming need nothing special. The kandev
# entries are the only source of truth; the proxy rescans them every
# KANDEV_PROXY_SCAN seconds and re-reads the one entry on each connection, so
# a destroyed sandbox refuses at once, and a token minted before a stop and
# start still works, while one from before a destroy and re-provision does not.
#
# Logged: the sandbox, the guest port and the outcome. Never a token, a
# request head or a byte of what passes through.

class _ProxyListener:
    def __init__(self, sock, name, guest):
        self.sock, self.name, self.guest = sock, name, guest
        self.port = sock.getsockname()[1]
        self.closed = False
        self.conns = set()
        self.lock = threading.Lock()

    def close(self):
        """Stop accepting and cut every connection it handed on."""
        self.closed = True
        self.sock.close()
        with self.lock:
            for conn in list(self.conns):
                with contextlib.suppress(OSError):
                    conn.shutdown(socket.SHUT_RDWR)


def kandev_proxy_log(message):
    print(f"msbctl host kandev proxy: {message}", file=sys.stderr, flush=True)


def kandev_proxy_wanted():
    """({(address, public port): (name, guest port)}, why it is empty or None)."""
    settings = kandev_settings(load_config())
    if not settings["enabled"]:
        return {}, "[kandev] enabled is false"
    if settings["serve"] != "proxy":
        return {}, f'[kandev] serve is "{settings["serve"]}"'
    if not settings["proxy_listen"]:
        return {}, "[kandev] proxy_listen is not set"
    want = {}
    for name, entry in kandev_entries():
        if kandev_entry_serve(entry)[0] == "proxy":
            for guest, public in kandev_proxy_ports(entry).items():
                want[(settings["proxy_listen"], public)] = (name, guest)
    return want, None


def kandev_tls_context():
    """A server context with the installed pair, or None."""
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    # HTTP/1.1 only: an h2 connection would carry many requests in frames the
    # head check below cannot read.
    ctx.set_alpn_protocols(["http/1.1"])
    try:
        ctx.load_cert_chain(KANDEV_TLS_CERT, KANDEV_TLS_KEY, password=lambda: b"")
    except (OSError, ssl.SSLError):
        return None
    return ctx


def _read_head(tls):
    """The bytes read until the end of the first request head, or None."""
    buf, deadline = b"", time.monotonic() + KANDEV_HEAD_WAIT
    while b"\r\n\r\n" not in buf[:KANDEV_HEAD_MAX + 4]:
        left = deadline - time.monotonic()
        if left <= 0 or len(buf) > KANDEV_HEAD_MAX:
            return None
        tls.settimeout(left)
        chunk = tls.recv(KANDEV_HEAD_MAX)
        if not chunk:
            return None
        buf += chunk
    return buf


def _lease_token(head):
    """The value of the one X-Msb-Lease header in a request head, or None.
    Authorization is not looked at: it is Kandev's token for agentctl, and
    passes to the guest untouched with everything else."""
    found = []
    want = KANDEV_LEASE_HEADER.lower().encode()
    for line in head.split(b"\r\n\r\n", 1)[0].split(b"\r\n")[1:]:
        key, _, value = line.partition(b":")
        if key.strip().lower() == want:
            found.append(value.strip())
    if len(found) != 1:
        return None
    return found[0].decode("ascii", "replace")


def _splice(listener, tls, backend):
    """Both directions until the backend closes or the listener goes. The
    client's EOF half-closes toward the guest; the guest's ends it all."""
    tls.settimeout(120)
    backend.settimeout(120)
    client_open = True
    while not listener.closed:
        if client_open and tls.pending():
            ready = [tls]
        else:
            ready = select.select([tls, backend] if client_open else [backend], [], [], 5)[0]
        for sock in ready:
            data = sock.recv(65536)
            if sock is tls:
                if data:
                    backend.sendall(data)
                else:
                    client_open = False
                    backend.shutdown(socket.SHUT_WR)
            elif data:
                tls.sendall(data)
            else:
                return


def kandev_proxy_conn(raw, listener, ctx, slots):
    """One connection: handshake, the head's token, then the splice."""
    outcome, tls, backend = "closed", None, None
    try:
        raw.settimeout(KANDEV_HEAD_WAIT)
        try:
            tls = ctx.wrap_socket(raw, server_side=True)
        except (OSError, ssl.SSLError):
            outcome = "tls handshake failed"
            return
        with listener.lock:
            listener.conns.add(tls)
        head = _read_head(tls)
        if head is None:
            outcome = "no request head"
            return
        path = registry_path_for(listener.name)
        try:
            entry = read_toml(path) if os.path.exists(path) else {}
        except SystemExit:
            entry = {}
        ok = (entry.get("source") == "kandev"
              and kandev_proxy_ports(entry).get(listener.guest) == listener.port
              and kandev_token_ok(kandev_lease_keys(), _lease_token(head), listener.name,
                                  listener.guest, kandev_incarnation(entry)))
        if not ok:
            outcome = "unauthorized"
            tls.sendall(KANDEV_UNAUTHORIZED)
            return
        try:
            backend = socket.create_connection(("127.0.0.1", kandev_ports(entry)[listener.guest]), timeout=10)
        except (OSError, KeyError):
            outcome = "guest port unreachable"
            tls.sendall(KANDEV_BAD_GATEWAY)
            return
        with listener.lock:
            listener.conns.add(backend)
        backend.sendall(head)
        outcome = "forwarded"
        _splice(listener, tls, backend)
    except (OSError, ssl.SSLError, KandevError):
        # A peer gone, reset or timed out: the connection is simply over.
        # `outcome` already says how far it got; `finally` logs and closes.
        pass
    finally:
        for sock in (tls, backend, raw):
            if sock is not None:
                with listener.lock:
                    listener.conns.discard(sock)
                with contextlib.suppress(OSError):
                    sock.close()
        slots.release()
        kandev_proxy_log(f"{listener.name} {listener.guest} {outcome}")


def kandev_proxy(stop=None):
    """The accept loop. Runs until killed (or `stop`, an Event, for tests)."""
    os.makedirs(os.path.dirname(KANDEV_PROXY_LOCK), mode=0o700, exist_ok=True)
    lock = open(KANDEV_PROXY_LOCK, "a", encoding="utf-8")    # held for the proxy's life
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("another `msbctl host kandev proxy` is already running on this host")
    # Who holds it: how health and an update tell this release from the next.
    lock.truncate(0)
    lock.write(version_string() + "\n")
    lock.flush()
    sel = selectors.DefaultSelector()
    listeners, slots = {}, threading.BoundedSemaphore(KANDEV_PROXY_MAX_CONNS)
    ctx, stamp, said, next_scan = None, None, "", 0.0
    try:
        while not (stop and stop.is_set()):
            if time.monotonic() >= next_scan:
                next_scan = time.monotonic() + KANDEV_PROXY_SCAN
                try:
                    want, why = kandev_proxy_wanted()
                except (KandevError, SystemExit) as exc:
                    # A config being edited: keep what is open, say so once.
                    want, why = {k: (v.name, v.guest) for k, v in listeners.items()}, \
                        f"config: {getattr(exc, 'message', exc)}"
                try:
                    now = tuple(os.stat(p).st_mtime_ns for p in (KANDEV_TLS_CERT, KANDEV_TLS_KEY))
                except OSError:
                    now = None
                if now != stamp:
                    fresh = kandev_tls_context() if now else None
                    if fresh or not now:
                        ctx, stamp = fresh, now
                        kandev_proxy_log("certificate loaded" if ctx else "no certificate")
                if ctx is None:
                    want, why = {}, why or "no certificate (`kandev tls install`)"
                if why != said:
                    kandev_proxy_log(f"listening on nothing: {why}" if why else "serving")
                    said = why
                for key in [k for k, v in listeners.items() if want.get(k) != (v.name, v.guest)]:
                    sel.unregister(listeners[key].sock)
                    listeners.pop(key).close()
                for key, (name, guest) in want.items():
                    if key in listeners:
                        continue
                    family = socket.AF_INET6 if ":" in key[0] else socket.AF_INET
                    sock = socket.socket(family, socket.SOCK_STREAM)
                    try:
                        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                        sock.bind(key)
                        sock.listen(64)
                    except OSError as exc:
                        sock.close()
                        kandev_proxy_log(f"{name} {guest} cannot listen on port {key[1]}: {exc.strerror}")
                        continue
                    sock.setblocking(False)
                    listeners[key] = _ProxyListener(sock, name, guest)
                    sel.register(sock, selectors.EVENT_READ, listeners[key])
            for key, _ in sel.select(timeout=0.5):
                listener = key.data
                try:
                    raw, _peer = listener.sock.accept()
                except OSError:
                    continue
                if not slots.acquire(blocking=False):
                    raw.close()
                    continue
                raw.setblocking(True)
                threading.Thread(target=kandev_proxy_conn, args=(raw, listener, ctx, slots),
                                 daemon=True).start()
    finally:
        for listener in listeners.values():
            listener.close()
        sel.close()
        lock.close()


# Only what needs Kandev's own input or knowledge. The rest is generic:
# `ls --json` lists, `show NAME --json` inspects, `stop NAME --json` stops and
# `purge NAME -y --json` destroys; under the Kandev key they see only Kandev's
# sandboxes. The reaper and the proxy are the host's: `host kandev reap|proxy`.
KANDEV_VERBS = {
    "health": kandev_health, "provision": kandev_provision, "agentctl": kandev_agentctl,
    "start": kandev_start, "expiry": kandev_expiry, "lease": kandev_lease, "tls": kandev_tls,
    "restart-proxy": kandev_restart_proxy_verb,
}
# The verbs that name an environment.
KANDEV_ENV_VERBS = ("provision", "agentctl", "start", "expiry", "lease")


def json_document(body):
    """Run body() and print what it returns as the one JSON document on stdout,
    then exit 0; on failure, exit 3 with {"error": {"code", "message"}}, the
    code one of Kandev's (KANDEV_ERROR_CODES). Everything else printed
    meanwhile goes to stderr. The contract of every `kandev` verb and of
    `ls`, `show`, `stop`, `purge` and `self-update` with --json."""
    code, data = 0, None
    with contextlib.redirect_stdout(sys.stderr):
        try:
            data = body()
        except KandevError as exc:
            code, data = KANDEV_EXIT_ERROR, {"error": {"code": exc.code, "message": exc.message}}
            if exc.retry_after is not None:
                data["error"]["retry_after_seconds"] = int(exc.retry_after)
        except SystemExit as exc:
            if exc.code:
                kind = "not_found" if isinstance(exc, NoSuchSandbox) else "unavailable"
                code = KANDEV_EXIT_ERROR
                data = {"error": {"code": kind,
                                  "message": str(exc.code).replace("msbctl: ", "", 1)[:300]}}
        except Exception:                       # the contract is JSON, always
            traceback.print_exc()
            code, data = KANDEV_EXIT_ERROR, {"error": {"code": "unavailable",
                                                       "message": "internal error (see stderr)"}}
    print_json(data if data is not None else {})
    sys.exit(code)


JSON_VERBS = (cmd_ls, cmd_show, cmd_stop, cmd_purge, cmd_self_update)


def json_verb(args, config):
    """`ls`, `show`, `stop`, `purge` or `self-update` with --json: one
    document for all the names given, built from what each call returns."""
    if kandev_key() and not kandev_settings(config)["enabled"]:
        raise KandevError("denied", "Kandev is not enabled on this host ([kandev] enabled)")
    if args.func is cmd_purge and not args.yes:
        die("purge --json needs -y: there is no one to ask")
    if not hasattr(args, "names"):
        kandev_guard(args)
        return args.func(args, config)
    results = []
    for name in args.names:
        if split_remote(name):
            die(f"{name}: --json answers for this machine's sandboxes only")
        args.name = name
        kandev_guard(args)
        results.append(args.func(args, config))
    if args.func is cmd_purge:
        return {"purged": [r["name"] for r in results if r["purged"]],
                "absent": [r["name"] for r in results if not r["purged"]]}
    return {"sandboxes": results}


def cmd_kandev(args, config):
    """`msbctl kandev <verb>`: one JSON document on stdout (json_document())."""
    def body():
        settings = kandev_settings(config)
        if args.verb != "health" and not settings["enabled"]:
            raise KandevError("denied", "Kandev is not enabled on this host ([kandev] enabled)")
        if args.verb in KANDEV_ENV_VERBS and not args.env:
            raise KandevError("invalid_config", f"kandev {args.verb} needs an environment id")
        return KANDEV_VERBS[args.verb](args, config, settings)
    json_document(body)


def kandev_guard(args):
    """Keep operator verbs and Kandev's sandboxes apart, both ways.

    The operator may look at one, shell into it while it runs, and stop or
    purge it at the host itself; never from the laptop's restricted key.
    Starting one would boot it without its secrets, which exist only in
    Kandev's requests, and everything else would change what Kandev owns.

    Under the Kandev key, `show` and `stop` see only Kandev's sandboxes: any
    other name is not found. (`purge` makes the same check itself, since a
    name with nothing under it is a success there.)"""
    names = [getattr(args, "name", None)] + list(getattr(args, "names", None) or [])
    for name in names:
        if not name or split_remote(name) or not SANDBOX_NAME.fullmatch(str(name)):
            continue
        path = registry_path_for(name)
        entry = read_toml(path) if os.path.exists(path) else {}
        if kandev_key():
            if args.func in (cmd_show, cmd_stop) and entry.get("source") != "kandev":
                raise NoSuchSandbox(name)
            continue
        if entry.get("source") != "kandev":
            continue
        if args.func in (cmd_ls, cmd_status, cmd_show, cmd_shell, cmd_exec, cmd_kandev, cmd_host):
            continue
        if args.func in (cmd_stop, cmd_purge) and not restricted():
            continue
        die(f"{name} is a Kandev sandbox: Kandev owns it. You can ls, show, and shell or exec "
            f"into it while it runs, and stop or purge it on this host itself.")


# `host kandev configure` flag → [kandev] key.
KANDEV_CONFIGURE_KEYS = (("enabled", "enabled"), ("serve", "serve"), ("proxy_listen", "proxy_listen"),
                         ("base_url", "base_url"), ("allow_extra", "allow_extra"),
                         ("private_names", "private_names"))


def kandev_configure(args):
    """`host kandev configure`: set the [kandev] keys given, in place in
    config.toml (its comments and every other table kept), and only if the
    result passes kandev_settings(), the check every verb makes at load. A
    refused value leaves the file as it was. Run from the host or an admin
    login (a bootstrap), never from either restricted key: the plugin's key
    deciding its own egress is what allow_extra exists to prevent."""
    changes = [(key, getattr(args, attr)) for attr, key in KANDEV_CONFIGURE_KEYS
               if getattr(args, attr) is not None]
    changes = [(k, [e for e in v if e.strip()] if k in ("allow_extra", "private_names") else v)
               for k, v in changes]
    ensure_local_config()
    target = os.path.realpath(CONFIG_FILE)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".config-", suffix=".toml")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out, open(target, encoding="utf-8") as src:
            out.write(src.read())
        shutil.copymode(target, tmp)
        changed = [key for key, value in changes if set_toml_key(tmp, key, value, table="kandev")]
        settings = kandev_settings(merge_config(read_toml(DEFAULTS_FILE), read_toml(tmp)))
        if changed:
            os.replace(tmp, target)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
    effective = {k: v for k, v in settings.items() if k != "allow_extra_entries"}
    for key in ("port_pool", "proxy_port_pool"):
        effective[key] = "%d-%d" % effective[key]
    return {"changed": changed, "kandev": effective}


def host_kandev(args, config):
    """`host kandev install|reap|proxy`. What runs on the host for Kandev and
    is never the plugin's to call: `reap`, one pass of the reaper (a JSON
    summary), `proxy`, the TLS proxy (long-running), and `install`, which runs
    the first every minute from a systemd user timer and the second as a user
    service. The proxy listens on nothing unless serve = "proxy"."""
    if args.arg == "reap":
        json_document(lambda: kandev_reap(args, config, kandev_settings(config)))
    if args.arg == "proxy":
        with contextlib.suppress(KeyboardInterrupt):       # ^C in a terminal: just stop
            kandev_proxy()
        return
    if args.arg == "rotate-lease-key":
        kandev_rotate_lease_key()
        return
    if args.arg == "configure":
        if args.json:
            json_document(lambda: kandev_configure(args))
        try:
            done = kandev_configure(args)
        except KandevError as exc:
            die(f"{exc.message}; {tilde(CONFIG_FILE)} is unchanged")
        note(f"[kandev] in {tilde(CONFIG_FILE)}: " +
             (f"set {', '.join(done['changed'])}" if done["changed"] else "nothing to change"))
        return
    if args.arg != "install":
        die("host kandev: install, reap, proxy, rotate-lease-key or configure")
    me = shutil.which("msbctl") or os.path.realpath(__file__)
    os.makedirs(SYSTEMD_USER_DIR, exist_ok=True)
    path_env = f"{os.path.join(HOME, '.local', 'bin')}:/usr/local/bin:/usr/bin:/bin"
    service = os.path.join(SYSTEMD_USER_DIR, f"{KANDEV_REAP_UNIT}.service")
    timer = os.path.join(SYSTEMD_USER_DIR, f"{KANDEV_REAP_UNIT}.timer")
    with open(service, "w", encoding="utf-8") as fh:
        fh.write(f"""# Written by `msbctl host kandev install`. One pass of the Kandev reaper:
# destroys Kandev sandboxes past their expiry, cleans up stuck creates and
# orphans. Run by {KANDEV_REAP_UNIT}.timer; it exits after each pass.
[Unit]
Description=msb-manager: reap expired Kandev sandboxes

[Service]
Type=oneshot
Environment=PATH={path_env}
ExecStart={me} host kandev reap
""")
    with open(timer, "w", encoding="utf-8") as fh:
        fh.write("""# Written by `msbctl host kandev install`.
[Unit]
Description=msb-manager: reap expired Kandev sandboxes every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=60s

[Install]
WantedBy=timers.target
""")
    proxy = os.path.join(SYSTEMD_USER_DIR, f"{KANDEV_PROXY_UNIT}.service")
    with open(proxy, "w", encoding="utf-8") as fh:
        fh.write(f"""# Written by `msbctl host kandev install`. The TLS proxy for Kandev's
# sandboxes ([kandev] serve = "proxy"): one listener per published port on
# proxy_listen, each connection checked for a lease token. It reads the kandev
# entries and the certificate itself, so it never needs a restart for them.
[Unit]
Description=msb-manager: TLS proxy for Kandev's sandboxes

[Service]
Type=simple
Environment=PATH={path_env}
ExecStart={me} host kandev proxy
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
""")
    note(f"wrote {tilde(service)}, {tilde(timer)} and {tilde(proxy)}")
    if shutil.which("systemctl"):
        run(["systemctl", "--user", "daemon-reload"], check=False)
        run(["systemctl", "--user", "enable", "--now", f"{KANDEV_REAP_UNIT}.timer"], check=False)
        # restart, not just --now: an upgrade must run the new code.
        run(["systemctl", "--user", "enable", f"{KANDEV_PROXY_UNIT}.service"], check=False)
        run(["systemctl", "--user", "restart", f"{KANDEV_PROXY_UNIT}.service"], check=False)
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or "<user>"
    if not os.path.exists(f"/var/lib/systemd/linger/{user}"):
        note("a user timer runs with nobody logged in only with lingering on; once, as root:")
        note(f"  loginctl enable-linger {user}")


# ----------------------------------------------------------- remotes (laptop)
#
# A remote is an ssh destination running msb-manager (see `msbctl host`).
# `host:name` addresses a sandbox there: the command line is sent as it was
# typed, that one token made the bare name, over ssh to the host's msbctl,
# with stdio passed straight through. Nothing else is involved: no daemon, no
# protocol, no port. ssh authenticates and encrypts; the host's `host serve`
# decides what the key may run. Local is not special: it is simply the host
# this command runs on.

REMOTE_NAME = re.compile(r"([a-z0-9][a-z0-9-]*):([a-z0-9][a-z0-9-]*|\.)")
REMOTE_DEST = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*@[A-Za-z0-9_][A-Za-z0-9.:_-]*|[A-Za-z0-9_][A-Za-z0-9._:-]*")
REMOTES_DIR = os.path.join(STATE_DIR, "remotes")
REMOTE_LS_TIMEOUT = 15
# How long an unreachable host is left alone before `ls` tries it again. The
# picker reloads the list after every action, and a host that is down would
# otherwise cost the full connect timeout on each one; `ls --refresh` tries now.
REMOTE_RETRY_AFTER = 60


def configured_remotes(config=None):
    """{name: {"ssh": dest}} from config.toml's [remotes.<name>] tables."""
    if config is None:
        try:
            config = load_config()
        except SystemExit:
            return {}
    return {k: v for k, v in (config.get("remotes") or {}).items() if isinstance(v, dict)}


def remote_dest(name, config):
    remote = configured_remotes(config).get(name)
    if not remote or not remote.get("ssh"):
        die(f"unknown remote {name!r} — `msbctl remote ls`")
    dest = str(remote["ssh"])
    if not REMOTE_DEST.fullmatch(dest):
        die(f"remote {name}: ssh = {dest!r} is not user@host or host (fix config.toml)")
    return dest


REMOTE_PROGRAM = re.compile(r"msbctl|/[A-Za-z0-9._/-]+/msbctl")


def remote_program(name, config):
    """What to run on a remote as msbctl. Plain `msbctl` unless `remote setup`
    found it off the PATH an ssh command gets (both installers use
    ~/.local/bin, which a non-interactive shell often lacks) and recorded the
    absolute path. A restricted key ignores it: `host serve` runs itself."""
    program = str((configured_remotes(config).get(name) or {}).get("msbctl") or "msbctl")
    if not REMOTE_PROGRAM.fullmatch(program):
        die(f"remote {name}: msbctl = {program!r} is not `msbctl` or an absolute path to it")
    return program


def ssh_argv(dest, tty, batch=False):
    """ssh to `dest`, sharing one connection per host for ten minutes, ending
    in `--`: the remote command follows as ONE argument (shlex.join), since ssh
    joins the rest with spaces for the far side's shell."""
    os.makedirs(os.path.join(STATE_DIR, "ssh"), mode=0o700, exist_ok=True)
    return ["ssh", "-o", "ControlMaster=auto",
            "-o", f"ControlPath={os.path.join(STATE_DIR, 'ssh', '%C')}",
            "-o", "ControlPersist=600", "-o", "ServerAliveInterval=30",
            "-t" if tty else "-T",
            *(["-o", "BatchMode=yes", "-o", "ConnectTimeout=5"] if batch else []),
            dest, "--"]


def wants_tty():
    """A pty only when both ends are a terminal: `exec` from a pipe (an ACP
    client) must be a clean byte stream, and -t would mangle it."""
    return sys.stdin.isatty() and sys.stdout.isatty()


def split_remote(name):
    """(remote, bare name) for `host:name`, or None for a local name."""
    match = REMOTE_NAME.fullmatch(name or "")
    if not match:
        return None
    if match.group(2) == ".":
        die(f"{name}: `.` means this machine's current folder, which names nothing on "
            f"{match.group(1)} — give the sandbox's name")
    return match.group(1), match.group(2)


def remote_names(args):
    """The names in `args` that are host:name, if any; [] if all are local."""
    names = [args.name] if getattr(args, "name", None) else list(getattr(args, "names", None) or [])
    return [n for n in names if REMOTE_NAME.fullmatch(n or "")]


def _remote_command(raw_argv, token, bare):
    """The original command line, `token` (host:name) replaced by `bare`. It
    occurs once, as the name; anything after it (an exec's command) is left as
    typed, including a later string that happens to look the same."""
    out = list(raw_argv)
    out[out.index(token)] = bare
    return out


def exec_remote(args, config, raw_argv):
    """Replace this process with ssh running the command on the remote; its exit
    status is the remote's (ssh's own failures are 255)."""
    token = args.name
    remote, bare = split_remote(token)
    dest = remote_dest(remote, config)
    argv = ssh_argv(dest, wants_tty()) + [shlex.join([remote_program(remote, config),
                                                      *_remote_command(raw_argv, token, bare)])]
    sys.stdout.flush()
    os.execvp("ssh", argv)


def run_remote_verb(args, config, raw_argv, token):
    """One host:name of a multi-name verb (start a:x b c:y): the verb, this name
    right after it, and the flags as typed; the other names left out."""
    remote, bare = split_remote(token)
    dest = remote_dest(remote, config)
    names = set(args.raw_names)
    verb_at = next(i for i, a in enumerate(raw_argv) if not a.startswith("-"))
    rest = [a for a in raw_argv[verb_at + 1:] if a not in names]
    command = [remote_program(remote, config), raw_argv[verb_at], bare, *rest]
    proc = subprocess.run(ssh_argv(dest, wants_tty()) + [shlex.join(command)])
    if proc.returncode:
        die(f"{token}: exit {proc.returncode} on {remote}")


def add_remote_forward(args, config, raw_argv):
    """add --remote HOST …: the rest of the arguments, run there."""
    dest = remote_dest(args.remote, config)
    rest, skip = [], False
    for a in raw_argv:
        if skip:
            skip = False
            continue
        if a == "--remote":
            skip = True
            continue
        if a.startswith("--remote="):
            continue
        rest.append(a)
    sys.stdout.flush()
    os.execvp("ssh", ssh_argv(dest, wants_tty()) + [shlex.join([remote_program(args.remote, config), *rest])])


def _remote_cache_path(name):
    return os.path.join(REMOTES_DIR, f"{name}.json")


def _short_reason(proc, remote=None):
    text = (proc.stderr or "").strip().splitlines()
    if proc.returncode == 127 and remote:
        return f"msbctl not found there — `msbctl remote setup {remote}`"
    return (text[-1] if text else f"ssh exit {proc.returncode}")[:80]


def query_remote_ls(name, dest, refresh, program="msbctl"):
    """(rows, problem, stale_age) for one remote: its `ls --json` sandboxes, why
    it could not answer (or None), and how old the rows are if they came from
    the cache. A host that failed less than REMOTE_RETRY_AFTER ago is not tried
    again, unless `refresh`."""
    cache = read_json(_remote_cache_path(name))
    now = time.time()
    if not refresh and cache.get("failed_at", 0) > now - REMOTE_RETRY_AFTER:
        problem = cache.get("reason", "unreachable")
    else:
        command = [program, "ls", "--json"] + (["--refresh"] if refresh else [])
        try:
            proc = subprocess.run(ssh_argv(dest, tty=False, batch=True) + [shlex.join(command)],
                                  capture_output=True, text=True, timeout=REMOTE_LS_TIMEOUT,
                                  stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            proc = None
        problem = None
        if proc is None:
            problem = f"no answer in {REMOTE_LS_TIMEOUT}s"
        elif proc.returncode == 255:            # ssh's own failure
            problem = f"unreachable: {_short_reason(proc)}"
        else:
            try:
                data = json.loads(proc.stdout)
                rows = data["sandboxes"]
            except (ValueError, KeyError, TypeError):
                # An older msbctl answers --json with its usage text, which is
                # not a parse error worth reporting as one.
                old = "usage:" in (proc.stderr or "") + (proc.stdout or "")
                problem = ("host msbctl too old (needs `ls --json`)" if old
                           else f"error: {_short_reason(proc, name)}")
            else:
                write_json(_remote_cache_path(name), {"at": now, "sandboxes": rows,
                                                      "msbctl": data.get("msbctl", "")})
                return rows, None, None
        cache["failed_at"], cache["reason"] = now, problem
        write_json(_remote_cache_path(name), cache)
    if cache.get("sandboxes") is not None:
        return cache["sandboxes"], problem, now - cache.get("at", now)
    return [], problem, None


def _age(seconds):
    for unit, step in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= step:
            return f"{int(seconds // step)}{unit}"
    return f"{int(seconds)}s"


def remote_ls_rows(args, config):
    """[(host, row dict or None, note)] for every configured remote, queried in
    parallel. A row None is the one line an unreachable remote gets."""
    import concurrent.futures
    remotes = configured_remotes(config)
    out = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, min(8, len(remotes)))) as pool:
        futures = {name: pool.submit(query_remote_ls, name, remote_dest(name, config), args.refresh,
                                     remote_program(name, config))
                   for name in sorted(remotes)}
        for name, fut in futures.items():
            rows, problem, stale = fut.result()
            if problem:
                out.append((name, None, problem + (f" (rows below are {_age(stale)} old)"
                                                   if stale is not None and rows else "")))
            for row in rows:
                out.append((name, row, f"stale {_age(stale)}" if stale is not None else ""))
    return out


def remote_key_candidates():
    """Public keys the laptop could authorize on a host: the agent's, then ~/.ssh/*.pub."""
    out = []
    proc = subprocess.run(["ssh-add", "-L"], capture_output=True, text=True)
    for line in proc.stdout.splitlines() if proc.returncode == 0 else []:
        if _parse_pub_line(line):
            out.append(("agent", line.strip()))
    try:
        for f in sorted(os.listdir(SSH_DIR)):
            if f.endswith(".pub"):
                with open(os.path.join(SSH_DIR, f), encoding="utf-8") as fh:
                    line = fh.read().strip()
                if _parse_pub_line(line) and all(line.split()[1] != l.split()[1] for _, l in out):
                    out.append((f"~/.ssh/{f}", line))
    except OSError:
        pass  # no ~/.ssh: nothing to list
    return out


def remote_test(name, config, batch=True):
    """Run the host's `host check --json` and say what matters from here."""
    dest = remote_dest(name, config)
    # Not batch: ssh may need to ask about the host key, on the terminal.
    proc = subprocess.run(ssh_argv(dest, tty=False, batch=batch)
                          + [shlex.join([remote_program(name, config), "host", "check", "--json"])],
                          capture_output=True, text=True,
                          stdin=subprocess.DEVNULL if batch else None)
    try:
        data = json.loads(proc.stdout)
    except ValueError:
        reason = _short_reason(proc, name) if proc.returncode else "not JSON (host msbctl too old?)"
        write_json(os.path.join(REMOTES_DIR, f"{name}.test.json"),
                   {"at": time.time(), "ok": False, "summary": reason})
        die(f"{name} ({dest}): {reason}")
    say(f"{name}  {dest}")
    for c in data.get("checks", []):
        mark = {True: "ok  ", False: "WARN", None: "info"}[c.get("ok")]
        note(f"{mark}  {c.get('check', '?'):<16} {c.get('detail', '')}")
    problems = []
    if not data.get("restricted"):
        problems.append("this key is not restricted")
        warn("this key can get a shell on the host: run `msbctl host authorize \"<this key>\"` "
             "there and remove its unrestricted line")
    theirs = str(data.get("msbctl", "")).split()[0]
    mine = version_string().split()[0]
    if theirs.split("+")[0] != mine.split("+")[0]:
        problems.append(f"msbctl {theirs} there, {mine} here")
        warn(f"the host runs msbctl {theirs}, this machine {mine}")
    write_json(os.path.join(REMOTES_DIR, f"{name}.test.json"),
               {"at": time.time(), "ok": not problems, "summary": "; ".join(problems) or "ok"})


RELEASES = "https://github.com/runoverlabs/sandbox-manager/releases"
MSB_RELEASES = "https://github.com/microsandbox/microsandbox/releases"
MSB_INSTALLER = f"{MSB_RELEASES}/latest/download/install.sh"
# microsandbox's installer always installs the LATEST release: it asks the
# GitHub API and has no version option, even in the copy attached to an older
# release. So for one version, that release's own install.sh is fetched and its
# single call to get_latest_version replaced by the version; its download and
# checksum steps run unchanged. If that line is not there exactly once the
# installer has changed shape, and nothing runs. $1 the releases URL, $2 the
# version (checked against MSB_VERSION first).
MSB_PINNED_INSTALL = r"""set -e
t="$(mktemp -d)"; trap 'rm -rf "$t"' EXIT
curl -fsSL "$1/download/v$2/install.sh" -o "$t/install.sh"
[ "$(grep -c '^    get_latest_version$' "$t/install.sh")" = 1 ] || {
	echo "msb's installer has changed shape; install msb $2 there by hand" >&2; exit 1; }
sed 's/^    get_latest_version$/    VERSION="v'"$2"'"/' "$t/install.sh" > "$t/pinned.sh"
sh "$t/pinned.sh"
"""
MSB_VERSION = re.compile(r"\d+\.\d+\.\d+")


def local_msb_version():
    """This machine's msb version (`0.7.6`), or None without one."""
    if not shutil.which("msb"):
        return None
    proc = subprocess.run(["msb", "--version"], capture_output=True, text=True)
    match = MSB_VERSION.search(proc.stdout or "")
    return match.group(0) if match else None

# What `remote setup` needs to know about a host, as key=value lines, run by
# remote_sh().
REMOTE_PROBE = r"""u="$(id -un)"
printf 'path=%s\n' "$(command -v msbctl)"
printf 'bare=%s\n' "$(PATH="$o"; command -v msbctl)"
printf 'user=%s\n' "$u"
printf 'msb=%s\n' "$(msb --version 2>/dev/null | head -n1)"
printf 'msbctl=%s\n' "$(msbctl --version 2>/dev/null | head -n1)"
printf 'kvm=%s\n' "$(if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then echo rw; elif [ -e /dev/kvm ]; then echo denied; else echo missing; fi)"
printf 'curl=%s\n' "$(command -v curl)"
printf 'linger=%s\n' "$(if [ -e "/var/lib/systemd/linger/$u" ]; then echo yes; else echo no; fi)"
printf 'unit=%s\n' "$(if [ -e "$HOME/.config/systemd/user/msb-autostart.service" ]; then echo yes; else echo no; fi)"
printf 'sudo=%s\n' "$(if sudo -n true 2>/dev/null; then echo yes; else echo no; fi)"
"""


def remote_sh(dest, script, *args, tty=False, batch=False, capture=False, stdin=None):
    """Run a sh script on `dest` with ~/.local/bin on PATH: for setting a host
    up, through a key that still has a shell. `sh -c` whatever the login shell
    is; ~/.local/bin because both installers put their commands there and a
    non-login ssh session often does not look. Under `host serve` this is
    refused (exit 126), which is how a key already restricted shows."""
    command = shlex.join(["sh", "-c", 'o="$PATH"; PATH="$HOME/.local/bin:$PATH"; ' + script, "sh", *args])
    return subprocess.run(ssh_argv(dest, tty=tty, batch=batch) + [command],
                          capture_output=capture, text=True,
                          stdin=subprocess.DEVNULL if batch and stdin is None else None,
                          input=stdin)


def ssh_close(dest):
    """End the shared connection to `dest`. One opened through a key that had
    a shell would otherwise keep that shell for ten minutes after the key has
    been restricted."""
    subprocess.run(ssh_argv(dest, tty=False)[:-2] + ["-O", "exit", dest],
                   capture_output=True, text=True)


def remote_probe(dest, batch=False):
    """{key: value} from REMOTE_PROBE, or None if this key already runs
    `host serve` there (it refuses a shell script, exit 126). Dies when ssh
    itself fails."""
    proc = remote_sh(dest, REMOTE_PROBE, batch=batch, capture=True)
    if proc.returncode == 126 and "host serve" in (proc.stderr or ""):
        return None
    if proc.returncode:
        die(f"{dest}: {_short_reason(proc)}")
    return dict(line.split("=", 1) for line in proc.stdout.splitlines() if "=" in line)


def own_release():
    """The release a host should run to match this machine. From a checkout,
    the release its VERSION names: VERSION moves only when one is cut, so it
    is the release the checkout started from."""
    return version_string().split()[0].split("+")[0]


def record_remote_program(name, probe):
    """Remember where msbctl is on the host if an ssh command's PATH does not
    find it there; forget it if it does."""
    program = probe.get("path") if probe.get("path") and not probe.get("bare") else "msbctl"
    if not REMOTE_PROGRAM.fullmatch(program):
        warn(f"msbctl on {name} is at {program!r}, which msbctl cannot use as a path")
        return
    current = (configured_remotes(load_config()).get(name) or {}).get("msbctl", "msbctl")
    if program != current:
        set_toml_key(CONFIG_FILE, "msbctl", program, table=f"remotes.{name}")
        if program != "msbctl":
            note(f"msbctl is not on the PATH an ssh command gets on {name}: using {program}")


def remote_setup(name, config):
    """Bring a remote to a working host, asking before each change: msb,
    msbctl at this machine's version, /dev/kvm, autostart, and last this
    machine's key restricted to `host serve`. Then `remote test`."""
    dest = remote_dest(name, config)
    say(f"Setting up {name}  ({dest})")
    # Not batch mode: an unknown host key has to be accepted at the prompt.
    probe = remote_probe(dest)
    if probe is None:
        note("this machine's key already runs `msbctl host serve` there, so the host is")
        note("set up; anything more is done on the host itself, or with an admin key")
        record_remote_program(name, {"bare": "msbctl"})     # host serve finds itself
        remote_test(name, load_config())
        return
    note(f"{'user':<9} {probe.get('user', '?')}")
    note(f"{'msb':<9} {probe.get('msb') or 'not installed'}")
    note(f"{'msbctl':<9} {probe.get('msbctl') or 'not installed'}")
    note(f"{'/dev/kvm':<9} {dict(rw='usable', denied='no access for this user', missing='missing').get(probe.get('kvm'), '?')}")
    if probe.get("kvm") == "missing":
        die(f"{name} has no /dev/kvm: msb cannot run sandboxes there (no KVM, or a VM "
            "without nested virtualization)")

    wanted = own_release()
    if not probe.get("curl") and (not probe.get("msb") or not probe.get("msbctl")):
        die(f"{name} has no curl, which both installers need — install it there first")
    # The same msb as here: a sandbox's behaviour is msb's, and what works
    # here should work there. Without msb here, the latest release.
    want = local_msb_version()
    match = MSB_VERSION.search(probe.get("msb") or "")
    there = match.group(0) if match else ""
    if not there or (want and there != want):
        note("")
        if there:
            warn(f"msb {there} on {name}, {want} here")
            note("installing over it replaces it for every sandbox already there; one")
            note("created by another msb version may not start under this one")
        question = (f"install msb {want or '(the latest release)'} on {name}?" if not there
                    else f"replace msb {there} on {name} with {want}?")
        if confirm(question):
            script = (MSB_PINNED_INSTALL if want
                      else f"curl -fsSL {shlex.quote(MSB_INSTALLER)} | sh")
            args = (MSB_RELEASES, want) if want else ()
            if remote_sh(dest, script, *args, tty=wants_tty()).returncode:
                die(f"installing msb on {name} failed (above)")
    theirs = (probe.get("msbctl") or "").split()[1:2]
    theirs = theirs[0] if theirs else ""
    mine = version_string().split()[0]
    installed = bool(theirs)
    if not theirs or theirs.split("+")[0] != mine.split("+")[0]:
        note("")
        if not theirs:
            note("msbctl is what this machine talks to there: without it, msb alone")
            note("cannot be driven from here, and nothing after this step can be set up")
        if "git checkout" in probe.get("msbctl", ""):
            warn(f"{name} runs msbctl from a git checkout ({theirs}): update it there with git pull")
        else:
            release = f"v{wanted}" + (" (the release this checkout started from)" if IS_CHECKOUT else "")
            question = (f"install msbctl {release} on {name}?" if not theirs
                        else f"msbctl {theirs} there, {mine} here — install msbctl {release} on {name}?")
            if confirm(question):
                get = f"{RELEASES}/download/v{wanted}/get.sh"
                script = f"curl -fsSL {shlex.quote(get)} | sh -s -- --version v{wanted}"
                if remote_sh(dest, script, tty=wants_tty()).returncode:
                    die(f"installing msbctl on {name} failed (above)")
                installed = True
    if not installed:
        # Autostart, the key's forced command and the test are all msbctl's.
        note("")
        note(f"without msbctl on {name} there is nothing more to set up; "
             f"`msbctl remote setup {name}` asks again")
        return
    # Where it is now, installed or not: for every command from here on.
    record_remote_program(name, remote_probe(dest) or {"bare": "msbctl"})
    if probe.get("kvm") == "denied":
        note("")
        user = probe.get("user", "")
        warn(f"{user} cannot open /dev/kvm on {name}: it is usually the kvm group")
        if probe.get("sudo") == "yes" and confirm(f"add {user} to the kvm group there (sudo)?"):
            remote_sh(dest, 'sudo -n usermod -aG kvm "$1"', user)
            # A group applies from the next login, so drop the shared connection.
            ssh_close(dest)
        else:
            note(f"on {name}, as root:  usermod -aG kvm {user}")

    if probe.get("unit") != "yes" or probe.get("linger") != "yes":
        note("")
        note("autostart: the sandboxes marked autostart start when the host boots, with")
        note("nobody logged in (a systemd user unit, and lingering for the user)")
        if confirm(f"set up autostart on {name}?"):
            remote_sh(dest, "msbctl host autostart install", tty=wants_tty())
            if probe.get("linger") != "yes":
                if probe.get("sudo") == "yes":
                    remote_sh(dest, 'sudo -n loginctl enable-linger "$1"', probe.get("user", ""))
                else:
                    note(f"lingering needs root, once, on {name}:  loginctl enable-linger {probe.get('user', '')}")

    remote_share_settings(name, dest, load_config())
    remote_restrict_key(name, dest)
    say(f"Testing {name}")
    remote_test(name, load_config())


def remote_share_settings(name, dest, config):
    """Offer to copy this machine's git identities and Claude tokens to the
    host, so its sandboxes can commit and log in. Before the key is restricted:
    `host serve` lets a Claude token through and nothing else here."""
    idents = {k: v for k, v in (config.get("identities") or {}).items()
              if isinstance(v, dict) and v.get("name") and v.get("email")}
    tokens = claude_tokens()
    if not idents and not tokens:
        return
    say(f"Settings for {name}'s sandboxes")
    note("A sandbox there commits as an identity and logs Claude in with a token, both")
    note(f"taken from {name}'s own settings, which start empty. Copy yours over?")
    note("Over ssh, the token on stdin: never in a command line or a file on the way.")

    def failed(proc, what):
        if proc.returncode and "unrecognized arguments" in (proc.stderr or ""):
            warn(f"msbctl on {name} is too old to take {what} this way: "
                 f"`ssh -t {dest} msbctl setup` sets them by hand")
            return True
        if proc.returncode:
            warn(f"{what} on {name}: {_short_reason(proc)}")
            return True
        return False

    if idents:
        default = config.get("defaults", {}).get("identity", "")
        labels = {f"{k:<12} {v['name']} <{v['email']}>"
                  + ("  (default)" if k == default else ""): k for k, v in sorted(idents.items())}
        chosen = toggle_list("git identities to copy", list(labels), list(labels))
        if any(idents[labels[c]].get("signing_key") for c in chosen):
            note("(signing keys stay here: a sandbox there gets no ssh-agent to sign with)")
        for label in chosen:
            key = labels[label]
            proc = remote_sh(dest, 'msbctl setup "$@"', "--identity", key,
                             "--git-name", idents[key]["name"], "--git-email", idents[key]["email"],
                             *(["--default"] if key == default else []), capture=True)
            if failed(proc, "identities"):
                break
            note(f"copied identity {key}")
    if tokens:
        default = default_claude_token(config)
        labels = {f"{k}" + ("  (default)" if k == default else ""): k for k in tokens}
        preselect = [lab for lab, k in labels.items() if k == default]
        chosen = toggle_list("Claude tokens to send", list(labels), preselect)
        for label in chosen:
            key = labels[label]
            make_default = ["--default"] if key == default else []
            proc = remote_sh(dest, 'msbctl setup "$@"', "--claude-token", key, "--stdin",
                             *make_default, capture=True, stdin=tokens[key] + "\n")
            if make_default and proc.returncode and "unrecognized arguments" in (proc.stderr or ""):
                # 0.3.0 takes the token but not --default.
                proc = remote_sh(dest, 'msbctl setup "$@"', "--claude-token", key, "--stdin",
                                 capture=True, stdin=tokens[key] + "\n")
                if not proc.returncode and key != CLAUDE_TOKEN_MAIN:
                    warn(f"msbctl on {name} is too old to make {key!r} its default: a sandbox "
                         f"there uses it only if named (`claude_token = \"{key}\"`)")
            if failed(proc, "Claude tokens"):
                break
            note(f"sent Claude token {key}")


def remote_restrict_key(name, dest):
    """Offer to give this machine's key the forced command on the host. If the
    key is the one this connection logs in with, that ends its shell there."""
    say("This machine's key on the host")
    note("Restricted, a key runs `msbctl host serve`: msbctl verbs from its allowlist,")
    note("no shell, nothing that reads a stored secret or approves a changed policy.")
    note("That is what keeps an agent running on this machine from doing more there.")
    cands = remote_key_candidates()
    if not cands:
        note("no public key found in the ssh-agent or ~/.ssh — skipped")
        return
    skip = "not now (the key keeps its shell; `msbctl remote setup` asks again)"
    labels = [f"{where:<22} {line.split()[0]} …{line.split()[1][-12:]} {' '.join(line.split()[2:])}"
              for where, line in cands]
    # The default is to skip: the agent's first key is as likely to be the
    # one an operator keeps a shell with as the everyday one.
    choice = choose_one("restrict which key", labels + [skip], len(labels))
    if choice == skip:
        return
    line = cands[labels.index(choice)][1]
    blob = line.split()[1]
    proc = remote_sh(dest, 'grep -F -- "$1" "$HOME/.ssh/authorized_keys"', blob, capture=True)
    current = (proc.stdout or "").strip()
    if "host serve" in current and "\n" not in current:
        note("already restricted there")
        return
    replace = bool(current)
    if replace:
        warn(f"this key logs in to {name} with a shell now; restricted, it no longer will.")
        warn("Keep another way in first: a password, the console, or an admin key")
        warn("(`ssh-keygen -t ed25519-sk`, then `msbctl host authorize '<its .pub line>' --admin` on the host).")
        if not confirm("restrict it anyway?"):
            return
    # The key line before the flag: before Python 3.12, argparse settles the
    # optional KEY positional as soon as it sees `authorize`, and a key after
    # --replace is then an unrecognized argument.
    proc = remote_sh(dest, 'msbctl host authorize "$@"', line, *(["--replace"] if replace else []))
    if proc.returncode:
        die(f"authorizing the key on {name} failed (above)")
    # The forced command finds msbctl itself, and an older one there accepts
    # nothing but the bare name.
    record_remote_program(name, {"bare": "msbctl"})
    # The shared connection still has the old key's shell: close it, so the
    # next command logs in again and gets the forced command.
    ssh_close(dest)


def cmd_remote(args, config):
    """remote add|setup|ls|test|rm — the ssh destinations this machine drives."""
    if args.action == "ls":
        remotes = configured_remotes(config)
        if not remotes:
            note("no remotes — `msbctl remote add NAME user@host`")
            return
        for name in sorted(remotes):
            note(f"{name:<16} {remotes[name].get('ssh', '?'):<32} {remote_last_test(name)}")
        return
    name = args.name or die(f"remote {args.action} needs a NAME")
    if not SANDBOX_NAME.fullmatch(name):
        die(f"{name!r}: a remote's name is lowercase letters, digits and dashes")
    if args.action == "add":
        dest = args.dest or die("remote add NAME DEST: DEST is user@host")
        if not REMOTE_DEST.fullmatch(dest):
            die(f"{dest!r} is not user@host or host")
        if name in configured_remotes(config):
            die(f"{name} is already a remote (`msbctl remote rm {name}` first)")
        ensure_local_config()
        set_toml_key(CONFIG_FILE, "ssh", dest, table=f"remotes.{name}")
        note(f"remotes.{name} = {dest}  ({tilde(CONFIG_FILE)})")
        if sys.stdin.isatty() and sys.stdout.isatty():
            # At a terminal, do the host's half from here too, asking first.
            try:
                remote_setup(name, load_config())
            except SystemExit as exc:
                warn(str(exc.code).replace("msbctl: ", "", 1))
                note(f"registered anyway; `msbctl remote setup {name}` tries again")
            return
        say("On the host, authorize this machine's everyday key")
        note("It gets a forced command there: msbctl verbs from host serve's allowlist,")
        note("no shell, and nothing that can read a stored secret or approve a policy.")
        cands = remote_key_candidates()
        for where, line in cands:
            parts = line.split()
            note(f"  {where:<22} {parts[0]} …{parts[1][-12:]} {' '.join(parts[2:])}")
        line = cands[0][1] if cands else "ssh-ed25519 AAAA... you@this-machine"
        note("")
        note(f"  msbctl host authorize \"{line}\"")
        note("")
        note("For policy changes from here, use a SEPARATE key the agent does not hold —")
        note("a FIDO2 one: `ssh-keygen -t ed25519-sk`, then on the host `msbctl host authorize '<its .pub line>' --admin`.")
        say(f"Testing {name}")
        # Not batch mode, this once: an unknown host key has to be accepted at
        # a prompt, and BatchMode fails on it with a message that does not say so.
        try:
            remote_test(name, load_config(), batch=False)
        except SystemExit as exc:
            warn(str(exc.code).replace("msbctl: ", "", 1))
            note(f"once the key is authorized there: `msbctl remote test {name}`")
    elif args.action == "setup":
        remote_setup(name, config)
    elif args.action == "test":
        remote_test(name, config)
    elif args.action == "rm":
        if not remove_toml_table(CONFIG_FILE, f"remotes.{name}"):
            die(f"no remote {name!r}")
        for f in (f"{name}.json", f"{name}.test.json"):
            try:
                os.unlink(os.path.join(REMOTES_DIR, f))
            except FileNotFoundError:
                pass  # never queried
        note(f"{name} removed from {tilde(CONFIG_FILE)}; the host itself is untouched")


def remote_last_test(name):
    test = read_json(os.path.join(REMOTES_DIR, f"{name}.test.json"))
    if not test.get("at"):
        return "not tested"
    return f"{'ok' if test.get('ok') else test.get('summary', '?')}, {_age(time.time() - test['at'])} ago"


def remotes_menu(config):
    """The main menu's "remote hosts": add one, set one up or test it, remove
    it. Each action is the `msbctl remote` verb of the same name."""
    while True:
        remotes = configured_remotes(config)
        say("Remote hosts")
        note("Machines that run sandboxes for this one, over ssh. A sandbox there is")
        note("HOST:name for every msbctl verb, and `msbctl ls` lists them all.")
        add, back = "add a remote host", "back"
        rows = {f"{n:<14} {remotes[n].get('ssh', '?'):<28} {remote_last_test(n)}": n
                for n in sorted(remotes)}
        choice = choose_one("remote hosts", list(rows) + [add, back], 0 if rows else len(rows))
        if choice == back:
            return
        try:
            if choice == add:
                dest = ask("ssh destination (user@host, or a Host from ~/.ssh/config)")
                if not dest:
                    continue
                host = dest.split("@")[-1].split(".")[0].lower()
                name = ask("call it", re.sub(r"[^a-z0-9-]+", "-", host).strip("-") or "remote")
                cmd_remote(verb_args("remote", action="add", name=name, dest=dest), config)
            else:
                name = rows[choice]
                setup, test, rm = "set up / check", "test the connection", "remove"
                action = choose_one(name, [setup, test, rm, back], 0)
                if action == setup:
                    remote_setup(name, config)
                elif action == test:
                    remote_test(name, config)
                elif action == rm and confirm(f"forget {name}? (the host itself is untouched)"):
                    cmd_remote(verb_args("remote", action="rm", name=name), config)
        except SystemExit as exc:
            if exc.code:
                warn(str(exc.code).replace("msbctl: ", "", 1))
        config = load_config()


