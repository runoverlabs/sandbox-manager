def capture_token(name):
    """Read a PAT straight to the sandbox's 0600 env file. Never echoed, never in
    argv. Sets ONLY GH_TOKEN: the file also holds this sandbox's other secrets, and
    an earlier version truncated it and lost them."""
    path = os.path.join(SECRETS_DIR, f"{name}.env")
    token = read_secret_hidden("paste the token")
    if not token or any(c.isspace() for c in token):
        note("skipped — the sandbox will have no GitHub API access.")
        note(f"Add it later: msbctl edit {name}  ->  GitHub token")
        return False
    set_env_file_value(path, "GH_TOKEN", token)
    note(f"stored in {tilde(path)} (0600)")
    return True


# ------------------------------------------------------------- a remote host
#
# A remote host is an ordinary install, driven over ssh: `ssh host msbctl ...`.
# The laptop is the adversary in this design (code run as the operator there:
# an agent outside any sandbox, a compromised dependency), so the key it uses
# every day must not be able to READ a stored secret or RE-AIM one at a host of
# its choosing — and a plain shell does both (`cat secrets/global.env`). So
# that key gets a forced command, `msbctl host serve`, which runs msbctl verbs
# only, from an allowlist that looks at the arguments too, and with
# MSB_RESTRICTED=1 so nothing it runs approves a policy change by prompting:
# behind a pty, code on the laptop can answer a prompt as easily as you can.
# Policy changes are made on the host itself, or with a second key the laptop's
# agent does not hold (a FIDO2 `sk-` key). `msbctl host authorize` writes both
# kinds of authorized_keys line. Hardening, not a permission system: the table
# below is the whole of it, and is meant to be read in one sitting.

HOST_EXIT_REFUSED = 126

# What `msb exec` accepts (msb 0.7.7, crates/cli/lib/commands/exec.rs). Every
# one acts inside the guest. Anything else is refused until it has been read:
# a future msb flag must not pass unreviewed.
MSB_EXEC_VALUE_FLAGS = ("-e", "--env", "-w", "--workdir", "-u", "--user", "--timeout", "--rlimit")
MSB_EXEC_BARE_FLAGS = ("-t", "--tty", "--no-tty", "--no-stdin", "-q", "--quiet", "--stream")


def _msb_flags_problem(flags):
    i = 0
    while i < len(flags):
        flag = flags[i]
        name = flag.split("=", 1)[0] if flag.startswith("--") else flag
        if name in MSB_EXEC_BARE_FLAGS and "=" not in flag:
            i += 1
        elif name in MSB_EXEC_VALUE_FLAGS:
            if "=" not in flag:
                if i + 1 >= len(flags):
                    return f"{flag} needs a value"
                i += 1
            i += 1
        else:
            return f"msb exec flag {flag!r} is not one host serve passes on"
    return None


def restricted_problem(argv):
    """None if `msbctl <argv>` may run under `host serve`, else the reason.
    Each refusal says what it would let a compromised laptop do."""
    if argv in (["--version"], ["-V"]):
        return None
    try:
        split, flags = split_cli(argv)
    except (ValueError, IndexError):
        return "the command line does not parse"
    problem = _msb_flags_problem(flags)
    if problem:
        return problem
    try:
        with contextlib.redirect_stderr(io.StringIO()), contextlib.redirect_stdout(io.StringIO()):
            args = build_parser().parse_args(split)
    except SystemExit as exc:
        # -h prints help and exits 0: harmless, and the child prints it again.
        return None if exc.code == 0 and ("-h" in split or "--help" in split) else \
            "the command line does not parse"
    func = args.func
    names = list(getattr(args, "names", None) or [])
    if hasattr(args, "name"):
        names.append(args.name)
    elif hasattr(args, "names") and not names and not getattr(args, "autostart", False):
        names = [None]                  # omitted: the folder's sandbox
    for name in names:
        # `.` and an omitted name mean "the folder I am in", which on the host
        # is nothing the caller chose; a path-like name is never a sandbox.
        if name is None:
            return "name the sandbox: the host's current folder means nothing to the caller"
        if not SANDBOX_NAME.fullmatch(name):
            return f"{name!r} is not a sandbox name"
    if func is cmd_rename and not SANDBOX_NAME.fullmatch(args.new):
        return f"{args.new!r} is not a sandbox name"

    # Allowed as they are: they read, start, stop, or act inside a sandbox, and
    # anything among them that would apply a changed policy (create, rebuild,
    # rename) refuses under MSB_RESTRICTED. `purge` destroys unpushed work and
    # leaks nothing, so it is outside the threat as stated.
    plain = (cmd_ls, cmd_status, cmd_show, cmd_config, cmd_start, cmd_stop, cmd_reclaim,
             cmd_shell, cmd_exec, cmd_update, cmd_resize, cmd_rebuild, cmd_purge, cmd_rename)
    if func in plain:
        return None
    if func is cmd_self_update:
        # Only forward: the latest release is how a remote gets upgraded without
        # the admin key; --version is the way DOWN, to a weaker host serve.
        return "self-update --version can downgrade host serve itself" if args.version else None
    if func is cmd_cache:
        return None if args.action in ("ls", "clear") else "cache: only ls and clear"
    if func is cmd_observe:
        # `on` lifts deny-by-default: everything the guest reads it could send.
        return None if args.action in ("report", "off") else \
            "observe on turns off egress filtering"
    if func is cmd_secret:
        # `add` binds a variable to a host, which decides where a stored value
        # is sent. Storing a value (`set`) is not reading one.
        return None if args.action in ("ls", "set", "rm") else \
            "secret add binds a stored value to a host"
    if func is cmd_setup:
        # The menu edits identities, egress groups and defaults. Storing a
        # Claude token is how one reaches the host at all.
        return None if args.claude_token and args.stdin and not args.welcome else \
            "setup: only --claude-token NAME --stdin"
    if func is cmd_add:
        # A folder `add` mounts a host path of the caller's choosing.
        return None if args.repo else "add: only --repo (a folder add mounts a host path)"
    if func is cmd_policy:
        return None if args.action == "show" else f"policy {args.action} changes what is approved"
    if func is cmd_host:
        return None if args.action == "check" else f"host {args.action} is for the host itself"
    # allow: a new egress rule. mount: a host path. port: a host port. keys:
    # which of the host's ssh keys a sandbox may sign with. code: runs an
    # editor on the host. move/entry/edit: rewrite the registry and the policy.
    # _agent-filter: the host's ssh-agent. The menu: all of the above.
    return f"`{getattr(args, 'cmd', None) or 'the menu'}` is not allowed with this key"


def host_serve():
    """The forced command: validate SSH_ORIGINAL_COMMAND and run it, restricted."""
    def refuse(reason):
        print(f"msbctl host serve: refused: {reason}", file=sys.stderr)
        sys.exit(HOST_EXIT_REFUSED)

    raw = os.environ.get("SSH_ORIGINAL_COMMAND")
    if raw is None:
        # Also what an interactive login with this key gets: there is no shell.
        refuse("this key runs msbctl commands only and gets no shell "
               "(`ssh host msbctl ls`); see `msbctl host authorize`")

    try:
        argv = shlex.split(raw)
    except ValueError:
        refuse("the command does not parse as shell words")
    if not argv or argv[0] != "msbctl":
        refuse("only msbctl commands")
    argv = argv[1:]
    problem = restricted_problem(argv)
    if problem:
        refuse(problem)
    os.environ["MSB_RESTRICTED"] = "1"
    # sshd runs a forced command with its own minimal PATH, so an msb in
    # ~/.local/bin (where get.sh puts it) would not be found by any verb.
    here = os.path.dirname(os.path.realpath(__file__))
    os.environ["PATH"] = os.pathsep.join(
        [os.path.join(HOME, ".local", "bin"), here, os.environ.get("PATH", "")])
    me = os.path.realpath(__file__)
    os.execv(sys.executable, [sys.executable, me, *argv])


def authorized_keys_path():
    return os.path.join(SSH_DIR, "authorized_keys")


def host_authorize(args):
    parsed = _parse_pub_line(args.arg or "")
    if not parsed or "\n" in args.arg:
        die("give one public key line, in quotes: \"ssh-ed25519 AAAA... comment\"")
    _, ktype, comment = parsed
    blob = args.arg.split()[1]
    comment = re.sub(r"[^\w@.: ()+-]", "", comment)    # it lands on an options-bearing line
    path = authorized_keys_path()
    os.makedirs(SSH_DIR, mode=0o700, exist_ok=True)
    os.chmod(SSH_DIR, 0o700)
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except FileNotFoundError:
        text = ""
    existing = text.splitlines()
    present = [line for line in existing if blob in line.split()]
    if present and not args.replace:
        die(f"that key is already in {tilde(path)}:\n  {present[0]}\n"
            "--replace rewrites that line; or edit the file by hand")
    if args.admin:
        if not ktype.startswith("sk-"):
            warn("a plain key as the admin key: if the laptop's ssh-agent holds it, the")
            warn("code this host is guarded against can use it without asking. A FIDO2")
            warn("`sk-` key (or one loaded with `ssh-add -c`) needs a touch or a yes.")
            if not confirm("authorize it unrestricted anyway?"):
                die("cancelled — nothing written")
        line = f"{ktype} {blob} {comment}".rstrip()
    else:
        # As found on PATH, not resolved: a packaged install's `current` link
        # moves on self-update, and the line must follow it.
        me = shutil.which("msbctl")
        if not me:
            me = os.path.realpath(__file__)
            warn(f"msbctl is not on PATH; the line names {me}, which an upgrade may move")
        line = f'restrict,pty,command="{me} host serve" {ktype} {blob} {comment}'.rstrip()
    if present:
        # Every line naming the key goes, so none of them still grants what the
        # new one does not; written whole and renamed, so a failure halfway
        # cannot leave sshd reading half a file.
        kept = [old for old in existing if old not in present] + [line]
        tmp = path + ".msbctl-new"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("\n".join(kept) + "\n")
        os.replace(tmp, path)
    else:
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as fh:
            fh.write(("" if not text or text.endswith("\n") else "\n") + line + "\n")
    os.chmod(path, 0o600)
    note(f"{'replaced in' if present else 'added to'} {tilde(path)}:")
    note(f"  {line}")
    if not args.admin:
        note("this key can run msbctl verbs from host serve's allowlist, and nothing else")


def _check(name, ok, detail):
    return {"check": name, "ok": ok, "detail": detail}


def host_checks():
    """The hygiene report. Heuristics, each labelled as such: none of these can
    prove the host is safe, only point at what plainly is not."""
    out = []
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or str(os.getuid())
    try:
        import grp
        groups = {grp.getgrgid(g).gr_name for g in os.getgroups()}
    except (ImportError, KeyError):
        groups = set()
    admin = sorted(groups & {"sudo", "wheel", "admin"})
    out.append(_check("user", os.getuid() != 0 and not admin,
                      f"{user}, uid {os.getuid()}" + (f", in {', '.join(admin)} (can become root)"
                                                     if admin else "") +
                      (" — root" if os.getuid() == 0 else "")))
    home_mode = os.stat(HOME).st_mode & 0o777
    out.append(_check("home", home_mode & 0o077 == 0, f"{tilde(HOME)} is {home_mode:04o}"))
    if os.path.isdir(SECRETS_DIR):
        loose = [f for f in sorted(os.listdir(SECRETS_DIR))
                 if os.stat(os.path.join(SECRETS_DIR, f)).st_mode & 0o077]
        dmode = os.stat(SECRETS_DIR).st_mode & 0o777
        out.append(_check("secrets", dmode == 0o700 and not loose,
                          f"{tilde(SECRETS_DIR)} {dmode:04o}" +
                          (f"; not 0600: {', '.join(loose)}" if loose else ", every file 0600")))
    else:
        out.append(_check("secrets", True, "no secrets stored yet"))

    def read(path):
        try:
            with open(path, encoding="utf-8") as fh:
                return fh.read().strip()
        except OSError:
            return None
    dumpable = read("/proc/sys/fs/suid_dumpable")
    out.append(_check("core dumps", dumpable == "0", f"fs.suid_dumpable = {dumpable}"))
    pattern = read("/proc/sys/kernel/core_pattern") or ""
    out.append(_check("core pattern", None if pattern.startswith("|") else True,
                      pattern + (" (a pipe: dumps may land on disk unless its Storage=none)"
                                 if pattern.startswith("|") else "")))
    swaps = [line.split()[0] for line in (read("/proc/swaps") or "").splitlines()[1:] if line.split()]
    # zram is compressed memory, not a disk; anything else must sit on dm-crypt.
    plain = [sw for sw in swaps if not sw.startswith("/dev/zram") and not _on_dm_crypt(sw)]
    out.append(_check("swap", not plain, "none" if not swaps else
                      f"{', '.join(swaps)}" + (f" — not encrypted: {', '.join(plain)}" if plain
                                              else " (in memory, or on dm-crypt)")))
    mounts = [line.split()[:2] for line in (read("/proc/mounts") or "").splitlines() if line.split()]
    best = max((m for m in mounts if HOME == m[1] or HOME.startswith(m[1].rstrip("/") + "/")),
               key=lambda m: len(m[1]), default=None)
    crypt = best is not None and _on_dm_crypt(best[0])
    out.append(_check("disk", crypt, f"{tilde(HOME)} is on {best[0] if best else '?'}"
                      f" ({best[1] if best else '?'}): "
                      + ("dm-crypt found below it" if crypt else
                         "no dm-crypt found below it — is the disk encrypted some other way?")))
    keys = []
    for line in (read(authorized_keys_path()) or "").splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            keys.append(line)
    open_keys = [line for line in keys if "host serve" not in line
                 and not any(part.startswith("sk-") for part in line.split()[:3])]
    out.append(_check("authorized_keys", not open_keys,
                      f"{len(keys)} key(s); " + (f"{len(open_keys)} can get a shell and are not sk- keys"
                                                 if open_keys else "each is host serve or an sk- key")))
    out.append(_check("restricted", None, "yes: this key runs under host serve"
                      if restricted() else "no: this session is unrestricted"))
    linger = os.path.exists(f"/var/lib/systemd/linger/{user}")
    unit = os.path.exists(os.path.join(SYSTEMD_USER_DIR, "default.target.wants", AUTOSTART_UNIT))
    out.append(_check("autostart", linger and unit,
                      f"linger {'on' if linger else 'off'}, {AUTOSTART_UNIT} "
                      f"{'enabled' if unit else 'not enabled'} (`msbctl host autostart install`)"))
    msb = shutil.which("msb")
    version = run(["msb", "--version"], capture=True, check=False).stdout.strip() if msb else ""
    out.append(_check("msb", bool(msb) and os.path.exists("/dev/kvm"),
                      f"{version or 'not found'}{' at ' + msb if msb else ''}, "
                      f"/dev/kvm {'present' if os.path.exists('/dev/kvm') else 'MISSING'}"))
    out.append(_check("msbctl", True, version_string()))
    return out


def _on_dm_crypt(device):
    """Whether a block device is, or sits on, a dm-crypt (LUKS) mapping: its
    device-mapper chain, walked through /sys, has a CRYPT- uuid. LVM alone is
    device-mapper too and encrypts nothing, so the name is not enough."""
    try:
        start = os.path.basename(os.path.realpath(device))
    except OSError:
        return False
    seen, todo = set(), [start]
    while todo:
        dev = todo.pop()
        if dev in seen:
            continue
        seen.add(dev)
        try:
            with open(f"/sys/class/block/{dev}/dm/uuid", encoding="utf-8") as fh:
                if fh.read().startswith("CRYPT-"):
                    return True
        except OSError:
            pass  # not a device-mapper device
        try:
            todo += os.listdir(f"/sys/class/block/{dev}/slaves")
        except OSError:
            pass  # a leaf: nothing below it
    return False


def host_check(args):
    checks = host_checks()
    if args.json:
        print_json({"msbctl": version_string(), "restricted": restricted(), "checks": checks})
        return
    say("Host check (heuristics: they point at what is plainly wrong, and prove nothing)")
    for c in checks:
        mark = {True: "ok  ", False: "WARN", None: "info"}[c["ok"]]
        note(f"{mark}  {c['check']:<16} {c['detail']}")


SYSTEMD_USER_DIR = os.path.join(HOME, ".config", "systemd", "user")
AUTOSTART_UNIT = "msb-autostart.service"


def host_autostart(args):
    if args.arg != "install":
        die("host autostart: the only action is `install`")
    me = shutil.which("msbctl") or os.path.realpath(__file__)
    os.makedirs(SYSTEMD_USER_DIR, exist_ok=True)
    path = os.path.join(SYSTEMD_USER_DIR, AUTOSTART_UNIT)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(f"""# Written by `msbctl host autostart install`. Starts every sandbox whose
# registry entry says autostart = true, after a reboot, with nobody logged in
# (that part needs `loginctl enable-linger`, once, as root).
[Unit]
Description=Start the msb-manager autostart sandboxes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH={os.path.join(HOME, '.local', 'bin')}:/usr/local/bin:/usr/bin:/bin
ExecStart={me} start --autostart

[Install]
WantedBy=default.target
""")
    note(f"wrote {tilde(path)}")
    if shutil.which("systemctl"):
        run(["systemctl", "--user", "daemon-reload"], check=False)
        run(["systemctl", "--user", "enable", AUTOSTART_UNIT], check=False)
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or "<user>"
    if not os.path.exists(f"/var/lib/systemd/linger/{user}"):
        note("a user unit runs with nobody logged in only with lingering on; once, as root:")
        note(f"  loginctl enable-linger {user}")


def cmd_host(args, config):
    """host serve|authorize|check|autostart — running this machine as a remote."""
    if args.action == "serve":
        host_serve()
    elif restricted() and args.action != "check":
        die(f"host {args.action} is for the host itself")
    elif args.action == "authorize":
        host_authorize(args)
    elif args.action == "check":
        host_check(args)
    elif args.action == "autostart":
        host_autostart(args)


# ----------------------------------------------------------- remotes (laptop)
#
# A remote is an ssh destination running msb-manager (see `msbctl host`).
# `host:name` addresses a sandbox there: the command line is sent as it was
# typed, that one token made the bare name, over ssh to the host's msbctl,
# with stdio passed straight through. Nothing else is involved: no daemon, no
# protocol, no port. ssh authenticates and encrypts; the host's `host serve`
# decides what the key may run. Local is not special: it is simply the host
# this command runs on.

REMOTE_NAME = re.compile(r"([a-z0-9][a-z0-9-]*):([a-z0-9][a-z0-9-]*|\.)")
REMOTE_DEST = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*@[A-Za-z0-9_][A-Za-z0-9.:_-]*|[A-Za-z0-9_][A-Za-z0-9._:-]*")
REMOTES_DIR = os.path.join(STATE_DIR, "remotes")
REMOTE_LS_TIMEOUT = 15
# How long an unreachable host is left alone before `ls` tries it again. The
# picker reloads the list after every action, and a host that is down would
# otherwise cost the full connect timeout on each one; `ls --refresh` tries now.
REMOTE_RETRY_AFTER = 60


def configured_remotes(config=None):
    """{name: {"ssh": dest}} from config.toml's [remotes.<name>] tables."""
    if config is None:
        try:
            config = load_config()
        except SystemExit:
            return {}
    return {k: v for k, v in (config.get("remotes") or {}).items() if isinstance(v, dict)}


def remote_dest(name, config):
    remote = configured_remotes(config).get(name)
    if not remote or not remote.get("ssh"):
        die(f"unknown remote {name!r} — `msbctl remote ls`")
    dest = str(remote["ssh"])
    if not REMOTE_DEST.fullmatch(dest):
        die(f"remote {name}: ssh = {dest!r} is not user@host or host (fix config.toml)")
    return dest


def ssh_argv(dest, tty, batch=False):
    """ssh to `dest`, sharing one connection per host for ten minutes, ending
    in `--`: the remote command follows as ONE argument (shlex.join), since ssh
    joins the rest with spaces for the far side's shell."""
    os.makedirs(os.path.join(STATE_DIR, "ssh"), mode=0o700, exist_ok=True)
    return ["ssh", "-o", "ControlMaster=auto",
            "-o", f"ControlPath={os.path.join(STATE_DIR, 'ssh', '%C')}",
            "-o", "ControlPersist=600", "-o", "ServerAliveInterval=30",
            "-t" if tty else "-T",
            *(["-o", "BatchMode=yes", "-o", "ConnectTimeout=5"] if batch else []),
            dest, "--"]


def wants_tty():
    """A pty only when both ends are a terminal: `exec` from a pipe (an ACP
    client) must be a clean byte stream, and -t would mangle it."""
    return sys.stdin.isatty() and sys.stdout.isatty()


def split_remote(name):
    """(remote, bare name) for `host:name`, or None for a local name."""
    match = REMOTE_NAME.fullmatch(name or "")
    if not match:
        return None
    if match.group(2) == ".":
        die(f"{name}: `.` means this machine's current folder, which names nothing on "
            f"{match.group(1)} — give the sandbox's name")
    return match.group(1), match.group(2)


def remote_names(args):
    """The names in `args` that are host:name, if any; [] if all are local."""
    names = [args.name] if getattr(args, "name", None) else list(getattr(args, "names", None) or [])
    return [n for n in names if REMOTE_NAME.fullmatch(n or "")]


def _remote_command(raw_argv, token, bare):
    """The original command line, `token` (host:name) replaced by `bare`. It
    occurs once, as the name; anything after it (an exec's command) is left as
    typed, including a later string that happens to look the same."""
    out = list(raw_argv)
    out[out.index(token)] = bare
    return out


def exec_remote(args, config, raw_argv):
    """Replace this process with ssh running the command on the remote; its exit
    status is the remote's (ssh's own failures are 255)."""
    token = args.name
    remote, bare = split_remote(token)
    dest = remote_dest(remote, config)
    argv = ssh_argv(dest, wants_tty()) + [shlex.join(["msbctl", *_remote_command(raw_argv, token, bare)])]
    sys.stdout.flush()
    os.execvp("ssh", argv)


def run_remote_verb(args, config, raw_argv, token):
    """One host:name of a multi-name verb (start a:x b c:y): the verb, this name
    right after it, and the flags as typed; the other names left out."""
    remote, bare = split_remote(token)
    dest = remote_dest(remote, config)
    names = set(args.raw_names)
    verb_at = next(i for i, a in enumerate(raw_argv) if not a.startswith("-"))
    rest = [a for a in raw_argv[verb_at + 1:] if a not in names]
    command = ["msbctl", raw_argv[verb_at], bare, *rest]
    proc = subprocess.run(ssh_argv(dest, wants_tty()) + [shlex.join(command)])
    if proc.returncode:
        die(f"{token}: exit {proc.returncode} on {remote}")


def add_remote_forward(args, config, raw_argv):
    """add --remote HOST …: the rest of the arguments, run there."""
    dest = remote_dest(args.remote, config)
    rest, skip = [], False
    for a in raw_argv:
        if skip:
            skip = False
            continue
        if a == "--remote":
            skip = True
            continue
        if a.startswith("--remote="):
            continue
        rest.append(a)
    sys.stdout.flush()
    os.execvp("ssh", ssh_argv(dest, wants_tty()) + [shlex.join(["msbctl", *rest])])


def _remote_cache_path(name):
    return os.path.join(REMOTES_DIR, f"{name}.json")


def _short_reason(proc):
    text = (proc.stderr or "").strip().splitlines()
    return (text[-1] if text else f"ssh exit {proc.returncode}")[:80]


def query_remote_ls(name, dest, refresh):
    """(rows, problem, stale_age) for one remote: its `ls --json` sandboxes, why
    it could not answer (or None), and how old the rows are if they came from
    the cache. A host that failed less than REMOTE_RETRY_AFTER ago is not tried
    again, unless `refresh`."""
    cache = read_json(_remote_cache_path(name))
    now = time.time()
    if not refresh and cache.get("failed_at", 0) > now - REMOTE_RETRY_AFTER:
        problem = cache.get("reason", "unreachable")
    else:
        command = ["msbctl", "ls", "--json"] + (["--refresh"] if refresh else [])
        try:
            proc = subprocess.run(ssh_argv(dest, tty=False, batch=True) + [shlex.join(command)],
                                  capture_output=True, text=True, timeout=REMOTE_LS_TIMEOUT,
                                  stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            proc = None
        problem = None
        if proc is None:
            problem = f"no answer in {REMOTE_LS_TIMEOUT}s"
        elif proc.returncode == 255:            # ssh's own failure
            problem = f"unreachable: {_short_reason(proc)}"
        else:
            try:
                data = json.loads(proc.stdout)
                rows = data["sandboxes"]
            except (ValueError, KeyError, TypeError):
                # An older msbctl answers --json with its usage text, which is
                # not a parse error worth reporting as one.
                old = "usage:" in (proc.stderr or "") + (proc.stdout or "")
                problem = ("host msbctl too old (needs `ls --json`)" if old
                           else f"error: {_short_reason(proc)}")
            else:
                write_json(_remote_cache_path(name), {"at": now, "sandboxes": rows,
                                                      "msbctl": data.get("msbctl", "")})
                return rows, None, None
        cache["failed_at"], cache["reason"] = now, problem
        write_json(_remote_cache_path(name), cache)
    if cache.get("sandboxes") is not None:
        return cache["sandboxes"], problem, now - cache.get("at", now)
    return [], problem, None


def _age(seconds):
    for unit, step in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= step:
            return f"{int(seconds // step)}{unit}"
    return f"{int(seconds)}s"


def remote_ls_rows(args, config):
    """[(host, row dict or None, note)] for every configured remote, queried in
    parallel. A row None is the one line an unreachable remote gets."""
    import concurrent.futures
    remotes = configured_remotes(config)
    out = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, min(8, len(remotes)))) as pool:
        futures = {name: pool.submit(query_remote_ls, name, remote_dest(name, config), args.refresh)
                   for name in sorted(remotes)}
        for name, fut in futures.items():
            rows, problem, stale = fut.result()
            if problem:
                out.append((name, None, problem + (f" (rows below are {_age(stale)} old)"
                                                   if stale is not None and rows else "")))
            for row in rows:
                out.append((name, row, f"stale {_age(stale)}" if stale is not None else ""))
    return out


def remote_key_candidates():
    """Public keys the laptop could authorize on a host: the agent's, then ~/.ssh/*.pub."""
    out = []
    proc = subprocess.run(["ssh-add", "-L"], capture_output=True, text=True)
    for line in proc.stdout.splitlines() if proc.returncode == 0 else []:
        if _parse_pub_line(line):
            out.append(("agent", line.strip()))
    try:
        for f in sorted(os.listdir(SSH_DIR)):
            if f.endswith(".pub"):
                with open(os.path.join(SSH_DIR, f), encoding="utf-8") as fh:
                    line = fh.read().strip()
                if _parse_pub_line(line) and all(line.split()[1] != l.split()[1] for _, l in out):
                    out.append((f"~/.ssh/{f}", line))
    except OSError:
        pass  # no ~/.ssh: nothing to list
    return out


def remote_test(name, config, batch=True):
    """Run the host's `host check --json` and say what matters from here."""
    dest = remote_dest(name, config)
    # Not batch: ssh may need to ask about the host key, on the terminal.
    proc = subprocess.run(ssh_argv(dest, tty=False, batch=batch)
                          + [shlex.join(["msbctl", "host", "check", "--json"])],
                          capture_output=True, text=True,
                          stdin=subprocess.DEVNULL if batch else None)
    try:
        data = json.loads(proc.stdout)
    except ValueError:
        reason = _short_reason(proc) if proc.returncode else "not JSON (host msbctl too old?)"
        write_json(os.path.join(REMOTES_DIR, f"{name}.test.json"),
                   {"at": time.time(), "ok": False, "summary": reason})
        die(f"{name} ({dest}): {reason}")
    say(f"{name}  {dest}")
    for c in data.get("checks", []):
        mark = {True: "ok  ", False: "WARN", None: "info"}[c.get("ok")]
        note(f"{mark}  {c.get('check', '?'):<16} {c.get('detail', '')}")
    problems = []
    if not data.get("restricted"):
        problems.append("this key is not restricted")
        warn("this key can get a shell on the host: run `msbctl host authorize \"<this key>\"` "
             "there and remove its unrestricted line")
    theirs = str(data.get("msbctl", "")).split()[0]
    mine = version_string().split()[0]
    if theirs.split("+")[0] != mine.split("+")[0]:
        problems.append(f"msbctl {theirs} there, {mine} here")
        warn(f"the host runs msbctl {theirs}, this machine {mine}")
    write_json(os.path.join(REMOTES_DIR, f"{name}.test.json"),
               {"at": time.time(), "ok": not problems, "summary": "; ".join(problems) or "ok"})


RELEASES = "https://github.com/runoverlabs/sandbox-manager/releases"
MSB_INSTALLER = "https://github.com/microsandbox/microsandbox/releases/latest/download/install.sh"

# What `remote setup` needs to know about a host, as key=value lines, run by
# remote_sh().
REMOTE_PROBE = r"""u="$(id -un)"
printf 'user=%s\n' "$u"
printf 'msb=%s\n' "$(msb --version 2>/dev/null | head -n1)"
printf 'msbctl=%s\n' "$(msbctl --version 2>/dev/null | head -n1)"
printf 'kvm=%s\n' "$(if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then echo rw; elif [ -e /dev/kvm ]; then echo denied; else echo missing; fi)"
printf 'curl=%s\n' "$(command -v curl)"
printf 'linger=%s\n' "$(if [ -e "/var/lib/systemd/linger/$u" ]; then echo yes; else echo no; fi)"
printf 'unit=%s\n' "$(if [ -e "$HOME/.config/systemd/user/msb-autostart.service" ]; then echo yes; else echo no; fi)"
printf 'sudo=%s\n' "$(if sudo -n true 2>/dev/null; then echo yes; else echo no; fi)"
"""


def remote_sh(dest, script, *args, tty=False, batch=False, capture=False, stdin=None):
    """Run a sh script on `dest` with ~/.local/bin on PATH: for setting a host
    up, through a key that still has a shell. `sh -c` whatever the login shell
    is; ~/.local/bin because both installers put their commands there and a
    non-login ssh session often does not look. Under `host serve` this is
    refused (exit 126), which is how a key already restricted shows."""
    command = shlex.join(["sh", "-c", 'PATH="$HOME/.local/bin:$PATH"; ' + script, "sh", *args])
    return subprocess.run(ssh_argv(dest, tty=tty, batch=batch) + [command],
                          capture_output=capture, text=True,
                          stdin=subprocess.DEVNULL if batch and stdin is None else None,
                          input=stdin)


def ssh_close(dest):
    """End the shared connection to `dest`. One opened through a key that had
    a shell would otherwise keep that shell for ten minutes after the key has
    been restricted."""
    subprocess.run(ssh_argv(dest, tty=False)[:-2] + ["-O", "exit", dest],
                   capture_output=True, text=True)


def remote_probe(dest, batch=False):
    """{key: value} from REMOTE_PROBE, or None if this key already runs
    `host serve` there (it refuses a shell script, exit 126). Dies when ssh
    itself fails."""
    proc = remote_sh(dest, REMOTE_PROBE, batch=batch, capture=True)
    if proc.returncode == 126 and "host serve" in (proc.stderr or ""):
        return None
    if proc.returncode:
        die(f"{dest}: {_short_reason(proc)}")
    return dict(line.split("=", 1) for line in proc.stdout.splitlines() if "=" in line)


def own_release():
    """The release a host should run to match this machine: this version, or
    None from a checkout, whose version may not have been released."""
    return None if IS_CHECKOUT else version_string().split()[0]


def remote_setup(name, config):
    """Bring a remote to a working host, asking before each change: msb,
    msbctl at this machine's version, /dev/kvm, autostart, and last this
    machine's key restricted to `host serve`. Then `remote test`."""
    dest = remote_dest(name, config)
    say(f"Setting up {name}  ({dest})")
    # Not batch mode: an unknown host key has to be accepted at the prompt.
    probe = remote_probe(dest)
    if probe is None:
        note("this machine's key already runs `msbctl host serve` there, so the host is")
        note("set up; anything more is done on the host itself, or with an admin key")
        remote_test(name, config)
        return
    note(f"{'user':<9} {probe.get('user', '?')}")
    note(f"{'msb':<9} {probe.get('msb') or 'not installed'}")
    note(f"{'msbctl':<9} {probe.get('msbctl') or 'not installed'}")
    note(f"{'/dev/kvm':<9} {dict(rw='usable', denied='no access for this user', missing='missing').get(probe.get('kvm'), '?')}")
    if probe.get("kvm") == "missing":
        die(f"{name} has no /dev/kvm: msb cannot run sandboxes there (no KVM, or a VM "
            "without nested virtualization)")

    wanted = own_release()
    if not probe.get("curl") and (not probe.get("msb") or not probe.get("msbctl")):
        die(f"{name} has no curl, which both installers need — install it there first")
    if not probe.get("msb"):
        note("")
        note(f"msb from microsandbox's installer ({MSB_INSTALLER})")
        if confirm(f"install msb on {name}?"):
            if remote_sh(dest, f"curl -fsSL {shlex.quote(MSB_INSTALLER)} | sh", tty=wants_tty()).returncode:
                die(f"installing msb on {name} failed (above)")
    theirs = (probe.get("msbctl") or "").split()[1:2]
    theirs = theirs[0] if theirs else ""
    mine = version_string().split()[0]
    installed = bool(theirs)
    if not theirs or theirs.split("+")[0] != mine.split("+")[0]:
        note("")
        if "git checkout" in probe.get("msbctl", ""):
            warn(f"{name} runs msbctl from a git checkout ({theirs}): update it there with git pull")
        else:
            release = f"v{wanted}" if wanted else "the latest release"
            question = (f"install msbctl ({release}) on {name}?" if not theirs
                        else f"msbctl {theirs} there, {mine} here — install {release} on {name}?")
            if confirm(question):
                get = f"{RELEASES}/{f'download/v{wanted}' if wanted else 'latest/download'}/get.sh"
                script = f"curl -fsSL {shlex.quote(get)} | sh" + (f" -s -- --version v{wanted}" if wanted else "")
                if remote_sh(dest, script, tty=wants_tty()).returncode:
                    die(f"installing msbctl on {name} failed (above)")
                installed = True
    if not installed:
        # Autostart, the key's forced command and the test are all msbctl's.
        note("")
        note(f"without msbctl on {name} there is nothing more to set up; "
             f"`msbctl remote setup {name}` asks again")
        return
    if probe.get("kvm") == "denied":
        note("")
        user = probe.get("user", "")
        warn(f"{user} cannot open /dev/kvm on {name}: it is usually the kvm group")
        if probe.get("sudo") == "yes" and confirm(f"add {user} to the kvm group there (sudo)?"):
            remote_sh(dest, 'sudo -n usermod -aG kvm "$1"', user)
            # A group applies from the next login, so drop the shared connection.
            ssh_close(dest)
        else:
            note(f"on {name}, as root:  usermod -aG kvm {user}")

    if probe.get("unit") != "yes" or probe.get("linger") != "yes":
        note("")
        note("autostart: the sandboxes marked autostart start when the host boots, with")
        note("nobody logged in (a systemd user unit, and lingering for the user)")
        if confirm(f"set up autostart on {name}?"):
            remote_sh(dest, "msbctl host autostart install", tty=wants_tty())
            if probe.get("linger") != "yes":
                if probe.get("sudo") == "yes":
                    remote_sh(dest, 'sudo -n loginctl enable-linger "$1"', probe.get("user", ""))
                else:
                    note(f"lingering needs root, once, on {name}:  loginctl enable-linger {probe.get('user', '')}")

    remote_restrict_key(name, dest)
    say(f"Testing {name}")
    remote_test(name, load_config())


def remote_restrict_key(name, dest):
    """Offer to give this machine's key the forced command on the host. If the
    key is the one this connection logs in with, that ends its shell there."""
    say("This machine's key on the host")
    note("Restricted, a key runs `msbctl host serve`: msbctl verbs from its allowlist,")
    note("no shell, nothing that reads a stored secret or approves a changed policy.")
    note("That is what keeps an agent running on this machine from doing more there.")
    cands = remote_key_candidates()
    if not cands:
        note("no public key found in the ssh-agent or ~/.ssh — skipped")
        return
    skip = "not now (the key keeps its shell; `msbctl remote setup` asks again)"
    labels = [f"{where:<22} {line.split()[0]} …{line.split()[1][-12:]} {' '.join(line.split()[2:])}"
              for where, line in cands]
    # The default is to skip: the agent's first key is as likely to be the
    # one an operator keeps a shell with as the everyday one.
    choice = choose_one("restrict which key", labels + [skip], len(labels))
    if choice == skip:
        return
    line = cands[labels.index(choice)][1]
    blob = line.split()[1]
    proc = remote_sh(dest, 'grep -F -- "$1" "$HOME/.ssh/authorized_keys"', blob, capture=True)
    current = (proc.stdout or "").strip()
    if "host serve" in current and "\n" not in current:
        note("already restricted there")
        return
    replace = bool(current)
    if replace:
        warn(f"this key logs in to {name} with a shell now; restricted, it no longer will.")
        warn("Keep another way in first: a password, the console, or an admin key")
        warn("(`ssh-keygen -t ed25519-sk`, then `msbctl host authorize '<its .pub line>' --admin` on the host).")
        if not confirm("restrict it anyway?"):
            return
    # The key line before the flag: before Python 3.12, argparse settles the
    # optional KEY positional as soon as it sees `authorize`, and a key after
    # --replace is then an unrecognized argument.
    proc = remote_sh(dest, 'msbctl host authorize "$@"', line, *(["--replace"] if replace else []))
    if proc.returncode:
        die(f"authorizing the key on {name} failed (above)")
    # The shared connection still has the old key's shell: close it, so the
    # next command logs in again and gets the forced command.
    ssh_close(dest)


def cmd_remote(args, config):
    """remote add|setup|ls|test|rm — the ssh destinations this machine drives."""
    if args.action == "ls":
        remotes = configured_remotes(config)
        if not remotes:
            note("no remotes — `msbctl remote add NAME user@host`")
            return
        for name in sorted(remotes):
            note(f"{name:<16} {remotes[name].get('ssh', '?'):<32} {remote_last_test(name)}")
        return
    name = args.name or die(f"remote {args.action} needs a NAME")
    if not SANDBOX_NAME.fullmatch(name):
        die(f"{name!r}: a remote's name is lowercase letters, digits and dashes")
    if args.action == "add":
        dest = args.dest or die("remote add NAME DEST: DEST is user@host")
        if not REMOTE_DEST.fullmatch(dest):
            die(f"{dest!r} is not user@host or host")
        if name in configured_remotes(config):
            die(f"{name} is already a remote (`msbctl remote rm {name}` first)")
        ensure_local_config()
        set_toml_key(CONFIG_FILE, "ssh", dest, table=f"remotes.{name}")
        note(f"remotes.{name} = {dest}  ({tilde(CONFIG_FILE)})")
        if sys.stdin.isatty() and sys.stdout.isatty():
            # At a terminal, do the host's half from here too, asking first.
            try:
                remote_setup(name, load_config())
            except SystemExit as exc:
                warn(str(exc.code).replace("msbctl: ", "", 1))
                note(f"registered anyway; `msbctl remote setup {name}` tries again")
            return
        say("On the host, authorize this machine's everyday key")
        note("It gets a forced command there: msbctl verbs from host serve's allowlist,")
        note("no shell, and nothing that can read a stored secret or approve a policy.")
        cands = remote_key_candidates()
        for where, line in cands:
            parts = line.split()
            note(f"  {where:<22} {parts[0]} …{parts[1][-12:]} {' '.join(parts[2:])}")
        line = cands[0][1] if cands else "ssh-ed25519 AAAA... you@this-machine"
        note("")
        note(f"  msbctl host authorize \"{line}\"")
        note("")
        note("For policy changes from here, use a SEPARATE key the agent does not hold —")
        note("a FIDO2 one: `ssh-keygen -t ed25519-sk`, then on the host `msbctl host authorize '<its .pub line>' --admin`.")
        say(f"Testing {name}")
        # Not batch mode, this once: an unknown host key has to be accepted at
        # a prompt, and BatchMode fails on it with a message that does not say so.
        try:
            remote_test(name, load_config(), batch=False)
        except SystemExit as exc:
            warn(str(exc.code).replace("msbctl: ", "", 1))
            note(f"once the key is authorized there: `msbctl remote test {name}`")
    elif args.action == "setup":
        remote_setup(name, config)
    elif args.action == "test":
        remote_test(name, config)
    elif args.action == "rm":
        if not remove_toml_table(CONFIG_FILE, f"remotes.{name}"):
            die(f"no remote {name!r}")
        for f in (f"{name}.json", f"{name}.test.json"):
            try:
                os.unlink(os.path.join(REMOTES_DIR, f))
            except FileNotFoundError:
                pass  # never queried
        note(f"{name} removed from {tilde(CONFIG_FILE)}; the host itself is untouched")


def remote_last_test(name):
    test = read_json(os.path.join(REMOTES_DIR, f"{name}.test.json"))
    if not test.get("at"):
        return "not tested"
    return f"{'ok' if test.get('ok') else test.get('summary', '?')}, {_age(time.time() - test['at'])} ago"


def remotes_menu(config):
    """The main menu's "remote hosts": add one, set one up or test it, remove
    it. Each action is the `msbctl remote` verb of the same name."""
    while True:
        remotes = configured_remotes(config)
        say("Remote hosts")
        note("Machines that run sandboxes for this one, over ssh. A sandbox there is")
        note("HOST:name for every msbctl verb, and `msbctl ls` lists them all.")
        add, back = "add a remote host", "back"
        rows = {f"{n:<14} {remotes[n].get('ssh', '?'):<28} {remote_last_test(n)}": n
                for n in sorted(remotes)}
        choice = choose_one("remote hosts", list(rows) + [add, back], 0 if rows else len(rows))
        if choice == back:
            return
        try:
            if choice == add:
                dest = ask("ssh destination (user@host, or a Host from ~/.ssh/config)")
                if not dest:
                    continue
                host = dest.split("@")[-1].split(".")[0].lower()
                name = ask("call it", re.sub(r"[^a-z0-9-]+", "-", host).strip("-") or "remote")
                cmd_remote(verb_args("remote", action="add", name=name, dest=dest), config)
            else:
                name = rows[choice]
                setup, test, rm = "set up / check", "test the connection", "remove"
                action = choose_one(name, [setup, test, rm, back], 0)
                if action == setup:
                    remote_setup(name, config)
                elif action == test:
                    remote_test(name, config)
                elif action == rm and confirm(f"forget {name}? (the host itself is untouched)"):
                    cmd_remote(verb_args("remote", action="rm", name=name), config)
        except SystemExit as exc:
            if exc.code:
                warn(str(exc.code).replace("msbctl: ", "", 1))
        config = load_config()


