    return which + ("" if stored else " — NOT STORED")


def section_claude_token(box, config, ctx):
    """Which named Claude token this sandbox logs in with. The value is read on
    every start, so a change is a restart, never a rebuild."""
    say("Claude token")
    tokens = claude_tokens()
    if box.claude_auth != "secret":
        note(f"claude_auth is {box.claude_auth!r}, so no token is bound")
        return
    if not tokens:
        note("no Claude tokens stored yet — `msbctl setup` → Claude login")
        return
    default = default_claude_token(config)
    follow = f"the default  (now {default})"
    options = [follow] + list(tokens)
    current = box.claude_token_pinned if box.claude_token_pinned in tokens else follow
    choice = choose_one("Claude token", options, options.index(current))
    pin = "" if choice == follow else choice
    if pin == box.claude_token_pinned:
        return
    set_toml_key(registry_path(box), "claude_token", pin)
    state = state_of(box.name)
    if state != "running":
        note("used from its next start")
        return
    if not confirm(f"apply now — this restarts {box.name}?"):
        note("saved; used from the next restart")
        return
    # msb reads a secret's value at start, so a restart is the whole change: the
    # binding and the guest's placeholder stay the same, only the value differs.
    run(["msb", "stop", box.name], check=False, quiet=True)
    ensure_running(Sandbox(box.name, config))


