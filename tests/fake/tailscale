#!/usr/bin/env python3
"""A fake `tailscale` for the kandev tests: records every call's argv in
FAKE_TAILSCALE_LOG, answers `status --json` as a running node, and accepts
`serve`. FAKE_TAILSCALE_FAIL=serve makes `serve` fail; FAKE_TAILSCALE_NO_CERTS=1
answers like a headscale node, with no CertDomains."""
import json
import os
import sys

argv = sys.argv[1:]
with open(os.environ["FAKE_TAILSCALE_LOG"], "a", encoding="utf-8") as fh:
    fh.write(json.dumps(argv) + "\n")
if argv[:1] == [os.environ.get("FAKE_TAILSCALE_FAIL")]:
    sys.exit("fake tailscale: fails on purpose")
if argv[:2] == ["status", "--json"]:
    status = {"BackendState": "Running", "Self": {"DNSName": "sbx-01.example.ts.net."},
              "CertDomains": ["sbx-01.example.ts.net"]}
    if os.environ.get("FAKE_TAILSCALE_NO_CERTS"):
        status["CertDomains"] = None
    print(json.dumps(status))
elif argv[:1] != ["serve"]:
    sys.exit(f"fake tailscale: unexpected call {argv[:2]}")
