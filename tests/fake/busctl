#!/usr/bin/env python3
"""A fake `busctl` for the tests: answers the one question msbctl asks it,
whether the Secret Service's default collection is Locked, from FAKE_KEYRING
("unlocked" or "locked"; unset, there is no Secret Service on the bus).
Anything else fails, loudly."""
import os
import sys

argv = sys.argv[1:]
question = ["--user", "--timeout=5", "get-property", "org.freedesktop.secrets",
            "/org/freedesktop/secrets/aliases/default", "org.freedesktop.Secret.Collection", "Locked"]
if argv != question:
    sys.exit(f"fake busctl: unexpected call {argv}")
mode = os.environ.get("FAKE_KEYRING")
if mode not in ("unlocked", "locked"):
    sys.exit("Failed to get property Locked on interface org.freedesktop.Secret.Collection: "
             "The name org.freedesktop.secrets was not provided by any .service files")
print("b false" if mode == "unlocked" else "b true")
