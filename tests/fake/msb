#!/usr/bin/env python3
"""A fake `msb` for the tests: records every call, keeps a little state, and
refuses anything it does not know so that an unexpected call fails loudly.

    FAKE_MSB_LOG       one JSON line per call: {"argv": [...], "env": {...}}
    FAKE_MSB_ENV_KEYS  comma-separated variables whose values `env` records;
                       only these, so a test asks for exactly what it checks
    FAKE_MSB_STATE     JSON {name: "running"|"stopped", "_volumes": {...}}
    FAKE_MSB_EXEC_OUT  printed by `exec`, which otherwise prints nothing
    FAKE_MSB_READ_STDIN  if set, `exec` reads its stdin and logs its sha256 and
                       length as "stdin" (never the bytes: they may be a secret)
    FAKE_MSB_FAIL      a verb (`create`, `pull`, …) that fails with exit 1
    FAKE_MSB_VERSION   what `--version` says (default 0.7.12)
    FAKE_MSB_DOCTOR    if set, `--help` lists `doctor`, which answers as 0.7.12's
                       does: "ok", "warn" (exit 0 with a warning) or "fail"

`ls --format json` prints what msbctl's msb_table() reads (`name`, `status`
as msb spells it, `Running`), plain `ls` msb's text table; keep
scripts/screenshots/bin/msb on the same shape.
"""
import hashlib
import json
import os
import re
import sys

MIB = 1024 * 1024
UNITS = {"M": 1, "G": 1024, "T": 1024 * 1024}


def load():
    try:
        with open(os.environ["FAKE_MSB_STATE"], encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return {}


def save(state):
    with open(os.environ["FAKE_MSB_STATE"], "w", encoding="utf-8") as fh:
        json.dump(state, fh)


def record(argv, stdin=None):
    keys = [k for k in os.environ.get("FAKE_MSB_ENV_KEYS", "").split(",") if k]
    line = {"argv": argv, "env": {k: os.environ[k] for k in keys if k in os.environ}}
    if stdin is not None:
        line["stdin"] = {"sha256": hashlib.sha256(stdin).hexdigest(), "size": len(stdin)}
    if "MSB_CONFIG_PATH" in os.environ and os.path.isfile(os.environ["MSB_CONFIG_PATH"]):
        with open(os.environ["MSB_CONFIG_PATH"], encoding="utf-8") as fh:
            line["msb_config"] = json.load(fh)
    with open(os.environ["FAKE_MSB_LOG"], "a", encoding="utf-8") as fh:
        fh.write(json.dumps(line) + "\n")


def refuse(argv):
    print(f"fake msb: unexpected call: {argv[:3]}", file=sys.stderr)
    sys.exit(2)


def size(text):
    m = re.fullmatch(r"(\d+)([MGT])", text.upper())
    return int(m.group(1)) * MIB * UNITS[m.group(2)] if m else 0


def create(argv, state):
    name = argv[argv.index("--name") + 1]
    if name in state:
        sys.exit(f"fake msb: sandbox {name} already exists")
    vols = state.setdefault("_volumes", {})
    for i, arg in enumerate(argv):
        if arg == "--mount-named":
            vol, _, opts = argv[i + 1].split(":", 2)
            if vol not in vols:
                found = re.search(r"size=([0-9]+[MGTmgt])", opts)
                vols[vol] = {"kind": "disk", "capacity_bytes": size(found.group(1)) if found else 0,
                             "used_bytes": 0}
    state[name] = "running"
    labels = [argv[i + 1] for i, a in enumerate(argv) if a == "--label"]
    if labels:
        state.setdefault("_labels", {})[name] = labels
    state.setdefault("_created", {})[name] = os.environ.get(
        "FAKE_MSB_CREATED", "2026-10-17T12:00:00.123456789+00:00")
    state.setdefault("_secrets", {})[name] = dict(secret_binding(argv[i + 1])
                                                  for i, a in enumerate(argv) if a == "--secret")
    state.setdefault("_ports", {})[name] = [port_row(argv[i + 1]) for i, a in enumerate(argv)
                                            if a == "--port"]


def secret_var(spec):
    """The variable an `ENV[:OPTIONS]@HOST` spec binds."""
    return spec.split("@", 1)[0].split(":", 1)[0]


def secret_binding(spec):
    """(variable, [hosts]) for an `ENV[:OPTIONS]@HOST[,HOST]` spec."""
    return secret_var(spec), spec.rpartition("@")[2].split(",")


def modify(argv, state):
    """--secret / --secret-rm change the recorded bindings; anything else is a
    no-op. Like msb, a binding NEW to a running sandbox needs --restart or
    --next-start; a new value for one it has is live."""
    name = argv[1]
    if name not in state:
        sys.exit(f"fake msb: no sandbox {name}")
    bound = state.setdefault("_secrets", {}).setdefault(name, {})
    timing = "--restart" in argv or "--next-start" in argv
    for i, a in enumerate(argv):
        if a == "--secret":
            var, hosts = secret_binding(argv[i + 1])
            if var not in bound and state[name] == "running" and not timing:
                sys.exit(f"fake msb: cannot modify {name!r} without a restart: secret {var} is new")
            bound[var] = hosts
        elif a == "--secret-rm":
            bound.pop(argv[i + 1], None)


def port_row(spec, rm=False):
    """msb's --port (or, with `rm`, --port-rm) syntax as inspect's row."""
    body, _, proto = spec.partition("/")
    bind = "127.0.0.1"
    if body.startswith("["):
        bind, _, body = body[1:].partition("]:")
    elif body.count(":") == (1 if rm else 2):
        bind, body = body.split(":", 1)
    host, _, guest = body.partition(":")
    return {"host_bind": bind, "host_port": int(host), "guest_port": int(guest or 0),
            "protocol": proto or "tcp"}


def modify(argv, state):
    """--port / --port-rm change the recorded ports; anything else is a no-op."""
    name = argv[1]
    if name not in state:
        sys.exit(f"fake msb: no sandbox {name}")
    ports = state.setdefault("_ports", {}).setdefault(name, [])
    key = lambda row: (row["host_bind"], row["host_port"], row["protocol"])
    for i, a in enumerate(argv):
        if a == "--port-rm":
            gone = key(port_row(argv[i + 1], rm=True))
            if not any(key(r) == gone for r in ports):
                sys.exit(f"fake msb: no published port at {argv[i + 1]}")
            ports[:] = [r for r in ports if key(r) != gone]
        elif a in ("--port", "-p"):
            row = port_row(argv[i + 1])
            ports[:] = [r for r in ports if key(r) != key(row)] + [row]


def ls(argv, state):
    wanted = [argv[i + 1] for i, a in enumerate(argv) if a == "--label"]
    names = [n for n in state if not n.startswith("_")
             and all(w in state.get("_labels", {}).get(n, []) for w in wanted)]
    if "-q" in argv:
        for name in names:
            print(name)
    elif "--format" in argv:
        print(json.dumps([{"name": n, "status": state[n].capitalize(), "image": "base",
                           "created_at": state.get("_created", {}).get(n, "")} for n in names]))
    else:
        print("NAME  IMAGE  STATUS  CREATED")
        for name in names:
            print(f"{name}  base  {state[name]}  2026-10-01")


def main():
    argv = sys.argv[1:]
    stdin = None
    if argv[:1] == ["exec"] and os.environ.get("FAKE_MSB_READ_STDIN"):
        stdin = sys.stdin.buffer.read()
    record(argv, stdin)
    if argv[:1] == [os.environ.get("FAKE_MSB_FAIL")]:
        sys.exit(f"fake msb: {argv[0]} fails on purpose")
    state = load()
    verb = argv[:1]
    if argv == ["--version"]:
        print(f"msb {os.environ.get('FAKE_MSB_VERSION', '0.7.12')}")
    elif argv == ["--help"]:
        print("Usage: msb <COMMAND>\n\nCommands:\n  create  Create a sandbox\n  ls      List sandboxes")
        if os.environ.get("FAKE_MSB_DOCTOR"):
            print("  doctor  Check this host")
    elif verb == ["doctor"] and os.environ.get("FAKE_MSB_DOCTOR"):
        mode = os.environ["FAKE_MSB_DOCTOR"]
        say = sys.stderr.write
        say("  • Platform            Linux x86_64\n  ✓ msb                 /x/bin/msb\n")
        if mode == "fail":
            say("  ✗ KVM access          permission denied\n"
                "error: /dev/kvm is not accessible\n  → fix: add your user to the kvm group\n"
                "  → apply automatically: msb doctor --fix\n")
            sys.exit(1)
        if mode == "warn":
            say("warn: Root clone: copy fallback — reflink unavailable\n")
        say("  ✓ Host setup is ready.\n")
    elif verb == ["ls"]:
        ls(argv, state)
    elif verb == ["pull"]:
        pass
    elif verb == ["create"]:
        create(argv, state)
    elif verb in (["start"], ["stop"]):
        name = argv[1]
        if name not in state:
            sys.exit(f"fake msb: no sandbox {name}")
        state[name] = "running" if verb == ["start"] else "stopped"
    elif verb == ["rm"]:
        name = next(a for a in argv[1:] if not a.startswith("-"))
        if state.pop(name, None) is None:
            sys.exit(f"fake msb: no sandbox {name}")
        state.get("_labels", {}).pop(name, None)
    elif verb == ["exec"]:
        sys.stdout.write(os.environ.get("FAKE_MSB_EXEC_OUT", ""))
    elif verb == ["modify"]:
        modify(argv, state)
    elif verb == ["inspect"]:
        sock = os.path.join(os.environ["MSB_STATE_DIR"], "agent", f"{argv[1]}.sock")
        bound = state.get("_secrets", {}).get(argv[1], {})
        print(json.dumps({"config": {"vsock": {"routes": [{"port": 5001, "host_socket": sock}]},
                                     "network": {"ports": state.get("_ports", {}).get(argv[1], []), 
                                                 "secrets": {"secrets": [
                                         {"env_var": v, "allowed_hosts": [
                                             {"wildcard" if h.startswith("*") else "exact": h}
                                             for h in hosts]}
                                         for v, hosts in bound.items()]}}}}))
    elif argv[:2] == ["volume", "ls"]:
        vols = state.get("_volumes", {})
        print(json.dumps([{"name": n, **v} for n, v in vols.items()]))
    elif argv[:2] == ["volume", "rm"]:
        if state.get("_volumes", {}).pop(argv[2], None) is None:
            sys.exit(f"fake msb: no volume {argv[2]}")
    else:
        refuse(argv)
    save(state)


if __name__ == "__main__":
    main()
