#!/usr/bin/env python3
"""A fake `secret-tool` (libsecret) for the tests: a keyring in a JSON file.

    FAKE_KEYRING        "unlocked" or "locked"; unset, there is no Secret Service
    FAKE_KEYRING_PROMPT "dismiss": the unlock prompt a locked keyring shows is
                        dismissed, and the call fails; otherwise it is answered
    FAKE_KEYRING_STATE  JSON [{"attrs": {...}, "label": ..., "value": ...}]
    FAKE_KEYRING_LOG    one JSON line per call, argv only (never the secret)
    FAKE_KEYRING_FAIL   a verb (`store`, …) that fails with exit 1, or
                        `verb:VAR` for that verb on that variable only

A real secret-tool asks to unlock a locked keyring: a call against one logs
`PROMPTED`, so a test can see the prompt happened, and an answered prompt
leaves it unlocked (FAKE_KEYRING_STATE + ".unlocked", which the fake busctl
reads too) until the test locks it again. As with gnome-keyring 48 and
libsecret 0.21 (spike 20): a `lookup` or `clear` that matches no item fails
with exit 1 and prompts for nothing, and `search` (no --unlock) never prompts,
listing a locked item as `[/n]` with its label but not its secret. With no Secret Service
msbctl must not call it at all; such a call logs `NO_SERVICE` and fails. `store` reads the secret from stdin, as the real one
does when stdin is not a terminal.
"""
import json
import os
import sys

argv = sys.argv[1:]
log = os.environ.get("FAKE_KEYRING_LOG")
state_path = os.environ.get("FAKE_KEYRING_STATE")
mode = os.environ.get("FAKE_KEYRING")


def record(entry):
    if log:
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(entry) + "\n")


record({"argv": argv})
if mode not in ("unlocked", "locked"):
    record({"NO_SERVICE": argv[:1]})
    sys.exit("fake secret-tool: there is no Secret Service to call")


def load():
    try:
        with open(state_path, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return []


def save(items):
    with open(state_path, "w", encoding="utf-8") as fh:
        json.dump(items, fh)


def attrs(words):
    if len(words) % 2:
        sys.exit("fake secret-tool: attributes come in pairs")
    return dict(zip(words[::2], words[1::2], strict=True))


def matches(item, want):
    return all(item["attrs"].get(k) == v for k, v in want.items())


verb, rest = (argv[0] if argv else ""), argv[1:]
items = load()
want = attrs([a for a in rest if not a.startswith("--label=")])
locked = mode == "locked" and not os.path.exists(state_path + ".unlocked")
if verb == "search":
    for n, item in enumerate(items, 1):
        if matches(item, want):
            print(f"[/{n}]\nlabel = {item['label']}")
    sys.exit(0)
if not any(matches(i, want) for i in items) and verb in ("lookup", "clear"):
    sys.exit(1)
if locked:
    record({"PROMPTED": argv[:1]})
    if os.environ.get("FAKE_KEYRING_PROMPT") == "dismiss":
        sys.exit("fake secret-tool: the unlock prompt was dismissed")
    open(state_path + ".unlocked", "w").close()
if os.environ.get("FAKE_KEYRING_FAIL") in (verb, f"{verb}:{want.get('var')}"):
    sys.exit("fake secret-tool: fails on purpose")
if verb == "store":
    label = next((a.split("=", 1)[1] for a in rest if a.startswith("--label=")), None)
    if label is None:
        sys.exit("fake secret-tool: store needs --label")
    value = sys.stdin.read()
    items = [i for i in items if i["attrs"] != want]
    items.append({"attrs": want, "label": label, "value": value})
    save(items)
elif verb == "lookup":
    sys.stdout.write(next(i for i in items if matches(i, want))["value"])
elif verb == "clear":
    save([i for i in items if not matches(i, want)])
else:
    sys.exit(f"fake secret-tool: unexpected call {argv[:1]}")
